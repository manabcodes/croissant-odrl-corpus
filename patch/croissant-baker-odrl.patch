+"""ODRL usage policy support for Croissant Baker."""
+
+from croissant_baker.odrl.injector import inject_odrl
+from croissant_baker.odrl.loader import load_odrl_config
+from croissant_baker.odrl.schema import ODRLConfig
+
+__all__ = ["load_odrl_config", "inject_odrl", "ODRLConfig"]
diff --git a/src/croissant_baker/odrl/injector.py b/src/croissant_baker/odrl/injector.py
new file mode 100644
index 0000000..f1ad615
--- /dev/null
+++ b/src/croissant_baker/odrl/injector.py
@@ -0,0 +1,201 @@
+"""Inject an ODRL usage policy into a Croissant JSON-LD metadata dict.
+
+Follows the shape Croissant 1.1 actually specifies
+(docs.mlcommons.org/croissant/docs/croissant-spec-1.1.html,
+"Fine-Grained Control with ODRL"): a `usageInfo` node typed
+`["CreativeWork", "odrl:Offer"]`, holding `odrl:permission` /
+`odrl:prohibition` / `odrl:duty` rules.
+
+NOTE: an earlier, unpublished draft of the ODRL-Croissant integration this
+was built alongside used a bespoke `odrl:hasPolicy` property by analogy
+with the RAI extension. That shape is NOT what the spec defines — always
+use `usageInfo`, which is what this module produces.
+"""
+
+from __future__ import annotations
+
+from croissant_baker.odrl.schema import ODRLConfig, ODRLConstraint, ODRLRule
+
+_ODRL_NS = "http://www.w3.org/ns/odrl/2/"
+
+# Prefixes we know how to auto-declare when referenced in action/operand
+# values, matching the vocabularies Croissant's own spec examples combine
+# ODRL with for health data. Any other prefix used in a config (e.g. a
+# site-specific vocabulary) must already be present in the dataset's own
+# @context — inject_odrl() warns rather than fails if it isn't, since a
+# missing prefix produces a dangling CURIE but shouldn't block generation.
+_KNOWN_PREFIXES = {
+    "duo": "http://purl.obolibrary.org/obo/DUO_",
+    "mondo": "http://purl.obolibrary.org/obo/MONDO_",
+    "cc": "http://creativecommons.org/ns#",
+}
+
+_RULE_TYPES = {
+    "permissions": "odrl:Permission",
+    "prohibitions": "odrl:Prohibition",
+    "duties": "odrl:Duty",
+}
+_RULE_PROPERTIES = {
+    "permissions": "odrl:permission",
+    "prohibitions": "odrl:prohibition",
+    "duties": "odrl:duty",
+}
+
+
+def inject_odrl(metadata: dict, config: ODRLConfig) -> dict:
+    """
+    Inject an ODRL usage policy into a Croissant metadata dict.
+
+    Mutates and returns the dict. If `usageInfo` already holds a value
+    (e.g. from --usage-info), the ODRL Offer is combined into a list
+    alongside it rather than overwriting it.
+    """
+    if not (config.permissions or config.prohibitions or config.duties):
+        return metadata
+
+    _ensure_odrl_context(metadata, config)
+
+    offer: dict = {"@type": ["CreativeWork", "odrl:Offer"]}
+    if config.name:
+        offer["name"] = config.name
+
+    for field_name, prop in _RULE_PROPERTIES.items():
+        rules = getattr(config, field_name)
+        if not rules:
+            continue
+        built = [_build_rule(r, _RULE_TYPES[field_name]) for r in rules]
+        offer[prop] = built[0] if len(built) == 1 else built
+
+    existing = metadata.get("usageInfo")
+    if existing is None:
+        metadata["usageInfo"] = offer
+    elif isinstance(existing, list):
+        metadata["usageInfo"] = [*existing, offer]
+    else:
+        metadata["usageInfo"] = [existing, offer]
+
+    return metadata
+
+
+def _build_rule(rule: ODRLRule, rule_type: str) -> dict:
+    node: dict = {
+        "@type": rule_type,
+        "odrl:action": _as_ref(rule.action),
+    }
+    if rule.target:
+        node["odrl:target"] = {"@id": rule.target}
+    if rule.constraints:
+        built = [_build_constraint(c) for c in rule.constraints]
+        node["odrl:constraint"] = built[0] if len(built) == 1 else built
+    return node
+
+
+def _build_constraint(c: ODRLConstraint) -> dict:
+    return {
+        "@type": "odrl:Constraint",
+        "odrl:leftOperand": _as_ref(c.left_operand),
+        "odrl:operator": _as_ref(c.operator),
+        "odrl:rightOperand": _as_value(c.right_operand),
+    }
+
+
+def _is_curie_or_iri(value: str) -> bool:
+    return "://" in value or (":" in value and " " not in value)
+
+
+def _as_ref(value: str) -> dict:
+    """odrl:action/leftOperand/operator values are always references.
+
+    A bare word like "use" becomes an odrl: CURIE; anything already
+    containing a colon (a CURIE like "duo:0000006" or a full IRI) is
+    passed through as-is.
+    """
+    ref = value if _is_curie_or_iri(value) else f"odrl:{value}"
+    return {"@id": ref}
+
+
+def _as_value(value: str) -> object:
+    """odrl:rightOperand may be a plain literal ("research") or a
+    reference to a term in another vocabulary ("duo:0000018")."""
+    if _is_curie_or_iri(value):
+        return {"@id": value}
+    return value
+
+
+def _collect_prefixes(config: ODRLConfig) -> set[str]:
+    prefixes: set[str] = set()
+    for field_name in ("permissions", "prohibitions", "duties"):
+        for rule in getattr(config, field_name):
+            for candidate in (rule.action, *(c.left_operand for c in rule.constraints), *(c.right_operand for c in rule.constraints)):
+                if _is_curie_or_iri(candidate) and "://" not in candidate:
+                    prefixes.add(candidate.split(":", 1)[0])
+    return prefixes
+
+
+def _ensure_odrl_context(metadata: dict, config: ODRLConfig) -> None:
+    """Make sure `odrl:` (and any other prefixes the config references) are
+    declared in @context, regardless of which of the four shapes @context
+    legitimately takes in JSON-LD:
+      - missing entirely
+      - a single object   {"schema": "...", ...}
+      - a remote reference "https://.../context.jsonld"   (a URL string)
+      - an array mixing either of the above, e.g. ["https://...", {...}]
+
+    Confirmed against a real 500-dataset Hugging Face run that the string
+    form is common enough to matter — 28/211 successfully "generated"
+    files had usageInfo referencing odrl: with no odrl: prefix declared
+    anywhere, because the old version of this function silently did
+    nothing for non-dict contexts. That produced files that looked
+    successful but were actually invalid JSON-LD.
+    """
+    ctx = metadata.get("@context")
+
+    needed: dict[str, str] = {"odrl": _ODRL_NS}
+    for prefix in _collect_prefixes(config):
+        if prefix == "odrl":
+            continue
+        if prefix in _KNOWN_PREFIXES:
+            needed[prefix] = _KNOWN_PREFIXES[prefix]
+        else:
+            print(
+                f"Warning: ODRL config references prefix '{prefix}:' which is not "
+                f"declared in @context and is not a built-in known prefix "
+                f"({', '.join(_KNOWN_PREFIXES)}). Add it to your dataset's context "
+                f"manually or the generated CURIE will not resolve."
+            )
+
+    if ctx is None:
+        metadata["@context"] = dict(needed)
+        return
+
+    if isinstance(ctx, dict):
+        for k, v in needed.items():
+            ctx.setdefault(k, v)
+        return
+
+    if isinstance(ctx, list):
+        already = set()
+        for entry in ctx:
+            if isinstance(entry, dict):
+                already.update(entry.keys())
+        missing = {k: v for k, v in needed.items() if k not in already}
+        if missing:
+            ctx.append(missing)
+        return
+
+    if isinstance(ctx, str):
+        # Remote context reference. JSON-LD lets @context be an array
+        # mixing a URL and inline term definitions — wrap rather than
+        # overwrite, so the document's original (possibly load-bearing)
+        # remote context is preserved alongside our additions.
+        metadata["@context"] = [ctx, dict(needed)]
+        return
+
+    # Unrecognized shape (shouldn't happen for valid JSON-LD) — warn
+    # instead of silently doing nothing, which is what caused this bug
+    # to go unnoticed in the first place.
+    print(
+        f"Warning: @context has an unexpected type ({type(ctx).__name__}); "
+        f"could not ensure odrl: prefix is declared. Generated usageInfo may "
+        f"not resolve as valid JSON-LD."
+    )
