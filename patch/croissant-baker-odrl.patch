@@ -0,0 +1,234 @@
+"""Tests for the ODRL usage-policy extension."""
+
+import json
+from pathlib import Path
+
+import pytest
+from typer.testing import CliRunner
+
+from croissant_baker.__main__ import app
+from croissant_baker.odrl import inject_odrl, load_odrl_config
+from croissant_baker.odrl.schema import ODRLConfig, ODRLConstraint, ODRLRule
+
+runner = CliRunner()
+
+_DATA = Path(__file__).parent / "data"
+ODRL_YAML = Path(__file__).parent.parent / "odrl-example.yaml"
+MIMICIV_PATH = (
+    _DATA / "input" / "mimiciv_demo" / "physionet.org" / "files" / "mimic-iv-demo" / "2.2"
+)
+
+
+@pytest.fixture
+def mimiciv_demo_path() -> Path:
+    if not MIMICIV_PATH.exists():
+        pytest.skip(f"MIMIC-IV demo dataset not found at {MIMICIV_PATH}")
+    return MIMICIV_PATH
+
+
+# ── Unit tests: loader ───────────────────────────────────────────────────────
+
+
+def test_load_odrl_config_parses_example_yaml() -> None:
+    config = load_odrl_config(ODRL_YAML)
+    assert config.name
+    assert len(config.permissions) == 2
+    assert len(config.prohibitions) == 2
+    assert len(config.duties) == 1
+    assert config.permissions[0].action == "use"
+    assert config.permissions[0].constraints[0].left_operand == "purpose"
+    assert config.permissions[0].constraints[0].right_operand == "research"
+
+
+# ── Unit tests: injector ─────────────────────────────────────────────────────
+
+
+def _base_metadata() -> dict:
+    return {"@context": {"@vocab": "https://schema.org/"}, "@type": "sc:Dataset", "name": "Test"}
+
+
+def test_inject_odrl_produces_spec_shape() -> None:
+    config = ODRLConfig(
+        name="Test policy",
+        permissions=[
+            ODRLRule(
+                action="use",
+                target="image-files",
+                constraints=[ODRLConstraint(left_operand="purpose", operator="eq", right_operand="research")],
+            )
+        ],
+        prohibitions=[ODRLRule(action="commercialize")],
+    )
+    metadata = inject_odrl(_base_metadata(), config)
+
+    assert metadata["@context"]["odrl"] == "http://www.w3.org/ns/odrl/2/"
+
+    usage_info = metadata["usageInfo"]
+    assert usage_info["@type"] == ["CreativeWork", "odrl:Offer"]
+
+    permission = usage_info["odrl:permission"]
+    assert permission["@type"] == "odrl:Permission"
+    assert permission["odrl:action"] == {"@id": "odrl:use"}
+    assert permission["odrl:target"] == {"@id": "image-files"}
+    constraint = permission["odrl:constraint"]
+    assert constraint["odrl:leftOperand"] == {"@id": "odrl:purpose"}
+    assert constraint["odrl:operator"] == {"@id": "odrl:eq"}
+    assert constraint["odrl:rightOperand"] == "research"  # plain literal, not a ref
+
+    prohibition = usage_info["odrl:prohibition"]
+    assert prohibition["@type"] == "odrl:Prohibition"
+    assert prohibition["odrl:action"] == {"@id": "odrl:commercialize"}
+
+
+def test_inject_odrl_resolves_curie_operands_as_refs() -> None:
+    config = ODRLConfig(
+        permissions=[
+            ODRLRule(
+                action="duo:0000006",
+                constraints=[ODRLConstraint(left_operand="duo:0000018", operator="eq", right_operand="duo:0000018")],
+            )
+        ]
+    )
+    metadata = inject_odrl(_base_metadata(), config)
+
+    # Known prefix (duo) gets auto-declared in @context.
+    assert metadata["@context"]["duo"] == "http://purl.obolibrary.org/obo/DUO_"
+
+    permission = metadata["usageInfo"]["odrl:permission"]
+    assert permission["odrl:action"] == {"@id": "duo:0000006"}
+    constraint = permission["odrl:constraint"]
+    assert constraint["odrl:leftOperand"] == {"@id": "duo:0000018"}
+    # A CURIE right_operand is a reference, not a plain string.
+    assert constraint["odrl:rightOperand"] == {"@id": "duo:0000018"}
+
+
+def test_inject_odrl_warns_on_unknown_prefix(capsys) -> None:
+    config = ODRLConfig(permissions=[ODRLRule(action="acme:doSomething")])
+    inject_odrl(_base_metadata(), config)
+    captured = capsys.readouterr()
+    assert "acme" in captured.out
+    assert "Warning" in captured.out
