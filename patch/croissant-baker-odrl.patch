+# ── Regression: @context can legitimately be a string or array, not just
+# a dict — a real 500-dataset Hugging Face run found 28/211 "successful"
+# files were actually invalid JSON-LD because of this. ──────────────────
+
+
+def test_inject_odrl_handles_string_context() -> None:
+    metadata = {"@context": "https://example.org/remote-context.jsonld", "@type": "sc:Dataset", "name": "Test"}
+    config = ODRLConfig(permissions=[ODRLRule(action="use")])
+    result = inject_odrl(metadata, config)
+    assert result["@context"] == ["https://example.org/remote-context.jsonld", {"odrl": "http://www.w3.org/ns/odrl/2/"}]
+    assert result["usageInfo"]["odrl:permission"]["odrl:action"] == {"@id": "odrl:use"}
+
+
+def test_inject_odrl_handles_array_context() -> None:
+    metadata = {
+        "@context": ["https://example.org/remote-context.jsonld", {"schema": "https://schema.org/"}],
+        "@type": "sc:Dataset",
+        "name": "Test",
+    }
+    config = ODRLConfig(permissions=[ODRLRule(action="use")])
+    result = inject_odrl(metadata, config)
+    # odrl: gets appended as a new entry rather than overwriting the existing dict entry
+    assert {"odrl": "http://www.w3.org/ns/odrl/2/"} in result["@context"]
+    assert {"schema": "https://schema.org/"} in result["@context"]
+
+
+def test_inject_odrl_handles_missing_context() -> None:
+    metadata = {"@type": "sc:Dataset", "name": "Test"}
+    config = ODRLConfig(permissions=[ODRLRule(action="use")])
+    result = inject_odrl(metadata, config)
+    assert result["@context"] == {"odrl": "http://www.w3.org/ns/odrl/2/"}
+
