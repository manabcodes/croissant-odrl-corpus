@@ -0,0 +1,55 @@
+"""Load an ODRL policy YAML file into an ODRLConfig dataclass."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Optional
+
+import yaml
+
+from croissant_baker.odrl.schema import ODRLConfig, ODRLConstraint, ODRLRule
+
+
+def _str(value) -> Optional[str]:
+    if value is None:
+        return None
+    s = str(value).strip()
+    return s if s else None
+
+
+def _load_rules(raw_list: list) -> list[ODRLRule]:
+    rules = []
+    for r in raw_list or []:
+        action = _str(r.get("action"))
+        if not action:
+            continue
+        constraints = [
+            ODRLConstraint(
+                left_operand=str(c.get("left_operand", "")),
+                operator=str(c.get("operator", "eq")),
+                right_operand=str(c.get("right_operand", "")),
+            )
+            for c in (r.get("constraints") or [])
+            if c.get("left_operand") and c.get("right_operand") is not None
+        ]
+        rules.append(
+            ODRLRule(
+                action=action,
+                target=_str(r.get("target")),
+                constraints=constraints,
+            )
+        )
+    return rules
+
+
+def load_odrl_config(path: Path) -> ODRLConfig:
+    """Load an ODRL YAML config file and return an ODRLConfig instance."""
+    with open(path, encoding="utf-8") as fh:
+        raw = yaml.safe_load(fh) or {}
+
+    return ODRLConfig(
+        name=_str(raw.get("name")),
+        permissions=_load_rules(raw.get("permissions") or []),
+        prohibitions=_load_rules(raw.get("prohibitions") or []),
+        duties=_load_rules(raw.get("duties") or []),
+    )
diff --git a/src/croissant_baker/odrl/schema.py b/src/croissant_baker/odrl/schema.py
new file mode 100644
index 0000000..7d278c9
--- /dev/null
+++ b/src/croissant_baker/odrl/schema.py
@@ -0,0 +1,36 @@
+"""ODRL policy schema — dataclass models for Croissant 1.1's usageInfo/odrl:Offer.
+
+Mirrors the structure Croissant's spec recommends
+(docs.mlcommons.org/croissant/docs/croissant-spec-1.1.html,
+"Fine-Grained Control with ODRL"): a usageInfo node typed
+["CreativeWork", "odrl:Offer"], holding odrl:permission / odrl:prohibition
+/ odrl:duty rules, each with an action, an optional target, and optional
+constraints.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Optional
+
+
+@dataclass
+class ODRLConstraint:
+    left_operand: str  # e.g. "purpose", "dateTime", or a full CURIE like "mondo:0005070"
+    operator: str  # e.g. "eq", "lt", "gt"
+    right_operand: str  # a plain value ("research") or a CURIE/IRI ("duo:0000018")
+
+
+@dataclass
+class ODRLRule:
+    action: str  # e.g. "use", "distribute", "commercialize", or a DUO action CURIE
+    target: Optional[str] = None  # @id of a FileObject/FileSet/RecordSet; omit for dataset-wide
+    constraints: list[ODRLConstraint] = field(default_factory=list)
+
+
+@dataclass
+class ODRLConfig:
+    name: Optional[str] = None
+    permissions: list[ODRLRule] = field(default_factory=list)
+    prohibitions: list[ODRLRule] = field(default_factory=list)
+    duties: list[ODRLRule] = field(default_factory=list)
