+def test_odrl_apply_to_existing_file(mimiciv_demo_path: Path, tmp_path: Path) -> None:
+    # First generate a plain file with no policy.
+    plain = tmp_path / "plain.jsonld"
+    gen = runner.invoke(
+        app,
+        [
+            "-i",
+            str(mimiciv_demo_path),
+            "-o",
+            str(plain),
+            "--creator",
+            "Alistair Johnson,aewj@mit.edu",
+            "--name",
+            "MIMIC-IV Demo Dataset",
+            "--description",
+            "Demo subset of MIMIC-IV",
+            "--url",
+            "https://physionet.org/content/mimic-iv-demo/2.2/",
+            "--license",
+            "https://opendatacommons.org/licenses/odbl/1-0/",
+        ],
+    )
+    assert gen.exit_code == 0, gen.output
+    assert "usageInfo" not in json.loads(plain.read_text())
+
+    # Then apply the ODRL policy after the fact, as you'd do to a file
+    # downloaded from a repository that doesn't have one yet.
+    enriched = tmp_path / "enriched.jsonld"
+    applied = runner.invoke(
+        app,
+        ["odrl-apply", str(plain), "--odrl-config", str(ODRL_YAML), "-o", str(enriched)],
+    )
+    assert applied.exit_code == 0, applied.output
+
+    metadata = json.loads(enriched.read_text())
+    assert "odrl:permission" in metadata["usageInfo"]
