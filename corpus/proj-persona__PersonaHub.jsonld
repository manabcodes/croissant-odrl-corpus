    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-instruction",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "instruction/*/*.parquet"
    },
    {
