  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/IQSeC-Lab/LAMDA/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Baseline",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Baseline/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-var_thresh_0.01",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "var_thresh_0.01/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Baseline_splits/split_name"
      },
      "@id": "Baseline_splits",
      "name": "Baseline_splits",
      "description": "Splits for the Baseline config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Baseline_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Baseline_splits/split_name": "train"
        },
        {
          "Baseline_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Baseline",
      "description": "IQSeC-Lab/LAMDA - 'Baseline' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Baseline/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Baseline"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Baseline/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Baseline_splits/split_name"
            }
          }
        },
        {
