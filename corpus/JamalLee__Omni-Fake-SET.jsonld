  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/JamalLee/Omni-Fake-SET/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-image",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "image/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-audio",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "audio/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-avth",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "avth/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-video",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "video/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "image_splits/split_name"
      },
      "@id": "image_splits",
      "name": "image_splits",
      "description": "Splits for the image config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "image_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "image_splits/split_name": "train"
        },
        {
          "image_splits/split_name": "validation"
        },
        {
          "image_splits/split_name": "masks"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "image",
      "description": "JamalLee/Omni-Fake-SET - 'image' subset\n\nAdditional information:\n- 3 splits: train, validation, masks",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "image/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-image"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "image/(?:partial-)?(train|validation|masks)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "image_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "image/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-image"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "image/mask",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-image"
            },
            "extract": {
              "column": "mask"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "image/label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-image"
            },
            "extract": {
              "column": "label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "image/generator",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-image"
            },
            "extract": {
              "column": "generator"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "image/filename",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-image"
            },
            "extract": {
              "column": "filename"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "image/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-image"
            },
            "extract": {
              "column": "split"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "audio_splits/split_name"
      },
      "@id": "audio_splits",
      "name": "audio_splits",
      "description": "Splits for the audio config.",
