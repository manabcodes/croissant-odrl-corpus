          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-audio"
            },
            "extract": {
              "column": "generator"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "audio/filename",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-audio"
            },
            "extract": {
              "column": "filename"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "audio/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-audio"
            },
            "extract": {
              "column": "split"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "audio/spoof_intervals",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-audio"
            },
            "extract": {
              "column": "spoof_intervals"
            }
          },
          "isArray": true,
          "arrayShape": "-1,-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "avth_splits/split_name"
      },
      "@id": "avth_splits",
      "name": "avth_splits",
      "description": "Splits for the avth config.",
