            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/topic_query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "topic_query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/preference",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "preference"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/topic_preference",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "topic_preference"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/conversation_scenario",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
