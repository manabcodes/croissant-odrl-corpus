              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "updated"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/prev_pref",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "prev_pref"
            }
          }
        },
        {
          "@type": "cr:Field",
