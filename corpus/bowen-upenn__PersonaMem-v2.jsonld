  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/bowen-upenn/PersonaMem-v2/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-benchmark",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "benchmark/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "benchmark_splits/split_name"
      },
      "@id": "benchmark_splits",
      "name": "benchmark_splits",
      "description": "Splits for the benchmark config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "benchmark_splits/split_name": "benchmark_multimodal"
        },
        {
          "benchmark_splits/split_name": "train_multimodal"
        },
        {
          "benchmark_splits/split_name": "val_multimodal"
        },
        {
          "benchmark_splits/split_name": "benchmark_text"
        },
        {
          "benchmark_splits/split_name": "train_text"
        },
        {
          "benchmark_splits/split_name": "val_text"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "benchmark",
      "description": "bowen-upenn/PersonaMem-v2 - 'benchmark' subset\n\nAdditional information:\n- 6 splits: benchmark_multimodal, train_multimodal, val_multimodal, benchmark_text, train_text, val_text",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "benchmark/(?:partial-)?(benchmark_multimodal|train_multimodal|val_multimodal|benchmark_text|train_text|val_text)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "benchmark_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/persona_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "persona_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/chat_history_32k_link",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "chat_history_32k_link"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/chat_history_128k_link",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "chat_history_128k_link"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/raw_persona_file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "raw_persona_file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/short_persona",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "short_persona"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/expanded_persona",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "expanded_persona"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/user_query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "user_query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/correct_answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "correct_answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/incorrect_answers",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
