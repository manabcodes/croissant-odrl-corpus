  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/parler-tts/libritts_r_filtered/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-clean",
      "name": "parquet-files-for-config-clean",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "clean/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-other",
      "name": "parquet-files-for-config-other",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "other/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "clean_splits/split_name"
      },
      "@id": "clean_splits",
      "name": "clean_splits",
      "description": "Splits for the clean config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "clean_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "clean_splits/split_name": "dev.clean"
        },
        {
          "clean_splits/split_name": "test.clean"
        },
        {
          "clean_splits/split_name": "train.clean.100"
        },
        {
          "clean_splits/split_name": "train.clean.360"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "clean",
      "name": "clean",
      "description": "parler-tts/libritts_r_filtered - 'clean' subset\n\nAdditional information:\n- 4 splits: dev.clean, test.clean, train.clean.100, train.clean.360\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "clean/split",
          "name": "clean/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "clean/(?:partial-)?(dev\\.clean|test\\.clean|train\\.clean\\.100|train\\.clean\\.360)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "clean_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/text_normalized",
          "name": "clean/text_normalized",
          "description": "Column 'text_normalized' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "text_normalized"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/text_original",
          "name": "clean/text_original",
          "description": "Column 'text_original' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "text_original"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/speaker_id",
          "name": "clean/speaker_id",
          "description": "Column 'speaker_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "speaker_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/path",
          "name": "clean/path",
          "description": "Column 'path' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/chapter_id",
          "name": "clean/chapter_id",
          "description": "Column 'chapter_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "chapter_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/id",
          "name": "clean/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "id"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "other_splits/split_name"
      },
      "@id": "other_splits",
      "name": "other_splits",
      "description": "Splits for the other config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "other_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "other_splits/split_name": "dev.other"
        },
        {
          "other_splits/split_name": "test.other"
        },
        {
          "other_splits/split_name": "train.other.500"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "other",
      "name": "other",
      "description": "parler-tts/libritts_r_filtered - 'other' subset\n\nAdditional information:\n- 3 splits: dev.other, test.other, train.other.500\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "other/split",
          "name": "other/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "other/(?:partial-)?(dev\\.other|test\\.other|train\\.other\\.500)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "other_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/text_normalized",
          "name": "other/text_normalized",
          "description": "Column 'text_normalized' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "text_normalized"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/text_original",
          "name": "other/text_original",
          "description": "Column 'text_original' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "text_original"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/speaker_id",
          "name": "other/speaker_id",
          "description": "Column 'speaker_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "speaker_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/path",
          "name": "other/path",
          "description": "Column 'path' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/chapter_id",
          "name": "other/chapter_id",
          "description": "Column 'chapter_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "chapter_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/id",
          "name": "other/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "id"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "libritts_r_filtered",
  "description": "\n\t\n\t\t\n\t\tDataset Card for Filtered LibriTTS-R\n\t\n\nThis is a filtered version of LibriTTS-R. It has been filtered based on two sources:\n\nLibriTTS-R paper [1], which lists samples for which speech restoration have failed\nLibriTTS-P [2] list of excluded speakers for which multiple speakers have been detected.\n\nLibriTTS-R [1] is a sound quality improved version of the LibriTTS corpus which is a multi-speaker English corpus of approximately \n585 hours of read English speech at 24kHz sampling rate\u2026 See the full description on the dataset page: https://huggingface.co/datasets/parler-tts/libritts_r_filtered.",
  "alternateName": [
    "parler-tts/libritts_r_filtered",
    "Filtered LibriTTS-R"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Parler TTS",
    "url": "https://huggingface.co/parler-tts"
  },
