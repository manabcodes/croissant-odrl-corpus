                },
                "transform": {
                  "jsonPath": "['WARC-IP-Address']"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/WARC-Identified-Payload-Type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "['WARC-Identified-Payload-Type']"
                }
