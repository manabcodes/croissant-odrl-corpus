                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/WARC-Concurrent-To",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "['WARC-Concurrent-To']"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/WARC-Date",
              "dataType": "sc:DateTime",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
