                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "['WARC-Record-ID']"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/WARC-Target-URI",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "['WARC-Target-URI']"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/WARC-Type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
