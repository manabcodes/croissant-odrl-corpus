  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "amh_splits/split_name"
      },
      "@id": "amh_splits",
      "name": "amh_splits",
      "description": "Splits for the amh config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "amh_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "amh_splits/split_name": "train"
        },
        {
          "amh_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "amh",
      "description": "masakhane/afrimgsm - 'amh' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "amh/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "amh/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "amh_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/answer_number",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "answer_number"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/equation_solution",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "equation_solution"
            }
          }
        }
      ]
    },
