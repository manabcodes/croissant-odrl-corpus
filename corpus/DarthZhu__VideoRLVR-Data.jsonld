  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "VideoRLVR-Data",
  "description": "\n\t\n\t\t\n\t\tVideoRLVR-Data \u00b7 Verifiable video reasoning data for RLVR\n\t\n\nTraining and evaluation data accompanyingVideo Models Can Reason with Verifiable Rewards.\nVideoRLVR-Data is built for a stricter question:\n\nCan a video model generate a full visual trajectory that is not only realistic, but also rule-consistent, executable, and automatically verifiable?\n\nThe dataset contains procedurally generated visual reasoning tasks from three domains: Maze, FlowFree, and Sokoban. Each sample pairs an\u2026 See the full description on the dataset page: https://huggingface.co/datasets/DarthZhu/VideoRLVR-Data.",
  "alternateName": [
    "DarthZhu/VideoRLVR-Data",
    "VideoRLVR-Data: Verifiable Video Reasoning Data"
  ],
  "creator": {
    "@type": "Person",
    "name": "Tinghui Zhu",
    "url": "https://huggingface.co/DarthZhu"
  },
