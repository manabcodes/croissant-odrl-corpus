{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/MMInstruction/ArxivCap/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "MMInstruction/ArxivCap - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/src",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "src"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/abstract",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "abstract"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/caption_images",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/caption_images/caption",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "caption_images"
                },
                "transform": {
                  "jsonPath": "caption"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/caption_images/cil_pairs",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/caption_images/cil_pairs/sub_caption",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "caption_images"
                    },
                    "transform": [
                      {
                        "jsonPath": "cil_pairs"
                      },
                      {
                        "jsonPath": "sub_caption"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/caption_images/cil_pairs/image_file",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "caption_images"
                    },
                    "transform": [
                      {
                        "jsonPath": "cil_pairs"
                      },
                      {
                        "jsonPath": "image_file"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/caption_images/cil_pairs/image",
                  "dataType": "sc:ImageObject",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "caption_images"
                    },
                    "transform": [
                      [
                        {
                          "jsonPath": "cil_pairs"
                        },
                        {
                          "jsonPath": "image"
                        }
                      ],
                      {
                        "jsonPath": "bytes"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/caption_images/cil_pairs/image_ocr",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "caption_images"
                    },
                    "transform": [
                      {
                        "jsonPath": "cil_pairs"
                      },
                      {
                        "jsonPath": "image_ocr"
                      }
                    ]
                  },
                  "isArray": true,
                  "arrayShape": "-1"
                }
              ],
              "isArray": true,
              "arrayShape": "-1"
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/meta",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/meta/meta_from_kaggle",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/meta/meta_from_kaggle/journey",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "meta"
                    },
                    "transform": [
                      {
                        "jsonPath": "meta_from_kaggle"
                      },
                      {
                        "jsonPath": "journey"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/meta/meta_from_kaggle/license",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "meta"
                    },
                    "transform": [
                      {
                        "jsonPath": "meta_from_kaggle"
                      },
                      {
                        "jsonPath": "license"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/meta/meta_from_kaggle/categories",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "meta"
                    },
                    "transform": [
                      {
                        "jsonPath": "meta_from_kaggle"
                      },
                      {
                        "jsonPath": "categories"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/meta/meta_from_s2",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/meta/meta_from_s2/citationCount",
                  "dataType": "cr:Int32",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "meta"
                    },
                    "transform": [
                      {
                        "jsonPath": "meta_from_s2"
                      },
                      {
                        "jsonPath": "citationCount"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/meta/meta_from_s2/influentialCitationCount",
                  "dataType": "cr:Int32",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "meta"
                    },
                    "transform": [
                      {
                        "jsonPath": "meta_from_s2"
                      },
                      {
                        "jsonPath": "influentialCitationCount"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/meta/meta_from_s2/publicationTypes",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "meta"
                    },
                    "transform": [
                      {
                        "jsonPath": "meta_from_s2"
                      },
                      {
                        "jsonPath": "publicationTypes"
                      }
                    ]
                  },
                  "isArray": true,
                  "arrayShape": "-1"
                }
              ]
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/arxiv_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "arxiv_id"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "ArxivCap",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tDataset Card for ArxivCap\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tData Instances\n\t\n\n\nExample-1 of single (image, caption) pairs\n\n\"......\" stands for omitted parts.\n\n{\n    'src': 'arXiv_src_2112_060/2112.08947', \n    'meta': \n    {\n        'meta_from_kaggle': \n        {\n            'journey': '', \n            'license': 'http://arxiv.org/licenses/nonexclusive-distrib/1.0/', \n            'categories': 'cs.ET'\n        }, \n        'meta_from_s2': \n        {\n            'citationCount': 8\u2026 See the full description on the dataset page: https://huggingface.co/datasets/MMInstruction/ArxivCap.",
  "alternateName": [
    "MMInstruction/ArxivCap",
    "ArxivCap"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Multi-modal Multilingual Instruction",
    "url": "https://huggingface.co/MMInstruction"
  },
  "keywords": [
    "image-to-text",
    "English",
    "cc-by-4.0",
    "100K - 1M",
    "parquet",
    "Image",
    "Text",
    "Datasets",
    "Dask",
