          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "harvard-lil/cold-cases - 'default' subset (first 5GB)\n\nAdditional information:\n- 1 skipped column: date_filed",
