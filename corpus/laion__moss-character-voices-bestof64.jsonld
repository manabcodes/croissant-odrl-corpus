            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "topic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/text",
          "dataType": "sc:Text",
          "source": {
