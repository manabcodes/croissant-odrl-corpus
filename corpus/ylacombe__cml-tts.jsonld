      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "dutch_splits/split_name"
      },
      "@id": "dutch_splits",
      "name": "dutch_splits",
      "description": "Splits for the dutch config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "dutch_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "dutch_splits/split_name": "train"
        },
        {
          "dutch_splits/split_name": "dev"
        },
        {
          "dutch_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "dutch",
      "name": "dutch",
      "description": "ylacombe/cml-tts - 'dutch' subset\n\nAdditional information:\n- 3 splits: train, dev, test\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "dutch/split",
          "name": "dutch/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dutch"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "dutch/(?:partial-)?(train|dev|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "dutch_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dutch/wav_filesize",
          "name": "dutch/wav_filesize",
          "description": "Column 'wav_filesize' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dutch"
            },
            "extract": {
              "column": "wav_filesize"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dutch/text",
          "name": "dutch/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dutch"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dutch/transcript_wav2vec",
          "name": "dutch/transcript_wav2vec",
          "description": "Column 'transcript_wav2vec' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dutch"
            },
            "extract": {
              "column": "transcript_wav2vec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dutch/levenshtein",
          "name": "dutch/levenshtein",
          "description": "Column 'levenshtein' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dutch"
            },
            "extract": {
              "column": "levenshtein"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dutch/duration",
          "name": "dutch/duration",
          "description": "Column 'duration' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dutch"
            },
            "extract": {
              "column": "duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dutch/num_words",
          "name": "dutch/num_words",
          "description": "Column 'num_words' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dutch"
            },
            "extract": {
              "column": "num_words"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dutch/speaker_id",
          "name": "dutch/speaker_id",
