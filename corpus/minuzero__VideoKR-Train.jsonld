        },
        {
          "@type": "cr:Field",
          "@id": "SFT-201K/options",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT-201K"
            },
            "extract": {
              "column": "options"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
