              "@id": "SFT-201K_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT-201K/file_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT-201K"
            },
            "extract": {
              "column": "file_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT-201K/domain",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT-201K"
            },
            "extract": {
              "column": "domain"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT-201K/subject",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT-201K"
            },
            "extract": {
              "column": "subject"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT-201K/course_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT-201K"
            },
            "extract": {
              "column": "course_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT-201K/skill_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT-201K"
            },
            "extract": {
              "column": "skill_type"
            }
          }
        },
        {
          "@type": "cr:Field",
