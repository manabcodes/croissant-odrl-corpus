  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/minuzero/VideoKR-Train/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-RL-114K",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "RL-114K/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-SFT-201K",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "SFT-201K/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "RL-114K_splits/split_name"
      },
      "@id": "RL-114K_splits",
      "name": "RL-114K_splits",
      "description": "Splits for the RL-114K config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "RL-114K_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "RL-114K_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "RL-114K",
      "description": "minuzero/VideoKR-Train - 'RL-114K' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "RL-114K/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "RL\\-114K/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "RL-114K_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/file_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "file_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/domain",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "domain"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/subject",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "subject"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/course_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "course_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/skill_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "skill_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/problem_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "problem_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/options",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "options"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "RL-114K/solution",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-RL-114K"
            },
            "extract": {
              "column": "solution"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "SFT-201K_splits/split_name"
      },
      "@id": "SFT-201K_splits",
      "name": "SFT-201K_splits",
      "description": "Splits for the SFT-201K config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "SFT-201K_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "SFT-201K_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "SFT-201K",
      "description": "minuzero/VideoKR-Train - 'SFT-201K' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "SFT-201K/split",
