    {
      "@type": "cr:RecordSet",
      "@id": "full",
      "description": "locuslab/TOFU - 'full' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "full/(?:partial-)?(train)/.+parquet$"
