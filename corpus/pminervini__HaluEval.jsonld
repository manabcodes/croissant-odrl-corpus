        {
          "@type": "cr:Field",
          "@id": "dialogue/split",
          "name": "dialogue/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dialogue"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "dialogue/(?:partial-)?(data)/.+parquet$"
