    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-dialogue",
      "name": "parquet-files-for-config-dialogue",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "dialogue/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-dialogue_samples",
