  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "steam-games-dataset",
  "identifier": "10.57967/hf/0511",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tSteam Games Dataset\n\t\n\nInformation of 138,304 games published on Steam.\nThis dataset has been created with this code (MIT) and use the API provided by Steam, the largest gaming platform on PC. Data is also collected from Steam Spy. Only published games, no DLCs, episodes, music, videos, etc.\nMaintained by Fronkon Games.\n",
  "alternateName": [
    "FronkonGames/steam-games-dataset"
  ],
  "creator": {
    "@type": "Person",
    "name": "Martin Bustos",
    "url": "https://huggingface.co/FronkonGames"
  },
