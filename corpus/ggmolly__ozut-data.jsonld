  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ggmolly/ozut-data/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-beatmaps",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "beatmaps/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-beatmapsets",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "beatmapsets/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "beatmaps_splits/split_name"
      },
      "@id": "beatmaps_splits",
      "name": "beatmaps_splits",
      "description": "Splits for the beatmaps config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "beatmaps_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "beatmaps_splits/split_name": "full"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "beatmaps",
      "description": "ggmolly/ozut-data - 'beatmaps' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "beatmaps/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-beatmaps"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "beatmaps/(?:partial-)?(full)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "beatmaps_splits/split_name"
            }
          }
        },
