    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ADSKAILab/Zero-To-CAD-1m/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "validation"
        },
        {
          "default_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "ADSKAILab/Zero-To-CAD-1m - 'default' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/uuid",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "uuid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/cadquery_file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "cadquery_file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_faces",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_faces"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/face_latency_ms",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "face_latency_ms"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/cadquery_ops_json",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "cadquery_ops_json"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/cadquery_ops_count",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "cadquery_ops_count"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ops_latency_ms",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ops_latency_ms"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_renders",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_renders"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_0",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_0"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_1",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_2",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_2"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_3",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_3"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_4",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_4"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_5",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_5"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_6",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_6"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_7",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_7"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/stl_file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "stl_file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/step_file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "step_file"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Zero-To-CAD-1m",
  "description": "\n  \n\n\n\n\t\n\t\t\n\t\tZero-to-CAD 1M\n\t\n\nOne million executable, interpretable CAD construction sequences synthesized entirely without real-world data.\n\n  \n\n\n\nZero-to-CAD: Agentic Synthesis of Interpretable CAD Programs at Million-Scale Without Real Data\nMohammadmehdi Ataei, Farzaneh Askari, Kamal Rahimi Malekshan, Pradeep Kumar Jayaraman\nAutodesk Research\n\n\n\t\n\t\n\t\n\t\tRelated Resources\n\t\n\n\n\t\n\t\t\nResource\nLink\n\n\n\t\t\n\ud83d\udcc4 Paper\nZero-to-CAD: Agentic Synthesis of Interpretable CAD Programs at Million-Scale\u2026 See the full description on the dataset page: https://huggingface.co/datasets/ADSKAILab/Zero-To-CAD-1m.",
  "alternateName": [
    "ADSKAILab/Zero-To-CAD-1m",
    "Zero-to-CAD 1M"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Autodesk AI Lab",
    "url": "https://huggingface.co/ADSKAILab"
  },
