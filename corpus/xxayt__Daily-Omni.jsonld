        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:prohibition": {
      "@type": "odrl:Prohibition",
      "odrl:action": {
        "@id": "odrl:commercialize"
      }
    },
    "odrl:duty": [
      {
        "@type": "odrl:Duty",
