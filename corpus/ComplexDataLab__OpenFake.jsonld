{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ComplexDataLab/OpenFake/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-core",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "core/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-reddit",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "reddit/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "core_splits/split_name"
      },
      "@id": "core_splits",
      "name": "core_splits",
      "description": "Splits for the core config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "core_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "core_splits/split_name": "train"
        },
        {
          "core_splits/split_name": "validation"
        },
        {
          "core_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "core",
      "description": "ComplexDataLab/OpenFake - 'core' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "core/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "core/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "core_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/model",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "model"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/release_date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "release_date"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "reddit_splits/split_name"
      },
      "@id": "reddit_splits",
      "name": "reddit_splits",
      "description": "Splits for the reddit config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "reddit_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "reddit_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "reddit",
      "description": "ComplexDataLab/OpenFake - 'reddit' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "reddit/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-reddit"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "reddit/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "reddit_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "reddit/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-reddit"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "reddit/prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-reddit"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "reddit/label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-reddit"
            },
            "extract": {
              "column": "label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "reddit/model",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-reddit"
            },
            "extract": {
              "column": "model"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "reddit/type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-reddit"
            },
            "extract": {
              "column": "type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "reddit/release_date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-reddit"
            },
            "extract": {
              "column": "release_date"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "OpenFake",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tDataset Card for OpenFake\n\t\n\n\n\n\t\n\t\t\n\t\n\t\n\t\tKnown issues\n\t\n\nPrompt\u2013image misalignment in the synthetic split (reported November 2025, fix pending)\nFor five of the eighty generators, the prompt field attached to synthetic\nimages does not correspond to the prompt actually used to generate that image.\nAffected generators:\n\nflux-realism\nsd-3.5\nsdxl-realvis-v5\nsd-1.5-dreamshaper\nsd-1.5-epicdream\n\nThis affects approximately 19.77% of synthetic images. It was first reported in\ndiscussion\u2026 See the full description on the dataset page: https://huggingface.co/datasets/ComplexDataLab/OpenFake.",
  "alternateName": [
    "ComplexDataLab/OpenFake"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Complex Data Lab",
    "url": "https://huggingface.co/ComplexDataLab"
  },
  "keywords": [
    "image-classification",
    "English",
    "cc-by-nc-4.0",
    "1M - 10M",
    "parquet",
    "Image",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "arxiv:2509.09495",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "deepfake",
    "Synthetic",
    "fake"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-nc-4.0/",
  "url": "https://huggingface.co/datasets/ComplexDataLab/OpenFake",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY-NC 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:prohibition": {
      "@type": "odrl:Prohibition",
      "odrl:action": {
        "@id": "odrl:commercialize"
      }
    },
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}