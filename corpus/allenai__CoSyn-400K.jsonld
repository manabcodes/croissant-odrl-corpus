  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "chart_splits/split_name"
      },
      "@id": "chart_splits",
      "name": "chart_splits",
      "description": "Splits for the chart config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "chart_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "chart_splits/split_name": "train"
        },
        {
          "chart_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "chart",
      "description": "allenai/CoSyn-400K - 'chart' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "chart/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-chart"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "chart/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "chart_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "chart/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-chart"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "chart/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-chart"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "chart/qa_pairs",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "chart/qa_pairs/question",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-chart"
                },
                "extract": {
                  "column": "qa_pairs"
                },
                "transform": {
                  "jsonPath": "question"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "chart/qa_pairs/explanation",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-chart"
                },
                "extract": {
                  "column": "qa_pairs"
                },
                "transform": {
                  "jsonPath": "explanation"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "chart/qa_pairs/answer",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-chart"
                },
                "extract": {
                  "column": "qa_pairs"
                },
                "transform": {
                  "jsonPath": "answer"
                }
              }
            }
          ],
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "chart/metadata",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "chart/metadata/figure_type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-chart"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "figure_type"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "chart/metadata/persona",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-chart"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "persona"
                }
              }
            },
            {
              "@type": "cr:Field",
