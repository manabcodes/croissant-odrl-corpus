  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "amh_splits/split_name"
      },
      "@id": "amh_splits",
      "name": "amh_splits",
      "description": "Splits for the amh config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "amh_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "amh_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "amh",
      "description": "bltlab/lr-sum - 'amh' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "amh/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "amh/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "amh_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/summary",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "summary"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amh/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amh"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
