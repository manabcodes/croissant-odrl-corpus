    {
      "@type": "cr:RecordSet",
      "@id": "knowmem",
      "name": "knowmem",
      "description": "muse-bench/MUSE-News - 'knowmem' subset\n\nAdditional information:\n- 4 splits: retain_qa_icl, retain_qa, forget_qa, forget_qa_icl",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "knowmem/split",
          "name": "knowmem/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-knowmem"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "knowmem/(?:partial-)?(retain_qa_icl|retain_qa|forget_qa|forget_qa_icl)/.+parquet$"
            }
