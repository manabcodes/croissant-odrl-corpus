  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/zongowo111/v2-crypto-ohlcv-data/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "zongowo111/v2-crypto-ohlcv-data - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/open_time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "open_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/open",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "open"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/high",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "high"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/low",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "low"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/close",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "close"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/volume",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/close_time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "close_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/quote_asset_volume",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "quote_asset_volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/number_of_trades",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "number_of_trades"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/taker_buy_base_asset_volume",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "taker_buy_base_asset_volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/taker_buy_quote_asset_volume",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "taker_buy_quote_asset_volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ignore",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ignore"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "v2-crypto-ohlcv-data",
  "description": "\n\t\n\t\t\n\t\tv2-crypto-ohlcv-data\n\t\n\nCryptocurrency OHLCV data from Binance API.\nGenerated: 2025-12-30 07:53:47\n\n\t\n\t\t\n\t\tDataset Info\n\t\n\n\nTotal Files: 46\nTotal Data Points: 4,819,964\nTotal Size: 110.57 MB\nSymbols: 23 cryptocurrencies\nTimeframes: 15m, 1h\n\n\n\t\n\t\t\n\t\tUsage\n\t\n\nimport pandas as pd\nfrom huggingface_hub import hf_hub_download\n\npath = hf_hub_download(\n    \"zongowo111/v2-crypto-ohlcv-data\",\n    \"klines/BTCUSDT/BTC_15m.parquet\",\n    repo_type=\"dataset\"\n)\ndf = pd.read_parquet(path)\u2026 See the full description on the dataset page: https://huggingface.co/datasets/zongowo111/v2-crypto-ohlcv-data.",
  "alternateName": [
    "zongowo111/v2-crypto-ohlcv-data"
  ],
