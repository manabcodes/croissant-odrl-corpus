  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ar_splits/split_name"
      },
      "@id": "ar_splits",
      "name": "ar_splits",
      "description": "Splits for the ar config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ar_splits/split_name": "train"
        },
        {
          "ar_splits/split_name": "val"
        },
        {
          "ar_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ar",
      "name": "ar",
      "description": "alexandrainst/m_arc - 'ar' subset\n\nAdditional information:\n- 3 splits: train, val, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar/split",
          "name": "ar/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ar/(?:partial-)?(train|val|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ar_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar/id",
          "name": "ar/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar/answer",
          "name": "ar/answer",
