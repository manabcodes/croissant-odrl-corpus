  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ace_splits/split_name"
      },
      "@id": "ace_splits",
      "name": "ace_splits",
      "description": "Splits for the ace config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ace_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ace_splits/split_name": "train"
        },
        {
          "ace_splits/split_name": "validation"
        },
        {
          "ace_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ace",
      "name": "ace",
      "description": "akoksal/muri-it-language-split - 'ace' subset (only the first 100 subsets are included in this metadata)\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ace/split",
          "name": "ace/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
