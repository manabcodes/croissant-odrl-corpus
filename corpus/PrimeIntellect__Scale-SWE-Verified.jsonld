{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/PrimeIntellect/Scale-SWE-Verified/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "PrimeIntellect/Scale-SWE-Verified - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/instance_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "instance_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/user",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "user"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/repo",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "repo"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/workdir",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "workdir"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/patch",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "patch"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pr_commit",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pr_commit"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parent_commit",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parent_commit"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/problem_statement",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "problem_statement"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/f2p_patch",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "f2p_patch"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/f2p_script",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "f2p_script"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/FAIL_TO_PASS",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "FAIL_TO_PASS"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/PASS_TO_PASS",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "PASS_TO_PASS"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/github_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "github_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pre_commands",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pre_commands"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Scale-SWE-Verified",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tScale-SWE-Verified\n\t\n\n\nGold-patch-validated fork of\nAweAI-Team/Scale-SWE\n(paper): 17,202 / 20,181 Python issue-resolving tasks\nthat produce a clean reward signal end-to-end. Default dataset of the scaleswe_v1 taskset.\n\n\t\n\t\t\n\t\n\t\n\t\tChanges vs upstream\n\t\n\nValidation (ours) removed 2,979 / 20,181 rows (14.8%):\n\n892 rows whose image_url appears in\nscale-swe-exclude-images.json.\n2,061 rows categorized gold_patch_failure in\nscale-swe-validation.jsonl.\n15 rows categorized noop_pass\u2026 See the full description on the dataset page: https://huggingface.co/datasets/PrimeIntellect/Scale-SWE-Verified.",
  "alternateName": [
    "PrimeIntellect/Scale-SWE-Verified",
    "Scale-SWE-Verified"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Prime Intellect",
    "url": "https://huggingface.co/PrimeIntellect"
  },
  "keywords": [
    "text-generation",
    "English",
    "cc-by-4.0",
    "10K - 100K",
