            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "start_city"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/target_city",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "target_city"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/days",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "days"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/people_number",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "people_number"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/limit_rooms",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "limit_rooms"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/limits_room_type",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "limits_room_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/hard_logic_py",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "hard_logic_py"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/nature_language",
          "dataType": "sc:Text",
          "source": {
