            },
            "extract": {
              "column": "task_identifier"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/kwargs",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/kwargs/N",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "kwargs"
                },
                "transform": {
                  "jsonPath": "N"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/kwargs/N1",
