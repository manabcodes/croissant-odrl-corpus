  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "all_splits/split_name"
      },
      "@id": "all_splits",
      "name": "all_splits",
      "description": "Splits for the all config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_splits/split_name": "train"
        },
        {
          "all_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all",
      "name": "all",
      "description": "clips/mfaq - 'all' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all/split",
          "name": "all/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/id",
          "name": "all/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/language",
          "name": "all/language",
          "description": "Column 'language' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
