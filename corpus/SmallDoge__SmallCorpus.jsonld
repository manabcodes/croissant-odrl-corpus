  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "code_splits/split_name"
      },
      "@id": "code_splits",
      "name": "code_splits",
      "description": "Splits for the code config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "code_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "code_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "code",
      "description": "SmallDoge/SmallCorpus - 'code' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "code/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-code"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "code/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "code_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "code/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-code"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
