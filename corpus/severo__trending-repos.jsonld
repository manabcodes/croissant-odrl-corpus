{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/severo/trending-repos/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-datasets",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "datasets/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-models",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "models/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-spaces",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "spaces/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "datasets_splits/split_name"
      },
      "@id": "datasets_splits",
      "name": "datasets_splits",
      "description": "Splits for the datasets config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "datasets_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "datasets_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "datasets",
      "description": "severo/trending-repos - 'datasets' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "datasets/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-datasets"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "datasets/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "datasets_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "datasets/date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-datasets"
            },
            "extract": {
              "column": "date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "datasets/author",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-datasets"
            },
            "extract": {
              "column": "author"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "datasets/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-datasets"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "datasets/rank",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-datasets"
            },
            "extract": {
              "column": "rank"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "datasets/recent_likes",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-datasets"
            },
            "extract": {
              "column": "recent_likes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "datasets/likes",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-datasets"
            },
            "extract": {
              "column": "likes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "datasets/month_downloads",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-datasets"
            },
            "extract": {
              "column": "month_downloads"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "models_splits/split_name"
      },
      "@id": "models_splits",
      "name": "models_splits",
      "description": "Splits for the models config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "models_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "models_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "models",
      "description": "severo/trending-repos - 'models' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "models/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-models"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "models/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "models_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "models/date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-models"
            },
            "extract": {
              "column": "date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "models/author",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-models"
            },
            "extract": {
              "column": "author"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "models/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-models"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "models/rank",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-models"
            },
            "extract": {
              "column": "rank"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "models/recent_likes",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-models"
            },
            "extract": {
              "column": "recent_likes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "models/likes",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-models"
            },
            "extract": {
              "column": "likes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "models/month_downloads",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-models"
            },
            "extract": {
              "column": "month_downloads"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "spaces_splits/split_name"
      },
      "@id": "spaces_splits",
      "name": "spaces_splits",
      "description": "Splits for the spaces config.",
      "field": [
        {
          "@type": "cr:Field",
