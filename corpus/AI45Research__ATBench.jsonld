    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/AI45Research/ATBench/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-ATBench",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "ATBench/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-ATBench500",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "ATBench500/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ATBench_splits/split_name"
      },
      "@id": "ATBench_splits",
      "name": "ATBench_splits",
      "description": "Splits for the ATBench config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ATBench_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ATBench_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ATBench",
      "description": "AI45Research/ATBench - 'ATBench' subset\n\nAdditional information:\n- 2 skipped columns: tool_used, contents",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ATBench/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ATBench/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ATBench_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench/label",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench"
            },
            "extract": {
              "column": "label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench/risk_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench"
            },
            "extract": {
              "column": "risk_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench/failure_mode",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench"
            },
            "extract": {
              "column": "failure_mode"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench/reason",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench"
            },
            "extract": {
              "column": "reason"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench/real_world_harm",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench"
            },
            "extract": {
              "column": "real_world_harm"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ATBench500_splits/split_name"
      },
      "@id": "ATBench500_splits",
      "name": "ATBench500_splits",
      "description": "Splits for the ATBench500 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ATBench500_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ATBench500_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ATBench500",
      "description": "AI45Research/ATBench - 'ATBench500' subset\n\nAdditional information:\n- 2 skipped columns: tool_used, content",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ATBench500/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench500"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ATBench500/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ATBench500_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench500/conv_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench500"
            },
            "extract": {
              "column": "conv_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench500/label",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench500"
            },
            "extract": {
              "column": "label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench500/risk_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench500"
            },
            "extract": {
              "column": "risk_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench500/failure_mode",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench500"
            },
            "extract": {
              "column": "failure_mode"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ATBench500/real_world_harm",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ATBench500"
            },
            "extract": {
              "column": "real_world_harm"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "ATBench",
  "description": "\n\t\n\t\t\n\t\tATBench: Agent Trajectory Safety Benchmark Family\n\t\n\n\n  \ud83d\udcbb GitHub\u00a0\u00a0 | \u00a0\u00a0\n  \ud83d\udcc4 ATBench Paper\u00a0\u00a0 | \u00a0\u00a0\n  \ud83d\udcc4 AgentDoG Paper (ATBench500)\u00a0\u00a0 | \u00a0\u00a0\n  \ud83e\udd17 Hugging Face Collection\n\n\nATBench is a family of trajectory-level safety benchmarks for long-horizon, tool-using AI agents. The latest release is introduced in ATBench: A Diverse and Realistic Agent Trajectory Benchmark for Safety Evaluation and Diagnosis. This repository now follows a versioned naming scheme:\n\nATBench: the latest 1\u2026 See the full description on the dataset page: https://huggingface.co/datasets/AI45Research/ATBench.",
  "alternateName": [
    "AI45Research/ATBench",
    "ATBench"
  ],
  "creator": {
    "@type": "Organization",
    "name": "AI45Research",
    "url": "https://huggingface.co/AI45Research"
  },
  "keywords": [
    "apache-2.0",
    "1K - 10K",
    "json",
    "Image",
    "Tabular",
