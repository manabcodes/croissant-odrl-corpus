    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/frgfm/imagenette/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-160px",
      "name": "parquet-files-for-config-160px",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "160px/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-320px",
      "name": "parquet-files-for-config-320px",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "320px/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-full_size",
      "name": "parquet-files-for-config-full_size",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "full_size/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "160px_splits/split_name"
      },
      "@id": "160px_splits",
      "name": "160px_splits",
      "description": "Splits for the 160px config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "160px_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "160px_splits/split_name": "train"
        },
        {
          "160px_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "160px",
      "name": "160px",
      "description": "frgfm/imagenette - '160px' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "160px/split",
          "name": "160px/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-160px"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "160px/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "160px_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "160px/image",
          "name": "160px/image",
          "description": "Image column 'image' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-160px"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "160px/label",
          "name": "160px/label",
          "description": "ClassLabel column 'label' from the Hugging Face parquet file.\nLabels:\ntench (0), English springer (1), cassette player (2), chain saw (3), church (4), French horn (5), garbage truck (6), gas pump (7), golf ball (8), parachute (9)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-160px"
            },
            "extract": {
              "column": "label"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "320px_splits/split_name"
      },
      "@id": "320px_splits",
      "name": "320px_splits",
      "description": "Splits for the 320px config.",
