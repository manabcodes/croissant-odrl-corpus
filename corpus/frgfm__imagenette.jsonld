          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "full_size_splits/split_name": "train"
        },
        {
          "full_size_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "full_size",
      "name": "full_size",
      "description": "frgfm/imagenette - 'full_size' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full_size/split",
          "name": "full_size/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full_size"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "full_size/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
