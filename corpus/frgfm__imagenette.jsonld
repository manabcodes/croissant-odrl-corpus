      "field": [
        {
          "@type": "cr:Field",
          "@id": "320px/split",
          "name": "320px/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-320px"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "320px/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "320px_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "320px/image",
          "name": "320px/image",
          "description": "Image column 'image' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-320px"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "320px/label",
          "name": "320px/label",
          "description": "ClassLabel column 'label' from the Hugging Face parquet file.\nLabels:\ntench (0), English springer (1), cassette player (2), chain saw (3), church (4), French horn (5), garbage truck (6), gas pump (7), golf ball (8), parachute (9)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-320px"
            },
            "extract": {
              "column": "label"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "full_size_splits/split_name"
      },
      "@id": "full_size_splits",
      "name": "full_size_splits",
      "description": "Splits for the full_size config.",
      "field": [
