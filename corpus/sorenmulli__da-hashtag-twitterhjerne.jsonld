            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Answer_6",
          "name": "default/Answer_6",
          "description": "Column 'Answer 6' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
