          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "text_embedding_dtype"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/file_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "file_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/caption",
