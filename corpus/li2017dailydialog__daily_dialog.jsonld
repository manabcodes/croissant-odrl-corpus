  "@type": "Dataset",
  "name": "daily_dialog",
  "description": "We develop a high-quality multi-turn dialog dataset, DailyDialog, which is intriguing in several aspects.\nThe language is human-written and less noisy. The dialogues in the dataset reflect our daily communication way\nand cover various topics about our daily life. We also manually label the developed dataset with communication\nintention and emotion information. Then, we evaluate existing approaches on DailyDialog dataset and hope it\nbenefit the research field of dialog systems.",
  "alternateName": [
    "li2017dailydialog/daily_dialog",
    "DailyDialog"
  ],
