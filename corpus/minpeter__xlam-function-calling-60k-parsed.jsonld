  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/minpeter/xlam-function-calling-60k-parsed/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-xlam-function-calling-60k",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "xlam-function-calling-60k/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "xlam-function-calling-60k_splits/split_name"
      },
      "@id": "xlam-function-calling-60k_splits",
      "name": "xlam-function-calling-60k_splits",
      "description": "Splits for the xlam-function-calling-60k config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "xlam-function-calling-60k_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "xlam-function-calling-60k_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "xlam-function-calling-60k",
      "description": "minpeter/xlam-function-calling-60k-parsed - 'xlam-function-calling-60k' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "xlam-function-calling-60k/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-xlam-function-calling-60k"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "xlam\\-function\\-calling\\-60k/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "xlam-function-calling-60k_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "xlam-function-calling-60k/messages",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "xlam-function-calling-60k/messages/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-xlam-function-calling-60k"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "xlam-function-calling-60k/messages/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-xlam-function-calling-60k"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "xlam-function-calling-60k/messages/tool_calls",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "xlam-function-calling-60k/messages/tool_calls/function",
                  "subField": [
                    {
                      "@type": "cr:Field",
                      "@id": "xlam-function-calling-60k/messages/tool_calls/function/arguments",
                      "dataType": "sc:Text",
                      "source": {
                        "fileSet": {
                          "@id": "parquet-files-for-config-xlam-function-calling-60k"
                        },
                        "extract": {
                          "column": "messages"
                        },
                        "transform": [
                          {
                            "jsonPath": "function"
                          },
                          {
                            "jsonPath": "arguments"
                          }
                        ]
                      }
                    },
                    {
                      "@type": "cr:Field",
                      "@id": "xlam-function-calling-60k/messages/tool_calls/function/name",
                      "dataType": "sc:Text",
                      "source": {
                        "fileSet": {
                          "@id": "parquet-files-for-config-xlam-function-calling-60k"
                        },
                        "extract": {
                          "column": "messages"
                        },
                        "transform": [
                          {
                            "jsonPath": "function"
                          },
                          {
                            "jsonPath": "name"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "@type": "cr:Field",
                  "@id": "xlam-function-calling-60k/messages/tool_calls/type",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-xlam-function-calling-60k"
                    },
                    "extract": {
                      "column": "messages"
                    },
                    "transform": {
                      "jsonPath": "type"
                    }
                  }
                }
              ],
              "isArray": true,
              "arrayShape": "-1"
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "xlam-function-calling-60k/tools",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-xlam-function-calling-60k"
            },
            "extract": {
              "column": "tools"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "xlam-function-calling-60k/extra",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "xlam-function-calling-60k/extra/id",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-xlam-function-calling-60k"
                },
                "extract": {
                  "column": "extra"
                },
                "transform": {
                  "jsonPath": "id"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "xlam-function-calling-60k-parsed",
  "description": "\n\t\n\t\t\n\t\t[PARSED] APIGen Function-Calling Datasets (xLAM)\n\t\n\nThis dataset contains the full data from the original Salesforce/xlam-function-calling-60k\n\n\t\n\t\t\nSubset name\nmulti-turn\nparallel\nmultiple definition\nLast turn type\nnumber of dataset\n\n\n\t\t\nxlam-function-calling-60k\nno\nyes\nyes\ntool_calls\n60000\n\n\n\t\n\nThis is a re-parsing formatting dataset for the xLAM official dataset.\n\n\t\n\t\t\n\t\n\t\n\t\tLoad the dataset\n\t\n\nfrom datasets import load_dataset\n\nds =\u2026 See the full description on the dataset page: https://huggingface.co/datasets/minpeter/xlam-function-calling-60k-parsed.",
