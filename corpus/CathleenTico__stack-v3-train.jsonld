            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_files"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/files",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/files/content_id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "content_id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/files/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/files/size_bytes",
              "dataType": "cr:Int32",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "size_bytes"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/files/file_path",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "file_path"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/files/file_timestamp",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "file_timestamp"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/files/language",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "language"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/files/is_vendor",
              "dataType": "sc:Boolean",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "is_vendor"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/files/license_type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "license_type"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/files/detected_licenses",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "files"
                },
                "transform": {
                  "jsonPath": "detected_licenses"
                }
