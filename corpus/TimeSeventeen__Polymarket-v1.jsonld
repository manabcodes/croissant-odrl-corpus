      "field": [
        {
          "@type": "cr:Field",
          "@id": "ctf_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ctf_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ctf",
      "description": "TimeSeventeen/Polymarket-v1 - 'ctf' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ctf/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ctf"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ctf/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ctf_splits/split_name"
            }
          }
        },
        {
