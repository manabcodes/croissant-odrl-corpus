        },
        {
          "@type": "cr:Field",
          "@id": "ctf/condition_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ctf"
            },
            "extract": {
              "column": "condition_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ctf/partition",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ctf"
            },
            "extract": {
              "column": "partition"
            }
