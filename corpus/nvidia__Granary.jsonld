  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "bg_voxpopuli_splits/split_name"
      },
      "@id": "bg_voxpopuli_splits",
      "name": "bg_voxpopuli_splits",
      "description": "Splits for the bg_voxpopuli config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bg_voxpopuli_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "bg_voxpopuli_splits/split_name": "asr"
        },
        {
          "bg_voxpopuli_splits/split_name": "ast"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "bg_voxpopuli",
      "description": "nvidia/Granary - 'bg_voxpopuli' subset (first 5GB)\n\nAdditional information:\n- 2 splits: asr, ast\n- 1 skipped column: duration",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bg_voxpopuli/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bg_voxpopuli"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "bg_voxpopuli/(?:partial-)?(asr|ast)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "bg_voxpopuli_splits/split_name"
            }
          }
        },
