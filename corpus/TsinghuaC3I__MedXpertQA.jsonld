  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/TsinghuaC3I/MedXpertQA/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-MM",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "MM/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Text",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Text/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "MM_splits/split_name"
      },
      "@id": "MM_splits",
      "name": "MM_splits",
      "description": "Splits for the MM config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "MM_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "MM_splits/split_name": "dev"
        },
        {
          "MM_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "MM",
      "description": "TsinghuaC3I/MedXpertQA - 'MM' subset\n\nAdditional information:\n- 2 splits: dev, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "MM/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-MM"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "MM/(?:partial-)?(dev|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "MM_splits/split_name"
            }
          }
        },
        {
