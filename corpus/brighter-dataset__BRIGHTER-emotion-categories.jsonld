            },
            "extract": {
              "column": "anger"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "afr/disgust",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-afr"
            },
            "extract": {
              "column": "disgust"
            }
          }
        },
        {
          "@type": "cr:Field",
