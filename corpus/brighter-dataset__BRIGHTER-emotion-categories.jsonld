          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-afr"
            },
            "extract": {
              "column": "fear"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "afr/joy",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-afr"
            },
            "extract": {
              "column": "joy"
