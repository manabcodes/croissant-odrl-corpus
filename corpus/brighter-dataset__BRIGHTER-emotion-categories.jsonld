      "key": {
        "@id": "afr_splits/split_name"
      },
      "@id": "afr_splits",
      "name": "afr_splits",
      "description": "Splits for the afr config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "afr_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "afr_splits/split_name": "train"
        },
        {
          "afr_splits/split_name": "dev"
        },
        {
          "afr_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "afr",
      "description": "brighter-dataset/BRIGHTER-emotion-categories - 'afr' subset\n\nAdditional information:\n- 3 splits: train, dev, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "afr/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-afr"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "afr/(?:partial-)?(train|dev|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "afr_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "afr/id",
          "dataType": "sc:Text",
          "source": {
