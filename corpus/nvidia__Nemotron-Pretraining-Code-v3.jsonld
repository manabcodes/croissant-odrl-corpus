{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/nvidia/Nemotron-Pretraining-Code-v3/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Nemotron-Code-Metadata",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Nemotron-Code-Metadata/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Nemotron-Code-Metadata_splits/split_name"
      },
      "@id": "Nemotron-Code-Metadata_splits",
      "name": "Nemotron-Code-Metadata_splits",
      "description": "Splits for the Nemotron-Code-Metadata config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Nemotron-Code-Metadata_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Nemotron-Code-Metadata_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Nemotron-Code-Metadata",
      "description": "nvidia/Nemotron-Pretraining-Code-v3 - 'Nemotron-Code-Metadata' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Nemotron-Code-Metadata/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Nemotron-Code-Metadata"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Nemotron\\-Code\\-Metadata/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Nemotron-Code-Metadata_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Nemotron-Code-Metadata/repo",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Nemotron-Code-Metadata"
            },
            "extract": {
              "column": "repo"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Nemotron-Code-Metadata/rel_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Nemotron-Code-Metadata"
            },
            "extract": {
              "column": "rel_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Nemotron-Code-Metadata/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Nemotron-Code-Metadata"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Nemotron-Code-Metadata/commit_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Nemotron-Code-Metadata"
            },
            "extract": {
              "column": "commit_id"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Nemotron-Pretraining-Code-v3",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tNemotron-Pretraining-Code-v3\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Description:\n\t\n\nThe Nemotron-Pretraining-Code-v3 dataset is part of the Nemotron Pretraining Data collection of pretraining datasets. Designed for the NVIDIA Nemotron 3 family of LLMs, this dataset is intended to improve the coding capabilities of LLMs.\nThe Nemotron-Pretraining-Code-v3 dataset contains the metadata corresponding to the raw source-code update to our Nemotron-Pretraining-Code-v2 and Nemotron-Pretraining-Code-v1\u2026 See the full description on the dataset page: https://huggingface.co/datasets/nvidia/Nemotron-Pretraining-Code-v3.",
  "alternateName": [
    "nvidia/Nemotron-Pretraining-Code-v3"
  ],
  "creator": {
    "@type": "Organization",
    "name": "NVIDIA",
    "url": "https://huggingface.co/nvidia"
  },
  "keywords": [
    "text-generation",
    "code",
    "cc-by-4.0",
    "100M - 1B",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "text",
    "pre-training",
    "human",
    "legal",
    "Nemotron_3_Ultra"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/nvidia/Nemotron-Pretraining-Code-v3",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
