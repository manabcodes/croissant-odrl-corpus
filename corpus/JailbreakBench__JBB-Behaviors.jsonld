  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/JailbreakBench/JBB-Behaviors/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-behaviors",
      "name": "parquet-files-for-config-behaviors",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "behaviors/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-judge_comparison",
      "name": "parquet-files-for-config-judge_comparison",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "judge_comparison/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "behaviors_splits/split_name"
      },
      "@id": "behaviors_splits",
      "name": "behaviors_splits",
      "description": "Splits for the behaviors config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "behaviors_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "behaviors_splits/split_name": "harmful"
        },
        {
          "behaviors_splits/split_name": "benign"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "behaviors",
      "name": "behaviors",
      "description": "JailbreakBench/JBB-Behaviors - 'behaviors' subset\n\nAdditional information:\n- 2 splits: harmful, benign",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "behaviors/split",
          "name": "behaviors/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-behaviors"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "behaviors/(?:partial-)?(harmful|benign)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "behaviors_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "behaviors/Index",
