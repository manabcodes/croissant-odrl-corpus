          "@id": "behaviors/Source",
          "name": "behaviors/Source",
          "description": "Column 'Source' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-behaviors"
            },
            "extract": {
              "column": "Source"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "judge_comparison_splits/split_name"
      },
