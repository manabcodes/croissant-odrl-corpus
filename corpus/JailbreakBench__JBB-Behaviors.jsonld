          "@id": "behaviors/Behavior",
          "name": "behaviors/Behavior",
          "description": "Column 'Behavior' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-behaviors"
            },
            "extract": {
              "column": "Behavior"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "behaviors/Category",
