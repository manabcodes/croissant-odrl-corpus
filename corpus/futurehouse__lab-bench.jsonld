    {
      "@type": "cr:RecordSet",
      "@id": "CloningScenarios",
      "description": "futurehouse/lab-bench - 'CloningScenarios' subset\n\nAdditional information:\n- 1 skipped column: source",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "CloningScenarios/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CloningScenarios"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "CloningScenarios/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
