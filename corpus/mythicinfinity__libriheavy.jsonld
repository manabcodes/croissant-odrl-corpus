              "@id": "parquet-files-for-config-small"
            },
            "extract": {
              "column": "audio"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "small/audio_duration",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-small"
            },
            "extract": {
              "column": "audio_duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "small/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-small"
            },
            "extract": {
              "column": "id"
            }
