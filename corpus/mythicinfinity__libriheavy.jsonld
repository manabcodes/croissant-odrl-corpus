      "includes": "test_clean_large/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-test_other",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "test_other/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-test_other_large",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "test_other_large/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "small_splits/split_name"
      },
      "@id": "small_splits",
      "name": "small_splits",
      "description": "Splits for the small config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "small_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "small_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "small",
      "description": "mythicinfinity/libriheavy - 'small' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "small/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-small"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "small/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "small_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "small/audio",
          "dataType": "sc:AudioObject",
