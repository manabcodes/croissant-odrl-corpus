      "@id": "ContextASR-Dialogue",
      "description": "MrSupW/ContextASR-Bench - 'ContextASR-Dialogue' subset\n\nAdditional information:\n- 2 splits: English, Mandarin",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ContextASR-Dialogue/split",
          "dataType": "sc:Text",
