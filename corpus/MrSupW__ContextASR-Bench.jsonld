              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-ContextASR-Dialogue"
                },
                "extract": {
                  "column": "dialogue"
                },
                "transform": {
                  "jsonPath": "start"
                }
              }
            },
            {
