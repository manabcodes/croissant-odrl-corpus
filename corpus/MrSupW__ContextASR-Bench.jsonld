            "fileSet": {
              "@id": "parquet-files-for-config-ContextASR-Dialogue"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ContextASR\\-Dialogue/(?:partial-)?(English|Mandarin)/.+parquet$"
            }
          },
