                "fileSet": {
                  "@id": "parquet-files-for-config-ContextASR-Dialogue"
                },
                "extract": {
                  "column": "dialogue"
                },
                "transform": {
                  "jsonPath": "end"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "ContextASR-Dialogue/dialogue/text",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-ContextASR-Dialogue"
                },
                "extract": {
                  "column": "dialogue"
                },
                "transform": {
                  "jsonPath": "text"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
