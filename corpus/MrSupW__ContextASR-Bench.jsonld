      "field": [
        {
          "@type": "cr:Field",
          "@id": "ContextASR-Dialogue_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ContextASR-Dialogue_splits/split_name": "English"
        },
        {
          "ContextASR-Dialogue_splits/split_name": "Mandarin"
        }
      ]
