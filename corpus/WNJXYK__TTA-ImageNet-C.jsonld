    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "brightness_splits/split_name"
      },
      "@id": "brightness_splits",
      "name": "brightness_splits",
      "description": "Splits for the brightness config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "brightness_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "brightness_splits/split_name": "severity_1"
        },
        {
          "brightness_splits/split_name": "severity_2"
        },
        {
          "brightness_splits/split_name": "severity_3"
        },
        {
          "brightness_splits/split_name": "severity_4"
        },
        {
          "brightness_splits/split_name": "severity_5"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "brightness",
      "description": "WNJXYK/TTA-ImageNet-C - 'brightness' subset\n\nAdditional information:\n- 5 splits: severity_1, severity_2, severity_3, severity_4, severity_5",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "brightness/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-brightness"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "brightness/(?:partial-)?(severity_1|severity_2|severity_3|severity_4|severity_5)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "brightness_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "brightness/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-brightness"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "brightness/label",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-brightness"
            },
            "extract": {
              "column": "label"
            }
          }
        }
      ]
    },
