{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ieasybooks-org/prophet-mosque-library/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-index",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "index/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "index_splits/split_name"
      },
      "@id": "index_splits",
      "name": "index_splits",
      "description": "Splits for the index config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "index_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "index_splits/split_name": "index"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "index",
      "description": "ieasybooks-org/prophet-mosque-library - 'index' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "index/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "index/(?:partial-)?(index)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "index_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/author",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "author"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/pages",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "pages"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/pdf_paths",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "pdf_paths"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/txt_paths",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "txt_paths"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/docx_paths",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "docx_paths"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "prophet-mosque-library",
  "description": "\n\t\n\t\t\n\t\tProphet's Mosque Library\n\t\n\n\n\t\n\t\t\n\t\t\ud83d\udcd6 Overview\n\t\n\nProphet\u2019s Mosque Library is one of the primary resources for Islamic books. It hosts more than 48,000 PDF books across over 70 categories.\nIn this dataset, we processed the original PDF files using Google Document AI APIs and extracted their contents into two additional formats: TXT and DOCX.\n\n\t\n\t\t\n\t\t\ud83d\udcca Dataset Contents\n\t\n\nThe dataset includes 70,884 PDF files (spanning 23,494,042 pages) representing 48,717 Islamic books. Each book is\u2026 See the full description on the dataset page: https://huggingface.co/datasets/ieasybooks-org/prophet-mosque-library.",
  "alternateName": [
    "ieasybooks-org/prophet-mosque-library",
    "Prophet's Mosque Library"
  ],
  "creator": {
    "@type": "Organization",
    "name": "\u0627\u0644\u0643\u062a\u0628 \u0627\u0644\u0645\u064f\u064a\u0633\u0651\u0631\u0629",
    "url": "https://huggingface.co/ieasybooks-org"
  },
  "keywords": [
    "image-to-text",
    "Arabic",
    "mit",
    "10K - 100K",
    "csv",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/ieasybooks-org/prophet-mosque-library",
