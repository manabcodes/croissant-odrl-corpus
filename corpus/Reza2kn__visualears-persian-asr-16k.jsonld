    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Reza2kn/visualears-persian-asr-16k/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "Reza2kn/visualears-persian-asr-16k - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "audio"
            },
            "sampling_rate": 16000
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/duration",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "visualears-persian-asr-16k",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\t\ud83d\uddc2\ufe0f visualears-persian-asr-16k\n\t\n\n\nEnglish + \u0641\u0627\u0631\u0633\u06cc \u00b7 Part of Shenava 1.0 \u00b7 Project hub \u00b7 SLT paper submission\n\n\n\t\n\t\t\n\t\n\t\n\t\t\ud83c\udf1f At a glance | \u0645\u0639\u0631\u0641\u06cc \u0633\u0631\u06cc\u0639\n\t\n\n\n\t\n\t\t\n\nEnglish\n\u0641\u0627\u0631\u0633\u06cc\n\n\n\t\t\n\ud83c\udfaf Purpose\nMain public Persian ASR audio/text dataset: 3.93M 16 kHz rows.\n\u0645\u062c\u0645\u0648\u0639\u0647\u200c\u062f\u0627\u062f\u0647\u0654 \u0627\u0635\u0644\u06cc \u0648 \u0639\u0645\u0648\u0645\u06cc \u0634\u0646\u0648\u0627 \u0628\u0631\u0627\u06cc \u0622\u0645\u0648\u0632\u0634 \u0628\u0627\u0632\u0634\u0646\u0627\u0633\u06cc \u06af\u0641\u062a\u0627\u0631 \u0641\u0627\u0631\u0633\u06cc\u061b \u0634\u0627\u0645\u0644 \u0635\u0648\u062a \u06f1\u06f6 \u06a9\u06cc\u0644\u0648\u0647\u0631\u062a\u0632\u060c \u0645\u062a\u0646 \u0648 \u0641\u0631\u0627\u062f\u0627\u062f\u0647\u0654 \u0645\u0646\u0634\u0623 \u062f\u0631 \u0645\u0642\u06cc\u0627\u0633 \u0686\u0646\u062f\u0645\u06cc\u0644\u06cc\u0648\u0646\u06cc.\n\n\n\ud83e\udde9 Role\nflagship training corpus\n\u067e\u06cc\u06a9\u0631\u0647\u0654 \u0627\u0635\u0644\u06cc \u0622\u0645\u0648\u0632\u0634\n\n\n\ud83d\udce6 Snapshot\n176 files; approximately 512.17 GB\n176\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Reza2kn/visualears-persian-asr-16k.",
  "alternateName": [
    "Reza2kn/visualears-persian-asr-16k"
  ],
  "creator": {
    "@type": "Person",
    "name": "Reza Sayar",
    "url": "https://huggingface.co/Reza2kn"
  },
