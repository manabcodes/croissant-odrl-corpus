  "@type": "Dataset",
  "name": "mlqa",
  "description": "    MLQA (MultiLingual Question Answering) is a benchmark dataset for evaluating cross-lingual question answering performance.\n    MLQA consists of over 5K extractive QA instances (12K in English) in SQuAD format in seven languages - English, Arabic,\n    German, Spanish, Hindi, Vietnamese and Simplified Chinese. MLQA is highly parallel, with QA instances parallel between\n    4 different languages on average.",
  "alternateName": [
    "facebook/mlqa",
    "MLQA (MultiLingual Question Answering)"
  ],
