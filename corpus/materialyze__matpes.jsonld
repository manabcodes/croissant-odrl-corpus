  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/materialyze/matpes/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-pbe-atoms",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "pbe-atoms/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-r2scan-atoms",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "r2scan-atoms/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "pbe-atoms_splits/split_name"
      },
      "@id": "pbe-atoms_splits",
      "name": "pbe-atoms_splits",
      "description": "Splits for the pbe-atoms config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pbe-atoms_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "pbe-atoms_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "pbe-atoms",
      "description": "materialyze/matpes - 'pbe-atoms' subset\n\nAdditional information:\n- 8 skipped columns: composition, composition_reduced, matpes_id, formation_energy_per_atom, cohesive_energy_per_atom, bader_charges, bader_magmoms, provenance",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pbe-atoms/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pbe-atoms"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "pbe\\-atoms/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "pbe-atoms_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pbe-atoms/builder_meta",
