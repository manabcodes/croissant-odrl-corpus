            "fileSet": {
              "@id": "parquet-files-for-config-all_attributes"
            },
            "extract": {
              "column": "videos"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "all_attributes/messages",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "all_attributes/messages/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-all_attributes"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "all_attributes/messages/content",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "all_attributes/messages/content/type",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-all_attributes"
                    },
                    "extract": {
                      "column": "messages"
                    },
                    "transform": [
                      {
                        "jsonPath": "content"
                      },
                      {
                        "jsonPath": "type"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "all_attributes/messages/content/text",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-all_attributes"
                    },
                    "extract": {
                      "column": "messages"
                    },
                    "transform": [
                      {
                        "jsonPath": "content"
                      },
                      {
                        "jsonPath": "text"
                      }
                    ]
                  }
                }
              ],
              "isArray": true,
              "arrayShape": "-1"
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
