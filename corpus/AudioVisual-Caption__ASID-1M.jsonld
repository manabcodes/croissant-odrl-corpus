            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "single_attribute/videos",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-single_attribute"
            },
            "extract": {
              "column": "videos"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
