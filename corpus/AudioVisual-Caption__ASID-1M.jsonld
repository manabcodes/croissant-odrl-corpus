  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/AudioVisual-Caption/ASID-1M/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-all_attributes",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "all_attributes/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-single_attribute",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "single_attribute/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "all_attributes_splits/split_name"
      },
      "@id": "all_attributes_splits",
      "name": "all_attributes_splits",
      "description": "Splits for the all_attributes config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_attributes_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_attributes_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all_attributes",
      "description": "AudioVisual-Caption/ASID-1M - 'all_attributes' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_attributes/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_attributes"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all_attributes/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_attributes_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_attributes/videos",
