        {
          "@type": "cr:Field",
          "@id": "test/regions",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "test/regions/bbox_0",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-test"
                },
                "extract": {
                  "column": "regions"
                },
                "transform": {
                  "jsonPath": "bbox"
