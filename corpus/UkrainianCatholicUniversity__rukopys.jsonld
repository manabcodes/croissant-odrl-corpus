  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/UkrainianCatholicUniversity/rukopys/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-full",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "full/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-test",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "test/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "full_splits/split_name"
      },
      "@id": "full_splits",
      "name": "full_splits",
      "description": "Splits for the full config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "full_splits/split_name": "train"
        },
        {
          "full_splits/split_name": "silver"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "full",
      "description": "UkrainianCatholicUniversity/rukopys - 'full' subset\n\nAdditional information:\n- 2 splits: train, silver",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "full/(?:partial-)?(train|silver)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "full_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/image_width",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "image_width"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/image_height",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "image_height"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/source_detail",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "source_detail"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/annotation_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "annotation_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/regions",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "full/regions/bbox",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-full"
                },
                "extract": {
                  "column": "regions"
                },
                "transform": {
                  "jsonPath": "bbox"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "full/regions/type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-full"
                },
                "extract": {
                  "column": "regions"
                },
                "transform": {
                  "jsonPath": "type"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "full/regions/language",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-full"
                },
                "extract": {
                  "column": "regions"
                },
                "transform": {
                  "jsonPath": "language"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "full/regions/legibility",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-full"
                },
                "extract": {
                  "column": "regions"
                },
                "transform": {
                  "jsonPath": "legibility"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "full/regions/text",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-full"
                },
                "extract": {
                  "column": "regions"
                },
                "transform": {
                  "jsonPath": "text"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "full/fund",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "fund"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/content_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "content_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/grade",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "grade"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/subject",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "subject"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/group",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "group"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "test_splits/split_name"
      },
      "@id": "test_splits",
      "name": "test_splits",
      "description": "Splits for the test config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "test_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "test_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "test",
      "description": "UkrainianCatholicUniversity/rukopys - 'test' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "test/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-test"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "test/(?:partial-)?(test)/.+parquet$"
            }
          },
