            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "test/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-test"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "test/image_width",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-test"
            },
            "extract": {
              "column": "image_width"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "test/image_height",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-test"
            },
            "extract": {
              "column": "image_height"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "test/source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-test"
            },
            "extract": {
              "column": "source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "test/source_detail",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-test"
            },
            "extract": {
              "column": "source_detail"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "test/annotation_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-test"
            },
            "extract": {
              "column": "annotation_source"
            }
          }
