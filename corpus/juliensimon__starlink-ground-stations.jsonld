    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/juliensimon/starlink-ground-stations/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-gateways",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "gateways/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-pops",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "pops/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "gateways_splits/split_name"
      },
      "@id": "gateways_splits",
      "name": "gateways_splits",
      "description": "Splits for the gateways config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "gateways_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "gateways_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "gateways",
      "description": "juliensimon/starlink-ground-stations - 'gateways' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "gateways/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gateways"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "gateways/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "gateways_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gateways/name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gateways"
            },
            "extract": {
              "column": "name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gateways/lat",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gateways"
            },
            "extract": {
              "column": "lat"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gateways/lon",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gateways"
            },
            "extract": {
              "column": "lon"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gateways/status",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gateways"
            },
            "extract": {
              "column": "status"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "pops_splits/split_name"
      },
      "@id": "pops_splits",
      "name": "pops_splits",
      "description": "Splits for the pops config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pops_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "pops_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "pops",
      "description": "juliensimon/starlink-ground-stations - 'pops' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pops/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pops"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "pops/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "pops_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pops/code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pops"
            },
            "extract": {
              "column": "code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pops/city",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pops"
            },
            "extract": {
              "column": "city"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pops/country",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pops"
            },
            "extract": {
              "column": "country"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pops/lat",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pops"
            },
            "extract": {
              "column": "lat"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pops/lon",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pops"
            },
            "extract": {
              "column": "lon"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "starlink-ground-stations",
  "description": "Worldwide Starlink gateway and Point of Presence locations from FCC IBFS filings and Starlink Insider. Updated daily.",
  "alternateName": [
    "juliensimon/starlink-ground-stations",
    "Starlink Ground Stations & Points of Presence"
  ],
  "creator": {
    "@type": "Person",
    "name": "Julien Simon",
    "url": "https://huggingface.co/juliensimon"
  },
