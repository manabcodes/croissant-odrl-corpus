  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/QuixiAI/dolphin/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-flan1m-alpaca-uncensored",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "flan1m-alpaca-uncensored/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-flan5m-alpaca-uncensored",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "flan5m-alpaca-uncensored/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "flan1m-alpaca-uncensored_splits/split_name"
      },
      "@id": "flan1m-alpaca-uncensored_splits",
      "name": "flan1m-alpaca-uncensored_splits",
      "description": "Splits for the flan1m-alpaca-uncensored config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "flan1m-alpaca-uncensored_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "flan1m-alpaca-uncensored_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "flan1m-alpaca-uncensored",
      "description": "QuixiAI/dolphin - 'flan1m-alpaca-uncensored' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "flan1m-alpaca-uncensored/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flan1m-alpaca-uncensored"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "flan1m\\-alpaca\\-uncensored/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "flan1m-alpaca-uncensored_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flan1m-alpaca-uncensored/instruction",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flan1m-alpaca-uncensored"
            },
            "extract": {
              "column": "instruction"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flan1m-alpaca-uncensored/input",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flan1m-alpaca-uncensored"
            },
            "extract": {
              "column": "input"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flan1m-alpaca-uncensored/output",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flan1m-alpaca-uncensored"
            },
            "extract": {
              "column": "output"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "flan5m-alpaca-uncensored_splits/split_name"
      },
      "@id": "flan5m-alpaca-uncensored_splits",
      "name": "flan5m-alpaca-uncensored_splits",
      "description": "Splits for the flan5m-alpaca-uncensored config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "flan5m-alpaca-uncensored_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "flan5m-alpaca-uncensored_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "flan5m-alpaca-uncensored",
      "description": "QuixiAI/dolphin - 'flan5m-alpaca-uncensored' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "flan5m-alpaca-uncensored/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flan5m-alpaca-uncensored"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "flan5m\\-alpaca\\-uncensored/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "flan5m-alpaca-uncensored_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flan5m-alpaca-uncensored/instruction",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flan5m-alpaca-uncensored"
            },
            "extract": {
              "column": "instruction"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flan5m-alpaca-uncensored/input",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flan5m-alpaca-uncensored"
            },
            "extract": {
              "column": "input"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flan5m-alpaca-uncensored/output",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flan5m-alpaca-uncensored"
            },
            "extract": {
              "column": "output"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "dolphin",
  "description": "Dolphin \ud83d\udc2c\nhttps://erichartford.com/dolphin\n\n\t\n\t\t\n\t\tDataset details\n\t\n\nThis dataset is an attempt to replicate the results of Microsoft's Orca\nOur dataset consists of:\n\n~1 million of FLANv2 augmented with GPT-4 completions (flan1m-alpaca-uncensored.jsonl)\n~3.5 million of FLANv2 augmented with GPT-3.5 completions (flan5m-alpaca-uncensored.jsonl)\n\nWe followed the submix and system prompt distribution outlined in the Orca paper. With a few exceptions. We included all 75k of CoT in the FLAN-1m\u2026 See the full description on the dataset page: https://huggingface.co/datasets/QuixiAI/dolphin.",
  "alternateName": [
    "QuixiAI/dolphin"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Quixi AI",
    "url": "https://huggingface.co/QuixiAI"
  },
