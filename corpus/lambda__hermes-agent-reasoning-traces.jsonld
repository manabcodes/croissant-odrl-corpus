  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/lambda/hermes-agent-reasoning-traces/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-glm-5.1",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "glm-5.1/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-kimi",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "kimi/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "glm-5.1_splits/split_name"
      },
      "@id": "glm-5.1_splits",
      "name": "glm-5.1_splits",
      "description": "Splits for the glm-5.1 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "glm-5.1_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "glm-5.1_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "glm-5.1",
      "description": "lambda/hermes-agent-reasoning-traces - 'glm-5.1' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "glm-5.1/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-glm-5.1"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "glm\\-5\\.1/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "glm-5.1_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "glm-5.1/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-glm-5.1"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "glm-5.1/conversations",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "glm-5.1/conversations/from",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-glm-5.1"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "from"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "glm-5.1/conversations/value",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-glm-5.1"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "value"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "glm-5.1/tools",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-glm-5.1"
            },
            "extract": {
              "column": "tools"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "glm-5.1/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-glm-5.1"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "glm-5.1/subcategory",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-glm-5.1"
            },
            "extract": {
              "column": "subcategory"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "glm-5.1/task",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-glm-5.1"
            },
            "extract": {
              "column": "task"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "kimi_splits/split_name"
      },
      "@id": "kimi_splits",
      "name": "kimi_splits",
      "description": "Splits for the kimi config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "kimi_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "kimi_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "kimi",
      "description": "lambda/hermes-agent-reasoning-traces - 'kimi' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "kimi/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-kimi"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "kimi/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "kimi_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "kimi/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-kimi"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "kimi/conversations",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "kimi/conversations/from_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-kimi"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "from"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "kimi/conversations/value_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-kimi"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "value"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "kimi/tools",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-kimi"
            },
            "extract": {
              "column": "tools"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "kimi/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-kimi"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "kimi/subcategory",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-kimi"
            },
            "extract": {
              "column": "subcategory"
