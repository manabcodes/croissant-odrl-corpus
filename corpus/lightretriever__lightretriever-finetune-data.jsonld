  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "AllArxiv_clustering_splits/split_name"
      },
      "@id": "AllArxiv_clustering_splits",
      "name": "AllArxiv_clustering_splits",
      "description": "Splits for the AllArxiv_clustering config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "AllArxiv_clustering_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "AllArxiv_clustering_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "AllArxiv_clustering",
      "description": "lightretriever/lightretriever-finetune-data - 'AllArxiv_clustering' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "AllArxiv_clustering/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-AllArxiv_clustering"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "AllArxiv_clustering/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "AllArxiv_clustering_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "AllArxiv_clustering/query_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-AllArxiv_clustering"
            },
            "extract": {
              "column": "query_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "AllArxiv_clustering/query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-AllArxiv_clustering"
            },
            "extract": {
              "column": "query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "AllArxiv_clustering/positive_passages",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "AllArxiv_clustering/positive_passages/docid",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-AllArxiv_clustering"
                },
                "extract": {
                  "column": "positive_passages"
                },
                "transform": {
                  "jsonPath": "docid"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "AllArxiv_clustering/positive_passages/text",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-AllArxiv_clustering"
                },
                "extract": {
                  "column": "positive_passages"
                },
                "transform": {
                  "jsonPath": "text"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "AllArxiv_clustering/positive_passages/title",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-AllArxiv_clustering"
                },
                "extract": {
                  "column": "positive_passages"
                },
                "transform": {
                  "jsonPath": "title"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "AllArxiv_clustering/negative_passages",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "AllArxiv_clustering/negative_passages/docid_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-AllArxiv_clustering"
                },
                "extract": {
                  "column": "negative_passages"
                },
                "transform": {
                  "jsonPath": "docid"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "AllArxiv_clustering/negative_passages/text_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-AllArxiv_clustering"
                },
                "extract": {
