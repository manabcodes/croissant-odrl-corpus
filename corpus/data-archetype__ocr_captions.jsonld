  "recordSet": [],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "ocr_captions",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tOCR-Data Bucketed Captions\n\t\n\nThis dataset is a bucketed WebDataset-style export of\nYesianrohn/OCR-Data,\nwith images paired with concise English captions for text-to-image training.\nThe source dataset aggregates public OCR benchmarks with images, recognized\ntext, text-region bounding boxes, and polygon annotations. This export keeps the\nsource OCR metadata in the JSON sidecars and replaces the training captions with\nshort descriptions focused on the visible image content, readable\u2026 See the full description on the dataset page: https://huggingface.co/datasets/data-archetype/ocr_captions.",
  "alternateName": [
    "data-archetype/ocr_captions",
    "OCR-Data Bucketed Captions"
  ],
  "creator": {
    "@type": "Person",
    "name": "Data Archetype",
    "url": "https://huggingface.co/data-archetype"
  },
  "keywords": [
    "text-to-image",
    "image-to-text",
    "Yesianrohn/OCR-Data",
    "English",
    "Chinese",
    "apache-2.0",
