{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/agkphysics/AudioSet/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-balanced",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "balanced/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-full",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "full/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-unbalanced",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "unbalanced/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "balanced_splits/split_name"
      },
      "@id": "balanced_splits",
      "name": "balanced_splits",
      "description": "Splits for the balanced config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "balanced_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "balanced_splits/split_name": "train"
        },
        {
          "balanced_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "balanced",
      "description": "agkphysics/AudioSet - 'balanced' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "balanced/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-balanced"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "balanced/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "balanced_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "balanced/video_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-balanced"
            },
            "extract": {
              "column": "video_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "balanced/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-balanced"
            },
            "extract": {
              "column": "audio"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "balanced/labels",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-balanced"
            },
            "extract": {
              "column": "labels"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "balanced/human_labels",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-balanced"
            },
            "extract": {
              "column": "human_labels"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "full_splits/split_name"
      },
      "@id": "full_splits",
      "name": "full_splits",
      "description": "Splits for the full config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "full_splits/split_name": "bal_train"
        },
        {
          "full_splits/split_name": "unbal_train"
        },
        {
          "full_splits/split_name": "eval"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "full",
      "description": "agkphysics/AudioSet - 'full' subset\n\nAdditional information:\n- 3 splits: bal_train, unbal_train, eval",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "full/(?:partial-)?(bal_train|unbal_train|eval)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "full_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/video_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "video_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "audio"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/labels",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "labels"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "full/human_labels",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "human_labels"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "unbalanced_splits/split_name"
      },
      "@id": "unbalanced_splits",
      "name": "unbalanced_splits",
      "description": "Splits for the unbalanced config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "unbalanced_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "unbalanced_splits/split_name": "train"
        },
        {
          "unbalanced_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "unbalanced",
      "description": "agkphysics/AudioSet - 'unbalanced' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "unbalanced/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-unbalanced"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "unbalanced/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "unbalanced_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "unbalanced/video_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-unbalanced"
            },
            "extract": {
              "column": "video_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "unbalanced/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-unbalanced"
            },
            "extract": {
              "column": "audio"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "unbalanced/labels",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-unbalanced"
            },
            "extract": {
              "column": "labels"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "unbalanced/human_labels",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-unbalanced"
            },
            "extract": {
              "column": "human_labels"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "AudioSet",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tDataset Card for AudioSet\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Summary\n\t\n\nAudioSet is a dataset of 10-second clips from YouTube, annotated into one or more sound categories, following the AudioSet ontology.\n\n\t\n\t\t\n\t\n\t\n\t\tSupported Tasks and Leaderboards\n\t\n\n\naudio-classification: Classify audio clips into categories. The leaderboard is available here\n\n\n\t\n\t\t\n\t\n\t\n\t\tLanguages\n\t\n\nThe class labels in the dataset are in English.\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Structure\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tData Instances\n\t\n\nExample\u2026 See the full description on the dataset page: https://huggingface.co/datasets/agkphysics/AudioSet.",
  "alternateName": [
    "agkphysics/AudioSet",
    "AudioSet"
  ],
  "creator": {
    "@type": "Person",
    "name": "Aaron Keesing",
    "url": "https://huggingface.co/agkphysics"
  },
  "keywords": [
    "audio-classification",
    "original",
    "English",
    "cc-by-4.0",
    "1M - 10M",
    "parquet",
    "Audio",
