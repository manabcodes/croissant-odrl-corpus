  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/AaronZ345/MRSDrama/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-meta",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "meta/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "meta_splits/split_name"
      },
      "@id": "meta_splits",
      "name": "meta_splits",
      "description": "Splits for the meta config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "meta_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "meta_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "meta",
      "description": "AaronZ345/MRSDrama - 'meta' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "meta/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "meta/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "meta_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/item_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "item_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/start_time",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "start_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/end_time",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "end_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/raw_txt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "raw_txt"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "meta/ph",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "ph"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "meta/ph_dur",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "ph_dur"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "meta/geometric_pose_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "geometric_pose_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/wav_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "wav_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/textual_prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "textual_prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/scene_prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "scene_prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/camera_pos",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "camera_pos"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/video_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "video_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/speaker",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "speaker"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "MRSDrama",
  "identifier": "10.57967/hf/6012",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tISDrama: Immersive Spatial Drama Generation through Multimodal Prompting\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tYu Zhang*, Wenxiang Guo*, Changhao Pan*, Zhiyuan Zhu*, Tao Jin, Zhou Zhao | Zhejiang University\n\t\n\nDataset of ISDrama (ACMMM 2025): Immersive Spatial Drama Generation through Multimodal Prompting.\n \n\n\n\n\n\nWe construct MRSDrama, the first multimodal recorded spatial drama dataset, containing binaural drama audios, scripts, videos, geometric poses, and textual prompts.\nWe provide the full corpus\u2026 See the full description on the dataset page: https://huggingface.co/datasets/AaronZ345/MRSDrama.",
  "alternateName": [
    "AaronZ345/MRSDrama"
  ],
  "creator": {
    "@type": "Person",
    "name": "Yu Zhang",
    "url": "https://huggingface.co/AaronZ345"
  },
