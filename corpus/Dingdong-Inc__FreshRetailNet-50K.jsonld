    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Dingdong-Inc/FreshRetailNet-50K/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "eval"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "Dingdong-Inc/FreshRetailNet-50K - 'default' subset\n\nAdditional information:\n- 2 splits: train, eval",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|eval)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/city_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "city_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/store_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "store_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/management_group_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "management_group_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/first_category_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "first_category_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/second_category_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "second_category_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/third_category_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "third_category_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/product_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "product_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/dt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "dt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sale_amount",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sale_amount"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/hours_sale",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "hours_sale"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/stock_hour6_22_cnt",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "stock_hour6_22_cnt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/hours_stock_status",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "hours_stock_status"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/discount",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "discount"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/holiday_flag",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "holiday_flag"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/activity_flag",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "activity_flag"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/precpt",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "precpt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/avg_temperature",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "avg_temperature"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/avg_humidity",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "avg_humidity"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/avg_wind_level",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "avg_wind_level"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "FreshRetailNet-50K",
  "description": "\n\t\n\t\t\n\t\tFreshRetailNet-50K\n\t\n\n\n\t\n\t\t\n\t\tDataset Overview\n\t\n\nFreshRetailNet-50K is the first large-scale benchmark for censored demand estimation in the fresh retail domain, incorporating approximately 20% organically occurring stockout data. It comprises 50,000 store-product 90-day time series of detailed hourly sales data from 898 stores in 18 major cities, encompassing 865 perishable SKUs with meticulous stockout event annotations. The hourly stock status records unique to this dataset\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Dingdong-Inc/FreshRetailNet-50K.",
  "alternateName": [
    "Dingdong-Inc/FreshRetailNet-50K",
    "FreshRetailNet-50K"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Dingdong Limited",
    "url": "https://huggingface.co/Dingdong-Inc"
  },
  "keywords": [
    "time-series-forecasting",
    "English",
