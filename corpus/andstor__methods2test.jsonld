        }
      ],
      "data": [
        {
          "fm_splits/split_name": "train"
        },
        {
          "fm_splits/split_name": "test"
        },
        {
          "fm_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "fm",
      "name": "fm",
      "description": "andstor/methods2test - 'fm' subset\n\nAdditional information:\n- 3 splits: train, test, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "fm/split",
          "name": "fm/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fm"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "fm/(?:partial-)?(train|test|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "fm_splits/split_name"
            }
