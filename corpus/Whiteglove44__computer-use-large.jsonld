      },
      "encodingFormat": "application/x-parquet",
      "includes": "photoshop/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-salesforce",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "salesforce/*/*.parquet"
    }
