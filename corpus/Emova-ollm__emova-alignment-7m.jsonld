  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "emova-alignment-7m",
  "description": "\n\t\n\t\t\n\t\tEMOVA-Alignment-7M\n\t\n\n\n\n\n\ud83e\udd17 EMOVA-Models | \ud83e\udd17 EMOVA-Datasets | \ud83e\udd17 EMOVA-Demo \n\ud83d\udcc4 Paper | \ud83c\udf10 Project-Page | \ud83d\udcbb Github | \ud83d\udcbb EMOVA-Speech-Tokenizer-Github\n\n\n\n\n\t\n\t\n\t\n\t\tOverview\n\t\n\nEMOVA-Alignment-7M is a comprehensive dataset curated for omni-modal pre-training, including vision-language and speech-language alignment. \nThis dataset is created using open-sourced image-text pre-training datasets, OCR datasets, and 2,000 hours of ASR and TTS data. \nThis dataset is part of the EMOVA-Datasets\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Emova-ollm/emova-alignment-7m.",
  "alternateName": [
    "Emova-ollm/emova-alignment-7m"
  ],
  "creator": {
    "@type": "Organization",
    "name": "EMOVA Hugging Face",
    "url": "https://huggingface.co/Emova-ollm"
  },
  "keywords": [
    "image-to-text",
    "text-generation",
    "audio-to-audio",
    "automatic-speech-recognition",
    "text-to-speech",
    "English",
    "Chinese",
    "apache-2.0",
    "1M - 10M",
    "parquet",
