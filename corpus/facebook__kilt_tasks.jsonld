  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "nq_splits/split_name"
      },
      "@id": "nq_splits",
      "name": "nq_splits",
      "description": "Splits for the nq config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "nq_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "nq_splits/split_name": "train"
        },
        {
          "nq_splits/split_name": "validation"
        },
        {
          "nq_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "nq",
      "name": "nq",
      "description": "facebook/kilt_tasks - 'nq' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "nq/split",
          "name": "nq/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-nq"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "nq/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "nq_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "nq/id",
