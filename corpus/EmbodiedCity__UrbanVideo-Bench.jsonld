{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/EmbodiedCity/UrbanVideo-Bench/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-benchmark",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "benchmark/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "benchmark_splits/split_name"
      },
      "@id": "benchmark_splits",
      "name": "benchmark_splits",
      "description": "Splits for the benchmark config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "benchmark_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "benchmark",
      "description": "EmbodiedCity/UrbanVideo-Bench - 'benchmark' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "benchmark/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "benchmark_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/Question_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "Question_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/video_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "video_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/question_category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "question_category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "answer"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "UrbanVideo-Bench",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\t[ACL'25 Oral] UrbanVideo-Bench: Benchmarking Vision-Language Models on Embodied Intelligence with Video Data in Urban Spaces\n\t\n\nThis repository contains the dataset introduced in the paper, consisting of two parts: 5k+ multiple-choice question-answering (MCQ) data and 1k+ video clips.\n\nArxiv: https://arxiv.org/pdf/2503.06157\nProject: https://embodiedcity.github.io/UrbanVideo-Bench/\nCode: https://github.com/EmbodiedCity/UrbanVideo-Bench.code\n\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Description\n\t\n\nThe\u2026 See the full description on the dataset page: https://huggingface.co/datasets/EmbodiedCity/UrbanVideo-Bench.",
  "alternateName": [
    "EmbodiedCity/UrbanVideo-Bench"
  ],
  "creator": {
    "@type": "Organization",
    "name": "EmbodiedCity",
    "url": "https://huggingface.co/EmbodiedCity"
  },
  "keywords": [
    "visual-question-answering",
    "English",
    "mit",
    "1K - 10K",
    "parquet",
    "Text",
    "Video",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2503.06157",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "Video",
    "Text",
    "Embodied"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/EmbodiedCity/UrbanVideo-Bench",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "MIT License",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}