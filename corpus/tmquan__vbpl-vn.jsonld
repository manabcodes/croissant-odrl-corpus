  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/tmquan/vbpl-vn/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-documents",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "documents/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "documents_splits/split_name"
      },
      "@id": "documents_splits",
      "name": "documents_splits",
      "description": "Splits for the documents config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "documents_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "documents_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "documents",
      "description": "tmquan/vbpl-vn - 'documents' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "documents/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-documents"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "documents/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "documents_splits/split_name"
            }
          }
        },
        {
