    {
      "@type": "cr:RecordSet",
      "@id": "amazon_counterfactual_classification",
      "description": "sbintuitions/JMTEB - 'amazon_counterfactual_classification' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "amazon_counterfactual_classification/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amazon_counterfactual_classification"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "amazon_counterfactual_classification/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "amazon_counterfactual_classification_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
