{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/NODEMIND/shadow-o-tokens-20b/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "NODEMIND/shadow-o-tokens-20b - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/array_sha256",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "array_sha256"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/blocks",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "blocks"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/context_length",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "context_length"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/created_unix",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "created_unix"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/dtype",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "dtype"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/folder",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "folder"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/schema_version",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "schema_version"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/source/datasets",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "source"
                },
                "transform": {
                  "jsonPath": "datasets"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "default/source/kind",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "source"
                },
                "transform": {
                  "jsonPath": "kind"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/source/sealed_eval_splits",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "source"
                },
                "transform": {
                  "jsonPath": "sealed_eval_splits"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/tokenizer_identity",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/tokenizer_identity/id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "tokenizer_identity"
                },
                "transform": {
                  "jsonPath": "id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/tokenizer_identity/revision",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "tokenizer_identity"
                },
                "transform": {
                  "jsonPath": "revision"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/tokenizer_identity/tokenizer_json_sha256",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "tokenizer_identity"
                },
                "transform": {
                  "jsonPath": "tokenizer_json_sha256"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/tokenizer_identity/vocab_size",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "tokenizer_identity"
                },
                "transform": {
                  "jsonPath": "vocab_size"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/tokens",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "tokens"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "shadow-o-tokens-20b",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tSHADOW-O OLMo-2 top-16 logits\n\t\n\nSparse next-token teacher logits for training the 252.8M SHADOW-O student.\n\nTeacher: allenai/OLMo-2-0425-1B\nToken ID space: AI2 Dolma/OLMo, first 100,278 IDs\nContext length: 2,048\nStored per token: input uint32, top-16 IDs uint32, top-16 logits float16\nPlanned size: 20B tokens, approximately 2.0 TB\nCapture code: 10_distill/capture_logits.py in the SHADOW-O workspace\n\nEach logical shard contains three files with the same base name:\n\n*.tok.npy: input\u2026 See the full description on the dataset page: https://huggingface.co/datasets/NODEMIND/shadow-o-tokens-20b.",
  "alternateName": [
    "NODEMIND/shadow-o-tokens-20b",
    "SHADOW-O OLMo-2 Top-16 Logits (20B)"
  ],
  "creator": {
    "@type": "Person",
    "name": "Sai kiran",
    "url": "https://huggingface.co/NODEMIND"
  },
  "keywords": [
    "text-generation",
    "English",
    "odc-by",
    "< 1K",
    "Tabular",
    "Text",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
