  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "bps_splits/split_name"
      },
      "@id": "bps_splits",
      "name": "bps_splits",
      "description": "Splits for the bps config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bps_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "bps_splits/split_name": "train"
        },
        {
          "bps_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "bps",
      "name": "bps",
      "description": "MERA-evaluation/MERA - 'bps' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bps/split",
          "name": "bps/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bps"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "bps/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "bps_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bps/instruction",
          "name": "bps/instruction",
          "description": "Column 'instruction' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bps"
            },
            "extract": {
              "column": "instruction"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bps/inputs",
          "name": "bps/inputs",
          "description": "Column 'inputs' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bps"
            },
            "extract": {
              "column": "inputs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bps/outputs",
          "name": "bps/outputs",
          "description": "Column 'outputs' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bps"
            },
            "extract": {
              "column": "outputs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bps/meta",
          "name": "bps/meta",
          "description": "Column 'meta' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "bps/meta/id",
              "name": "bps/meta/id",
              "description": "Column 'meta' from the Hugging Face parquet file.",
              "dataType": "sc:Integer",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-bps"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "id"
                }
              }
            }
          ]
        }
      ]
