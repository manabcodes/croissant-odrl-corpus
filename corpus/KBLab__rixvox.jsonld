  "@type": "Dataset",
  "name": "rixvox",
  "description": "RixVox is a speech dataset comprised of speeches from the Swedish Parliament (the Riksdag). Audio from speeches have been aligned with official transcripts, on the sentence level, using aeneas. \nSpeaker metadata is available for each observation, including the speaker's name, gender, party, birth year and electoral district. The dataset contains a total of 5493 hours of speech. \nAn observation may consist of one or several sentences (up to 30 seconds in duration).",
  "alternateName": [
    "KBLab/rixvox"
  ],
  "creator": {
    "@type": "Organization",
    "name": "National Library of Sweden / KBLab",
    "url": "https://huggingface.co/KBLab"
  },
