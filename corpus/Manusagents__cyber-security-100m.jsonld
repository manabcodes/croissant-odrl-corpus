      "@id": "signals_splits",
      "name": "signals_splits",
      "description": "Splits for the signals config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "signals_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "signals_splits/split_name": "train"
        }
      ]
