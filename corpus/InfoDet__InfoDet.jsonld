{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/InfoDet/InfoDet/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-preview",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "preview/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "preview_splits/split_name"
      },
      "@id": "preview_splits",
      "name": "preview_splits",
      "description": "Splits for the preview config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "preview_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "preview_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "preview",
      "description": "InfoDet/InfoDet - 'preview' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "preview/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "preview/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "preview_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/image_with_bbox",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "image_with_bbox"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/image_id",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "image_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/file_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "file_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/width",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "width"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/height",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "height"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/is_test",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "is_test"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/num_objects",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "num_objects"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/categories",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "categories"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "preview/subcategories",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "subcategories"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "InfoDet",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tInfoDet: A Dataset for Infographic Element Detection\n\t\n\n\ud83e\udd17 Dataset | \ud83d\udda5\ufe0f Code | \ud83d\udcc4 Paper | \ud83d\udcc4 Arxiv\n\n\t\n\t\t\n\t\n\t\n\t\t\ud83d\udd25 News\n\t\n\n\n[2026.2] \ud83c\udf89\ud83c\udf89 InfoDet has been accepted by ICLR 2026!\n[2025.11] \ud83c\udf89\ud83c\udf89 We have released the first version of our dataset, which includes 11,264 real and 90,000 synthetic infographic charts, with 14,227,680 bounding box annotations.\n\n\n\t\n\t\t\n\t\n\t\n\t\t\u2728 Dataset Description\n\t\n\nInfoDet is a dataset designed to support the development of accurate object detection models\u2026 See the full description on the dataset page: https://huggingface.co/datasets/InfoDet/InfoDet.",
  "alternateName": [
    "InfoDet/InfoDet"
  ],
  "creator": {
    "@type": "Person",
    "name": "InfoDet",
    "url": "https://huggingface.co/InfoDet"
  },
  "keywords": [
    "object-detection",
    "English",
    "cc-by-nc-4.0",
    "< 1K",
    "parquet",
    "optimized-parquet",
    "Image",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2505.17473",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "infographic",
    "chart",
    "object-detection",
    "graphic design"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-nc-4.0/",
  "url": "https://huggingface.co/datasets/InfoDet/InfoDet",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY-NC 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:prohibition": {
      "@type": "odrl:Prohibition",
      "odrl:action": {
        "@id": "odrl:commercialize"
      }
    },
    "odrl:duty": {
