  "recordSet": [],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "GenECG",
  "description": "GenECG is an image-based ECG dataset which has been created from the PTB-XL dataset (https://physionet.org/content/ptb-xl/1.0.3/).\nThe PTB-XL dataset is a signal-based ECG dataset comprising 21799 unique ECGs.\nGenECG is divided into the following subsets:\n-Dataset A: ECGs without imperfections (Dataset_A_ECGs_without_imperfections) - This subset includes 21799 ECG images that have been generated directly from the original PTB-XL recordings, free from any visual imperfections.\n-Dataset B: ECGs\u2026 See the full description on the dataset page: https://huggingface.co/datasets/edcci/GenECG.",
  "alternateName": [
    "edcci/GenECG"
  ],
