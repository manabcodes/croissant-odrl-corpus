    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-pov_rounds",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "pov_rounds/*/*.parquet"
    },
    {
