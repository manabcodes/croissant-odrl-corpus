              "@id": "parquet-files-for-config-Lottie"
            },
            "extract": {
              "column": "motion_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Lottie/motion_caption",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Lottie"
            },
            "extract": {
              "column": "motion_caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Lottie/lottie_json",
          "dataType": "sc:Text",
          "source": {
