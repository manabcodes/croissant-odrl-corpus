          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Lottie"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Lottie/video",
          "dataType": "sc:VideoObject",
          "source": {
