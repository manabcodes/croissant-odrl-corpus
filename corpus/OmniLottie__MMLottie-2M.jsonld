  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/OmniLottie/MMLottie-2M/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Lottie",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Lottie/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Lottie_SVG",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Lottie_SVG/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Lottie_splits/split_name"
      },
      "@id": "Lottie_splits",
      "name": "Lottie_splits",
      "description": "Splits for the Lottie config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Lottie_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Lottie_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
