    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/DBWBD/Chinese_Debate_Documents/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "DBWBD/Chinese_Debate_Documents - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_collection",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_collection"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_format",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_format"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/topic",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "topic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/round",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "round"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/team_a",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "team_a"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/team_b",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "team_b"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_segments",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_segments"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_chars",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_chars"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/transcript",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "transcript"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/segments",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/segments/speaker_id",
              "dataType": "cr:Int32",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "segments"
                },
                "transform": {
                  "jsonPath": "speaker_id"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "default/segments/timestamp",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "segments"
                },
                "transform": {
                  "jsonPath": "timestamp"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "default/segments/text",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "segments"
                },
                "transform": {
                  "jsonPath": "text"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Chinese_Debate_Documents",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tDataset Card for Chinese Debate Documents\n\t\n\n\nASR-transcribed corpus of competitive Mandarin Chinese university debates,\nspeaker-segmented and timestamped, with topic / round / team metadata parsed\nfrom the source filenames.\n\n\n\t\n\t\t\n\t\n\t\n\t\tLoading the Dataset\n\t\n\nfrom datasets import load_dataset\n\nds = load_dataset(\"DBWBD/Chinese_Debate_Documents\", split=\"train\")\nprint(ds[0][\"topic\"], \"\u2014\", ds[0][\"team_a\"], \"vs\", ds[0][\"team_b\"])\nfor seg in ds[0][\"segments\"][:3]:\n    print(f\"\u2026 See the full description on the dataset page: https://huggingface.co/datasets/DBWBD/Chinese_Debate_Documents.",
  "alternateName": [
    "DBWBD/Chinese_Debate_Documents",
    "Chinese Debate Documents"
  ],
  "creator": {
    "@type": "Person",
    "name": "Brian Deng",
    "url": "https://huggingface.co/DBWBD"
  },
