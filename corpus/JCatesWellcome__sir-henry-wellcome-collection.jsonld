    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/JCatesWellcome/sir-henry-wellcome-collection/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "JCatesWellcome/sir-henry-wellcome-collection - 'default' subset\n\nAdditional information:\n- 1 skipped column: iiif_manifest",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/object_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "object_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/description",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "description"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/raw_smg_data",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "raw_smg_data"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/catalogue_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "catalogue_url"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "sir-henry-wellcome-collection",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tSir Henry Wellcome's Museum Collection (Science Museum Group)\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Description\n\t\n\nThis dataset contains images and metadata for objects in the Sir Henry Wellcome's Museum Collection, which has been on loan to the Science Museum Group (SMG) since 1976. American-born pharmacist and philanthropist Sir Henry Wellcome assembled historical objects relating to the history of medicine from around the world.\n\n\t\n\t\t\n\t\n\t\n\t\tData Structure\n\t\n\nThis dataset is formatted as a\u2026 See the full description on the dataset page: https://huggingface.co/datasets/JCatesWellcome/sir-henry-wellcome-collection.",
  "alternateName": [
    "JCatesWellcome/sir-henry-wellcome-collection"
  ],
  "creator": {
    "@type": "Person",
    "name": "Jonathan Cates",
    "url": "https://huggingface.co/JCatesWellcome"
  },
  "keywords": [
    "image-classification",
    "English",
    "cc-by-nc-sa-4.0",
    "10K - 100K",
    "imagefolder",
    "Image",
    "Text",
    "Datasets",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "museum",
    "medical-history",
    "science-museum-group",
    "wellcome-collection",
    "cultural-heritage"
  ],
