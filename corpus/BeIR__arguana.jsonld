{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/BeIR/arguana/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-corpus",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "corpus/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-queries",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "queries/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "corpus_splits/split_name"
      },
      "@id": "corpus_splits",
      "name": "corpus_splits",
      "description": "Splits for the corpus config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "corpus_splits/split_name": "corpus"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "corpus",
      "description": "BeIR/arguana - 'corpus' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "corpus/(?:partial-)?(corpus)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "corpus_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "queries_splits/split_name"
      },
      "@id": "queries_splits",
      "name": "queries_splits",
      "description": "Splits for the queries config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "queries_splits/split_name": "queries"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "queries",
      "description": "BeIR/arguana - 'queries' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "queries/(?:partial-)?(queries)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "queries_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "arguana",
  "description": "\n\t\n\t\t\n\t\tDataset Card for BEIR Benchmark\n\t\n\n\narguana is one of the datasets from the Argument Retrieval task within BEIR, evaluating retrieving counterarguments for a given argument as query.\nNOTE: ArguAna has queries also incorporated within the corpus, so you should remove the same query_id if present within corpus during inference (implemented in BEIR)\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nBEIR is a heterogeneous benchmark built from 18 diverse datasets representing 9 information retrieval tasks.\u2026 See the full description on the dataset page: https://huggingface.co/datasets/BeIR/arguana.",
  "alternateName": [
    "BeIR/arguana",
    "BEIR Benchmark"
  ],
  "creator": {
    "@type": "Organization",
    "name": "BEIR",
    "url": "https://huggingface.co/BeIR"
  },
  "keywords": [
    "zero-shot-classification",
    "text-retrieval",
    "document-retrieval",
    "entity-linking-retrieval",
    "fact-checking-retrieval",
    "monolingual",
    "English",
    "cc-by-sa-4.0",
    "10K - 100K",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "biomedical-information-retrieval",
    "citation-prediction-retrieval",
    "passage-retrieval",
    "news-retrieval",
    "argument-retrieval",
    "zero-shot-information-retrieval",
    "tweet-retrieval",
    "question-answering-retrieval",
    "duplication-question-retrieval",
    "zero-shot-retrieval"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-sa-4.0/",
  "sameAs": "https://beir.ai",
  "url": "https://huggingface.co/datasets/BeIR/arguana",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY-SA 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
