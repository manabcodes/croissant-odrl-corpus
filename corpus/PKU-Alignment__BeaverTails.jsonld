          "name": "default/category",
          "description": "Column 'category' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/category/animal_abuse",
              "name": "default/category/animal_abuse",
              "description": "Column 'category' from the Hugging Face parquet file.",
