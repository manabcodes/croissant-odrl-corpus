            "fileSet": {
              "@id": "parquet-files-for-config-attack_meta"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "attack_meta/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
