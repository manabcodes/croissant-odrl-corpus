    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/piebro/deutsche-bahn-data/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "piebro/deutsche-bahn-data - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/station_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "station_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/xml_station_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "xml_station_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/eva",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "eva"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/train_number",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "train_number"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/line_number",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "line_number"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/final_destination_station",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "final_destination_station"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/delay_in_min",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "delay_in_min"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/arrival_is_canceled",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "arrival_is_canceled"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/departure_is_canceled",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "departure_is_canceled"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/train_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "train_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/train_line_ride_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "train_line_ride_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/train_line_station_num",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "train_line_station_num"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/arrival_planned_time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "arrival_planned_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/arrival_change_time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "arrival_change_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/departure_planned_time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "departure_planned_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/departure_change_time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "departure_change_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "deutsche-bahn-data",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tDeutsche Bahn Train Data\n\t\n\nThis dataset contains public historical data from Deutsche Bahn, the largest German train company. It includes train schedules, delays, and cancellations from stations across Germany.\nFor more info visit the project page at GitHub: https://github.com/piebro/deutsche-bahn-data\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Structure\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tMonthly Processed Data\n\t\n\nThe monthly processed data is located in monthly_processed_data/ and contains files named\u2026 See the full description on the dataset page: https://huggingface.co/datasets/piebro/deutsche-bahn-data.",
  "alternateName": [
    "piebro/deutsche-bahn-data",
    "Deutsche Bahn Data"
  ],
  "creator": {
    "@type": "Person",
    "name": "Piet",
    "url": "https://huggingface.co/piebro"
  },
  "keywords": [
    "time-series-forecasting",
    "tabular-regression",
    "cc-by-4.0",
    "100M - 1B",
    "parquet",
    "Tabular",
    "Text",
