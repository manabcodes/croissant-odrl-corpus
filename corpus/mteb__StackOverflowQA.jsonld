{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/mteb/StackOverflowQA/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-corpus",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "corpus/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-qrels",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "qrels/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-queries",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "queries/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "corpus_splits/split_name"
      },
      "@id": "corpus_splits",
      "name": "corpus_splits",
      "description": "Splits for the corpus config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "corpus_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "corpus",
      "description": "mteb/StackOverflowQA - 'corpus' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "corpus/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "corpus_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "title"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "qrels_splits/split_name"
      },
      "@id": "qrels_splits",
      "name": "qrels_splits",
      "description": "Splits for the qrels config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qrels_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "qrels_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "qrels",
      "description": "mteb/StackOverflowQA - 'qrels' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qrels/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "qrels/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "qrels_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qrels/query-id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "column": "query-id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qrels/corpus-id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "column": "corpus-id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qrels/score",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "column": "score"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "queries_splits/split_name"
      },
      "@id": "queries_splits",
      "name": "queries_splits",
      "description": "Splits for the queries config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "queries_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "queries",
      "description": "mteb/StackOverflowQA - 'queries' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "queries/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "queries_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "StackOverflowQA",
  "description": "\n  StackOverflowQA\n  An MTEB dataset\n  Massive Text Embedding Benchmark\n\n\nThe dataset is a collection of natural language queries and their corresponding response which may include some text mixed with code snippets. The task is to retrieve the most relevant response for a given query.\n\n\t\n\t\t\n\n\n\n\n\t\t\nTask category\nt2t\n\n\nDomains\nProgramming, Written\n\n\nReference\nhttps://arxiv.org/abs/2407.02883\n\n\n\t\n\n\n\t\n\t\t\n\t\tHow to evaluate on this task\n\t\n\nYou can evaluate an embedding model on this dataset using\u2026 See the full description on the dataset page: https://huggingface.co/datasets/mteb/StackOverflowQA.",
  "alternateName": [
    "mteb/StackOverflowQA"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Massive Text Embedding Benchmark",
    "url": "https://huggingface.co/mteb"
  },
  "keywords": [
    "text-retrieval",
    "derived",
    "monolingual",
    "CoIR-Retrieval/stackoverflow-qa",
    "English",
    "mit",
    "10K - 100K",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "arxiv:2407.02883",
    "arxiv:2502.13595",
    "arxiv:2210.07316",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "mteb",
    "text"
  ],
