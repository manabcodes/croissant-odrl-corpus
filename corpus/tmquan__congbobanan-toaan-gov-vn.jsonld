    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-reduce",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "reduce/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-sentences",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "sentences/*/*.parquet"
    }
  ],
