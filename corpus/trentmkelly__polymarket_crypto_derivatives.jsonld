  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "polymarket_crypto_derivatives",
  "description": "\n\t\n\t\t\n\t\tPolymarket Crypto Derivatives Order Book Data\n\t\n\nThis dataset contains high-frequency Polymarket crypto \"Up or Down\" derivative market data for BTC, ETH, SOL, and XRP markets.\nThe collection currently spans 2026-02-21 15:45:00 UTC through 2026-03-24 20:05:00 UTC. It covers 5-minute and 15-minute Polymarket interval markets, with decision snapshots collected at approximately 100 ms cadence.\n\n\t\n\t\t\n\t\tFormat\n\t\n\nData is uploaded as Zstandard-compressed Parquet, converted from the project's\u2026 See the full description on the dataset page: https://huggingface.co/datasets/trentmkelly/polymarket_crypto_derivatives.",
  "alternateName": [
    "trentmkelly/polymarket_crypto_derivatives",
    "Polymarket Crypto Derivatives Order Book Data"
  ],
  "creator": {
    "@type": "Person",
    "name": "Trent Kelly",
    "url": "https://huggingface.co/trentmkelly"
  },
