  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/InternVL-U/ScaleEdit-12M/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "InternVL-U/ScaleEdit-12M - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edit_task",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "edit_task"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edit_instruction",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "edit_instruction"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_image",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_image"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_image_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_image_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_image_sha256",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_image_sha256"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_image_fetch_date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_image_fetch_date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edited_image",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "edited_image"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_image_width",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_image_width"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_image_height",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_image_height"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edited_image_width",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "edited_image_width"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edited_image_height",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "edited_image_height"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/instruction_following_score",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "instruction_following_score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/editing_consistency_score",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "editing_consistency_score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/generation_quality_score",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "generation_quality_score"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "ScaleEdit-12M",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tScaleEdit-12M: Scaling Open-Source Image Editing Data Generation via Multi-Agent Framework\n\t\n\n\n\n&nbsp;\n&nbsp;\n&nbsp;\n\n\n\n\t\n\t\t\n\t\n\t\n\t\t\ud83d\udccc Overview\n\t\n\nThe largest open-source instruction-based image editing dataset to date.\nScaleEdit-12M contains 11.8 million rigorously verified instruction\u2013image pairs spanning 23 task families across diverse real and synthetic visual domains. It was constructed using ScaleEditor, a fully open-source hierarchical multi-agent framework that eliminates\u2026 See the full description on the dataset page: https://huggingface.co/datasets/InternVL-U/ScaleEdit-12M.",
  "alternateName": [
    "InternVL-U/ScaleEdit-12M"
  ],
  "creator": {
    "@type": "Organization",
    "name": "InternVL-U",
    "url": "https://huggingface.co/InternVL-U"
  },
