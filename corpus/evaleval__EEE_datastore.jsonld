    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "BountyBench_splits/split_name"
      },
      "@id": "BountyBench_splits",
      "name": "BountyBench_splits",
      "description": "Splits for the BountyBench config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "BountyBench_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "BountyBench_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "BountyBench",
      "description": "evaleval/EEE_datastore - 'BountyBench' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "BountyBench/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-BountyBench"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "BountyBench/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "BountyBench_splits/split_name"
            }
          }
        },
