        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "segmentation/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-text_cot",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "text_cot/*/*.parquet"
    }
