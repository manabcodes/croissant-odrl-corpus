{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/bowen-upenn/PersonaMem-v1/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-benchmark",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "benchmark/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "benchmark_splits/split_name"
      },
      "@id": "benchmark_splits",
      "name": "benchmark_splits",
      "description": "Splits for the benchmark config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "benchmark_splits/split_name": "32k"
        },
        {
          "benchmark_splits/split_name": "128k"
        },
        {
          "benchmark_splits/split_name": "1M"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "benchmark",
      "description": "bowen-upenn/PersonaMem-v1 - 'benchmark' subset\n\nAdditional information:\n- 3 splits: 32k, 128k, 1M",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "benchmark/(?:partial-)?(32k|128k|1M)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "benchmark_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/persona_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "persona_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/question_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "question_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/question_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "question_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/topic",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "topic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/context_length_in_tokens",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "context_length_in_tokens"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/context_length_in_letters",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "context_length_in_letters"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/distance_to_ref_in_blocks",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "distance_to_ref_in_blocks"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/distance_to_ref_in_tokens",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "distance_to_ref_in_tokens"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/num_irrelevant_tokens",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "num_irrelevant_tokens"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/distance_to_ref_proportion_in_context",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "distance_to_ref_proportion_in_context"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/user_question_or_message",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "user_question_or_message"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/correct_answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "correct_answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/all_options",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "all_options"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/shared_context_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "shared_context_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/end_index_in_shared_context",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark"
            },
            "extract": {
              "column": "end_index_in_shared_context"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "PersonaMem-v1",
  "description": "\ud83d\udea8 We have now released PersonaMem-v3 and PersonaMem-v2.\nThis is the official Huggingface repository of the paper Know Me, Respond to Me: Benchmarking LLMs for Dynamic User Profiling and Personalized Responses at Scale and the PersonaMem benchmark.\nWe present PersonaMem, a new LLM personalization benchmark to assess how well language models can infer evolving user profiles and generate personalized responses across task scenarios. PersonaMem emphasizes persona-oriented, multi-session\u2026 See the full description on the dataset page: https://huggingface.co/datasets/bowen-upenn/PersonaMem-v1.",
  "alternateName": [
    "bowen-upenn/PersonaMem-v1",
    "PersonaMem"
  ],
  "creator": {
    "@type": "Person",
    "name": "Lauren Jiang",
    "url": "https://huggingface.co/bowen-upenn"
  },
  "keywords": [
    "text-generation",
    "question-answering",
    "English",
    "mit",
    "1K - 10K",
    "csv",
    "Tabular",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2504.14225",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "personalization",
    "preference",
    "chatbot",
    "memory",
    "long-context",
    "alignment",
    "persona",
    "benchmark"
  ],
