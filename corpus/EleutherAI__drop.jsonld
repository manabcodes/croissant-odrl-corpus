{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/EleutherAI/drop/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "EleutherAI/drop - 'default' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/section_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "section_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/passage",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "passage"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/query_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "query_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/answer",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/answer/number",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "answer"
                },
                "transform": {
                  "jsonPath": "number"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/answer/date",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/answer/date/day",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "answer"
                    },
                    "transform": {
                      "jsonPath": "day"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/answer/date/month",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "answer"
                    },
                    "transform": {
                      "jsonPath": "month"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/answer/date/year",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "answer"
                    },
                    "transform": {
                      "jsonPath": "year"
                    }
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/answer/spans",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "answer"
                }
              },
              "repeated": true
            },
            {
              "@type": "cr:Field",
              "@id": "default/answer/worker_id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "answer"
                },
                "transform": {
                  "jsonPath": "worker_id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/answer/hit_id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "answer"
                },
                "transform": {
                  "jsonPath": "hit_id"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/validated_answers",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/validated_answers/number",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "validated_answers"
                },
                "transform": {
                  "jsonPath": "number"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/validated_answers/date",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/validated_answers/date/day",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "validated_answers"
                    },
                    "transform": {
                      "jsonPath": "day"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/validated_answers/date/month",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "validated_answers"
                    },
                    "transform": {
                      "jsonPath": "month"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/validated_answers/date/year",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "validated_answers"
                    },
                    "transform": {
                      "jsonPath": "year"
                    }
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/validated_answers/spans",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "validated_answers"
                }
              },
              "repeated": true
            },
            {
              "@type": "cr:Field",
              "@id": "default/validated_answers/worker_id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "validated_answers"
                },
                "transform": {
                  "jsonPath": "worker_id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/validated_answers/hit_id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "validated_answers"
                },
                "transform": {
                  "jsonPath": "hit_id"
                }
              }
            }
          ],
          "repeated": true
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "drop",
  "description": "EleutherAI/drop dataset hosted on Hugging Face and contributed by the HF Datasets community",
  "alternateName": [
    "EleutherAI/drop"
  ],
  "creator": {
    "@type": "Organization",
    "name": "EleutherAI",
    "url": "https://huggingface.co/EleutherAI"
  },
  "keywords": [
    "cc-by-4.0",
    "10K - 100K",
    "parquet",
