  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "captioning_IF-flickr30k_splits/split_name"
      },
      "@id": "captioning_IF-flickr30k_splits",
      "name": "captioning_IF-flickr30k_splits",
      "description": "Splits for the captioning_IF-flickr30k config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "captioning_IF-flickr30k_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "captioning_IF-flickr30k_splits/split_name": "train"
        },
        {
          "captioning_IF-flickr30k_splits/split_name": "val"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "captioning_IF-flickr30k",
      "description": "zlab-princeton/Vero-600k - 'captioning_IF-flickr30k' subset\n\nAdditional information:\n- 2 splits: train, val",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "captioning_IF-flickr30k/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-captioning_IF-flickr30k"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "captioning_IF\\-flickr30k/(?:partial-)?(train|val)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "captioning_IF-flickr30k_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "captioning_IF-flickr30k/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-captioning_IF-flickr30k"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "captioning_IF-flickr30k/data_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-captioning_IF-flickr30k"
            },
            "extract": {
              "column": "data_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "captioning_IF-flickr30k/prompt",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "captioning_IF-flickr30k/prompt/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-captioning_IF-flickr30k"
                },
                "extract": {
                  "column": "prompt"
                },
                "transform": {
                  "jsonPath": "role"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "captioning_IF-flickr30k/prompt/content",
              "dataType": "sc:Text",
