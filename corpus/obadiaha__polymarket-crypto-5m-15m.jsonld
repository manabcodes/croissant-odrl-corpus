  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/obadiaha/polymarket-crypto-5m-15m/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "obadiaha/polymarket-crypto-5m-15m - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/timestamp",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "timestamp"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/asset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "asset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/open",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "open"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/high",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "high"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/low",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "low"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/close",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "close"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/volume",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/trade_count",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "trade_count"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "polymarket-crypto-5m-15m",
  "description": "\n\t\n\t\t\n\t\tPolymarket Crypto 5-Minute & 15-Minute Market Data\n\t\n\nHigh-frequency data from Polymarket's crypto up/down prediction markets. Covers BTC, ETH, SOL, XRP across 5-minute and 15-minute windows.\nUpdated daily. All timestamps are UTC.\nLast updated: 2026-03-24 12:51 UTC\n\n\t\n\t\t\n\t\tData Summary\n\t\n\n\n\t\n\t\t\nDataset\nRows\nFirst Date\nLast Date\n\n\n\t\t\norderbooks\n5,327,757\n2026-01-09\n2026-03-19\n\n\ntrades\n37,103,888\n2026-01-27\n2026-03-19\n\n\nprice_history\n587,188\n2026-03-06\n2026-03-19\n\n\ncrypto_prices\n72,088\u2026 See the full description on the dataset page: https://huggingface.co/datasets/obadiaha/polymarket-crypto-5m-15m.",
  "alternateName": [
    "obadiaha/polymarket-crypto-5m-15m",
    "Polymarket Crypto 5m/15m Market Data"
  ],
  "creator": {
    "@type": "Person",
    "name": "Obadiah Bridges",
    "url": "https://huggingface.co/obadiaha"
  },
  "keywords": [
    "time-series-forecasting",
    "mit",
    "10M - 100M",
