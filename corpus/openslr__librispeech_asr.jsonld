{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/openslr/librispeech_asr/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-all",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "all/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-clean",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "clean/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-other",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "other/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "all_splits/split_name"
      },
      "@id": "all_splits",
      "name": "all_splits",
      "description": "Splits for the all config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_splits/split_name": "test.clean"
        },
        {
          "all_splits/split_name": "test.other"
        },
        {
          "all_splits/split_name": "train.clean.100"
        },
        {
          "all_splits/split_name": "train.clean.360"
        },
        {
          "all_splits/split_name": "train.other.500"
        },
        {
          "all_splits/split_name": "validation.clean"
        },
        {
          "all_splits/split_name": "validation.other"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all",
      "description": "openslr/librispeech_asr - 'all' subset\n\nAdditional information:\n- 7 splits: test.clean, test.other, train.clean.100, train.clean.360, train.other.500, validation.clean, validation.other\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all/(?:partial-)?(test\\.clean|test\\.other|train\\.clean\\.100|train\\.clean\\.360|train\\.other\\.500|validation\\.clean|validation\\.other)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/speaker_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "speaker_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/chapter_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "chapter_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "id"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "clean_splits/split_name"
      },
      "@id": "clean_splits",
      "name": "clean_splits",
      "description": "Splits for the clean config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "clean_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "clean_splits/split_name": "test"
        },
        {
          "clean_splits/split_name": "train.100"
        },
        {
          "clean_splits/split_name": "train.360"
        },
        {
          "clean_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "clean",
      "description": "openslr/librispeech_asr - 'clean' subset\n\nAdditional information:\n- 4 splits: test, train.100, train.360, validation\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "clean/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "clean/(?:partial-)?(test|train\\.100|train\\.360|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "clean_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/speaker_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "speaker_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/chapter_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "chapter_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "id"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "other_splits/split_name"
      },
      "@id": "other_splits",
      "name": "other_splits",
      "description": "Splits for the other config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "other_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "other_splits/split_name": "test"
        },
        {
          "other_splits/split_name": "train.500"
        },
        {
          "other_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "other",
      "description": "openslr/librispeech_asr - 'other' subset\n\nAdditional information:\n- 3 splits: test, train.500, validation\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "other/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "other/(?:partial-)?(test|train\\.500|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "other_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/speaker_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "speaker_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/chapter_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "chapter_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "other/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-other"
            },
            "extract": {
              "column": "id"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "librispeech_asr",
  "description": "\n\t\n\t\t\n\t\tDataset Card for librispeech_asr\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nLibriSpeech is a corpus of approximately 1000 hours of 16kHz read English speech, prepared by Vassil Panayotov with the assistance of Daniel Povey. The data is derived from read audiobooks from the LibriVox project, and has been carefully segmented and aligned.\n\n\t\n\t\t\n\t\tSupported Tasks and Leaderboards\n\t\n\n\nautomatic-speech-recognition, audio-speaker-identification: The dataset can be used to train a model for Automatic\u2026 See the full description on the dataset page: https://huggingface.co/datasets/openslr/librispeech_asr.",
  "alternateName": [
    "openslr/librispeech_asr",
    "LibriSpeech"
  ],
  "creator": {
    "@type": "Organization",
    "name": "OpenSLR",
    "url": "https://huggingface.co/openslr"
  },
  "keywords": [
    "automatic-speech-recognition",
    "audio-classification",
    "speaker-identification",
    "expert-generated",
    "crowdsourced",
    "expert-generated",
    "monolingual",
    "original",
    "English",
    "cc-by-4.0",
    "100K - 1M",
