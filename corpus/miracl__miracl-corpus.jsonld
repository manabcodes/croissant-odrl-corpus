  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ar_splits/split_name"
      },
      "@id": "ar_splits",
      "name": "ar_splits",
      "description": "Splits for the ar config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ar_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ar",
      "name": "ar",
      "description": "miracl/miracl-corpus - 'ar' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar/split",
          "name": "ar/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ar/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ar_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar/docid",
          "name": "ar/docid",
          "description": "Column 'docid' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "column": "docid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar/title",
          "name": "ar/title",
