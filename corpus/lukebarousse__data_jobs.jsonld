              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "job_no_degree_mention"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/job_health_insurance",
          "name": "default/job_health_insurance",
          "description": "Column 'job_health_insurance' from the Hugging Face parquet file.",
          "dataType": "sc:Boolean",
          "source": {
