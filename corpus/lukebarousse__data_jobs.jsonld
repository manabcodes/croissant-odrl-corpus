            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/job_work_from_home",
          "name": "default/job_work_from_home",
          "description": "Column 'job_work_from_home' from the Hugging Face parquet file.",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "job_work_from_home"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/search_location",
          "name": "default/search_location",
          "description": "Column 'search_location' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
