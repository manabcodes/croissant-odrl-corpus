    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": [
      {
        "@type": "odrl:Duty",
        "odrl:action": {
          "@id": "odrl:attribution"
        }
      },
      {
        "@type": "odrl:Duty",
