  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/paper-review-only/S-EMBER/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-grounding",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "grounding/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-mcq",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "mcq/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "grounding_splits/split_name"
      },
      "@id": "grounding_splits",
      "name": "grounding_splits",
      "description": "Splits for the grounding config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "grounding_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "grounding_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "grounding",
      "description": "paper-review-only/S-EMBER - 'grounding' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "grounding/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-grounding"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "grounding/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "grounding_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "grounding/question_id",
