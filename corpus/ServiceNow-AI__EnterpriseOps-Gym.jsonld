    {
      "@type": "cr:RecordSet",
      "@id": "oracle",
      "description": "ServiceNow-AI/EnterpriseOps-Gym - 'oracle' subset\n\nAdditional information:\n- 8 splits: calendar, csm, drive, email, hr, hybrid, itsm, teams\n- 1 skipped column: restricted_tools",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "oracle/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "oracle/(?:partial-)?(calendar|csm|drive|email|hr|hybrid|itsm|teams)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "oracle_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "oracle/task_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "column": "task_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "oracle/domain",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "column": "domain"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "oracle/system_prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "column": "system_prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "oracle/user_prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "column": "user_prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "oracle/selected_tools",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "column": "selected_tools"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "oracle/mcp_endpoint",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "column": "mcp_endpoint"
            }
          }
