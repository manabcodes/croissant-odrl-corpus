    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-oracle",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "oracle/*/*.parquet"
    },
