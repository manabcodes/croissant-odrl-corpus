          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "column": "number_of_runs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "oracle/reset_database_between_runs",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle"
            },
            "extract": {
              "column": "reset_database_between_runs"
