  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Lin-Chen/ShareGPT4V/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-ShareGPT4V",
      "name": "parquet-files-for-config-ShareGPT4V",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "ShareGPT4V/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-ShareGPT4V-PT",
      "name": "parquet-files-for-config-ShareGPT4V-PT",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "ShareGPT4V-PT/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ShareGPT4V_splits/split_name"
      },
      "@id": "ShareGPT4V_splits",
      "name": "ShareGPT4V_splits",
      "description": "Splits for the ShareGPT4V config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ShareGPT4V_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ShareGPT4V_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ShareGPT4V",
      "name": "ShareGPT4V",
      "description": "Lin-Chen/ShareGPT4V - 'ShareGPT4V' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ShareGPT4V/split",
          "name": "ShareGPT4V/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ShareGPT4V"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ShareGPT4V/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ShareGPT4V_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ShareGPT4V/id",
          "name": "ShareGPT4V/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ShareGPT4V"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ShareGPT4V/image",
          "name": "ShareGPT4V/image",
          "description": "Column 'image' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ShareGPT4V"
            },
            "extract": {
              "column": "image"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ShareGPT4V/conversations",
          "name": "ShareGPT4V/conversations",
          "description": "Column 'conversations' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "ShareGPT4V/conversations/from",
              "name": "ShareGPT4V/conversations/from",
              "description": "Column 'conversations' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-ShareGPT4V"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "from"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "ShareGPT4V/conversations/value",
              "name": "ShareGPT4V/conversations/value",
              "description": "Column 'conversations' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-ShareGPT4V"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "value"
                }
              }
            }
          ],
          "repeated": true
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ShareGPT4V-PT_splits/split_name"
      },
      "@id": "ShareGPT4V-PT_splits",
      "name": "ShareGPT4V-PT_splits",
      "description": "Splits for the ShareGPT4V-PT config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ShareGPT4V-PT_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
