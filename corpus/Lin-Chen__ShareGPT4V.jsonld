    {
      "@type": "cr:RecordSet",
      "@id": "ShareGPT4V-PT",
      "name": "ShareGPT4V-PT",
      "description": "Lin-Chen/ShareGPT4V - 'ShareGPT4V-PT' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ShareGPT4V-PT/split",
          "name": "ShareGPT4V-PT/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
