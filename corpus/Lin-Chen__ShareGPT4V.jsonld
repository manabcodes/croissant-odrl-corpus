              "@id": "parquet-files-for-config-ShareGPT4V-PT"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ShareGPT4V\\-PT/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
