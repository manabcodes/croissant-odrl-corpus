                "transform": {
                  "jsonPath": "from"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "ShareGPT4V-PT/conversations/value",
              "name": "ShareGPT4V-PT/conversations/value",
              "description": "Column 'conversations' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
