            },
            "extract": {
              "column": "query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Auto/query_components",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "Auto/query_components/e2e_task",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-Auto"
                },
                "extract": {
                  "column": "query_components"
                },
                "transform": {
                  "jsonPath": "e2e_task"
                }
              }
            },
            {
              "@type": "cr:Field",
