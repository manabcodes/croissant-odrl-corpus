  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/allenai/super/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Auto",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Auto/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Expert",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Expert/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Masked",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Masked/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Auto_splits/split_name"
      },
      "@id": "Auto_splits",
      "name": "Auto_splits",
      "description": "Splits for the Auto config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Auto_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Auto_splits/split_name": "all_examples"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Auto",
      "description": "allenai/super - 'Auto' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Auto/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Auto"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Auto/(?:partial-)?(all_examples)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Auto_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Auto/task_id",
