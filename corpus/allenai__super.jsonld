                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "Auto/query_components/report",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-Auto"
                },
                "extract": {
                  "column": "query_components"
                },
                "transform": {
                  "jsonPath": "report"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "Auto/query_components/instructions",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-Auto"
                },
                "extract": {
                  "column": "query_components"
                },
                "transform": {
                  "jsonPath": "instructions"
