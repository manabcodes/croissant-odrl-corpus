  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/bench-llm/or-bench/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-or-bench-80k",
      "name": "parquet-files-for-config-or-bench-80k",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "or-bench-80k/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-or-bench-hard-1k",
      "name": "parquet-files-for-config-or-bench-hard-1k",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "or-bench-hard-1k/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-or-bench-toxic",
      "name": "parquet-files-for-config-or-bench-toxic",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "or-bench-toxic/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "or-bench-80k_splits/split_name"
      },
      "@id": "or-bench-80k_splits",
      "name": "or-bench-80k_splits",
      "description": "Splits for the or-bench-80k config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "or-bench-80k_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "or-bench-80k_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "or-bench-80k",
      "name": "or-bench-80k",
      "description": "bench-llm/or-bench - 'or-bench-80k' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "or-bench-80k/split",
          "name": "or-bench-80k/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-80k"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "or\\-bench\\-80k/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "or-bench-80k_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "or-bench-80k/prompt",
          "name": "or-bench-80k/prompt",
          "description": "Column 'prompt' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-80k"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "or-bench-80k/category",
          "name": "or-bench-80k/category",
          "description": "Column 'category' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-80k"
            },
            "extract": {
              "column": "category"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "or-bench-hard-1k_splits/split_name"
      },
      "@id": "or-bench-hard-1k_splits",
      "name": "or-bench-hard-1k_splits",
      "description": "Splits for the or-bench-hard-1k config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "or-bench-hard-1k_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "or-bench-hard-1k_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "or-bench-hard-1k",
      "name": "or-bench-hard-1k",
      "description": "bench-llm/or-bench - 'or-bench-hard-1k' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "or-bench-hard-1k/split",
          "name": "or-bench-hard-1k/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-hard-1k"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "or\\-bench\\-hard\\-1k/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "or-bench-hard-1k_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "or-bench-hard-1k/prompt",
          "name": "or-bench-hard-1k/prompt",
          "description": "Column 'prompt' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-hard-1k"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "or-bench-hard-1k/category",
          "name": "or-bench-hard-1k/category",
          "description": "Column 'category' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-hard-1k"
            },
            "extract": {
              "column": "category"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "or-bench-toxic_splits/split_name"
      },
      "@id": "or-bench-toxic_splits",
      "name": "or-bench-toxic_splits",
      "description": "Splits for the or-bench-toxic config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "or-bench-toxic_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "or-bench-toxic_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "or-bench-toxic",
      "name": "or-bench-toxic",
      "description": "bench-llm/or-bench - 'or-bench-toxic' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "or-bench-toxic/split",
          "name": "or-bench-toxic/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-toxic"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "or\\-bench\\-toxic/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "or-bench-toxic_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "or-bench-toxic/prompt",
          "name": "or-bench-toxic/prompt",
          "description": "Column 'prompt' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-toxic"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "or-bench-toxic/category",
          "name": "or-bench-toxic/category",
          "description": "Column 'category' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-or-bench-toxic"
            },
            "extract": {
              "column": "category"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "or-bench",
  "description": "\n\t\n\t\t\n\t\tOR-Bench: An Over-Refusal Benchmark for Large Language Models\n\t\n\nPlease see our demo at HuggingFace Spaces. \n\n\t\n\t\t\n\t\tOverall Plots of Model Performances\n\t\n\nBelow is the overall model performance. X axis shows the rejection rate on OR-Bench-Hard-1K and Y axis shows the rejection rate on OR-Bench-Toxic. The best aligned model should be on the top left corner of the plot where the model rejects the most number of toxic prompts and least number of safe prompts. We also plot a blue line\u2026 See the full description on the dataset page: https://huggingface.co/datasets/bench-llm/or-bench.",
  "alternateName": [
    "bench-llm/or-bench",
    "OR-Bench"
  ],
  "creator": {
    "@type": "Person",
    "name": "Bench LLM",
    "url": "https://huggingface.co/bench-llm"
  },
