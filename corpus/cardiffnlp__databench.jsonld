{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/cardiffnlp/databench/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-qa",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "qa/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-semeval",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "semeval/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "qa_splits/split_name"
      },
      "@id": "qa_splits",
      "name": "qa_splits",
      "description": "Splits for the qa config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qa_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "qa_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "qa",
      "description": "cardiffnlp/databench - 'qa' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qa/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qa"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "qa/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "qa_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qa/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qa"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qa/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qa"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qa/type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qa"
            },
            "extract": {
              "column": "type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qa/columns_used",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qa"
            },
            "extract": {
              "column": "columns_used"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qa/column_types",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qa"
            },
            "extract": {
              "column": "column_types"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qa/sample_answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qa"
            },
            "extract": {
              "column": "sample_answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qa/dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qa"
            },
            "extract": {
              "column": "dataset"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "semeval_splits/split_name"
      },
      "@id": "semeval_splits",
      "name": "semeval_splits",
      "description": "Splits for the semeval config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "semeval_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "semeval_splits/split_name": "train"
        },
        {
          "semeval_splits/split_name": "dev"
        },
        {
          "semeval_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "semeval",
      "description": "cardiffnlp/databench - 'semeval' subset\n\nAdditional information:\n- 3 splits: train, dev, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "semeval/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-semeval"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "semeval/(?:partial-)?(train|dev|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "semeval_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "semeval/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-semeval"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "semeval/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-semeval"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "semeval/type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-semeval"
            },
            "extract": {
              "column": "type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "semeval/columns_used",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-semeval"
            },
            "extract": {
              "column": "columns_used"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "semeval/column_types",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-semeval"
            },
            "extract": {
              "column": "column_types"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "semeval/sample_answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-semeval"
            },
            "extract": {
              "column": "sample_answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "semeval/dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-semeval"
            },
            "extract": {
              "column": "dataset"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "databench",
  "description": "\n\t\n\t\t\n\t\t\ud83d\udcbe\ud83c\udfcb\ufe0f\ud83d\udcbe DataBench \ud83d\udcbe\ud83c\udfcb\ufe0f\ud83d\udcbe\n\t\n\nNew! All the splits from the SemEval competition, including the test set, are now available in this page. \nThis repository contains the original 80 datasets used for the paper Question Answering over Tabular Data with DataBench:\nA Large-Scale Empirical Evaluation of LLMs which appeared in LREC-COLING 2024 and the associated SemEval 2025 Task 8 competition.\nLarge Language Models (LLMs) are showing emerging abilities, and one of the latest recognized ones is\u2026 See the full description on the dataset page: https://huggingface.co/datasets/cardiffnlp/databench.",
  "alternateName": [
    "cardiffnlp/databench",
    " \ud83d\udcbe\ud83c\udfcb\ufe0f\ud83d\udcbe DataBench \ud83d\udcbe\ud83c\udfcb\ufe0f\ud83d\udcbe"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Cardiff NLP",
    "url": "https://huggingface.co/cardiffnlp"
  },
  "keywords": [
    "table-question-answering",
    "question-answering",
    "English",
    "Spanish",
    "mit",
    "1K - 10K",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "table-question-answering",
    "table",
    "qa"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/cardiffnlp/databench",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "MIT License",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}