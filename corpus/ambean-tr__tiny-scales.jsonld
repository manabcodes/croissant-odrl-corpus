              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "quantitative_reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/spatial_reasoning_and_navigation",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
