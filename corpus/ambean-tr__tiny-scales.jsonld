    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ambean-tr/tiny-scales/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "ambean-tr/tiny-scales - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/benchmark_label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "benchmark_label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/benchmark_item_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "benchmark_item_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/attention_and_scan",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "attention_and_scan"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/calibrating_knowns_and_unknowns",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "calibrating_knowns_and_unknowns"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/conceptualisation_learning_abstraction",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "conceptualisation_learning_abstraction"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/critical_thinking_processes",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "critical_thinking_processes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/identifying_relevant_information",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "identifying_relevant_information"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/knowledge_applied_science",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "knowledge_applied_science"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/knowledge_customary",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "knowledge_customary"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/knowledge_formal_science",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "knowledge_formal_science"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/knowledge_natural_science",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "knowledge_natural_science"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/knowledge_social_science",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "knowledge_social_science"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/logical_reasoning",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "logical_reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/mind_modelling_and_social_cognition",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "mind_modelling_and_social_cognition"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/quantitative_reasoning",
          "dataType": "cr:Float64",
