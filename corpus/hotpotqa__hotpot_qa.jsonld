{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/hotpotqa/hotpot_qa/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-distractor",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "distractor/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-fullwiki",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "fullwiki/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "distractor_splits/split_name"
      },
      "@id": "distractor_splits",
      "name": "distractor_splits",
      "description": "Splits for the distractor config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "distractor_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "distractor_splits/split_name": "train"
        },
        {
          "distractor_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "distractor",
      "description": "hotpotqa/hotpot_qa - 'distractor' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "distractor/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-distractor"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "distractor/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "distractor_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "distractor/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-distractor"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "distractor/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-distractor"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "distractor/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-distractor"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "distractor/type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-distractor"
            },
            "extract": {
              "column": "type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "distractor/level",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-distractor"
            },
            "extract": {
              "column": "level"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "distractor/supporting_facts",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "distractor/supporting_facts/title",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-distractor"
                },
                "extract": {
                  "column": "supporting_facts"
                },
                "transform": {
                  "jsonPath": "title"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "distractor/supporting_facts/sent_id",
              "dataType": "cr:Int32",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-distractor"
                },
                "extract": {
                  "column": "supporting_facts"
                },
                "transform": {
                  "jsonPath": "sent_id"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "distractor/context",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "distractor/context/title",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-distractor"
                },
                "extract": {
                  "column": "context"
                },
                "transform": {
                  "jsonPath": "title"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "distractor/context/sentences",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-distractor"
                },
                "extract": {
                  "column": "context"
                },
                "transform": {
                  "jsonPath": "sentences"
                }
              },
              "isArray": true,
              "arrayShape": "-1,-1"
            }
          ]
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "fullwiki_splits/split_name"
      },
      "@id": "fullwiki_splits",
      "name": "fullwiki_splits",
      "description": "Splits for the fullwiki config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "fullwiki_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "fullwiki_splits/split_name": "train"
        },
        {
          "fullwiki_splits/split_name": "validation"
        },
        {
          "fullwiki_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "fullwiki",
      "description": "hotpotqa/hotpot_qa - 'fullwiki' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "fullwiki/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fullwiki"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "fullwiki/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "fullwiki_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fullwiki/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fullwiki"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fullwiki/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fullwiki"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fullwiki/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fullwiki"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fullwiki/type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fullwiki"
            },
            "extract": {
              "column": "type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fullwiki/level",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fullwiki"
            },
            "extract": {
              "column": "level"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fullwiki/supporting_facts",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "fullwiki/supporting_facts/title",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-fullwiki"
                },
                "extract": {
                  "column": "supporting_facts"
                },
                "transform": {
                  "jsonPath": "title"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "fullwiki/supporting_facts/sent_id",
              "dataType": "cr:Int32",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-fullwiki"
                },
                "extract": {
                  "column": "supporting_facts"
                },
                "transform": {
                  "jsonPath": "sent_id"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "fullwiki/context",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "fullwiki/context/title",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-fullwiki"
                },
                "extract": {
                  "column": "context"
                },
                "transform": {
                  "jsonPath": "title"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "fullwiki/context/sentences",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-fullwiki"
                },
                "extract": {
                  "column": "context"
                },
                "transform": {
                  "jsonPath": "sentences"
                }
              },
              "isArray": true,
              "arrayShape": "-1,-1"
            }
          ]
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "hotpot_qa",
  "description": "\n\t\n\t\t\n\t\tDataset Card for \"hotpot_qa\"\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nHotpotQA is a new dataset with 113k  Wikipedia-based question-answer  pairs with  four  key  features:  (1)  the  questions  require finding and reasoning over multiple supporting  documents  to  answer;  (2)  the  questions  are  diverse  and  not  constrained  to  any pre-existing  knowledge  bases  or  knowledge schemas;  (3)  we  provide  sentence-level  supporting facts required for reasoning, allowingQA systems to reason\u2026 See the full description on the dataset page: https://huggingface.co/datasets/hotpotqa/hotpot_qa.",
  "alternateName": [
    "hotpotqa/hotpot_qa",
    "HotpotQA"
  ],
  "creator": {
    "@type": "Organization",
    "name": "hotpotqa",
    "url": "https://huggingface.co/hotpotqa"
  },
  "keywords": [
    "question-answering",
    "crowdsourced",
    "found",
    "monolingual",
    "original",
    "English",
    "cc-by-sa-4.0",
    "100K - 1M",
    "parquet",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "arxiv:1809.09600",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "multi-hop"
  ],
