  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/BleachNick/UltraEdit_500k/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "name": "parquet-files-for-config-default",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "FreeForm"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "BleachNick/UltraEdit_500k - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "name": "default/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(FreeForm)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/clip_sim_source",
          "name": "default/clip_sim_source",
          "description": "Column 'clip_sim_source' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "clip_sim_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/clip_sim_target",
          "name": "default/clip_sim_target",
          "description": "Column 'clip_sim_target' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "clip_sim_target"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/clip_sim_dir",
          "name": "default/clip_sim_dir",
          "description": "Column 'clip_sim_dir' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "clip_sim_dir"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/clip_sim_image",
          "name": "default/clip_sim_image",
          "description": "Column 'clip_sim_image' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "clip_sim_image"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/dinov2_sim",
          "name": "default/dinov2_sim",
          "description": "Column 'dinov2_sim' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "dinov2_sim"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ssim",
          "name": "default/ssim",
          "description": "Column 'ssim' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ssim"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_caption",
          "name": "default/source_caption",
          "description": "Column 'source_caption' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/target_caption",
          "name": "default/target_caption",
          "description": "Column 'target_caption' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "target_caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/idx",
          "name": "default/idx",
          "description": "Column 'idx' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "idx"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edit_prompt",
          "name": "default/edit_prompt",
          "description": "Column 'edit_prompt' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "edit_prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_image",
          "name": "default/source_image",
          "description": "Image column 'source_image' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edited_image",
          "name": "default/edited_image",
          "description": "Image column 'edited_image' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
