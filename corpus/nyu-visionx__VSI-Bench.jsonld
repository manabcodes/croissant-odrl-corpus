  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/nyu-visionx/VSI-Bench/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-full",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "full/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-debiased",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "debiased/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-pruned",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "pruned/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "full_splits/split_name"
      },
      "@id": "full_splits",
      "name": "full_splits",
      "description": "Splits for the full config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "full_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "full",
      "description": "nyu-visionx/VSI-Bench - 'full' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "full/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "full_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "dataset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/scene_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "scene_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/question_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "question_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/ground_truth",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "ground_truth"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/options",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "options"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "full/pruned",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "pruned"
            }
          }
        }
      ]
    },
    {
