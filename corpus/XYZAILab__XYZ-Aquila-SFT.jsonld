{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/XYZAILab/XYZ-Aquila-SFT/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-en",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "en/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-zh",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "zh/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "en_splits/split_name"
      },
      "@id": "en_splits",
      "name": "en_splits",
      "description": "Splits for the en config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "en_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "en_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "en",
      "description": "XYZAILab/XYZ-Aquila-SFT - 'en' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "en/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-en"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "en/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "en_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "en/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-en"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "en/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-en"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "en/number_of_tool_calls",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-en"
            },
            "extract": {
              "column": "number of tool calls"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "en/trajectory",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "en/trajectory/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-en"
                },
                "extract": {
                  "column": "trajectory"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "en/trajectory/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-en"
                },
                "extract": {
                  "column": "trajectory"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "zh_splits/split_name"
      },
      "@id": "zh_splits",
      "name": "zh_splits",
      "description": "Splits for the zh config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "zh_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "zh_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "zh",
      "description": "XYZAILab/XYZ-Aquila-SFT - 'zh' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "zh/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zh"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "zh/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "zh_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "zh/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zh"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "zh/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zh"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "zh/number_of_tool_calls",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zh"
            },
            "extract": {
              "column": "number of tool calls"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "zh/trajectory",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "zh/trajectory/role_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-zh"
                },
                "extract": {
                  "column": "trajectory"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "zh/trajectory/content_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-zh"
                },
                "extract": {
                  "column": "trajectory"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "XYZ-Aquila-SFT",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tXYZ-Aquila SFT\n\t\n\nXYZ-Aquila SFT is a bilingual release of 7,000 multi-turn, search-oriented\ntool-use trajectories, comprising 5,000 English examples and 2,000 Chinese\nexamples.\nThis release is a sample of the broader supervised fine-tuning data used for\nXYZ-Aquila-mini and\nXYZ-Aquila-pro. The examples\ncapture agent interactions with search tools, intermediate observations, and\nanswer generation in English and Chinese.\nA small portion of the QA content is derived from\u2026 See the full description on the dataset page: https://huggingface.co/datasets/XYZAILab/XYZ-Aquila-SFT.",
  "alternateName": [
    "XYZAILab/XYZ-Aquila-SFT",
    "XYZ-Aquila SFT"
  ],
  "creator": {
    "@type": "Person",
    "name": "XYZ AI Lab",
    "url": "https://huggingface.co/XYZAILab"
  },
  "keywords": [
    "text-generation",
    "question-answering",
    "English",
    "Chinese",
    "apache-2.0",
    "1K - 10K",
    "json",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "agent",
    "tool-use",
    "multi-turn",
    "supervised-fine-tuning",
    "web-search",
    "xyz-aquila"
  ],
  "license": "https://choosealicense.com/licenses/apache-2.0/",
  "url": "https://huggingface.co/datasets/XYZAILab/XYZ-Aquila-SFT",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "Apache License 2.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}