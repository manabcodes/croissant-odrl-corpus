{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/nvidia/Llama-Nemotron-Post-Training-Dataset/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-SFT",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "SFT/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "SFT_splits/split_name"
      },
      "@id": "SFT_splits",
      "name": "SFT_splits",
      "description": "Splits for the SFT config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "SFT_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "SFT_splits/split_name": "code"
        },
        {
          "SFT_splits/split_name": "math"
        },
        {
          "SFT_splits/split_name": "science"
        },
        {
          "SFT_splits/split_name": "chat"
        },
        {
          "SFT_splits/split_name": "safety"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "SFT",
      "description": "nvidia/Llama-Nemotron-Post-Training-Dataset - 'SFT' subset (first 5GB)\n\nAdditional information:\n- 5 splits: code, math, science, chat, safety",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "SFT/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "SFT/(?:partial-)?(code|math|science|chat|safety)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "SFT_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/input",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "SFT/input/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-SFT"
                },
                "extract": {
                  "column": "input"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "SFT/input/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-SFT"
                },
                "extract": {
                  "column": "input"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/output",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "column": "output"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/license",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "column": "license"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/reasoning",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "column": "reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/generator",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "column": "generator"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/used_in_training",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "column": "used_in_training"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/version",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "column": "version"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SFT/system_prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SFT"
            },
            "extract": {
              "column": "system_prompt"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Llama-Nemotron-Post-Training-Dataset",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tLlama-Nemotron-Post-Training-Dataset-v1.1 Release\n\t\n\nUpdate [4/8/2025]: \nv1.1: We are releasing an additional 2.2M Math and 500K Code Reasoning Data in support of our release of Llama-3.1-Nemotron-Ultra-253B-v1. \ud83c\udf89 \n\n\t\n\t\t\n\t\n\t\n\t\tData Overview\n\t\n\nThis dataset is a compilation of SFT and RL data that supports improvements of math, code, general reasoning, and instruction following capabilities of the original Llama instruct model, in support of NVIDIA\u2019s release of\u2026 See the full description on the dataset page: https://huggingface.co/datasets/nvidia/Llama-Nemotron-Post-Training-Dataset.",
  "alternateName": [
    "nvidia/Llama-Nemotron-Post-Training-Dataset"
  ],
  "creator": {
    "@type": "Organization",
    "name": "NVIDIA",
    "url": "https://huggingface.co/nvidia"
  },
  "keywords": [
    "cc-by-4.0",
    "1M - 10M",
    "json",
    "Text",
    "Datasets",
    "Dask",
    "Croissant",
    "arxiv:2505.00949",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/nvidia/Llama-Nemotron-Post-Training-Dataset",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}