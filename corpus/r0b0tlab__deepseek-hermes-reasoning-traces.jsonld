    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "hermes",
    "agent",
    "tool-calling",
    "reasoning",
    "sft",
    "lora",
    "function-calling",
    "deepseek",
    "chatml"
  ],
