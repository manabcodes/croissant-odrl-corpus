{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/osunlp/QUEST-SFT-Data-Objective-Script/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "osunlp/QUEST-SFT-Data-Objective-Script - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/data_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "data_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/prompt",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/prompt/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "prompt"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/prompt/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "prompt"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/reward_model",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/reward_model/ground_truth",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/reward_model/ground_truth/task_id",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "reward_model"
                    },
                    "transform": [
                      {
                        "jsonPath": "ground_truth"
                      },
                      {
                        "jsonPath": "task_id"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/reward_model/ground_truth/type",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "reward_model"
                    },
                    "transform": [
                      {
                        "jsonPath": "ground_truth"
                      },
                      {
                        "jsonPath": "type"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/reward_model/style",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "reward_model"
                },
                "transform": {
                  "jsonPath": "style"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/reward_model/task_id_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "reward_model"
                },
                "transform": {
                  "jsonPath": "task_id"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/extra_info",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/extra_info/index",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "extra_info"
                },
                "transform": {
                  "jsonPath": "index"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/extra_info/original_task_id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "extra_info"
                },
                "transform": {
                  "jsonPath": "original_task_id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/extra_info/question",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "extra_info"
                },
                "transform": {
                  "jsonPath": "question"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/extra_info/rubric_tree",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "extra_info"
                },
                "transform": {
                  "jsonPath": "rubric_tree"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/rl_task_category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "rl_task_category"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "QUEST-SFT-Data-Objective-Script",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tQUEST SFT Data Objective Script\n\t\n\nProject Page | Paper | GitHub\nSupervised fine-tuning split for QUEST / DeepResearch objective tasks. Each row includes the user prompt, a rule-style reward_model, extra_info, and the objective task category. The corresponding objective evaluation scripts are provided separately under eval_scripts/.\nThis dataset follows the same broad schema style as osunlp/QUEST-RL-Data: each row includes prompt, reward_model, extra_info, and rl_task_category. The\u2026 See the full description on the dataset page: https://huggingface.co/datasets/osunlp/QUEST-SFT-Data-Objective-Script.",
  "alternateName": [
    "osunlp/QUEST-SFT-Data-Objective-Script",
    "QUEST SFT Data Objective Script"
  ],
  "creator": {
    "@type": "Organization",
    "name": "OSU NLP Group",
    "url": "https://huggingface.co/osunlp"
  },
  "keywords": [
    "text-generation",
    "English",
    "mit",
    "1K - 10K",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2605.24218",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "deep-research",
    "supervised-fine-tuning",
    "objective-evaluation",
    "eval-scripts"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/osunlp/QUEST-SFT-Data-Objective-Script",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "MIT License",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
