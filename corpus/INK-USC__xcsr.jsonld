      },
      "@id": "X-CODAH-ar_splits",
      "name": "X-CODAH-ar_splits",
      "description": "Splits for the X-CODAH-ar config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "X-CODAH-ar_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "X-CODAH-ar_splits/split_name": "test"
        },
        {
          "X-CODAH-ar_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "X-CODAH-ar",
      "name": "X-CODAH-ar",
      "description": "INK-USC/xcsr - 'X-CODAH-ar' subset\n\nAdditional information:\n- 2 splits: test, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "X-CODAH-ar/split",
          "name": "X-CODAH-ar/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-X-CODAH-ar"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "X\\-CODAH\\-ar/(?:partial-)?(test|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "X-CODAH-ar_splits/split_name"
            }
          }
        },
        {
