  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "arxiv_splits/split_name"
      },
      "@id": "arxiv_splits",
      "name": "arxiv_splits",
      "description": "Splits for the arxiv config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "arxiv_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "arxiv_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "arxiv",
      "name": "arxiv",
      "description": "wyu1/Leopard-Instruct - 'arxiv' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "arxiv/split",
          "name": "arxiv/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-arxiv"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "arxiv/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "arxiv_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "arxiv/id",
          "name": "arxiv/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-arxiv"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "arxiv/images",
          "name": "arxiv/images",
          "description": "Image column 'images' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-arxiv"
            },
            "extract": {
              "column": "images"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "arxiv/texts",
          "name": "arxiv/texts",
          "description": "Column 'texts' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "arxiv/texts/content",
              "name": "arxiv/texts/content",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-arxiv"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "arxiv/texts/from",
              "name": "arxiv/texts/from",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-arxiv"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "from"
                }
              }
            }
          ],
          "repeated": true
        }
      ]
