            "fileSet": {
              "@id": "parquet-files-for-config-A-OKVQA"
            },
            "extract": {
              "column": "qry_image_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "A-OKVQA/pos_text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-A-OKVQA"
            },
            "extract": {
              "column": "pos_text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "A-OKVQA/pos_image_path",
