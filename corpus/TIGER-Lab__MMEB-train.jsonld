  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "A-OKVQA_splits/split_name"
      },
      "@id": "A-OKVQA_splits",
      "name": "A-OKVQA_splits",
      "description": "Splits for the A-OKVQA config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "A-OKVQA_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "A-OKVQA_splits/split_name": "original"
        },
        {
          "A-OKVQA_splits/split_name": "diverse_instruction"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "A-OKVQA",
      "description": "TIGER-Lab/MMEB-train - 'A-OKVQA' subset\n\nAdditional information:\n- 2 splits: original, diverse_instruction",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "A-OKVQA/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-A-OKVQA"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "A\\-OKVQA/(?:partial-)?(original|diverse_instruction)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "A-OKVQA_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "A-OKVQA/qry",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-A-OKVQA"
            },
            "extract": {
              "column": "qry"
            }
          }
        },
        {
          "@type": "cr:Field",
