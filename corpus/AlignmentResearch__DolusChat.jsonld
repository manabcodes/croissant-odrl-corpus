              "@id": "default/ground_truth_features/AI Instantiation",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "ground_truth_features"
                },
