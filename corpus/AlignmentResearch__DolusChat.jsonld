                },
                "extract": {
                  "column": "ground_truth_features"
                },
                "transform": {
                  "jsonPath": "Difficulty Factor communication_medium"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/ground_truth_features/Difficulty Factor number_of_irrelevant_context_items",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
