                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/ground_truth_features/Issue",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "ground_truth_features"
                },
                "transform": {
                  "jsonPath": "Issue"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/ground_truth_features/Difficulty Factor seniority_of_user",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
