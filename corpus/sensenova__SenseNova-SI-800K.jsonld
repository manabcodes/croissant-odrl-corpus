{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/sensenova/SenseNova-SI-800K/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-preview",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "preview/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-full",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "full/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "preview_splits/split_name"
      },
      "@id": "preview_splits",
      "name": "preview_splits",
      "description": "Splits for the preview config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "preview_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "preview_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "preview",
      "description": "sensenova/SenseNova-SI-800K - 'preview' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "preview/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "preview/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "preview_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/conversations",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "conversations"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "preview/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preview"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "full_splits/split_name"
      },
      "@id": "full_splits",
      "name": "full_splits",
      "description": "Splits for the full config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "full_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "full",
      "description": "sensenova/SenseNova-SI-800K - 'full' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "full/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "full_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/conversations",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "full/conversations/from",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-full"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "from"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "full/conversations/value",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-full"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "value"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "full/image",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "image"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "SenseNova-SI-800K",
  "description": "EN | \u4e2d\u6587 \n\n\t\n\t\t\n\t\tSenseNova-SI-800K\n\t\n\n\n    \n\n  \n      \n  \n\n    \n\n\n    \n\n\n\ud83d\udd25Please check out our newly released SenseNova-SI-8M, official full-scale training dataset of the SenseNova-SI series. SenseNova-SI-8M contains ~8.16 million carefully curated training samples spanning ~2.72 million unique images, organized under a rigorous taxonomy of spatial capabilities.The SenseNova-SI-800K dataset provided here is a downsampled subset of SenseNova-SI-8M, specifically designed for studying scaling\u2026 See the full description on the dataset page: https://huggingface.co/datasets/sensenova/SenseNova-SI-800K.",
  "alternateName": [
    "sensenova/SenseNova-SI-800K",
    "SenseNova-SI-800K"
  ],
  "creator": {
    "@type": "Organization",
    "name": "SenseNova",
    "url": "https://huggingface.co/sensenova"
  },
  "keywords": [
    "visual-question-answering",
    "question-answering",
    "English",
    "apache-2.0",
    "100K - 1M",
    "parquet",
    "optimized-parquet",
    "Image",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2511.13719",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/apache-2.0/",
  "url": "https://huggingface.co/datasets/sensenova/SenseNova-SI-800K",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
