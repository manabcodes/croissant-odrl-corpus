  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "agent_splits/split_name"
      },
      "@id": "agent_splits",
      "name": "agent_splits",
      "description": "Splits for the agent config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "agent_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "agent_splits/split_name": "high"
        },
        {
          "agent_splits/split_name": "medium"
        },
        {
          "agent_splits/split_name": "low"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
