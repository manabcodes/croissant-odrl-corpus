      "description": "IFM/TxT360-3efforts - 'agent' subset\n\nAdditional information:\n- 3 splits: high, medium, low",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "agent/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-agent"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "agent/(?:partial-)?(high|medium|low)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "agent_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "agent/messages",
          "dataType": "sc:Text",
