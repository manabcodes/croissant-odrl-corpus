    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/aliplayer1/polymarket-crypto-updown/tree/refs%2Fconvert%2Fparquet",
