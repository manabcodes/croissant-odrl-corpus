  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "AM-Thinking-v1-Distilled-code_splits/split_name"
      },
      "@id": "AM-Thinking-v1-Distilled-code_splits",
      "name": "AM-Thinking-v1-Distilled-code_splits",
      "description": "Splits for the AM-Thinking-v1-Distilled-code config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "AM-Thinking-v1-Distilled-code_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "AM-Thinking-v1-Distilled-code_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "AM-Thinking-v1-Distilled-code",
      "description": "OpenDataArena/OpenDataArena-scored-data-2603 - 'AM-Thinking-v1-Distilled-code' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "AM-Thinking-v1-Distilled-code/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-AM-Thinking-v1-Distilled-code"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "AM\\-Thinking\\-v1\\-Distilled\\-code/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "AM-Thinking-v1-Distilled-code_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "AM-Thinking-v1-Distilled-code/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-AM-Thinking-v1-Distilled-code"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "AM-Thinking-v1-Distilled-code/source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-AM-Thinking-v1-Distilled-code"
            },
            "extract": {
              "column": "source"
            }
