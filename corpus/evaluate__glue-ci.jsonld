    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ax_splits/split_name"
      },
      "@id": "ax_splits",
      "name": "ax_splits",
      "description": "Splits for the ax config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ax_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ax_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ax",
      "description": "evaluate/glue-ci - 'ax' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ax/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ax"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ax/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ax_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ax/premise",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ax"
            },
            "extract": {
              "column": "premise"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ax/hypothesis",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ax"
            },
            "extract": {
              "column": "hypothesis"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ax/label",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ax"
            },
            "extract": {
              "column": "label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ax/idx",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ax"
            },
            "extract": {
              "column": "idx"
            }
          }
        }
      ]
    },
