  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/villekuosmanen/dAgger_build_block_tower_1.2.0-advantages/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "villekuosmanen/dAgger_build_block_tower_1.2.0-advantages - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/frame_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "frame_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/episode_idx",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "episode_idx"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/advantage",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "advantage"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/required_intervention",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "required_intervention"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "dAgger_build_block_tower_1.2.0-advantages",
  "description": "\n\t\n\t\t\n\t\tAdvantage Values for villekuosmanen/dAgger_build_block_tower_1.2.0\n\t\n\nPre-computed advantage values for offline RL training.\n\n\t\n\t\t\n\t\tSource\n\t\n\n\nDataset: villekuosmanen/dAgger_build_block_tower_1.2.0\nValue Model: villekuosmanen/rewact_build_block_tower_all_3\nN-step lookahead: 50\n\n\n\t\n\t\t\n\t\tFiles\n\t\n\nThis dataset contains per-episode parquet files with advantage values for each frame.\n\n\t\n\t\t\n\t\tUsage\n\t\n\nfrom pathlib import Path\nimport pandas as pd\n\n# Load advantages for a specific episode\u2026 See the full description on the dataset page: https://huggingface.co/datasets/villekuosmanen/dAgger_build_block_tower_1.2.0-advantages.",
  "alternateName": [
    "villekuosmanen/dAgger_build_block_tower_1.2.0-advantages"
  ],
  "creator": {
    "@type": "Person",
    "name": "Ville Kuosmanen",
    "url": "https://huggingface.co/villekuosmanen"
  },
