        "@id": "assamese_splits/split_name"
      },
      "@id": "assamese_splits",
      "name": "assamese_splits",
      "description": "Splits for the assamese config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "assamese_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "assamese_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "assamese",
      "description": "grushaaaaa/indic-dialect-asr - 'assamese' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "assamese/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-assamese"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "assamese/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "assamese_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "assamese/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-assamese"
            },
            "extract": {
              "column": "audio"
            },
            "sampling_rate": 16000
          }
        },
        {
          "@type": "cr:Field",
          "@id": "assamese/sentence",
          "dataType": "sc:Text",
