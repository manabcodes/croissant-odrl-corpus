    {
      "@type": "cr:RecordSet",
      "@id": "tasks_base",
      "description": "johanneskirmayr/car-bench-dataset - 'tasks_base' subset\n\nAdditional information:\n- 2 splits: train, test\n- 4 skipped columns: disambiguation_element_internal, disambiguation_element_user, disambiguation_element_note, removed_part",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "tasks_base/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks_base"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "tasks_base/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "tasks_base_splits/split_name"
            }
          }
        },
        {
