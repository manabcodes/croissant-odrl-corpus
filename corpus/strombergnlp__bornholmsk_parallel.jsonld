    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/strombergnlp/bornholmsk_parallel/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-BornholmskParallel",
      "name": "parquet-files-for-config-BornholmskParallel",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "BornholmskParallel/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "BornholmskParallel_splits/split_name"
      },
      "@id": "BornholmskParallel_splits",
      "name": "BornholmskParallel_splits",
      "description": "Splits for the BornholmskParallel config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "BornholmskParallel_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "BornholmskParallel_splits/split_name": "train"
        },
        {
          "BornholmskParallel_splits/split_name": "validation"
        },
        {
          "BornholmskParallel_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "BornholmskParallel",
      "name": "BornholmskParallel",
      "description": "strombergnlp/bornholmsk_parallel - 'BornholmskParallel' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "BornholmskParallel/split",
          "name": "BornholmskParallel/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-BornholmskParallel"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "BornholmskParallel/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "BornholmskParallel_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "BornholmskParallel/id",
          "name": "BornholmskParallel/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-BornholmskParallel"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "BornholmskParallel/da_bornholm",
          "name": "BornholmskParallel/da_bornholm",
          "description": "Column 'da_bornholm' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-BornholmskParallel"
            },
            "extract": {
              "column": "da_bornholm"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "BornholmskParallel/da",
          "name": "BornholmskParallel/da",
          "description": "Column 'da' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-BornholmskParallel"
            },
            "extract": {
              "column": "da"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "bornholmsk_parallel",
  "description": "This dataset is parallel text for Bornholmsk and Danish. \n\nFor more details, see the paper [Bornholmsk Natural Language Processing: Resources and Tools](https://aclanthology.org/W19-6138/).",
  "alternateName": [
    "strombergnlp/bornholmsk_parallel",
    "Bornholmsk/Danish Parallel Texts"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Str\u00f8mberg NLP",
    "url": "https://huggingface.co/strombergnlp"
  },
