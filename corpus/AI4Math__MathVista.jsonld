          "name": "default/question_type",
          "description": "Column 'question_type' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "question_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/answer_type",
          "name": "default/answer_type",
          "description": "Column 'answer_type' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
