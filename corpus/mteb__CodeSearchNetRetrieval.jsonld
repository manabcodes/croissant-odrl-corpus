    {
      "@type": "cr:RecordSet",
      "@id": "go-corpus",
      "description": "mteb/CodeSearchNetRetrieval - 'go-corpus' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "go-corpus/split",
          "dataType": "sc:Text",
          "source": {
