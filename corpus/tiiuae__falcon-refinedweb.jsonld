    "Polars",
    "arxiv:2306.01116",
    "arxiv:2203.15556",
    "arxiv:2107.06499",
    "arxiv:2104.08758",
    "arxiv:2109.07445",
    "arxiv:1911.00359",
    "arxiv:2112.11446",
    "doi:10.57967/hf/0737",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/odc-by/",
  "sameAs": "falconllm.tii.ae",
  "url": "https://huggingface.co/datasets/tiiuae/falcon-refinedweb",
