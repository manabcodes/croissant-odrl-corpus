  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/OpenCoder-LLM/opc-annealing-corpus/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-algorithmic_corpus",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "algorithmic_corpus/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-synthetic_code_snippet",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "synthetic_code_snippet/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-synthetic_qa",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "synthetic_qa/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "algorithmic_corpus_splits/split_name"
      },
      "@id": "algorithmic_corpus_splits",
      "name": "algorithmic_corpus_splits",
      "description": "Splits for the algorithmic_corpus config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "algorithmic_corpus_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "algorithmic_corpus_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "algorithmic_corpus",
      "description": "OpenCoder-LLM/opc-annealing-corpus - 'algorithmic_corpus' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "algorithmic_corpus/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-algorithmic_corpus"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "algorithmic_corpus/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "algorithmic_corpus_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "algorithmic_corpus/type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-algorithmic_corpus"
            },
            "extract": {
              "column": "type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "algorithmic_corpus/lang",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-algorithmic_corpus"
            },
            "extract": {
              "column": "lang"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "algorithmic_corpus/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-algorithmic_corpus"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "synthetic_code_snippet_splits/split_name"
      },
      "@id": "synthetic_code_snippet_splits",
      "name": "synthetic_code_snippet_splits",
      "description": "Splits for the synthetic_code_snippet config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "synthetic_code_snippet_splits/split_name",
          "dataType": "sc:Text"
        }
