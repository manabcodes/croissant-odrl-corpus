            },
            "transform": {
              "regex": "synthetic_code_snippet/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "synthetic_code_snippet_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "synthetic_code_snippet/type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-synthetic_code_snippet"
