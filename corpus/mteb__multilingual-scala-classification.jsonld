  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/mteb/multilingual-scala-classification/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Danish",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Danish/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Norwegian_b",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Norwegian_b/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Norwegian_n",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Norwegian_n/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Swedish",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Swedish/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Danish_splits/split_name"
      },
      "@id": "Danish_splits",
      "name": "Danish_splits",
      "description": "Splits for the Danish config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Danish_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Danish_splits/split_name": "train"
        },
        {
          "Danish_splits/split_name": "test"
        },
        {
          "Danish_splits/split_name": "full_train"
        },
        {
          "Danish_splits/split_name": "val"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Danish",
      "description": "mteb/multilingual-scala-classification - 'Danish' subset\n\nAdditional information:\n- 4 splits: train, test, full_train, val",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Danish/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Danish"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Danish/(?:partial-)?(train|test|full_train|val)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Danish_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Danish/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Danish"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Danish/corruption_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Danish"
            },
            "extract": {
              "column": "corruption_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Danish/label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Danish"
            },
            "extract": {
              "column": "label"
            }
          }
        }
      ]
    },
