  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/AlphaDojo/dojo_benchmark_kline/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "AlphaDojo/dojo_benchmark_kline - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/symbol",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "symbol"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/market",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "market"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/name_zh",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "name_zh"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/name_en",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "name_en"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sort_order",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sort_order"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "dojo_benchmark_kline",
  "description": "\nLanguages: \u7b80\u4f53\u4e2d\u6587 \u00b7 English\n\n\n\t\n\t\t\n\t\n\t\n\t\tdojo_benchmark_kline \u2014 Benchmark Index Bars\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tOverview\n\t\n\nDaily OHLCV for major broad and representative indices across US, CN, and HK (e.g. ^SPX, ^HSI, 000300.SS). Each row is one index on one trade date.\n\n\t\n\t\t\n\t\n\t\n\t\tFiles\n\t\n\n\n\t\n\t\t\nFile\nDescription\n\n\n\t\t\ndata.parquet\nIndex daily bars\n\n\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tKey Fields\n\t\n\n\n\t\n\t\t\nField\nDescription\n\n\n\t\t\nsymbol\nIndex code (e.g. ^SPX, 000300.SS)\n\n\nkline_t\nBar interval; \"1D\" for daily bars\n\n\nbar_time\u2026 See the full description on the dataset page: https://huggingface.co/datasets/AlphaDojo/dojo_benchmark_kline.",
  "alternateName": [
    "AlphaDojo/dojo_benchmark_kline"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Alpha Dojo",
    "url": "https://huggingface.co/AlphaDojo"
  },
  "keywords": [
