    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "cs_splits/split_name"
      },
      "@id": "cs_splits",
      "name": "cs_splits",
      "description": "Splits for the cs config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "cs_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "cs_splits/split_name": "train"
        },
        {
          "cs_splits/split_name": "validation"
        },
        {
          "cs_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "cs",
      "description": "facebook/voxpopuli - 'cs' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "cs/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cs"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "cs/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "cs_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cs/audio_id",
          "dataType": "sc:Text",
