            "fileSet": {
              "@id": "parquet-files-for-config-cs"
            },
            "extract": {
              "column": "audio_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cs/language",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cs"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cs/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cs"
            },
            "extract": {
              "column": "audio"
            },
            "sampling_rate": 16000
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cs/raw_text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cs"
            },
            "extract": {
              "column": "raw_text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cs/normalized_text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cs"
            },
            "extract": {
              "column": "normalized_text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cs/gender",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cs"
            },
            "extract": {
              "column": "gender"
            }
          }
        },
        {
          "@type": "cr:Field",
