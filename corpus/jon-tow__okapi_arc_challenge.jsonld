  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ar_splits/split_name"
      },
      "@id": "ar_splits",
      "name": "ar_splits",
      "description": "Splits for the ar config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ar_splits/split_name": "train"
        },
        {
          "ar_splits/split_name": "validation"
        },
        {
          "ar_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ar",
      "description": "jon-tow/okapi_arc_challenge - 'ar' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ar/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ar_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar/choices",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "ar/choices/text",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-ar"
                },
                "extract": {
                  "column": "choices"
                },
                "transform": {
                  "jsonPath": "text"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "ar/choices/label",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-ar"
                },
                "extract": {
                  "column": "choices"
                },
                "transform": {
                  "jsonPath": "label"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "ar/answerKey",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "column": "answerKey"
            }
          }
        }
      ]
    },
