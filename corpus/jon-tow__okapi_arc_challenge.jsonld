          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zh"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "zh/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "zh_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "zh/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zh"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "zh/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zh"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "zh/choices",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "zh/choices/text_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-zh"
