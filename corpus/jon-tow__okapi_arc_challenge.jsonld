              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "zh/choices/label_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-zh"
                },
                "extract": {
                  "column": "choices"
                },
                "transform": {
                  "jsonPath": "label"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "zh/answerKey",
          "dataType": "sc:Text",
          "source": {
