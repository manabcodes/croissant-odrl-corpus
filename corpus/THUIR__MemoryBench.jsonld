    {
      "@type": "cr:RecordSet",
      "@id": "DialSim-bigbang",
      "description": "THUIR/MemoryBench - 'DialSim-bigbang' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "DialSim-bigbang/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DialSim-bigbang"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "DialSim\\-bigbang/(?:partial-)?(train|test)/.+parquet$"
            }
          },
