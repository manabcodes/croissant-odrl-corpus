    {
      "@type": "cr:RecordSet",
      "@id": "Classification",
      "description": "akshaydudhane/EarthDial-Dataset - 'Classification' subset (first 5GB)\n\nAdditional information:\n- 4 splits: AID_sample, UCM_sample, BigEarthNet_RGB_sample, WHU_sample",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Classification/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Classification"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Classification/(?:partial-)?(AID_sample|UCM_sample|BigEarthNet_RGB_sample|WHU_sample)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Classification_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Classification/jpg",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Classification"
            },
            "extract": {
              "column": "jpg"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Classification/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Classification"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Classification/groundtruth",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Classification"
            },
            "extract": {
              "column": "groundtruth"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Classification/__key__",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Classification"
            },
            "extract": {
              "column": "__key__"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Classification/origin",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Classification"
            },
            "extract": {
              "column": "origin"
            }
          }
        }
      ]
    },
