        }
      ],
      "data": [
        {
          "Classification_splits/split_name": "AID_sample"
        },
        {
          "Classification_splits/split_name": "UCM_sample"
        },
        {
          "Classification_splits/split_name": "BigEarthNet_RGB_sample"
        },
        {
