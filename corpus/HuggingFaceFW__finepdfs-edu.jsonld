        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "eng_Latn",
      "description": "HuggingFaceFW/finepdfs-edu - 'eng_Latn' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "eng_Latn/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eng_Latn"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "eng_Latn/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "eng_Latn_splits/split_name"
            }
          }
        },
        {
