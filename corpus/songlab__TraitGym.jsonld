      "includes": "mendelian_traits/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-mendelian_traits_full",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "mendelian_traits_full/*/*.parquet"
    }
  ],
