        "@id": "commonsense_splits/split_name"
      },
      "@id": "commonsense_splits",
      "name": "commonsense_splits",
      "description": "Splits for the commonsense config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "commonsense_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "commonsense_splits/split_name": "train"
        },
        {
          "commonsense_splits/split_name": "validation"
        },
        {
          "commonsense_splits/split_name": "test"
        }
      ]
