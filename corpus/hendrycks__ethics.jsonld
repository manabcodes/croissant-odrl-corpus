    {
      "@type": "cr:RecordSet",
      "@id": "commonsense",
      "name": "commonsense",
      "description": "hendrycks/ethics - 'commonsense' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "commonsense/split",
          "name": "commonsense/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-commonsense"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "commonsense/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "commonsense_splits/split_name"
            }
