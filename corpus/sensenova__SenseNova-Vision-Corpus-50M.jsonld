  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/sensenova/SenseNova-Vision-Corpus-50M/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Structure",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Structure/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Geometry",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Geometry/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-Segmentation",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "Segmentation/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Structure_splits/split_name"
      },
      "@id": "Structure_splits",
      "name": "Structure_splits",
      "description": "Splits for the Structure config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Structure_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Structure_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Structure",
      "description": "sensenova/SenseNova-Vision-Corpus-50M - 'Structure' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Structure/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Structure"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Structure/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Structure_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Structure/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Structure"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Structure/conversations",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Structure"
            },
            "extract": {
              "column": "conversations"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Structure/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Structure"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Geometry_splits/split_name"
      },
      "@id": "Geometry_splits",
      "name": "Geometry_splits",
      "description": "Splits for the Geometry config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Geometry_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Geometry_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Geometry",
      "description": "sensenova/SenseNova-Vision-Corpus-50M - 'Geometry' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Geometry/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Geometry"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Geometry/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Geometry_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Geometry/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Geometry"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Geometry/conversations",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Geometry"
            },
            "extract": {
              "column": "conversations"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Geometry/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Geometry"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Segmentation_splits/split_name"
      },
      "@id": "Segmentation_splits",
      "name": "Segmentation_splits",
      "description": "Splits for the Segmentation config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Segmentation_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Segmentation_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Segmentation",
      "description": "sensenova/SenseNova-Vision-Corpus-50M - 'Segmentation' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Segmentation/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Segmentation"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Segmentation/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Segmentation_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Segmentation/image_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Segmentation"
            },
            "extract": {
              "column": "image_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Segmentation/conversations",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Segmentation"
            },
            "extract": {
              "column": "conversations"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Segmentation/caption",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Segmentation"
            },
            "extract": {
              "column": "caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Segmentation/num_instances",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Segmentation"
            },
            "extract": {
              "column": "num_instances"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Segmentation/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Segmentation"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "Segmentation/seg",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Segmentation"
            },
            "extract": {
              "column": "seg"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "SenseNova-Vision-Corpus-50M",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tVision as Unified Multimodal Generation\n\t\n\n\n  English | \u7b80\u4f53\u4e2d\u6587\n\n\n\n  \n  \n  \n  \n  \n\n\nThis repository contains the dataset for the paper Vision as Unified Multimodal Generation.\n\n\t\n\t\t\n\t\n\t\n\t\tSenseNova Vision Corpus 50M\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tOverview\n\t\n\nSenseNova Vision Corpus 50M (SN-VC-50M) is a large-scale multimodal vision corpus designed for unified training across diverse visual understanding and geometry-oriented tasks. The dataset is curated to address a common limitation of existing\u2026 See the full description on the dataset page: https://huggingface.co/datasets/sensenova/SenseNova-Vision-Corpus-50M.",
  "alternateName": [
