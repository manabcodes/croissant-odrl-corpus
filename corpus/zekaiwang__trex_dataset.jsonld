{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/zekaiwang/trex_dataset/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-frames",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "frames/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-episodes",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "episodes/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "frames_splits/split_name"
      },
      "@id": "frames_splits",
      "name": "frames_splits",
      "description": "Splits for the frames config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "frames_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "frames_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "frames",
      "description": "zekaiwang/trex_dataset - 'frames' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "frames/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "frames/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "frames_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "frames/observation.state",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "column": "observation.state"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "frames/action",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "column": "action"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "frames/observation.tactile_force",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "column": "observation.tactile_force"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "frames/timestamp",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "column": "timestamp"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "frames/frame_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "column": "frame_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "frames/episode_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "column": "episode_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "frames/index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "column": "index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "frames/task_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-frames"
            },
            "extract": {
              "column": "task_index"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "episodes_splits/split_name"
      },
      "@id": "episodes_splits",
      "name": "episodes_splits",
      "description": "Splits for the episodes config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "episodes_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "episodes_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "episodes",
      "description": "zekaiwang/trex_dataset - 'episodes' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "episodes/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-episodes"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "episodes/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "episodes_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "episodes/episode_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-episodes"
            },
            "extract": {
              "column": "episode_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "episodes/caption",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-episodes"
            },
            "extract": {
              "column": "caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "episodes/motor_primitive",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-episodes"
            },
            "extract": {
              "column": "motor_primitive"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "episodes/object",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-episodes"
            },
            "extract": {
              "column": "object"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "episodes/target",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-episodes"
            },
            "extract": {
              "column": "target"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "episodes/length",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-episodes"
            },
            "extract": {
              "column": "length"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "trex_dataset",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tT-Rex Dataset\n\t\n\nA large-scale, tactile-reactive bimanual manipulation dataset, collected via teleoperation on a\nDexmate Vega-1 robot with two Sharpa Wave dexterous hands. Stored as a\nLeRobotDataset v3.0.\n\ud83c\udf10 Project Page \u00b7 \u270d\ufe0f Paper (arXiv) \u00b7 \ud83d\udcbb Code (T-Rex) \u00b7 \ud83d\ude80 Dataset Quickstart \u00b7 \ud83d\udcd3 Colab notebook\n\n  \n  \n  One episode from each of 20 motor primitives (head-camera view, cropped to the workspace), each with a different object.\n\n\n\n  \n  \n  Teleoperation setup: Manus gloves + VIVE\u2026 See the full description on the dataset page: https://huggingface.co/datasets/zekaiwang/trex_dataset.",
  "alternateName": [
    "zekaiwang/trex_dataset",
    "T-Rex Dataset"
  ],
  "creator": {
    "@type": "Person",
    "name": "Zekai Wang",
    "url": "https://huggingface.co/zekaiwang"
  },
  "keywords": [
    "robotics",
    "English",
    "mit",
    "1M - 10M",
