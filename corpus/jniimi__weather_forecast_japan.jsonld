    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/jniimi/weather_forecast_japan/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "jniimi/weather_forecast_japan - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/from_date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "from_date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/from_hour",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "from_hour"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/diff_days",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "diff_days"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/target_date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "target_date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/target_place",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "target_place"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/weather",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "weather"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/rain",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "rain"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/confidence",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "confidence"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/lowest",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "lowest"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/highest",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "highest"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/observatory_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "observatory_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/observatory_code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "observatory_code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/html_obtained_datetime",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "html_obtained_datetime"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/__index_level_0__",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "__index_level_0__"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "weather_forecast_japan",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tOverview\n\t\n\nThis dataset contains daily-collected weather forecasts for up to seven days ahead for all the meteorological observatories in Japan, published by the Japan Meteorological Agency (JMA) at https://www.jma.go.jp/bosai/forecast/. \nWe collect, structurize, and accumulate the prediction since the page is overridden whenever the information is updated. \nThe data is automatically updated daily using GitHub Actions. Since the actual forecasts are published multiple times a day\u2026 See the full description on the dataset page: https://huggingface.co/datasets/jniimi/weather_forecast_japan.",
  "alternateName": [
    "jniimi/weather_forecast_japan",
    "\"7days Weather Forecast in Japan (Dataset)\""
  ],
  "creator": {
    "@type": "Person",
    "name": "Junichiro Niimi",
    "url": "https://huggingface.co/jniimi"
  },
  "keywords": [
    "tabular-regression",
    "tabular-classification",
    "Japanese",
    "English",
    "cc-by-4.0",
    "100K - 1M",
    "parquet",
    "optimized-parquet",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "climate"
  ],
