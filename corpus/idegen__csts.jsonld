              "regex": "nonnormal_complete_data/(?:partial-)?(exploratory|confirmatory|reduced_11_clusters_exploratory|reduced_6_clusters_exploratory|reduced_50_segments_exploratory|reduced_25_segments_exploratory|reduced_11_clusters_confirmatory|reduced_6_clusters_confirmatory|reduced_50_segments_confirmatory|reduced_25_segments_confirmatory)/.+parquet$"
