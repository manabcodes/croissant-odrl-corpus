{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/keenable-ai/keenbench-results/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-news",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "news/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-scholar",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "scholar/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "news_splits/split_name"
      },
      "@id": "news_splits",
      "name": "news_splits",
      "description": "Splits for the news config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "news_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "news_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "news",
      "description": "keenable-ai/keenbench-results - 'news' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "news/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "news/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "news_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "news/query_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "column": "query_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "news/query_hash",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "column": "query_hash"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "news/query_text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "column": "query_text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "news/query_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "column": "query_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "news/query_origin",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "column": "query_origin"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "news/topical_domain",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "column": "topical_domain"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "news/hour_ts",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "column": "hour_ts"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "news/query_produced_at",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-news"
            },
            "extract": {
              "column": "query_produced_at"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "scholar_splits/split_name"
      },
      "@id": "scholar_splits",
      "name": "scholar_splits",
      "description": "Splits for the scholar config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "scholar_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "scholar_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "scholar",
      "description": "keenable-ai/keenbench-results - 'scholar' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "scholar/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-scholar"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "scholar/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "scholar_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scholar/query_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-scholar"
            },
            "extract": {
              "column": "query_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scholar/query_hash",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-scholar"
            },
            "extract": {
              "column": "query_hash"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scholar/query_text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-scholar"
            },
            "extract": {
              "column": "query_text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scholar/query_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-scholar"
            },
            "extract": {
              "column": "query_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scholar/query_origin",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-scholar"
            },
            "extract": {
              "column": "query_origin"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scholar/gold",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-scholar"
            },
            "extract": {
              "column": "gold"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scholar/hour_ts",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-scholar"
            },
            "extract": {
              "column": "hour_ts"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "keenbench-results",
  "description": "keenable-ai/keenbench-results dataset hosted on Hugging Face and contributed by the HF Datasets community",
  "alternateName": [
