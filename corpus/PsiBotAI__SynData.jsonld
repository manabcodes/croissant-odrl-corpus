      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
