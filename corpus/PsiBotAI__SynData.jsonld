{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/PsiBotAI/SynData/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-all_clips",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "all_clips/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "all_clips_splits/split_name"
      },
      "@id": "all_clips_splits",
      "name": "all_clips_splits",
      "description": "Splits for the all_clips config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_clips_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_clips_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all_clips",
      "description": "PsiBotAI/SynData - 'all_clips' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_clips/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all_clips/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_clips_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/subset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "subset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/clip_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "clip_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/task_key",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "task_key"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/task_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "task_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/volume_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "volume_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/rel_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "rel_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/zarr_tar_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "zarr_tar_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/start_idx",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "start_idx"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/end_idx",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "end_idx"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/num_frames",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "num_frames"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/fps",
          "dataType": "cr:Int16",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "fps"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/duration_sec",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "duration_sec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/modalities",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "modalities"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_clips/caption",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_clips"
            },
            "extract": {
              "column": "caption"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "SynData",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tSynData\n\t\n\n\u4e2d\u6587\u8bf4\u660e\n\n\t\n\t\t\n\t\n\t\n\t\tDemo\n\t\n\n\n  \n\n\nIf the video cannot be displayed in your environment, open it directly:\nassets/syndata-demo.mp4\n\n\t\n\t\t\n\t\n\t\n\t\t1. Overview\n\t\n\nSynData is a next-generation large-scale real-world multimodal dataset newly released by PsiBot. It comprehensively covers key dimensions including vision, language, and action, and provides highly realistic, high-density, and highly usable human data as a solid foundation for embodied intelligence training.\nPowered by\u2026 See the full description on the dataset page: https://huggingface.co/datasets/PsiBotAI/SynData.",
  "alternateName": [
    "PsiBotAI/SynData"
  ],
  "creator": {
    "@type": "Organization",
    "name": "PsiBot",
    "url": "https://huggingface.co/PsiBotAI"
  },
  "keywords": [
    "English",
    "cc-by-4.0",
    "100K - 1M",
    "parquet",
    "3D",
    "Tabular",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/PsiBotAI/SynData",
