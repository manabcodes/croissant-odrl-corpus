    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/allenai/qasper/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-qasper",
      "name": "parquet-files-for-config-qasper",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "qasper/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "qasper_splits/split_name"
      },
      "@id": "qasper_splits",
      "name": "qasper_splits",
      "description": "Splits for the qasper config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qasper_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "qasper_splits/split_name": "train"
        },
        {
          "qasper_splits/split_name": "validation"
        },
        {
          "qasper_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "qasper",
      "name": "qasper",
      "description": "allenai/qasper - 'qasper' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qasper/split",
          "name": "qasper/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qasper"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "qasper/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "qasper_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qasper/id",
          "name": "qasper/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qasper"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qasper/title",
          "name": "qasper/title",
          "description": "Column 'title' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qasper"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qasper/abstract",
          "name": "qasper/abstract",
          "description": "Column 'abstract' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qasper"
            },
            "extract": {
              "column": "abstract"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qasper/full_text",
          "name": "qasper/full_text",
          "description": "Column 'full_text' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "qasper/full_text/section_name",
              "name": "qasper/full_text/section_name",
              "description": "Column 'full_text' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-qasper"
                },
                "extract": {
                  "column": "full_text"
                },
                "transform": {
                  "jsonPath": "section_name"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "qasper/full_text/paragraphs",
              "name": "qasper/full_text/paragraphs",
              "description": "Column 'full_text' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-qasper"
                },
                "extract": {
                  "column": "full_text"
                }
              },
              "repeated": true
            }
          ],
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "qasper/qas",
          "name": "qasper/qas",
          "description": "Column 'qas' from the Hugging Face parquet file.",
