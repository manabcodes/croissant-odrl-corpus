  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "qasper",
  "description": "A dataset containing 1585 papers with 5049 information-seeking questions asked by regular readers of NLP papers, and answered by a separate set of NLP practitioners.",
  "alternateName": [
    "allenai/qasper",
    "QASPER"
  ],
  "creator": {
    "@type": "Organization",
