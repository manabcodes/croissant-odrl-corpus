  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "SQuADDS_DB",
  "identifier": "10.57967/hf/1582",
  "description": "\n   \n\n\n\n\t\n\t\t\n\t\n\t\n\t\tSQuADDS_DB - a Superconducting Qubit And Device Design and Simulation Database\n\t\n\nThe SQuADDS (Superconducting Qubit And Device Design and Simulation) Database Project is an open-source resource aimed at advancing research in superconducting quantum device designs. It provides a robust workflow for generating and simulating superconducting quantum device designs, facilitating the accurate prediction of Hamiltonian parameters across a wide range of design geometries.\u2026 See the full description on the dataset page: https://huggingface.co/datasets/SQuADDS/SQuADDS_DB.",
  "alternateName": [
    "SQuADDS/SQuADDS_DB",
    "SQuADDS_DB"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Superconducting Qubit And Device Design and Simulation database",
    "url": "https://huggingface.co/SQuADDS"
  },
