                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/test_info/function_name",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "test_info"
                },
                "transform": {
                  "jsonPath": "function_name"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/test_info/parameter_list",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "test_info"
                },
                "transform": {
                  "jsonPath": "parameter_list"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/gpt_pass_sequence",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
