        {
          "@type": "cr:Field",
          "@id": "default/metadata",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/metadata/original_instruction",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
