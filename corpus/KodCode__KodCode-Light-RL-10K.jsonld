            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/test_info",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/test_info/docstring",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "test_info"
                },
                "transform": {
                  "jsonPath": "docstring"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/test_info/function_declaration",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "test_info"
                },
                "transform": {
