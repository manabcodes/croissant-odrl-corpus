  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/jasperai/monet/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-parquet",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "parquet/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "parquet_splits/split_name"
      },
      "@id": "parquet_splits",
      "name": "parquet_splits",
      "description": "Splits for the parquet config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "parquet_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "parquet_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "parquet",
      "description": "jasperai/monet - 'parquet' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "parquet/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-parquet"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "parquet/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "parquet_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "parquet/__key__",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-parquet"
            },
            "extract": {
              "column": "__key__"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "parquet/thumbnail",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-parquet"
            },
            "extract": {
              "column": "thumbnail"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
