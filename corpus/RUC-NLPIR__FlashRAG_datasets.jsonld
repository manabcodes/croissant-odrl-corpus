    {
      "@type": "cr:RecordSet",
      "@id": "2wikimultihopqa",
      "description": "RUC-NLPIR/FlashRAG_datasets - '2wikimultihopqa' subset (first 5GB)\n\nAdditional information:\n- 2 splits: train, dev",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "2wikimultihopqa/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
