  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "am_splits/split_name"
      },
      "@id": "am_splits",
      "name": "am_splits",
      "description": "Splits for the am config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "am_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "am_splits/split_name": "low"
        },
        {
          "am_splits/split_name": "medium"
        },
        {
          "am_splits/split_name": "high"
        },
        {
          "am_splits/split_name": "top"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "am",
      "description": "tum-nlp/PluraMath - 'am' subset\n\nAdditional information:\n- 4 splits: low, medium, high, top",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "am/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-am"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "am/(?:partial-)?(low|medium|high|top)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "am_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "am/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-am"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "am/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-am"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "am/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-am"
            },
            "extract": {
              "column": "answer"
            }
          }
        }
      ]
    },
