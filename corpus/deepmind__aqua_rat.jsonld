{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/deepmind/aqua_rat/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-raw",
      "name": "parquet-files-for-config-raw",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "raw/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-tokenized",
      "name": "parquet-files-for-config-tokenized",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "tokenized/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "raw_splits/split_name"
      },
      "@id": "raw_splits",
      "name": "raw_splits",
      "description": "Splits for the raw config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "raw_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "raw_splits/split_name": "train"
        },
        {
          "raw_splits/split_name": "test"
        },
        {
          "raw_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "raw",
      "name": "raw",
      "description": "deepmind/aqua_rat - 'raw' subset\n\nAdditional information:\n- 3 splits: train, test, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "raw/split",
          "name": "raw/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-raw"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "raw/(?:partial-)?(train|test|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "raw_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "raw/question",
          "name": "raw/question",
          "description": "Column 'question' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-raw"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "raw/options",
          "name": "raw/options",
          "description": "Column 'options' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-raw"
            },
            "extract": {
              "column": "options"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "raw/rationale",
          "name": "raw/rationale",
          "description": "Column 'rationale' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-raw"
            },
            "extract": {
              "column": "rationale"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "raw/correct",
          "name": "raw/correct",
          "description": "Column 'correct' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-raw"
            },
            "extract": {
              "column": "correct"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "tokenized_splits/split_name"
      },
      "@id": "tokenized_splits",
      "name": "tokenized_splits",
      "description": "Splits for the tokenized config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "tokenized_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "tokenized_splits/split_name": "train"
        },
        {
          "tokenized_splits/split_name": "test"
        },
        {
          "tokenized_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "tokenized",
      "name": "tokenized",
      "description": "deepmind/aqua_rat - 'tokenized' subset\n\nAdditional information:\n- 3 splits: train, test, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "tokenized/split",
          "name": "tokenized/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tokenized"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "tokenized/(?:partial-)?(train|test|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "tokenized_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tokenized/question",
          "name": "tokenized/question",
          "description": "Column 'question' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tokenized"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tokenized/options",
          "name": "tokenized/options",
          "description": "Column 'options' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tokenized"
            },
            "extract": {
              "column": "options"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "tokenized/rationale",
          "name": "tokenized/rationale",
          "description": "Column 'rationale' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tokenized"
            },
            "extract": {
              "column": "rationale"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tokenized/correct",
          "name": "tokenized/correct",
          "description": "Column 'correct' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tokenized"
            },
            "extract": {
              "column": "correct"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "aqua_rat",
  "description": "\n\t\n\t\t\n\t\tDataset Card for AQUA-RAT\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nA large-scale dataset consisting of approximately 100,000 algebraic word problems.\nThe solution to each question is explained step-by-step using natural language.\nThis data is used to train a program generation model that learns to generate the explanation,\nwhile generating the program that solves the question.\n\n\t\n\t\t\n\t\tSupported Tasks and Leaderboards\n\t\n\n\n\t\n\t\t\n\t\tLanguages\n\t\n\nen\n\n\t\n\t\t\n\t\tDataset Structure\n\t\n\n\n\t\n\t\t\n\t\tData Instances\u2026 See the full description on the dataset page: https://huggingface.co/datasets/deepmind/aqua_rat.",
  "alternateName": [
    "deepmind/aqua_rat",
    "Algebra Question Answering with Rationales"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Deepmind",
    "url": "https://huggingface.co/deepmind"
  },
  "keywords": [
    "question-answering",
    "multiple-choice-qa",
    "crowdsourced",
    "crowdsourced",
    "expert-generated",
    "monolingual",
    "original",
    "English",
    "apache-2.0",
    "100K - 1M",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "arxiv:1705.04146",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
