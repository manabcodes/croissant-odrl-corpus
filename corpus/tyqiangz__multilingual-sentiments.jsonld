  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "all_splits/split_name"
      },
      "@id": "all_splits",
      "name": "all_splits",
      "description": "Splits for the all config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_splits/split_name": "train"
        },
        {
          "all_splits/split_name": "validation"
        },
        {
          "all_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all",
      "name": "all",
      "description": "tyqiangz/multilingual-sentiments - 'all' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all/split",
          "name": "all/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/text",
          "name": "all/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/source",
          "name": "all/source",
          "description": "Column 'source' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/language",
          "name": "all/language",
          "description": "Column 'language' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/label",
          "name": "all/label",
          "description": "ClassLabel column 'label' from the Hugging Face parquet file.\nLabels:\npositive (0), neutral (1), negative (2)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "label"
            }
          }
        }
      ]
