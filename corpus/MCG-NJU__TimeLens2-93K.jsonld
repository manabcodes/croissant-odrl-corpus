                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "preview/conversation/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-preview"
                },
                "extract": {
                  "column": "conversation"
                },
                "transform": {
