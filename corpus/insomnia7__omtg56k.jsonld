{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/insomnia7/omtg56k/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-rl",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "rl/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-sft",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "sft/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "rl_splits/split_name"
      },
      "@id": "rl_splits",
      "name": "rl_splits",
      "description": "Splits for the rl config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "rl_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "rl_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "rl",
      "description": "insomnia7/omtg56k - 'rl' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "rl/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-rl"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "rl/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "rl_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rl/messages",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "rl/messages/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-rl"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "rl/messages/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-rl"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "rl/videos",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-rl"
            },
            "extract": {
              "column": "videos"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "rl/_original_query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-rl"
            },
            "extract": {
              "column": "_original_query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rl/_query_refined",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-rl"
            },
            "extract": {
              "column": "_query_refined"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "sft_splits/split_name"
      },
      "@id": "sft_splits",
      "name": "sft_splits",
      "description": "Splits for the sft config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "sft_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "sft_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "sft",
      "description": "insomnia7/omtg56k - 'sft' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "sft/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-sft"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "sft/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "sft_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "sft/messages",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "sft/messages/role_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-sft"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "sft/messages/content_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-sft"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "sft/videos",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-sft"
            },
            "extract": {
              "column": "videos"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "omtg56k",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tOMTG-56K: A High-Quality Instruction-Tuning Dataset for One-to-Many Temporal Grounding\n\t\n\nOMTG-56K is a large-scale, high-fidelity instruction-tuning dataset introduced in the paper\n\"Towards One-to-Many Temporal Grounding\" (ICML 2026, under review). It empowers MLLMs to\nevolve from one-to-one to one-to-many temporal grounding via SFT + RL (GRPO).\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Summary\n\t\n\n\n\t\n\t\t\nItem\nValue\n\n\n\t\t\nTask\nOne-to-Many Temporal Grounding (OMTG)\n\n\nTotal samples\n~56,000\n\n\nSFT split\n~46\u2026 See the full description on the dataset page: https://huggingface.co/datasets/insomnia7/omtg56k.",
  "alternateName": [
    "insomnia7/omtg56k",
    "OMTG-56K Training Dataset"
  ],
  "creator": {
    "@type": "Person",
    "name": "XuQi",
    "url": "https://huggingface.co/insomnia7"
  },
  "keywords": [
    "video-text-to-text",
    "visual-question-answering",
    "English",
    "cc-by-nc-4.0",
    "10K - 100K",
    "json",
    "Text",
    "Video",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2606.06294",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "video",
    "temporal-grounding",
    "one-to-many",
    "instruction-tuning",
    "multimodal",
    "mllm",
    "sft",
    "rl",
    "grpo"
  ],
