    {
      "@type": "cr:RecordSet",
      "@id": "preference",
      "description": "nvidia/HelpSteer3 - 'preference' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "preference/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-preference"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "preference/(?:partial-)?(train|validation)/.+parquet$"
            }
