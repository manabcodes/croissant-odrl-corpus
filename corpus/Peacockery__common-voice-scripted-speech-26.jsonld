{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Peacockery/common-voice-scripted-speech-26/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "validation"
        },
        {
          "default_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "Peacockery/common-voice-scripted-speech-26 - 'default' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/audio",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/audio/bytes",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "audio"
                },
                "transform": {
                  "jsonPath": "bytes"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/audio/path",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "audio"
                },
                "transform": {
                  "jsonPath": "path"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_audio_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_audio_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/upstream_split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "upstream_split"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_dataset_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_dataset_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_archive",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_archive"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/collection",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "collection"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/locale",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "locale"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/license",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "license"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/license_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "license_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/duration_ms",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "duration_ms"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/client_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "client_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sentence_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sentence_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sentence",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sentence"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sentence_domain",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sentence_domain"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/up_votes",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "up_votes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/down_votes",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "down_votes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/age",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "age"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/gender",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gender"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/accents",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "accents"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/variant",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "variant"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/segment",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "segment"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "common-voice-scripted-speech-26",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tCommon Voice Scripted Speech\n\t\n\nA row-normalized multilingual ASR dataset built from Mozilla Data Collective\nCommon Voice Scripted Speech. Each upstream archive is converted to appendable\nparquet shards under data/<upstream_split>/, one shard per source archive and\nsplit, with audio bytes embedded in an audio struct column.\n\n\t\n\t\t\n\t\n\t\n\t\tStatus\n\t\n\n\nManifest languages: 60\nLanguages uploaded: 18\n\n\n\t\n\t\t\n\t\n\t\n\t\tColumns\n\t\n\n\naudio (bytes, path)\nsentence, locale, language, upstream_split\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Peacockery/common-voice-scripted-speech-26.",
  "alternateName": [
    "Peacockery/common-voice-scripted-speech-26",
    "Common Voice Scripted Speech"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Peacockery Studio",
    "url": "https://huggingface.co/Peacockery"
  },
