  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/IFM/TxT360-Midas/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-stage1",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "stage1/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-stage2",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "stage2/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-stage3",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "stage3/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-stage4",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "stage4/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "stage1_splits/split_name"
      },
      "@id": "stage1_splits",
      "name": "stage1_splits",
      "description": "Splits for the stage1 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "stage1_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "stage1_splits/split_name": "other_behaviors"
        },
        {
          "stage1_splits/split_name": "reasoning_behaviors"
        },
        {
          "stage1_splits/split_name": "thinking_traces"
        },
        {
          "stage1_splits/split_name": "web"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "stage1",
      "description": "IFM/TxT360-Midas - 'stage1' subset\n\nAdditional information:\n- 4 splits: other_behaviors, reasoning_behaviors, thinking_traces, web",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "stage1/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-stage1"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "stage1/(?:partial-)?(other_behaviors|reasoning_behaviors|thinking_traces|web)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "stage1_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "stage1/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-stage1"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
