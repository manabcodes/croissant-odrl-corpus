          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-stage2"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "stage3_splits/split_name"
      },
      "@id": "stage3_splits",
      "name": "stage3_splits",
      "description": "Splits for the stage3 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "stage3_splits/split_name",
