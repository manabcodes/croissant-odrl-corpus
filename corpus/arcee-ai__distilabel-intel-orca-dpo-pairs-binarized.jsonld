    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/arcee-ai/distilabel-intel-orca-dpo-pairs-binarized/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "name": "parquet-files-for-config-default",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "arcee-ai/distilabel-intel-orca-dpo-pairs-binarized - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "name": "default/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/prompt",
          "name": "default/prompt",
          "description": "Column 'prompt' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/chosen",
          "name": "default/chosen",
          "description": "Column 'chosen' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/chosen/content",
              "name": "default/chosen/content",
              "description": "Column 'chosen' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "chosen"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/chosen/role",
              "name": "default/chosen/role",
              "description": "Column 'chosen' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "chosen"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            }
          ],
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "default/rejected",
          "name": "default/rejected",
          "description": "Column 'rejected' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/rejected/content",
              "name": "default/rejected/content",
              "description": "Column 'rejected' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "rejected"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/rejected/role",
              "name": "default/rejected/role",
              "description": "Column 'rejected' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "rejected"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            }
          ],
          "repeated": true
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "distilabel-intel-orca-dpo-pairs-binarized",
  "description": "This is the binarized version of distilabel Orca Pairs for DPO and ORPO. \nReference: https://huggingface.co/datasets/argilla/distilabel-intel-orca-dpo-pairs?row=0\n",
  "alternateName": [
