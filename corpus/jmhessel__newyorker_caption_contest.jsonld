  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "explanation_splits/split_name"
      },
      "@id": "explanation_splits",
      "name": "explanation_splits",
      "description": "Splits for the explanation config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "explanation_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "explanation_splits/split_name": "train"
        },
        {
          "explanation_splits/split_name": "validation"
        },
        {
          "explanation_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "explanation",
      "name": "explanation",
      "description": "jmhessel/newyorker_caption_contest - 'explanation' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "explanation/split",
          "name": "explanation/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-explanation"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "explanation/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "explanation_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "explanation/image",
          "name": "explanation/image",
          "description": "Image column 'image' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-explanation"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "explanation/contest_number",
          "name": "explanation/contest_number",
          "description": "Column 'contest_number' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
