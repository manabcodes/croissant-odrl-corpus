  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "af_splits/split_name"
      },
      "@id": "af_splits",
      "name": "af_splits",
      "description": "Splits for the af config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "af_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "af_splits/split_name": "train"
        },
        {
          "af_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "af",
      "name": "af",
      "description": "allenai/c4 - 'af' subset (first 5GB) (only the first 100 subsets are included in this metadata)\n\nAdditional information:\n- 2 splits: train, validation\n- 1 skipped column: timestamp",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "af/split",
          "name": "af/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-af"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "af/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
