            },
            "extract": {
              "column": "problem_statement"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/hints_text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "hints_text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/resolved_issues",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/resolved_issues/body",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "resolved_issues"
                },
                "transform": {
                  "jsonPath": "body"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/resolved_issues/number",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "resolved_issues"
                },
                "transform": {
                  "jsonPath": "number"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/resolved_issues/title",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "resolved_issues"
                },
                "transform": {
                  "jsonPath": "title"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/base_commit",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "base_commit"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/commit_to_review",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/commit_to_review/head_commit",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "commit_to_review"
                },
                "transform": {
                  "jsonPath": "head_commit"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/commit_to_review/head_commit_message",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "commit_to_review"
                },
                "transform": {
                  "jsonPath": "head_commit_message"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/commit_to_review/patch_to_review",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "commit_to_review"
                },
                "transform": {
