          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/reference_review_comments/diff_hunk",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
