            {
              "@type": "cr:Field",
              "@id": "default/reference_review_comments/original_line",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "reference_review_comments"
                },
                "transform": {
                  "jsonPath": "original_line"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/reference_review_comments/original_start_line",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "reference_review_comments"
                },
                "transform": {
                  "jsonPath": "original_start_line"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/reference_review_comments/path",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "reference_review_comments"
                },
                "transform": {
                  "jsonPath": "path"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/reference_review_comments/start_line",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "reference_review_comments"
                },
                "transform": {
                  "jsonPath": "start_line"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/reference_review_comments/text",
              "dataType": "sc:Text",
