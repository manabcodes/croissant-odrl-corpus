{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/paint-by-inpaint/PIPE/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-data",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "data/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "paint-by-inpaint/PIPE - 'default' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/source_img",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "source_img"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/target_img",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "target_img"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Instruction_VLM-LLM",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Instruction_VLM-LLM"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Instruction_Class",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Instruction_Class"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Instruction_Ref_Dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Instruction_Ref_Dataset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/object_location",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "object_location"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/target_img_dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "target_img_dataset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/img_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "img_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ann_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ann_id"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "data_splits/split_name"
      },
      "@id": "data_splits",
      "name": "data_splits",
      "description": "Splits for the data config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "data_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "data_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "data",
      "description": "paint-by-inpaint/PIPE - 'data' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "data/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "data/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "data_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/source_img",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "source_img"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/target_img",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "target_img"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/Instruction_VLM-LLM",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "Instruction_VLM-LLM"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/Instruction_Class",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "Instruction_Class"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/Instruction_Ref_Dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "Instruction_Ref_Dataset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/object_location",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "object_location"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/target_img_dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "target_img_dataset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/img_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "img_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "data/ann_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-data"
            },
            "extract": {
              "column": "ann_id"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "PIPE",
  "description": "\n\t\n\t\t\n\t\tDataset Card for PIPE Dataset\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nThe PIPE (Paint by InPaint Edit) dataset is designed to enhance the efficacy of mask-free, instruction-following image editing models by providing a large-scale collection of image pairs and diverse object addition instructions. Comprising approximately 1 million image pairs, PIPE includes both source and target images, along with corresponding natural language instructions for object addition. The dataset leverages extensive\u2026 See the full description on the dataset page: https://huggingface.co/datasets/paint-by-inpaint/PIPE.",
  "alternateName": [
    "paint-by-inpaint/PIPE"
  ],
  "creator": {
    "@type": "Organization",
    "name": "paint-by-inpaint",
    "url": "https://huggingface.co/paint-by-inpaint"
  },
  "keywords": [
    "image-to-image",
    "cc-by-4.0",
    "1M - 10M",
    "parquet",
    "Image",
    "Text",
    "Datasets",
    "Dask",
    "Croissant",
    "Polars",
    "arxiv:2404.18212",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
