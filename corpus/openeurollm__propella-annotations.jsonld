    {
      "@type": "cr:RecordSet",
      "@id": "fineweb-2",
      "description": "openeurollm/propella-annotations - 'fineweb-2' subset\n\nAdditional information:\n- 6 splits: deu_Latn, fin_Latn, fra_Latn, ita_Latn, spa_Latn, swe_Latn",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "fineweb-2/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fineweb-2"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "fineweb\\-2/(?:partial-)?(deu_Latn|fin_Latn|fra_Latn|ita_Latn|spa_Latn|swe_Latn)/.+parquet$"
            }
          },
          "references": {
            "field": {
