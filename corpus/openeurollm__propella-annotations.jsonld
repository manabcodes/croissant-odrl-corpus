      "field": [
        {
          "@type": "cr:Field",
          "@id": "fineweb-2_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "fineweb-2_splits/split_name": "deu_Latn"
        },
        {
          "fineweb-2_splits/split_name": "fin_Latn"
        },
        {
          "fineweb-2_splits/split_name": "fra_Latn"
        },
        {
