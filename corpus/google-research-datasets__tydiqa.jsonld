  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/google-research-datasets/tydiqa/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-primary_task",
      "name": "parquet-files-for-config-primary_task",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "primary_task/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-secondary_task",
      "name": "parquet-files-for-config-secondary_task",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "secondary_task/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "primary_task_splits/split_name"
      },
      "@id": "primary_task_splits",
      "name": "primary_task_splits",
      "description": "Splits for the primary_task config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "primary_task_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "primary_task_splits/split_name": "train"
        },
        {
          "primary_task_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "primary_task",
      "name": "primary_task",
      "description": "google-research-datasets/tydiqa - 'primary_task' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "primary_task/split",
          "name": "primary_task/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-primary_task"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "primary_task/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
