                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "primary_task/passage_answer_candidates/plaintext_end_byte",
              "name": "primary_task/passage_answer_candidates/plaintext_end_byte",
              "description": "Column 'passage_answer_candidates' from the Hugging Face parquet file.",
              "dataType": "sc:Integer",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-primary_task"
                },
                "extract": {
                  "column": "passage_answer_candidates"
                },
                "transform": {
                  "jsonPath": "plaintext_end_byte"
                }
              }
            }
