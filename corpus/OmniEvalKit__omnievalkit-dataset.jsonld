  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "aishell1_test_splits/split_name"
      },
      "@id": "aishell1_test_splits",
      "name": "aishell1_test_splits",
      "description": "Splits for the aishell1_test config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "aishell1_test_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "aishell1_test_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "aishell1_test",
      "description": "OmniEvalKit/omnievalkit-dataset - 'aishell1_test' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "aishell1_test/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aishell1_test"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "aishell1_test/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "aishell1_test_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "aishell1_test/name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aishell1_test"
            },
            "extract": {
              "column": "name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "aishell1_test/WavPath",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aishell1_test"
            },
            "extract": {
              "column": "WavPath"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "aishell1_test/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aishell1_test"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "aishell1_test/duration",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aishell1_test"
            },
            "extract": {
