  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "arena-human-preference-140k",
  "description": "\n\t\n\t\t\n\t\tOverview\n\t\n\nThis dataset contains user votes collected in the text-only category. Each row represents a single vote judging two models (model_a and model_b) on a user conversation, along with the full conversation history and metadata. Key fields include:\n\nid: Unique feedback ID of each vote/row.\nevaluation_session_id: Unique ID of each evaluation session, which can contain multiple separate votes/evaluations. \nevaluation_order: Evaluation order of the current vote.\nwinner: Battle\u2026 See the full description on the dataset page: https://huggingface.co/datasets/lmarena-ai/arena-human-preference-140k.",
  "alternateName": [
    "lmarena-ai/arena-human-preference-140k"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Arena",
    "url": "https://huggingface.co/lmarena-ai"
  },
