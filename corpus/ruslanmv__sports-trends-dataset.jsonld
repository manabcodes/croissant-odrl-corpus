              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "home_form_last_10"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/away_form_last_10",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "away_form_last_10"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/home_goals_for_last_5",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "home_goals_for_last_5"
            }
          }
        },
        {
