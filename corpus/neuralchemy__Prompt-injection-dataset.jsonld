{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/neuralchemy/Prompt-injection-dataset/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-core",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "core/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-full",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "full/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "core_splits/split_name"
      },
      "@id": "core_splits",
      "name": "core_splits",
      "description": "Splits for the core config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "core_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "core_splits/split_name": "train"
        },
        {
          "core_splits/split_name": "validation"
        },
        {
          "core_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "core",
      "description": "neuralchemy/Prompt-injection-dataset - 'core' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "core/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "core/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "core_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/label",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/severity",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "severity"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/group_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "group_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/augmented",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "augmented"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "core/tags",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-core"
            },
            "extract": {
              "column": "tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "full_splits/split_name"
      },
      "@id": "full_splits",
      "name": "full_splits",
      "description": "Splits for the full config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "full_splits/split_name": "train"
        },
        {
          "full_splits/split_name": "validation"
        },
        {
          "full_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "full",
      "description": "neuralchemy/Prompt-injection-dataset - 'full' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "full/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "full_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/label",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/severity",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "severity"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/group_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "group_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/augmented",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "augmented"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/tags",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Prompt-injection-dataset",
  "description": "\n\t\n\t\t\n\t\tadvance dataset if you want for llm security\n\t\n\nhttps://huggingface.co/datasets/neuralchemy/prompt-injection-Threat-Matrix\n\n\t\n\t\t\n\t\tPrompt Injection & Jailbreak Detection Dataset\n\t\n\nA high-quality, leakage-free binary classification dataset for detecting prompt injection and jailbreak attacks against Large Language Models.\n\nZero data leakage \u2014 group-aware splitting confirmed\nBalanced classes \u2014 ~60% malicious / 40% benign\nTwo configs \u2014 core for classical ML, full for transformers\n29\u2026 See the full description on the dataset page: https://huggingface.co/datasets/neuralchemy/Prompt-injection-dataset.",
  "alternateName": [
    "neuralchemy/Prompt-injection-dataset"
  ],
  "creator": {
    "@type": "Organization",
    "name": "neuralchemy",
    "url": "https://huggingface.co/neuralchemy"
  },
  "keywords": [
    "text-classification",
