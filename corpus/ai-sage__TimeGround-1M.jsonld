      },
      "encodingFormat": "application/x-parquet",
      "includes": "tl/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-recordings",
      "containedIn": {
        "@id": "repo"
      },
