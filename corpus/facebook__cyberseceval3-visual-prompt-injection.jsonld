    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/facebook/cyberseceval3-visual-prompt-injection/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-visual_prompt_injection",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "visual_prompt_injection/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "visual_prompt_injection_splits/split_name"
      },
      "@id": "visual_prompt_injection_splits",
      "name": "visual_prompt_injection_splits",
      "description": "Splits for the visual_prompt_injection config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "visual_prompt_injection_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "visual_prompt_injection",
      "description": "facebook/cyberseceval3-visual-prompt-injection - 'visual_prompt_injection' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "visual_prompt_injection/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "visual_prompt_injection_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/id",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/system_prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "system_prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/user_input_text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "user_input_text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/image_description",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "image_description"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/image_text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "image_text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/judge_question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "judge_question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/injection_technique",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "injection_technique"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/injection_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "injection_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "visual_prompt_injection/risk_category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-visual_prompt_injection"
            },
            "extract": {
              "column": "risk_category"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "cyberseceval3-visual-prompt-injection",
  "description": "\n\t\n\t\t\n\t\tDataset Card for CyberSecEval 3 - Visual Prompt Injection Benchmark\n\t\n\n\n\t\n\t\t\n\t\tDataset Details\n\t\n\n\n\t\n\t\t\n\t\tDataset Description\n\t\n\nThis dataset provides a multimodal benchmark for visual prompt injection, with text/image inputs. It is part of CyberSecEval 3, the third edition of Meta's flagship suite of security benchmarks for LLMs to measure cybersecurity risks and capabilities across multiple domains.\n\nLanguage(s): English\nLicense: MIT\n\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Sources\n\t\n\n\nRepository: Link\u2026 See the full description on the dataset page: https://huggingface.co/datasets/facebook/cyberseceval3-visual-prompt-injection.",
  "alternateName": [
    "facebook/cyberseceval3-visual-prompt-injection",
    "CyberSecEval 3 - Visual Prompt Injection Benchmark"
  ],
  "creator": {
    "@type": "Organization",
    "name": "AI at Meta",
    "url": "https://huggingface.co/facebook"
  },
