{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Mohammadta/BEAM/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "100K"
        },
        {
          "default_splits/split_name": "500K"
        },
        {
          "default_splits/split_name": "1M"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "Mohammadta/BEAM - 'default' subset\n\nAdditional information:\n- 3 splits: 100K, 500K, 1M",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(100K|500K|1M)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/conversation_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "conversation_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/conversation_seed",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/conversation_seed/category",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "conversation_seed"
                },
                "transform": {
                  "jsonPath": "category"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/conversation_seed/id",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "conversation_seed"
                },
                "transform": {
                  "jsonPath": "id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/conversation_seed/subtopics",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "conversation_seed"
                },
                "transform": {
                  "jsonPath": "subtopics"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "default/conversation_seed/theme",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "conversation_seed"
                },
                "transform": {
                  "jsonPath": "theme"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/conversation_seed/title",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "conversation_seed"
                },
                "transform": {
                  "jsonPath": "title"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/narratives",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "narratives"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/user_profile",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/user_profile/user_info",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "user_profile"
                },
                "transform": {
                  "jsonPath": "user_info"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/user_profile/user_relationships",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "user_profile"
                },
                "transform": {
                  "jsonPath": "user_relationships"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/conversation_plan",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "conversation_plan"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/user_questions",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/user_questions/messages",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "user_questions"
                },
                "transform": {
                  "jsonPath": "messages"
                }
              },
              "isArray": true,
              "arrayShape": "-1,-1"
            },
            {
              "@type": "cr:Field",
              "@id": "default/user_questions/time_anchor",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "user_questions"
                },
                "transform": {
                  "jsonPath": "time_anchor"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/chat",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/chat/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "chat"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/chat/id_0",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "chat"
                },
                "transform": {
                  "jsonPath": "id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/chat/index",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "chat"
                },
                "transform": {
                  "jsonPath": "index"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/chat/question_type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "chat"
                },
                "transform": {
                  "jsonPath": "question_type"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/chat/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "chat"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/chat/time_anchor_0",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "chat"
                },
                "transform": {
                  "jsonPath": "time_anchor"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1,-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/probing_questions",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "probing_questions"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "BEAM",
  "description": "\n\t\n\t\t\n\t\tBeyond a Million Tokens: Benchmarking and Enhancing Long-Term Memory in LLMs\n\t\n\nThis huggingface page contains data for the paper: Beyond a Million Tokens: Benchmarking and Enhancing Long-Term Memory in LLMs\n\n\t\n\t\t\n\t\tAbstract\n\t\n\nEvaluating the abilities of large language models (LLMs) for tasks that require long-term memory and thus long-context reasoning, for example in conversational settings, is hampered by the existing benchmarks, which often lack narrative coherence, cover narrow\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Mohammadta/BEAM.",
  "alternateName": [
    "Mohammadta/BEAM"
  ],
  "creator": {
    "@type": "Person",
    "name": "Mohammad Tavakoli",
    "url": "https://huggingface.co/Mohammadta"
  },
