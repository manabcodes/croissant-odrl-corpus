      "description": "EuniAI/TerminalWorld - 'full' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
