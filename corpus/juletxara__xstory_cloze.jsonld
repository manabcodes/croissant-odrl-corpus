        "@id": "ar_splits/split_name"
      },
      "@id": "ar_splits",
      "name": "ar_splits",
      "description": "Splits for the ar config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ar_splits/split_name": "train"
        },
        {
          "ar_splits/split_name": "eval"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ar",
      "description": "juletxara/xstory_cloze - 'ar' subset\n\nAdditional information:\n- 2 splits: train, eval",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ar/(?:partial-)?(train|eval)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ar_splits/split_name"
            }
          }
        },
        {
