{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/MathLLMs/MathVision-Wild/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-MathVision_Wild",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "MathVision_Wild/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "MathVision_Wild_splits/split_name"
      },
      "@id": "MathVision_Wild_splits",
      "name": "MathVision_Wild_splits",
      "description": "Splits for the MathVision_Wild config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "MathVision_Wild_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "MathVision_Wild_splits/split_name": "test_photo"
        },
        {
          "MathVision_Wild_splits/split_name": "testmini_photo"
        },
        {
          "MathVision_Wild_splits/split_name": "testmini_screenshot"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "MathVision_Wild",
      "description": "MathLLMs/MathVision-Wild - 'MathVision_Wild' subset\n\nAdditional information:\n- 3 splits: test_photo, testmini_photo, testmini_screenshot",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "MathVision_Wild/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-MathVision_Wild"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "MathVision_Wild/(?:partial-)?(test_photo|testmini_photo|testmini_screenshot)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "MathVision_Wild_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "MathVision_Wild/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-MathVision_Wild"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "MathVision_Wild/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-MathVision_Wild"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "MathVision_Wild/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-MathVision_Wild"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "MathVision_Wild/level",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-MathVision_Wild"
            },
            "extract": {
              "column": "level"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "MathVision_Wild/subject",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-MathVision_Wild"
            },
            "extract": {
              "column": "subject"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "MathVision-Wild",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tMeasuring Multimodal Mathematical Reasoning with the MATH-Vision Dataset\n\t\n\n[\ud83d\udcbb Github] [\ud83c\udf10 Homepage]  [\ud83d\udcca Main Leaderboard ] [\ud83d\udcca Open Source Leaderboard ] [\ud83c\udf3f Wild Leaderboard ] [\ud83d\udd0d Visualization] [\ud83d\udcd6 Paper]\n\n\n\t\n\t\t\n\t\n\t\n\t\t\ud83d\udca5 News\n\t\n\n\n\ud83d\udd25\ud83d\udd25\ud83d\udd25 We are pleased to announce the release of full MathVision-Wild, which provides photographic versions of the complete MathVision test dataset.\n\n\n\t\n\t\t\n\t\n\t\n\t\t\ud83d\udc40 Introduction\n\t\n\nMathVision has been widely used in various SOTA  VLM (e.g., QwenVL\u2026 See the full description on the dataset page: https://huggingface.co/datasets/MathLLMs/MathVision-Wild.",
  "alternateName": [
    "MathLLMs/MathVision-Wild",
    "MathVision-Wild"
  ],
  "creator": {
    "@type": "Organization",
    "name": "LLMs for Reasoning",
    "url": "https://huggingface.co/MathLLMs"
  },
  "keywords": [
    "visual-question-answering",
    "image-to-text",
    "English",
    "apache-2.0",
    "1K - 10K",
    "imagefolder",
    "Image",
    "Text",
    "Datasets",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "math",
    "reasoning",
    "multimodal",
    "visual-reasoning",
    "real-world"
  ],
  "license": "https://choosealicense.com/licenses/apache-2.0/",
  "url": "https://huggingface.co/datasets/MathLLMs/MathVision-Wild",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
