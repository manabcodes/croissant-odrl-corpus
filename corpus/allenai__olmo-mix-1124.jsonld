    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-dclm",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "dclm/*/*.parquet"
    }
