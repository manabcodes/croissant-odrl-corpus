    {
      "@type": "cr:RecordSet",
      "@id": "activity_net_1",
      "description": "nvidia/Nemotron-VLM-Dataset-v2 - 'activity_net_1' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "activity_net_1/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-activity_net_1"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "activity_net_1/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "activity_net_1_splits/split_name"
            }
          }
        },
        {
