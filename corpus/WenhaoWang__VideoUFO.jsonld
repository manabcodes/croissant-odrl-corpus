{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/WenhaoWang/VideoUFO/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "Full"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "WenhaoWang/VideoUFO - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(Full)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ID",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ID"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Middle_Frame",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Middle_Frame"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Topic",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Topic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Detailed_Caption",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Detailed_Caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Brief_Caption",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Brief_Caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Start_Time",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Start_Time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/End_Time",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "End_Time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Aesthetic_Quality",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Aesthetic_Quality"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Background_Consistency",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Background_Consistency"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Dynamic_Degree",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Dynamic_Degree"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Imaging_Quality",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Imaging_Quality"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Motion_Smoothness",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Motion_Smoothness"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Subject_Consistency",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Subject_Consistency"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "VideoUFO",
  "description": "\n\t\n\t\t\n\t\tNews\n\t\n\n\ud83c\udf89 Accepted by NeurIPS 2025 Datasets and Benchmarks Track.\n\u2728 Ranked Top 1 in the Hugging Face Dataset Trending List for text-to-video generation on March 7, 2025.\n\ud83d\udc97 Financially supported by OpenAI through the Researcher Access Program.\n\ud83c\udf1f Downloaded 10,000+ times on Hugging Face after one month of release.\n\ud83d\udd25 Featured in Hugging Face Daily Papers on March 4, 2025.\n\ud83d\udc4d Drawn interest from leading companies such as Alibaba Group and Baidu Inc.\n\ud83d\ude0a Recommended by a famous writer on\u2026 See the full description on the dataset page: https://huggingface.co/datasets/WenhaoWang/VideoUFO.",
  "alternateName": [
    "WenhaoWang/VideoUFO"
  ],
  "creator": {
    "@type": "Person",
    "name": "Wenhao Wang",
    "url": "https://huggingface.co/WenhaoWang"
  },
  "keywords": [
    "text-to-video",
    "text-to-image",
    "image-to-video",
    "image-to-image",
    "English",
    "cc-by-4.0",
    "1M - 10M",
    "parquet",
    "Image",
    "Text",
    "Datasets",
    "Dask",
    "Croissant",
    "Polars",
    "arxiv:2503.01739",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "video-generation",
    "text-to-video-dataset"
  ],
