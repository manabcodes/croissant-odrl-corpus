    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Xaira-Therapeutics/X-Atlas-Orion/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-gene_metadata",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "gene_metadata/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "HCT116"
        },
        {
          "default_splits/split_name": "HEK293T"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "Xaira-Therapeutics/X-Atlas-Orion - 'default' subset (first 5GB)\n\nAdditional information:\n- 2 splits: HCT116, HEK293T",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(HCT116|HEK293T)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/gene_token_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gene_token_id"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/gene_expression",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gene_expression"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/cell_barcode",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "cell_barcode"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sample",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sample"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_features",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_features"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/guide_target",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "guide_target"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/gene_target",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gene_target"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/n_genes_by_counts",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "n_genes_by_counts"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/total_counts",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "total_counts"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/total_counts_mt",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "total_counts_mt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pct_counts_mt",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pct_counts_mt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pass_guide_filter",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pass_guide_filter"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "gene_metadata_splits/split_name"
      },
      "@id": "gene_metadata_splits",
      "name": "gene_metadata_splits",
      "description": "Splits for the gene_metadata config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "gene_metadata_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "gene_metadata_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "gene_metadata",
      "description": "Xaira-Therapeutics/X-Atlas-Orion - 'gene_metadata' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "gene_metadata/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gene_metadata"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "gene_metadata/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "gene_metadata_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gene_metadata/ensembl_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gene_metadata"
            },
            "extract": {
              "column": "ensembl_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gene_metadata/gene_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gene_metadata"
            },
            "extract": {
              "column": "gene_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gene_metadata/gene_token_id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-gene_metadata"
            },
            "extract": {
              "column": "gene_token_id"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "X-Atlas-Orion",
  "description": "\n\t\n\t\t\n\t\tX-Atlas/Orion\n\t\n\nX-Atlas: Orion edition (X-Atlas/Orion) is a Perturb-seq atlas containing two genome-wide Fix-Cryopreserve-ScRNAseq (FiCS) Perturb-seq screens that target all human \nprotein-coding genes (n = 18,903 genes). The dataset is comprised of eight million HCT116 and HEK293T cells, each deeply sequenced to a median of 16,000 unique molecular \nidentifiers (UMIs) per cell. The median on-target knockdown efficiency is 75.4% in HCT116 cells and 51.5% in HEK293T cells, with a median\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Xaira-Therapeutics/X-Atlas-Orion.",
  "alternateName": [
    "Xaira-Therapeutics/X-Atlas-Orion"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Xaira Therapeutics",
    "url": "https://huggingface.co/Xaira-Therapeutics"
  },
