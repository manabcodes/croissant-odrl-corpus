{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/agentica-org/DeepCoder-Preview-Dataset/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-codeforces",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "codeforces/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-lcbv5",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "lcbv5/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-primeintellect",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "primeintellect/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-taco",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "taco/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "codeforces_splits/split_name"
      },
      "@id": "codeforces_splits",
      "name": "codeforces_splits",
      "description": "Splits for the codeforces config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "codeforces_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "codeforces_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "codeforces",
      "description": "agentica-org/DeepCoder-Preview-Dataset - 'codeforces' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "codeforces/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-codeforces"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "codeforces/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "codeforces_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "codeforces/problem",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-codeforces"
            },
            "extract": {
              "column": "problem"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "codeforces/tests",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-codeforces"
            },
            "extract": {
              "column": "tests"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "lcbv5_splits/split_name"
      },
      "@id": "lcbv5_splits",
      "name": "lcbv5_splits",
      "description": "Splits for the lcbv5 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "lcbv5_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "lcbv5_splits/split_name": "train"
        },
        {
          "lcbv5_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "lcbv5",
      "description": "agentica-org/DeepCoder-Preview-Dataset - 'lcbv5' subset (first 5GB)\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "lcbv5/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-lcbv5"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "lcbv5/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "lcbv5_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "lcbv5/problem",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-lcbv5"
            },
            "extract": {
              "column": "problem"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "lcbv5/starter_code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-lcbv5"
            },
            "extract": {
              "column": "starter_code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "lcbv5/tests",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-lcbv5"
            },
            "extract": {
              "column": "tests"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "lcbv5/metadata",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "lcbv5/metadata/func_name",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-lcbv5"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "func_name"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "primeintellect_splits/split_name"
      },
      "@id": "primeintellect_splits",
      "name": "primeintellect_splits",
      "description": "Splits for the primeintellect config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "primeintellect_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "primeintellect_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "primeintellect",
      "description": "agentica-org/DeepCoder-Preview-Dataset - 'primeintellect' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "primeintellect/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-primeintellect"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "primeintellect/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "primeintellect_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "primeintellect/problem",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-primeintellect"
            },
            "extract": {
              "column": "problem"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "primeintellect/solutions",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-primeintellect"
            },
            "extract": {
              "column": "solutions"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "primeintellect/tests",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-primeintellect"
            },
            "extract": {
              "column": "tests"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "taco_splits/split_name"
      },
      "@id": "taco_splits",
      "name": "taco_splits",
      "description": "Splits for the taco config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "taco_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "taco_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "taco",
      "description": "agentica-org/DeepCoder-Preview-Dataset - 'taco' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "taco/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-taco"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "taco/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "taco_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "taco/problem",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-taco"
            },
            "extract": {
              "column": "problem"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "taco/tests",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-taco"
            },
            "extract": {
              "column": "tests"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "taco/solutions",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-taco"
            },
            "extract": {
              "column": "solutions"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "DeepCoder-Preview-Dataset",
  "description": "\n\t\n\t\t\n\t\tData\n\t\n\nOur training dataset consists of 24K problems paired with their test cases:\n\n7.5K TACO Verified problems.\n16K verified coding problems from PrimeIntellect\u2019s SYNTHETIC-1.\n600 LiveCodeBench (v5) problems submitted between May 1, 2023 and July 31, 2024.\n\nOur test dataset consists of:\n\nLiveCodeBench (v5) problems between August 1, 2024 and February 1, 2025.\nCodeforces problems from Qwen/CodeElo.\n\n\n\t\n\t\t\n\t\n\t\n\t\tFormat\n\t\n\nEach row in the dataset contains:\n\nproblem: The coding problem\u2026 See the full description on the dataset page: https://huggingface.co/datasets/agentica-org/DeepCoder-Preview-Dataset.",
  "alternateName": [
    "agentica-org/DeepCoder-Preview-Dataset"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Agentica",
    "url": "https://huggingface.co/agentica-org"
  },
  "keywords": [
    "English",
    "mit",
    "10K - 100K",
    "parquet",
    "Text",
    "Datasets",
    "Dask",
    "Croissant",
    "Polars",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "code"
  ],
