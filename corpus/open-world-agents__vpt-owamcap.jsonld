  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/open-world-agents/vpt-owamcap/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
