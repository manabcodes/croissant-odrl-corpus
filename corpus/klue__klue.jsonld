    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "dp_splits/split_name"
      },
      "@id": "dp_splits",
      "name": "dp_splits",
      "description": "Splits for the dp config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "dp_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "dp_splits/split_name": "train"
        },
        {
          "dp_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "dp",
      "name": "dp",
      "description": "klue/klue - 'dp' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "dp/split",
          "name": "dp/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dp"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "dp/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "dp_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dp/sentence",
          "name": "dp/sentence",
          "description": "Column 'sentence' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dp"
            },
            "extract": {
              "column": "sentence"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dp/index",
          "name": "dp/index",
          "description": "Column 'index' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dp"
            },
            "extract": {
              "column": "index"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "dp/word_form",
          "name": "dp/word_form",
