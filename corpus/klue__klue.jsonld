  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "klue",
  "description": "\n\t\n\t\t\n\t\tDataset Card for KLUE\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nKLUE is a collection of 8 tasks to evaluate natural language understanding capability of Korean language models. We delibrately select the 8 tasks, which are Topic Classification, Semantic Textual Similarity, Natural Language Inference, Named Entity Recognition, Relation Extraction, Dependency Parsing, Machine Reading Comprehension, and Dialogue State Tracking.\n\n\t\n\t\t\n\t\tSupported Tasks and Leaderboards\n\t\n\nTopic Classification, Semantic\u2026 See the full description on the dataset page: https://huggingface.co/datasets/klue/klue.",
  "alternateName": [
    "klue/klue",
    "KLUE"
  ],
  "creator": {
    "@type": "Organization",
    "name": "KLUE Benchmark",
    "url": "https://huggingface.co/klue"
  },
  "keywords": [
    "fill-mask",
    "question-answering",
    "text-classification",
    "text-generation",
    "token-classification",
    "extractive-qa",
    "named-entity-recognition",
    "natural-language-inference",
    "parsing",
    "semantic-similarity-scoring",
    "text-scoring",
    "topic-classification",
    "expert-generated",
    "expert-generated",
    "monolingual",
    "original",
    "Korean",
    "cc-by-sa-4.0",
    "100K - 1M",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "arxiv:2105.09680",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
