            },
            "extract": {
              "column": "Answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/wikipedia_link_1",
          "name": "default/wikipedia_link_1",
          "description": "Column 'wikipedia_link_1' from the Hugging Face parquet file.",
