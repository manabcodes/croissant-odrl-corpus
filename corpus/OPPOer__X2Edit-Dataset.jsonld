{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/OPPOer/X2Edit-Dataset/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "OPPOer/X2Edit-Dataset - 'default' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/1.0.jpg",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "1.0.jpg"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/2.jpg",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "2.jpg"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/json",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/json/aesthetic_score",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "aesthetic_score"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/aesthetic_score_v2_5",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "aesthetic_score_v2_5"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/aesthetic_score_v2_5_edit",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "aesthetic_score_v2_5_edit"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/caption_en",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "caption_en"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/caption_ori_en",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "caption_ori_en"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/caption_ori_zh",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "caption_ori_zh"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/caption_zh",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "caption_zh"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/instruction",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "instruction"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/liqe_score",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "liqe_score"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/liqe_score_clip",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "liqe_score_clip"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/liqe_score_clip_edit",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "liqe_score_clip_edit"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/liqe_score_edit",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "liqe_score_edit"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/model",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "model"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/score_7b",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "score_7b"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/task",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "task"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/watermark",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "watermark"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/txt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "txt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/__key__",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "__key__"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/__url__",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
