    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "zhifeixie/Voices-in-the-Wild-2M - 'default' subset\n\nAdditional information:\n- 54 splits: distortion, distortion_dropout, distortion_dropout_noise, distortion_noise, dropout, echo, echo_distortion, echo_distortion_dropout, echo_distortion_dropout_noise, echo_dropout, echo_noise, echo_recording, echo_recording_distortion, echo_recording_distortion_dropout, echo_recording_distortion_dropout_noise, echo_recording_distortion_noise, echo_recording_dropout, echo_recording_dropout_noise, far_field, far_field_distortion, far_field_distortion_dropout, far_field_distortion_dropout_noise, far_field_dropout, far_field_noise, far_field_recording, far_field_recording_distortion, far_field_recording_distortion_dropout, far_field_recording_distortion_dropout_noise, far_field_recording_distortion_noise, far_field_recording_dropout, far_field_recording_dropout_noise, noise, noise_dropout, obstructed, obstructed_distortion, obstructed_distortion_dropout, obstructed_distortion_dropout_noise, obstructed_dropout, obstructed_noise, obstructed_recording, obstructed_recording_distortion, obstructed_recording_distortion_dropout, obstructed_recording_distortion_dropout_noise, obstructed_recording_distortion_noise, obstructed_recording_dropout, obstructed_recording_dropout_noise, recording, recording_distortion, recording_distortion_dropout, recording_distortion_dropout_noise, recording_distortion_noise, recording_dropout, recording_dropout_noise, recording_noise",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(distortion|distortion_dropout|distortion_dropout_noise|distortion_noise|dropout|echo|echo_distortion|echo_distortion_dropout|echo_distortion_dropout_noise|echo_dropout|echo_noise|echo_recording|echo_recording_distortion|echo_recording_distortion_dropout|echo_recording_distortion_dropout_noise|echo_recording_distortion_noise|echo_recording_dropout|echo_recording_dropout_noise|far_field|far_field_distortion|far_field_distortion_dropout|far_field_distortion_dropout_noise|far_field_dropout|far_field_noise|far_field_recording|far_field_recording_distortion|far_field_recording_distortion_dropout|far_field_recording_distortion_dropout_noise|far_field_recording_distortion_noise|far_field_recording_dropout|far_field_recording_dropout_noise|noise|noise_dropout|obstructed|obstructed_distortion|obstructed_distortion_dropout|obstructed_distortion_dropout_noise|obstructed_dropout|obstructed_noise|obstructed_recording|obstructed_recording_distortion|obstructed_recording_distortion_dropout|obstructed_recording_distortion_dropout_noise|obstructed_recording_distortion_noise|obstructed_recording_dropout|obstructed_recording_dropout_noise|recording|recording_distortion|recording_distortion_dropout|recording_distortion_dropout_noise|recording_distortion_noise|recording_dropout|recording_dropout_noise|recording_noise)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/audio",
