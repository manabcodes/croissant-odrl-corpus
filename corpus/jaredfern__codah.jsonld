            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "codah/question_category",
          "name": "codah/question_category",
          "description": "ClassLabel column 'question_category' from the Hugging Face parquet file.\nLabels:\nIdioms (0), Reference (1), Polysemy (2), Negation (3), Quantitative (4), Others (5)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-codah"
            },
            "extract": {
              "column": "question_category"
            }
