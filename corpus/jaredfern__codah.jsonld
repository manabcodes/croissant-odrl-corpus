  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "codah_splits/split_name"
      },
      "@id": "codah_splits",
      "name": "codah_splits",
      "description": "Splits for the codah config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "codah_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "codah_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "codah",
      "name": "codah",
      "description": "jaredfern/codah - 'codah' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "codah/split",
          "name": "codah/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-codah"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "codah/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "codah_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "codah/id",
          "name": "codah/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
