        "@id": "fluxreason_splits/split_name"
      },
      "@id": "fluxreason_splits",
      "name": "fluxreason_splits",
      "description": "Splits for the fluxreason config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "fluxreason_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "fluxreason_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "fluxreason",
      "description": "zlab-princeton/i1-captions - 'fluxreason' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "fluxreason/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-fluxreason"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "fluxreason/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "fluxreason_splits/split_name"
            }
          }
        },
        {
