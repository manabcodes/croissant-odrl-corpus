  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Aniket-Tathe-08/Custom_common_voice_dataset_using_RVC/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "name": "parquet-files-for-config-default",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "test"
        },
        {
          "default_splits/split_name": "other"
        },
        {
          "default_splits/split_name": "dev"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "Aniket-Tathe-08/Custom_common_voice_dataset_using_RVC - 'default' subset\n\nAdditional information:\n- 4 splits: train, test, other, dev",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "name": "default/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|test|other|dev)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/client_id",
          "name": "default/client_id",
          "description": "Column 'client_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "client_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/path",
          "name": "default/path",
          "description": "Column 'path' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sentence",
          "name": "default/sentence",
          "description": "Column 'sentence' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sentence"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/up_votes",
          "name": "default/up_votes",
          "description": "Column 'up_votes' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "up_votes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/down_votes",
          "name": "default/down_votes",
          "description": "Column 'down_votes' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "down_votes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/age",
          "name": "default/age",
          "description": "Column 'age' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "age"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/gender",
          "name": "default/gender",
          "description": "Column 'gender' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gender"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/accents",
          "name": "default/accents",
          "description": "Column 'accents' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "accents"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/locale",
          "name": "default/locale",
          "description": "Column 'locale' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "locale"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/segment",
          "name": "default/segment",
          "description": "Column 'segment' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "segment"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "Custom_common_voice_dataset_using_RVC",
  "description": "\n\t\n\t\t\n\t\tCustom Data Augmentation for low resource ASR using Bark and    Retrieval-Based Voice Conversion\n\t\n\nCustom common_voice_v11 corpus with a custom voice was was created using RVC(Retrieval-Based Voice Conversion) \nThe model underwent 200 epochs of training, utilizing a total of 1 hour of audio clips. The data was scraped from Youtube.\nThe audio in the custom generated dataset is of a YouTuber named \nAjay Pandey\n\n\t\n\t\t\n\t\n\t\n\t\tDescription\n\t\n\n\n\n\t\n\t\n\t\n\t\tlicense: cc0-1.0\nlanguage:\n- hi\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Aniket-Tathe-08/Custom_common_voice_dataset_using_RVC.",
  "alternateName": [
    "Aniket-Tathe-08/Custom_common_voice_dataset_using_RVC",
    "Custom Common Voice"
  ],
  "creator": {
    "@type": "Person",
    "name": "Aniket Tathe",
    "url": "https://huggingface.co/Aniket-Tathe-08"
  },
