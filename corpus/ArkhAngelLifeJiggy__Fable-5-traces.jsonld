{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ArkhAngelLifeJiggy/Fable-5-traces/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-pi_agent",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "pi_agent/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "pi_agent_splits/split_name"
      },
      "@id": "pi_agent_splits",
      "name": "pi_agent_splits",
      "description": "Splits for the pi_agent config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pi_agent_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "pi_agent_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "pi_agent",
      "description": "ArkhAngelLifeJiggy/Fable-5-traces - 'pi_agent' subset\n\nAdditional information:\n- 4 skipped columns: messages, tools, metadata, trace",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pi_agent/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pi_agent"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "pi_agent/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "pi_agent_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pi_agent/harness",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pi_agent"
            },
            "extract": {
              "column": "harness"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pi_agent/session_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pi_agent"
            },
            "extract": {
              "column": "session_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pi_agent/prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pi_agent"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pi_agent/sent_at",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pi_agent"
            },
            "extract": {
              "column": "sent_at"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pi_agent/num_user_messages",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pi_agent"
            },
            "extract": {
              "column": "num_user_messages"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pi_agent/num_tool_calls",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pi_agent"
            },
            "extract": {
              "column": "num_tool_calls"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pi_agent/file_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pi_agent"
            },
            "extract": {
              "column": "file_path"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Fable-5-traces",
  "description": "\n  \n\n\n\n  \n    \n      \n        Glint Research Dataset Card\n        Fable 5 Pi Agent Traces\n        A compact, high-signal corpus of Fable 5 coding-agent traces converted into Hugging Face Agent Traces / Pi-compatible sessions for Data Studio inspection, tool-use policy learning, and reasoning/action distillation.\n      \n      \n        Primary Config\n        pi_agent/train\n        Agent Trace preview enabled\n      \n    \n    \n      4,665 Pi trace sessions\n      60 source sessions\n      3,799 tool\u2026 See the full description on the dataset page: https://huggingface.co/datasets/ArkhAngelLifeJiggy/Fable-5-traces.",
  "alternateName": [
    "ArkhAngelLifeJiggy/Fable-5-traces",
    "Fable 5 Pi Agent Traces"
  ],
  "creator": {
    "@type": "Person",
    "name": "Peace Stephen",
    "url": "https://huggingface.co/ArkhAngelLifeJiggy"
  },
  "keywords": [
    "text-generation",
    "machine-generated",
    "English",
    "agpl-3.0",
    "1K - 10K",
    "json",
    "Traces",
    "Tabular",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "agent-traces",
    "pi-agent",
    "claude-code",
    "fable-5",
    "chain-of-thought",
    "tool-use",
    "coding-agents",
    "synthetic-data",
    "distillation",
    "cot"
  ],
  "license": "https://choosealicense.com/licenses/agpl-3.0/",
  "url": "https://huggingface.co/datasets/ArkhAngelLifeJiggy/Fable-5-traces",
  "usageInfo": {
