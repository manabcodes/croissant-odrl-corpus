  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ak_splits/split_name"
      },
      "@id": "ak_splits",
      "name": "ak_splits",
      "description": "Splits for the ak config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ak_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ak_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ak",
      "name": "ak",
      "description": "bigscience/xP3mt - 'ak' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ak/split",
          "name": "ak/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ak"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ak/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ak_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ak/inputs",
          "name": "ak/inputs",
          "description": "Column 'inputs' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ak"
            },
            "extract": {
              "column": "inputs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ak/targets",
          "name": "ak/targets",
          "description": "Column 'targets' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ak"
            },
            "extract": {
              "column": "targets"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ar_splits/split_name"
      },
      "@id": "ar_splits",
      "name": "ar_splits",
      "description": "Splits for the ar config.",
      "field": [
        {
