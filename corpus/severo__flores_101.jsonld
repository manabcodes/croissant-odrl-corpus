  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "afr_splits/split_name"
      },
      "@id": "afr_splits",
      "name": "afr_splits",
      "description": "Splits for the afr config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "afr_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "afr_splits/split_name": "dev"
        },
        {
          "afr_splits/split_name": "devtest"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "afr",
      "name": "afr",
      "description": "severo/flores_101 - 'afr' subset (only the first 100 subsets are included in this metadata)\n\nAdditional information:\n- 2 splits: dev, devtest",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "afr/split",
          "name": "afr/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-afr"
            },
