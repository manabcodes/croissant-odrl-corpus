{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/google-research-datasets/nq_open/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-nq_open",
      "name": "parquet-files-for-config-nq_open",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "nq_open/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "nq_open_splits/split_name"
      },
      "@id": "nq_open_splits",
      "name": "nq_open_splits",
      "description": "Splits for the nq_open config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "nq_open_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "nq_open_splits/split_name": "train"
        },
        {
          "nq_open_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "nq_open",
      "name": "nq_open",
      "description": "google-research-datasets/nq_open - 'nq_open' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "nq_open/split",
          "name": "nq_open/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-nq_open"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "nq_open/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "nq_open_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "nq_open/question",
          "name": "nq_open/question",
          "description": "Column 'question' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-nq_open"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "nq_open/answer",
          "name": "nq_open/answer",
          "description": "Column 'answer' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-nq_open"
            },
            "extract": {
              "column": "answer"
            }
          },
          "repeated": true
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "nq_open",
  "description": "\n\t\n\t\t\n\t\tDataset Card for nq_open\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nThe NQ-Open task, introduced by Lee et.al. 2019,\nis an open domain question answering benchmark that is derived from Natural Questions.\nThe goal is to predict an English answer string for an input English question.\nAll questions can be answered using the contents of English Wikipedia.\n\n\t\n\t\t\n\t\tSupported Tasks and Leaderboards\n\t\n\nOpen Domain Question-Answering, \nEfficientQA Leaderboard:\u2026 See the full description on the dataset page: https://huggingface.co/datasets/google-research-datasets/nq_open.",
  "alternateName": [
    "google-research-datasets/nq_open",
    "NQ-Open"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Google Research Datasets",
    "url": "https://huggingface.co/google-research-datasets"
  },
  "keywords": [
    "question-answering",
    "open-domain-qa",
    "expert-generated",
    "other",
    "monolingual",
    "extended|natural_questions",
    "English",
    "cc-by-sa-3.0",
    "10K - 100K",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-sa-3.0/",
  "sameAs": "https://efficientqa.github.io/",
  "url": "https://huggingface.co/datasets/google-research-datasets/nq_open",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY-SA 3.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": [
      {
        "@type": "odrl:Duty",
        "odrl:action": {
          "@id": "odrl:attribution"
        }
      },
      {
        "@type": "odrl:Duty",
        "odrl:action": {
          "@id": "cc:ShareAlike"
        }
      }
    ]
  }
}