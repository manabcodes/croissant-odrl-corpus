  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/TechWolf/Skill-extraction-Tech-graded/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-corpus",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "corpus/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-qrels",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "qrels/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-queries",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "queries/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "corpus_splits/split_name"
      },
      "@id": "corpus_splits",
      "name": "corpus_splits",
      "description": "Splits for the corpus config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "corpus_splits/split_name": "corpus"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "corpus",
      "description": "TechWolf/Skill-extraction-Tech-graded - 'corpus' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "corpus/(?:partial-)?(corpus)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "corpus_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/esco_version",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "esco_version"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "qrels_splits/split_name"
      },
      "@id": "qrels_splits",
      "name": "qrels_splits",
      "description": "Splits for the qrels config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qrels_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "qrels_splits/split_name": "validation"
        },
        {
          "qrels_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "qrels",
      "description": "TechWolf/Skill-extraction-Tech-graded - 'qrels' subset\n\nAdditional information:\n- 2 splits: validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qrels/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "qrels/(?:partial-)?(validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "qrels_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qrels/query-id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "column": "query-id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qrels/corpus-id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "column": "corpus-id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qrels/score",
          "dataType": "cr:Int8",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "column": "score"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "queries_splits/split_name"
      },
      "@id": "queries_splits",
      "name": "queries_splits",
      "description": "Splits for the queries config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "queries_splits/split_name": "validation"
        },
        {
          "queries_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "queries",
      "description": "TechWolf/Skill-extraction-Tech-graded - 'queries' subset\n\nAdditional information:\n- 2 splits: validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "queries/(?:partial-)?(validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "queries_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Skill-extraction-Tech-graded",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tskill-extraction-tech-graded\n\t\n\nGraded-relevance annotations for sentences from\nTechWolf/skill-extraction-tech\nagainst the ESCO v1.1.0 skill taxonomy. Layout follows the\nBEIR convention so it is drop-in for\nMTEB-style retrieval evaluators.\nThis dataset was created for the RecSys-HR 2026 WorkRB challenge.\n\n\t\n\t\t\n\t\n\t\n\t\tConfigs\n\t\n\n\n\t\n\t\t\nconfig\nsplit\nrows\ncolumns\n\n\n\t\t\nqueries\nvalidation\n75\n_id (sentence id), text (sentence)\n\n\nqueries\ntest\n338\n_id (sentence id), text (sentence)\n\n\ncorpus\u2026 See the full description on the dataset page: https://huggingface.co/datasets/TechWolf/Skill-extraction-Tech-graded.",
  "alternateName": [
    "TechWolf/Skill-extraction-Tech-graded"
  ],
  "creator": {
    "@type": "Organization",
    "name": "TechWolf",
    "url": "https://huggingface.co/TechWolf"
  },
