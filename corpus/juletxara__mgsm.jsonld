  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "bn_splits/split_name"
      },
      "@id": "bn_splits",
      "name": "bn_splits",
      "description": "Splits for the bn config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bn_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "bn_splits/split_name": "train"
        },
        {
          "bn_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "bn",
      "description": "juletxara/mgsm - 'bn' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bn/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bn"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "bn/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "bn_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bn/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bn"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bn/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bn"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bn/answer_number",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bn"
            },
            "extract": {
              "column": "answer_number"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bn/equation_solution",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bn"
            },
            "extract": {
              "column": "equation_solution"
            }
          }
        }
      ]
    },
