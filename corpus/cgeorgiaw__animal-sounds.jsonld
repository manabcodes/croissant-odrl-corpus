    {
      "@type": "cr:RecordSet",
      "@id": "birds",
      "description": "cgeorgiaw/animal-sounds - 'birds' subset (first 5GB)\n\nAdditional information:\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "birds/split",
          "dataType": "sc:Text",
