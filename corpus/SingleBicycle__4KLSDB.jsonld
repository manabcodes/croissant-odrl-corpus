{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/SingleBicycle/4KLSDB/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train_x4"
        },
        {
          "default_splits/split_name": "train_x8"
        },
        {
          "default_splits/split_name": "train_x16"
        },
        {
          "default_splits/split_name": "validation_x4"
        },
        {
          "default_splits/split_name": "validation_x8"
        },
        {
          "default_splits/split_name": "validation_x16"
        },
        {
          "default_splits/split_name": "test_bicubic_x4"
        },
        {
          "default_splits/split_name": "test_bicubic_x8"
        },
        {
          "default_splits/split_name": "test_bicubic_x16"
        },
        {
          "default_splits/split_name": "test_real_x4"
        },
        {
          "default_splits/split_name": "test_real_x8"
        },
        {
          "default_splits/split_name": "test_real_x16"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "SingleBicycle/4KLSDB - 'default' subset\n\nAdditional information:\n- 12 splits: train_x4, train_x8, train_x16, validation_x4, validation_x8, validation_x16, test_bicubic_x4, test_bicubic_x8, test_bicubic_x16, test_real_x4, test_real_x8, test_real_x16",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train_x4|train_x8|train_x16|validation_x4|validation_x8|validation_x16|test_bicubic_x4|test_bicubic_x8|test_bicubic_x16|test_real_x4|test_real_x8|test_real_x16)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/file_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "file_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/hr",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "hr"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/lr",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "lr"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/scale",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "scale"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/degradation",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "degradation"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/width",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "width"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/height",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "height"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/caption",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/aspect_ratio",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "aspect_ratio"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/cogvlm_caption",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "cogvlm_caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/quality_score",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "quality_score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/aesthetic_score",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "aesthetic_score"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "4KLSDB",
  "description": "\n\t\n\t\t\n\t\t4KLSDB: A Large-Scale Dataset for 4K Image Restoration and Generation\n\t\n\nDataCV @ CVPR 2026 \u00b7 Accepted \ud83c\udf89\n\n\n  \n  \n  \n  \n  \n\n\n4KLSDB is a native-4K image dataset with 129,484 train / 2,000 val / 1,984 test images, spanning nature, urban scenes, people, food, artwork, CGI, animals, and architecture. It supports both image restoration (super-resolution) and 4K text-to-image generation.\nQuick links \u00b7 \ud83c\udf10 Project page \u00b7 \ud83d\udcbb Code (GitHub) \u00b7 \ud83d\udcc4 Paper (arXiv) \u00b7 \ud83e\udd17 Dataset \u00b7 \ud83e\uddf1 Checkpoints\u2026 See the full description on the dataset page: https://huggingface.co/datasets/SingleBicycle/4KLSDB.",
  "alternateName": [
    "SingleBicycle/4KLSDB",
    "4KLSDB"
  ],
  "creator": {
    "@type": "Person",
    "name": "Zihao Zhu",
    "url": "https://huggingface.co/SingleBicycle"
  },
  "keywords": [
    "image-to-image",
    "text-to-image",
    "English",
    "cc-by-4.0",
    "100K - 1M",
    "parquet",
    "Image",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "arxiv:2605.24762",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "4K",
    "super-resolution",
    "text-to-image",
    "diffusion",
    "restoration",
    "native-4K"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/SingleBicycle/4KLSDB",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
