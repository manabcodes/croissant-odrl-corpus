{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Goku-OpenLab/messy-prompt-datasets/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "Goku-OpenLab/messy-prompt-datasets - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/version",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "version"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/is_featured",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "is_featured"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/date",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/slug",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "slug"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/model_info",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/model_info/name",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "model_info"
                },
                "transform": {
                  "jsonPath": "name"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/model_info/version",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "model_info"
                },
                "transform": {
                  "jsonPath": "version"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/raw_p",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "raw_p"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/media",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/media/images",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "media"
                },
                "transform": {
                  "jsonPath": "images"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/i18n",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/i18n/zh",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/i18n/zh/t",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "i18n"
                    },
                    "transform": [
                      {
                        "jsonPath": "zh"
                      },
                      {
                        "jsonPath": "t"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/i18n/zh/p_0",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "i18n"
                    },
                    "transform": [
                      {
                        "jsonPath": "zh"
                      },
                      {
                        "jsonPath": "p"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/i18n/zh/tags",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "i18n"
                    },
                    "transform": [
                      {
                        "jsonPath": "zh"
                      },
                      {
                        "jsonPath": "tags"
                      }
                    ]
                  },
                  "isArray": true,
                  "arrayShape": "-1"
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/i18n/en",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/i18n/en/t_0",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "i18n"
                    },
                    "transform": [
                      {
                        "jsonPath": "en"
                      },
                      {
                        "jsonPath": "t"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/i18n/en/p_0_0",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "i18n"
                    },
                    "transform": [
                      {
                        "jsonPath": "en"
                      },
                      {
                        "jsonPath": "p"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/i18n/en/tags_0",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "i18n"
                    },
                    "transform": [
                      {
                        "jsonPath": "en"
                      },
                      {
                        "jsonPath": "tags"
                      }
                    ]
                  },
                  "isArray": true,
                  "arrayShape": "-1"
                }
              ]
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/platform",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "platform"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sourceLink",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sourceLink"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/spec",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/spec/width",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "spec"
                },
                "transform": {
                  "jsonPath": "width"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/spec/height",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "spec"
                },
                "transform": {
                  "jsonPath": "height"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/spec/ratio",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "spec"
                },
                "transform": {
                  "jsonPath": "ratio"
                }
              }
            },
            null,
            {
              "@type": "cr:Field",
              "@id": "default/spec/safety_rating",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "spec"
                },
                "transform": {
                  "jsonPath": "safety_rating"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image"
