  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Shanmuk4622/jeb-rag/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-oracle_matrix",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "oracle_matrix/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "oracle_matrix_splits/split_name"
      },
      "@id": "oracle_matrix_splits",
      "name": "oracle_matrix_splits",
      "description": "Splits for the oracle_matrix config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "oracle_matrix_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "oracle_matrix_splits/split_name": "nq"
        },
        {
          "oracle_matrix_splits/split_name": "hotpotqa"
        },
        {
          "oracle_matrix_splits/split_name": "popqa"
        },
        {
          "oracle_matrix_splits/split_name": "triviaqa"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "oracle_matrix",
      "description": "Shanmuk4622/jeb-rag - 'oracle_matrix' subset\n\nAdditional information:\n- 4 splits: nq, hotpotqa, popqa, triviaqa",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "oracle_matrix/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle_matrix"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "oracle_matrix/(?:partial-)?(nq|hotpotqa|popqa|triviaqa)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "oracle_matrix_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "oracle_matrix/query_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle_matrix"
            },
            "extract": {
              "column": "query_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "oracle_matrix/dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oracle_matrix"
            },
