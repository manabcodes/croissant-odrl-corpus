  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/AlphaDojo/dojo_sector_symbol_relations/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "AlphaDojo/dojo_sector_symbol_relations - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ticker",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ticker"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/market",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "market"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/primary",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "primary"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/secondary",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "secondary"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/symbol",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "symbol"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "dojo_sector_symbol_relations",
  "description": "\nLanguages: \u7b80\u4f53\u4e2d\u6587 \u00b7 English\n\n\n\t\n\t\t\n\t\n\t\n\t\tdojo_sector_symbol_relations \u2014 Stock\u2013Sector Mapping\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tOverview\n\t\n\nMaps each stock to L1/L2/L3 sector paths with primary and secondary assignments. One row per (ticker, market) pair.\n\n\t\n\t\t\n\t\n\t\n\t\tFiles\n\t\n\n\n\t\n\t\t\nFile\nDescription\n\n\n\t\t\ndata.parquet\nFull stock \u2194 sector relations\n\n\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tKey Fields\n\t\n\n\n\t\n\t\t\nField\nDescription\n\n\n\t\t\nticker\nStock symbol\n\n\nmarket\nus, cn, or hk\n\n\nprimary\nJSON object \u2014 primary sector path\n\n\nsecondary\nJSON array \u2014\u2026 See the full description on the dataset page: https://huggingface.co/datasets/AlphaDojo/dojo_sector_symbol_relations.",
  "alternateName": [
    "AlphaDojo/dojo_sector_symbol_relations"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Alpha Dojo",
    "url": "https://huggingface.co/AlphaDojo"
  },
  "keywords": [
