              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "wire_country"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/wire_coordinates",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
