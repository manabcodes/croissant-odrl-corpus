    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/abhinavpola/tau2-bench-verified-airline/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-tasks",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "tasks/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "tasks_splits/split_name"
      },
      "@id": "tasks_splits",
      "name": "tasks_splits",
      "description": "Splits for the tasks config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "tasks_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "tasks_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "tasks",
      "description": "abhinavpola/tau2-bench-verified-airline - 'tasks' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "tasks/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "tasks/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "tasks_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/task_json",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "task_json"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "tau2-bench-verified-airline",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\ttau2-bench-verified \u2014 airline domain (mirror)\n\t\n\nMirror of the airline domain from\namazon-agi/tau2-bench-verified\n(MIT License), pinned at commit 864350a8971a8f8ee9e7b8472e2edc380a806b0c.\nRe-hosted for the OpenRouter native TypeScript benchmark harness so it can fetch\nthe verified airline tasks + environment DB at runtime.\n\n\t\n\t\t\n\t\n\t\n\t\tContents\n\t\n\n\ntasks/test.jsonl \u2014 50 verified airline tasks. Each row has a single\ntask_json string column holding one verbatim tau2 v2 task object\n(id\u2026 See the full description on the dataset page: https://huggingface.co/datasets/abhinavpola/tau2-bench-verified-airline.",
  "alternateName": [
    "abhinavpola/tau2-bench-verified-airline"
  ],
  "creator": {
    "@type": "Person",
    "name": "Abhinav Pola",
    "url": "https://huggingface.co/abhinavpola"
  },
  "keywords": [
    "mit",
    "< 1K",
    "json",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/abhinavpola/tau2-bench-verified-airline",
