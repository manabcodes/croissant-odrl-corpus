    {
      "@type": "cr:RecordSet",
      "@id": "drone-only",
      "description": "ahlab-drone-project/DroneAudioSet - 'drone-only' subset\n\nAdditional information:\n- 28 splits: train_001, train_002, train_003, train_004, train_005, train_006, train_007, train_008, train_009, train_010, train_011, train_012, train_013, train_014, train_015, train_016, train_017, train_018, train_019, train_020, train_021, train_022, train_023, train_024, train_025, train_026, train_027, train_028",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "drone-only/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-drone-only"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "drone\\-only/(?:partial-)?(train_001|train_002|train_003|train_004|train_005|train_006|train_007|train_008|train_009|train_010|train_011|train_012|train_013|train_014|train_015|train_016|train_017|train_018|train_019|train_020|train_021|train_022|train_023|train_024|train_025|train_026|train_027|train_028)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "drone-only_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "drone-only/file_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-drone-only"
            },
            "extract": {
              "column": "file_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "drone-only/audio",
          "subField": [
            null,
            {
              "@type": "cr:Field",
              "@id": "drone-only/audio/sampling_rate",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-drone-only"
                },
                "extract": {
                  "column": "audio"
                },
                "transform": {
                  "jsonPath": "sampling_rate"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "drone-only/audio/path",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-drone-only"
                },
                "extract": {
                  "column": "audio"
                },
                "transform": {
                  "jsonPath": "path"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "drone-only/data_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-drone-only"
            },
            "extract": {
              "column": "data_type"
            }
          }
        }
      ]
    },
