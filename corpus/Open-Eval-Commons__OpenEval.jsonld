  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Open-Eval-Commons/OpenEval/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-bench",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "bench/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-item",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "item/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-response",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "response/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "bench_splits/split_name"
      },
      "@id": "bench_splits",
      "name": "bench_splits",
      "description": "Splits for the bench config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bench_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "bench_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "bench",
      "description": "Open-Eval-Commons/OpenEval - 'bench' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bench/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bench"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "bench/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "bench_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bench/benchmark_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bench"
            },
            "extract": {
              "column": "benchmark_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bench/benchmark_version",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bench"
            },
            "extract": {
              "column": "benchmark_version"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bench/paper_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bench"
            },
            "extract": {
              "column": "paper_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bench/dataset_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bench"
            },
            "extract": {
              "column": "dataset_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bench/benchmark_tags",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bench"
            },
            "extract": {
              "column": "benchmark_tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
