    {
      "@type": "cr:RecordSet",
      "@id": "item",
      "description": "Open-Eval-Commons/OpenEval - 'item' subset\n\nAdditional information:\n- 25 splits: all, anthropic_red_teaming, imdb, mmlu_pro, gpqa, omni_math, ifeval, bbq, disinformation, cnndm, xsum, boolq, bold, culturalbench, do_not_answer, emobench, hi_tom, moralbench, opentom, salad_bench, truthfulqa, wildbench, harmbench, xstest, simplesafetytests",
