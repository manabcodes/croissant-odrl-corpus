    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "all_sentence_splits/split_name"
      },
      "@id": "all_sentence_splits",
      "name": "all_sentence_splits",
      "description": "Splits for the all_sentence config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_sentence_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_sentence_splits/split_name": "train"
        },
        {
          "all_sentence_splits/split_name": "validation"
        },
        {
          "all_sentence_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all_sentence",
      "name": "all_sentence",
      "description": "clarin-pl/polemo2-official - 'all_sentence' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_sentence/split",
          "name": "all_sentence/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_sentence"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all_sentence/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_sentence_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_sentence/text",
          "name": "all_sentence/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_sentence"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_sentence/target",
          "name": "all_sentence/target",
          "description": "ClassLabel column 'target' from the Hugging Face parquet file.\nLabels:\nzero (0), minus (1), plus (2), amb (3)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_sentence"
            },
            "extract": {
              "column": "target"
            }
          }
        }
      ]
