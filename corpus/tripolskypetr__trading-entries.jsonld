    "time-series",
    "crypto",
    "bitcoin",
    "trading-signals",
    "social-signals",
    "tradingview",
    "backtest",
    "grid-search",
    "risk-management",
    "parameter-sweep",
    "analyst-evaluation",
    "signal-quality",
    "drawdown",
    "sharpe-ratio",
    "look-ahead-bias"
  ],
