  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "bos_splits/split_name"
      },
      "@id": "bos_splits",
      "name": "bos_splits",
      "description": "Splits for the bos config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bos_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "bos_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "bos",
      "description": "Helsinki-NLP/fineweb-edu-translated - 'bos' subset\n\nAdditional information:\n- 1 skipped column: metadata",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "bos/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bos"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "bos/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "bos_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bos/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bos"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bos/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bos"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "bos/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-bos"
            },
            "extract": {
              "column": "language"
            }
          }
        }
      ]
    },
