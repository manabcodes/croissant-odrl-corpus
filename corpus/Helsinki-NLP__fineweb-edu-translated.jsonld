  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "fineweb-edu-translated",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tHelsinki-NLP/fineweb-edu-translated\n\t\n\nfineweb-edu-tanslated is a collection of automatically translated documents from fineweb-edu.\nTranslations are based on OPUS-MT and HPLT-MT models.\nThe data in v1.0 covers 36,704,000 documents with over 28 billion space-searated tokens of English data translated into 36 languages.\nThe total v1.0 data set includes over 960 billion tokens and the translated documents are aligned across all languages.\nIn the v1.1 release, additional translations\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Helsinki-NLP/fineweb-edu-translated.",
  "alternateName": [
    "Helsinki-NLP/fineweb-edu-translated"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Helsinki-NLP Research Group",
    "url": "https://huggingface.co/Helsinki-NLP"
  },
  "keywords": [
    "translation",
    "text-generation",
    "Bosnian",
    "Bulgarian",
    "Catalan",
    "Czech",
    "Danish",
    "German",
    "Modern Greek (1453-)",
    "English",
    "Estonian",
    "Basque",
    "Finnish",
    "French",
    "Irish",
    "Galician",
    "Croatian",
    "Hungarian",
    "Icelandic",
    "Italian",
    "Georgian",
    "Latvian",
    "Lithuanian",
    "Macedonian",
    "Maltese",
