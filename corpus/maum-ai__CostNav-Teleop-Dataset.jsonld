    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/maum-ai/CostNav-Teleop-Dataset/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "maum-ai/CostNav-Teleop-Dataset - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/recording_dir",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "recording_dir"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/metadata_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "metadata_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/mcap_files",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "mcap_files"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/start_time_utc",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "start_time_utc"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/end_time_utc",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "end_time_utc"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/start_time_kst",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "start_time_kst"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/end_time_kst",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "end_time_kst"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/duration_seconds",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "duration_seconds"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/duration_hms",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "duration_hms"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/message_count",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "message_count"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/episode_success",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "episode_success"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/food_cam",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "food_cam"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "CostNav-Teleop-Dataset",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tCostNav Teleop Dataset\n\t\n\n\n  \n  \n  \n  \n  \n\n\n\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Summary\n\t\n\nThe CostNav Teleop Dataset is a large-scale collection of human teleoperation recordings for robot navigation in an urban sidewalk simulation environment. It was collected as part of the CostNav benchmark, which evaluates navigation systems using real-world economic cost and revenue metrics rather than purely technical metrics.\nThe dataset contains 2,203 teleoperation episodes totaling 50.2 hours of driving\u2026 See the full description on the dataset page: https://huggingface.co/datasets/maum-ai/CostNav-Teleop-Dataset.",
  "alternateName": [
    "maum-ai/CostNav-Teleop-Dataset",
    "CostNav Teleop Dataset: Human Teleoperation Data for Navigation Cost Benchmarking"
  ],
  "creator": {
    "@type": "Organization",
    "name": "maum-ai",
    "url": "https://huggingface.co/maum-ai"
  },
