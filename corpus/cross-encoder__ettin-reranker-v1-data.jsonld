  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "agnews_splits/split_name"
      },
      "@id": "agnews_splits",
      "name": "agnews_splits",
      "description": "Splits for the agnews config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "agnews_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "agnews_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "agnews",
      "description": "cross-encoder/ettin-reranker-v1-data - 'agnews' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "agnews/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-agnews"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "agnews/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "agnews_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "agnews/query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-agnews"
            },
            "extract": {
              "column": "query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "agnews/document",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-agnews"
            },
            "extract": {
              "column": "document"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "agnews/label",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-agnews"
            },
            "extract": {
              "column": "label"
            }
          }
        }
      ]
    },
