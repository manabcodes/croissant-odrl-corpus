    {
      "@type": "cr:RecordSet",
      "@id": "caption_gpt4o",
      "description": "mm-bright/MM-BRIGHT - 'caption_gpt4o' subset\n\nAdditional information:\n- 29 splits: academia, apple, askubuntu, aviation, bioacoustics, bioinformatics, biology, bitcoin, chemistry, christianity, crypto, earthscience, economics, gaming, gis, islam, law, math, medicalsciences, philosophy, physics, pm, psychology, quant, quantumcomputing, robotics, salesforce, sustainability, travel",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "caption_gpt4o/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-caption_gpt4o"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "caption_gpt4o/(?:partial-)?(academia|apple|askubuntu|aviation|bioacoustics|bioinformatics|biology|bitcoin|chemistry|christianity|crypto|earthscience|economics|gaming|gis|islam|law|math|medicalsciences|philosophy|physics|pm|psychology|quant|quantumcomputing|robotics|salesforce|sustainability|travel)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "caption_gpt4o_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "caption_gpt4o/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-caption_gpt4o"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "caption_gpt4o/query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-caption_gpt4o"
            },
            "extract": {
              "column": "query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "caption_gpt4o/gold_ids",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-caption_gpt4o"
            },
            "extract": {
              "column": "gold_ids"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "caption_gpt4o/image_paths",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-caption_gpt4o"
            },
            "extract": {
              "column": "image_paths"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
