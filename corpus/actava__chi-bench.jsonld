    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/actava/chi-bench/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-tasks",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "tasks/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "tasks_splits/split_name"
      },
      "@id": "tasks_splits",
      "name": "tasks_splits",
      "description": "Splits for the tasks config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "tasks_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "tasks_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "tasks",
      "description": "actava/chi-bench - 'tasks' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "tasks/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "tasks/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "tasks_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/family",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "family"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/task_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "task_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/task_kind",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "task_kind"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/task_actor",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "task_actor"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/instruction_excerpt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "instruction_excerpt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/expected_target_status",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "expected_target_status"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/expected_payer_route",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "expected_payer_route"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/verifier_contract",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "verifier_contract"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/agent_timeout_sec",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "agent_timeout_sec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/num_fixture_files",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "num_fixture_files"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/num_input_pdfs",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "num_input_pdfs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/instruction_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "instruction_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "tasks/task_toml_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-tasks"
            },
            "extract": {
              "column": "task_toml_url"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "chi-bench",
  "description": "\n  \n  Clinical Healthcare In-Situ Environment\n  Task fixtures for a long-horizon, policy-rich healthcare-workflow agent benchmark\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\n\t\t\n\t\n\t\n\t\tWhat is in this dataset\n\t\n\nCHI-Bench evaluates AI agents on end-to-end U.S. healthcare workflows across three long-horizon domains: provider prior authorization, payer utilization management, and population care management. Each task hands the agent a clinical case in a high-fidelity simulator of 20 healthcare apps exposed over MCP, with a 1\u2026 See the full description on the dataset page: https://huggingface.co/datasets/actava/chi-bench.",
  "alternateName": [
    "actava/chi-bench",
    "\u03c7-Bench"
  ],
  "creator": {
    "@type": "Organization",
    "name": "actAVA AI",
    "url": "https://huggingface.co/actava"
  },
  "keywords": [
    "Benchmark",
