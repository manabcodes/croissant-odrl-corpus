  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ar-corpus_splits/split_name"
      },
      "@id": "ar-corpus_splits",
      "name": "ar-corpus_splits",
      "description": "Splits for the ar-corpus config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar-corpus_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ar-corpus_splits/split_name": "dev"
        },
        {
          "ar-corpus_splits/split_name": "test"
        },
        {
          "ar-corpus_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ar-corpus",
      "description": "mteb/MultiLongDocRetrieval - 'ar-corpus' subset\n\nAdditional information:\n- 3 splits: dev, test, train",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar-corpus/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar-corpus"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ar\\-corpus/(?:partial-)?(dev|test|train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ar-corpus_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar-corpus/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar-corpus"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar-corpus/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar-corpus"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ar-corpus/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar-corpus"
            },
            "extract": {
              "column": "title"
            }
          }
        }
      ]
