    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "BOB12311/Orpheus_Hearing - 'default' subset\n\nAdditional information:\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train_chunk_10)/.+parquet$"
            }
          },
          "references": {
            "field": {
