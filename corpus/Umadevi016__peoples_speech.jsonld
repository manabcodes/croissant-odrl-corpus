{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Umadevi016/peoples_speech/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-microset",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "microset/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-validation",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "validation/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "microset_splits/split_name"
      },
      "@id": "microset_splits",
      "name": "microset_splits",
      "description": "Splits for the microset config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "microset_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "microset_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "microset",
      "description": "Umadevi016/peoples_speech - 'microset' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "microset/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-microset"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "microset/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "microset_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "microset/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-microset"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "microset/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-microset"
            },
            "extract": {
              "column": "audio"
            },
            "sampling_rate": 16000
          }
        },
        {
          "@type": "cr:Field",
          "@id": "microset/duration_ms",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-microset"
            },
            "extract": {
              "column": "duration_ms"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "microset/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-microset"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "validation_splits/split_name"
      },
      "@id": "validation_splits",
      "name": "validation_splits",
      "description": "Splits for the validation config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "validation_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "validation_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "validation",
      "description": "Umadevi016/peoples_speech - 'validation' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "validation/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-validation"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "validation/(?:partial-)?(validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "validation_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "validation/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-validation"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "validation/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-validation"
            },
            "extract": {
              "column": "audio"
            },
            "sampling_rate": 16000
          }
        },
        {
          "@type": "cr:Field",
          "@id": "validation/duration_ms",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-validation"
            },
            "extract": {
              "column": "duration_ms"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "validation/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-validation"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "peoples_speech",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tDataset Card for People's Speech\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Summary\n\t\n\nThe People's Speech Dataset is among the world's largest English speech recognition corpus today that is licensed for academic and commercial usage under CC-BY-SA and CC-BY 4.0. It includes 30,000+ hours of transcribed speech in English languages with a diverse set of speakers. This open dataset is large enough to train speech-to-text systems and crucially is available with a permissive license.\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Umadevi016/peoples_speech.",
  "alternateName": [
    "Umadevi016/peoples_speech",
    "People's Speech"
  ],
  "creator": {
    "@type": "Person",
    "name": "Uma Devi Cheruku",
    "url": "https://huggingface.co/Umadevi016"
  },
  "keywords": [
    "automatic-speech-recognition",
    "crowdsourced",
    "machine-generated",
    "crowdsourced",
    "machine-generated",
    "monolingual",
    "original",
    "English",
    "cc-by-2.0",
    "cc-by-2.5",
    "cc-by-3.0",
    "cc-by-4.0",
    "cc-by-sa-3.0",
    "cc-by-sa-4.0",
    "10K - 100K",
    "parquet",
    "Audio",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "arxiv:2111.09344",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "robust-speech-recognition",
    "noisy-speech-recognition",
    "speech-recognition"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-2.0/",
  "sameAs": "https://mlcommons.org/en/peoples-speech/",
  "url": "https://huggingface.co/datasets/Umadevi016/peoples_speech",
