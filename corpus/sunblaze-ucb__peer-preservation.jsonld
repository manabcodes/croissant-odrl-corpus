            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "main/(?:partial-)?(misrep_evaluation|misrep_finance|tampering|alignment_faking|exfiltration_transfer|exfiltration_deletion)/.+parquet$"
