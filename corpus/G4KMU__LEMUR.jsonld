        "@id": "Bulgarian_splits/split_name"
      },
      "@id": "Bulgarian_splits",
      "name": "Bulgarian_splits",
      "description": "Splits for the Bulgarian config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Bulgarian_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Bulgarian_splits/split_name": "train"
        },
        {
          "Bulgarian_splits/split_name": "validation"
        },
        {
          "Bulgarian_splits/split_name": "test"
        },
        {
          "Bulgarian_splits/split_name": "full"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Bulgarian",
      "description": "G4KMU/LEMUR - 'Bulgarian' subset\n\nAdditional information:\n- 4 splits: train, validation, test, full",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Bulgarian/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Bulgarian"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Bulgarian/(?:partial-)?(train|validation|test|full)/.+parquet$"
