  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/turkish-nlp-suite/BellaTurca/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-AkademikDerlem",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "AkademikDerlem/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-OzenliDerlem",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "OzenliDerlem/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-temiz-OSCAR",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "temiz-OSCAR/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-temiz-mC4",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "temiz-mC4/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "AkademikDerlem_splits/split_name"
      },
      "@id": "AkademikDerlem_splits",
      "name": "AkademikDerlem_splits",
      "description": "Splits for the AkademikDerlem config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "AkademikDerlem_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "AkademikDerlem_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "AkademikDerlem",
      "description": "turkish-nlp-suite/BellaTurca - 'AkademikDerlem' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "AkademikDerlem/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-AkademikDerlem"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "AkademikDerlem/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "AkademikDerlem_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "AkademikDerlem/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-AkademikDerlem"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "OzenliDerlem_splits/split_name"
      },
      "@id": "OzenliDerlem_splits",
