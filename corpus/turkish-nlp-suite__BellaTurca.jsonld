            "fileSet": {
              "@id": "parquet-files-for-config-OzenliDerlem"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "temiz-OSCAR_splits/split_name"
      },
      "@id": "temiz-OSCAR_splits",
      "name": "temiz-OSCAR_splits",
      "description": "Splits for the temiz-OSCAR config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "temiz-OSCAR_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "temiz-OSCAR_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "temiz-OSCAR",
      "description": "turkish-nlp-suite/BellaTurca - 'temiz-OSCAR' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "temiz-OSCAR/split",
          "dataType": "sc:Text",
          "source": {
