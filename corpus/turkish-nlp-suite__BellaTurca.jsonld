          "OzenliDerlem_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "OzenliDerlem",
      "description": "turkish-nlp-suite/BellaTurca - 'OzenliDerlem' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "OzenliDerlem/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-OzenliDerlem"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "OzenliDerlem/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
