      "@type": "cr:RecordSet",
      "@id": "queries",
      "description": "clips/beir-nl-cqadupstack - 'queries' subset\n\nAdditional information:\n- 12 splits: android, english, gaming, gis, mathematica, physics, programmers, stats, tex, unix, webmasters, wordpress",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries/split",
          "dataType": "sc:Text",
