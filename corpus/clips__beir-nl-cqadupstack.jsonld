  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/clips/beir-nl-cqadupstack/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-corpus",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "corpus/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-queries",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "queries/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-test",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "test/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "corpus_splits/split_name"
      },
      "@id": "corpus_splits",
      "name": "corpus_splits",
      "description": "Splits for the corpus config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "corpus_splits/split_name": "android"
        },
        {
          "corpus_splits/split_name": "english"
        },
        {
          "corpus_splits/split_name": "gaming"
        },
        {
          "corpus_splits/split_name": "gis"
        },
        {
          "corpus_splits/split_name": "mathematica"
        },
        {
          "corpus_splits/split_name": "physics"
        },
        {
          "corpus_splits/split_name": "programmers"
        },
        {
          "corpus_splits/split_name": "stats"
        },
        {
          "corpus_splits/split_name": "tex"
        },
        {
          "corpus_splits/split_name": "unix"
        },
        {
          "corpus_splits/split_name": "webmasters"
        },
        {
          "corpus_splits/split_name": "wordpress"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "corpus",
      "description": "clips/beir-nl-cqadupstack - 'corpus' subset\n\nAdditional information:\n- 12 splits: android, english, gaming, gis, mathematica, physics, programmers, stats, tex, unix, webmasters, wordpress",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "corpus/(?:partial-)?(android|english|gaming|gis|mathematica|physics|programmers|stats|tex|unix|webmasters|wordpress)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "corpus_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "queries_splits/split_name"
      },
