  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "all_splits/split_name"
      },
      "@id": "all_splits",
      "name": "all_splits",
      "description": "Splits for the all config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all",
      "description": "ShadenA/MathNet - 'all' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/problem_markdown",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "problem_markdown"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/solutions_markdown",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "solutions_markdown"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "all/images",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "images"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "all/country",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "country"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/competition",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "competition"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/topics_flat",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "topics_flat"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "all/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/problem_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "problem_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/final_answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "final_answer"
            }
          }
        }
      ]
    },
    {
