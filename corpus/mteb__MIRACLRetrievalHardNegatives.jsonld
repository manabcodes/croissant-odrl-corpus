      },
      "@id": "ar-corpus_splits",
      "name": "ar-corpus_splits",
      "description": "Splits for the ar-corpus config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar-corpus_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ar-corpus_splits/split_name": "dev"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ar-corpus",
      "description": "mteb/MIRACLRetrievalHardNegatives - 'ar-corpus' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ar-corpus/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ar-corpus"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ar\\-corpus/(?:partial-)?(dev)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ar-corpus_splits/split_name"
            }
          }
        },
        {
