  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/BAAI/DenseFusion-1M/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-DenseFusion-1M",
      "name": "parquet-files-for-config-DenseFusion-1M",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "DenseFusion-1M/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-DenseFusion-4V-100K",
      "name": "parquet-files-for-config-DenseFusion-4V-100K",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "DenseFusion-4V-100K/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "DenseFusion-1M_splits/split_name"
      },
      "@id": "DenseFusion-1M_splits",
      "name": "DenseFusion-1M_splits",
      "description": "Splits for the DenseFusion-1M config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-1M_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "DenseFusion-1M_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "DenseFusion-1M",
      "name": "DenseFusion-1M",
      "description": "BAAI/DenseFusion-1M - 'DenseFusion-1M' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-1M/split",
          "name": "DenseFusion-1M/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DenseFusion-1M"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "DenseFusion\\-1M/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "DenseFusion-1M_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-1M/image_id",
          "name": "DenseFusion-1M/image_id",
          "description": "Column 'image_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DenseFusion-1M"
            },
            "extract": {
              "column": "image_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-1M/caption",
          "name": "DenseFusion-1M/caption",
          "description": "Column 'caption' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DenseFusion-1M"
            },
            "extract": {
              "column": "caption"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-1M/url",
          "name": "DenseFusion-1M/url",
          "description": "Column 'url' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DenseFusion-1M"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-1M/image_path",
          "name": "DenseFusion-1M/image_path",
          "description": "Column 'image_path' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DenseFusion-1M"
            },
            "extract": {
              "column": "image_path"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "DenseFusion-4V-100K_splits/split_name"
      },
      "@id": "DenseFusion-4V-100K_splits",
      "name": "DenseFusion-4V-100K_splits",
      "description": "Splits for the DenseFusion-4V-100K config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-4V-100K_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "DenseFusion-4V-100K_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "DenseFusion-4V-100K",
      "name": "DenseFusion-4V-100K",
      "description": "BAAI/DenseFusion-1M - 'DenseFusion-4V-100K' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-4V-100K/split",
          "name": "DenseFusion-4V-100K/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DenseFusion-4V-100K"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "DenseFusion\\-4V\\-100K/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "DenseFusion-4V-100K_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DenseFusion-4V-100K/image_id",
          "name": "DenseFusion-4V-100K/image_id",
          "description": "Column 'image_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
