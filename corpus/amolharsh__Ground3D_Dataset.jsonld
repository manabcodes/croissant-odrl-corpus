  "recordSet": [],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Ground3D_Dataset",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tGround3D Dataset\n\t\n\nA large-scale 3D vision-language question-answering dataset for point-grounded,\nmetric-aware 3D scene understanding. Built on ScanNet and ScanNet++\nwith dense object and part annotations, the dataset spans eight downstream\nreasoning tasks at both object and part granularity, plus multi-turn\ndialogue that composes them.\nAnswers are both:\n\npoint-grounded: explicitly tied to the referred 3D region via\n<p>label</p><SEG> markup, and\nmetric: physical quantities (size\u2026 See the full description on the dataset page: https://huggingface.co/datasets/amolharsh/Ground3D_Dataset.",
  "alternateName": [
    "amolharsh/Ground3D_Dataset",
    "Ground3D Dataset"
  ],
  "creator": {
    "@type": "Person",
    "name": "Amol Harsh",
    "url": "https://huggingface.co/amolharsh"
  },
  "keywords": [
    "visual-question-answering",
    "question-answering",
    "English",
