{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/classla/ParlaSpeech-RS/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "name": "parquet-files-for-config-default",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "classla/ParlaSpeech-RS - 'default' subset\n\nAdditional information:\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "name": "default/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "name": "default/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/text",
          "name": "default/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/text_cyrillic",
          "name": "default/text_cyrillic",
          "description": "Column 'text_cyrillic' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "text_cyrillic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/text_normalised",
          "name": "default/text_normalised",
          "description": "Column 'text_normalised' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "text_normalised"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/text_cyrillic_normalised",
          "name": "default/text_cyrillic_normalised",
          "description": "Column 'text_cyrillic_normalised' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "text_cyrillic_normalised"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/words",
          "name": "default/words",
          "description": "Column 'words' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/words/char_e",
              "name": "default/words/char_e",
              "description": "Column 'words' from the Hugging Face parquet file.",
              "dataType": "sc:Integer",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "words"
                },
                "transform": {
                  "jsonPath": "char_e"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/words/char_s",
              "name": "default/words/char_s",
              "description": "Column 'words' from the Hugging Face parquet file.",
              "dataType": "sc:Integer",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "words"
                },
                "transform": {
                  "jsonPath": "char_s"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/words/time_e",
              "name": "default/words/time_e",
              "description": "Column 'words' from the Hugging Face parquet file.",
              "dataType": "sc:Float",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "words"
                },
                "transform": {
                  "jsonPath": "time_e"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/words/time_s",
              "name": "default/words/time_s",
              "description": "Column 'words' from the Hugging Face parquet file.",
              "dataType": "sc:Float",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "words"
                },
                "transform": {
                  "jsonPath": "time_s"
                }
              }
            }
          ],
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "default/audio_length",
          "name": "default/audio_length",
          "description": "Column 'audio_length' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "audio_length"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/date",
          "name": "default/date",
          "description": "Column 'date' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_name",
          "name": "default/speaker_name",
          "description": "Column 'speaker_name' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_gender",
          "name": "default/speaker_gender",
          "description": "Column 'speaker_gender' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_gender"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_birth",
          "name": "default/speaker_birth",
          "description": "Column 'speaker_birth' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_birth"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_party",
          "name": "default/speaker_party",
          "description": "Column 'speaker_party' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_party"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/party_orientation",
          "name": "default/party_orientation",
          "description": "Column 'party_orientation' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "party_orientation"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/party_status",
          "name": "default/party_status",
          "description": "Column 'party_status' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "party_status"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "ParlaSpeech-RS",
  "description": "\n\t\n\t\t\n\t\tThe Serbian Parliamentary Spoken Dataset ParlaSpeech-RS 1.0\n\t\n\nThe master dataset can be found at http://hdl.handle.net/11356/1834.\n\n  Notice: ParlaSpeech corpora are currently in the process of enrichment with new features. Follow our progress here: http://clarinsi.github.io/parlaspeech\n\n\nThe ParlaSpeech-RS dataset is built from the transcripts of parliamentary proceedings available in the Serbian part of the ParlaMint corpus (http://hdl.handle.net/11356/1859), and the parliamentary\u2026 See the full description on the dataset page: https://huggingface.co/datasets/classla/ParlaSpeech-RS.",
  "alternateName": [
    "classla/ParlaSpeech-RS"
  ],
  "creator": {
    "@type": "Organization",
    "name": "CLASSLA - CLARIN Knowledge Centre for South Slavic Languages",
    "url": "https://huggingface.co/classla"
  },
