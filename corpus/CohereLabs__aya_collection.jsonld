  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "aya_dataset_splits/split_name"
      },
      "@id": "aya_dataset_splits",
      "name": "aya_dataset_splits",
      "description": "Splits for the aya_dataset config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "aya_dataset_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "aya_dataset_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "aya_dataset",
      "description": "CohereLabs/aya_collection - 'aya_dataset' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "aya_dataset/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aya_dataset"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "aya_dataset/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "aya_dataset_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "aya_dataset/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aya_dataset"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "aya_dataset/inputs",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aya_dataset"
            },
            "extract": {
              "column": "inputs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "aya_dataset/targets",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-aya_dataset"
            },
            "extract": {
              "column": "targets"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "aya_dataset/dataset_name",
