            }
          },
          "references": {
            "field": {
              "@id": "en_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "en/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-en"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "en/label",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-en"
