        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "table/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-tutorial",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "tutorial/*/*.parquet"
    }
