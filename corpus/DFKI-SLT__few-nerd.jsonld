  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/DFKI-SLT/few-nerd/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-inter",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "inter/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-intra",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "intra/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-supervised",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "supervised/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "inter_splits/split_name"
      },
      "@id": "inter_splits",
      "name": "inter_splits",
      "description": "Splits for the inter config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "inter_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "inter_splits/split_name": "train"
        },
        {
          "inter_splits/split_name": "validation"
        },
        {
          "inter_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "inter",
      "description": "DFKI-SLT/few-nerd - 'inter' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "inter/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-inter"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "inter/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "inter_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inter/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-inter"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inter/tokens",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-inter"
            },
            "extract": {
              "column": "tokens"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "inter/ner_tags",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-inter"
            },
            "extract": {
              "column": "ner_tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "inter/fine_ner_tags",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-inter"
            },
            "extract": {
              "column": "fine_ner_tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "intra_splits/split_name"
      },
      "@id": "intra_splits",
      "name": "intra_splits",
      "description": "Splits for the intra config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "intra_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "intra_splits/split_name": "train"
        },
        {
          "intra_splits/split_name": "validation"
        },
        {
          "intra_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "intra",
      "description": "DFKI-SLT/few-nerd - 'intra' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "intra/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-intra"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "intra/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "intra_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "intra/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-intra"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "intra/tokens",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-intra"
            },
            "extract": {
              "column": "tokens"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "intra/ner_tags",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-intra"
            },
            "extract": {
              "column": "ner_tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "intra/fine_ner_tags",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-intra"
            },
            "extract": {
              "column": "fine_ner_tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "supervised_splits/split_name"
      },
      "@id": "supervised_splits",
      "name": "supervised_splits",
      "description": "Splits for the supervised config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "supervised_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "supervised_splits/split_name": "train"
        },
        {
          "supervised_splits/split_name": "validation"
        },
        {
          "supervised_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "supervised",
      "description": "DFKI-SLT/few-nerd - 'supervised' subset\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "supervised/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-supervised"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "supervised/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "supervised_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "supervised/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-supervised"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "supervised/tokens",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-supervised"
            },
            "extract": {
              "column": "tokens"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "supervised/ner_tags",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-supervised"
            },
            "extract": {
              "column": "ner_tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "supervised/fine_ner_tags",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-supervised"
