    }
  ],
  "recordSet": [],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "nba-data-archive",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tNBA Data Archive\n\t\n\nParquet mirror of NBA play-by-play, shot detail, and player-matchup data\nfrom the 1996/97 season through 2025/26.\nBuilt and maintained as the data layer for HoopsMatic.com\nanalytics tools and HoopsHype editorial automation.\nPublic so other researchers and tinkerers don't have to rebuild the same\npipeline.\n\n\t\n\t\t\n\t\n\t\n\t\tLayout\n\t\n\nTwo complementary layouts; pick whichever fits your query pattern.\n\n\t\n\t\t\n\t\n\t\n\t\tper_season/\n\t\n\nOne Parquet file per (data type, season\u2026 See the full description on the dataset page: https://huggingface.co/datasets/cdechoch/nba-data-archive.",
  "alternateName": [
    "cdechoch/nba-data-archive",
    "NBA Data Archive (1996-2026)"
  ],
  "creator": {
    "@type": "Person",
    "name": "Cyro",
    "url": "https://huggingface.co/cdechoch"
  },
  "keywords": [
    "apache-2.0",
    "10M<n<100M",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "basketball",
    "nba",
    "sports",
    "play-by-play",
    "shot-charts"
  ],
  "license": "https://choosealicense.com/licenses/apache-2.0/",
