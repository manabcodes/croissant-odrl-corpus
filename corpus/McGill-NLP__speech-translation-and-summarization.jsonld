  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "amharic_english_splits/split_name"
      },
      "@id": "amharic_english_splits",
      "name": "amharic_english_splits",
      "description": "Splits for the amharic_english config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "amharic_english_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "amharic_english_splits/split_name": "test"
        },
        {
          "amharic_english_splits/split_name": "few_shot"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "amharic_english",
      "description": "McGill-NLP/speech-translation-and-summarization - 'amharic_english' subset\n\nAdditional information:\n- 2 splits: test, few_shot",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "amharic_english/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amharic_english"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "amharic_english/(?:partial-)?(test|few_shot)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "amharic_english_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amharic_english/source_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amharic_english"
            },
            "extract": {
              "column": "source_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "amharic_english/target_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-amharic_english"
            },
            "extract": {
              "column": "target_url"
            }
          }
        },
        {
