    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/TIGER-Lab/OmniEdit-Filtered-1.2M/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "name": "parquet-files-for-config-default",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "dev"
        },
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "TIGER-Lab/OmniEdit-Filtered-1.2M - 'default' subset\n\nAdditional information:\n- 2 splits: dev, train",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "name": "default/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(dev|train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/omni_edit_id",
          "name": "default/omni_edit_id",
          "description": "Column 'omni_edit_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "omni_edit_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/task",
          "name": "default/task",
          "description": "Column 'task' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "task"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/src_img",
          "name": "default/src_img",
          "description": "Image column 'src_img' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "src_img"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edited_img",
          "name": "default/edited_img",
          "description": "Image column 'edited_img' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "edited_img"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/edited_prompt_list",
          "name": "default/edited_prompt_list",
          "description": "Column 'edited_prompt_list' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "edited_prompt_list"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "default/width",
          "name": "default/width",
          "description": "Column 'width' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "width"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/height",
          "name": "default/height",
          "description": "Column 'height' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "height"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sc_score_1",
          "name": "default/sc_score_1",
          "description": "Column 'sc_score_1' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sc_score_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sc_score_2",
          "name": "default/sc_score_2",
          "description": "Column 'sc_score_2' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sc_score_2"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sc_reasoning",
          "name": "default/sc_reasoning",
          "description": "Column 'sc_reasoning' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sc_reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pq_score",
          "name": "default/pq_score",
          "description": "Column 'pq_score' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pq_score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pq_reasoning",
          "name": "default/pq_reasoning",
          "description": "Column 'pq_reasoning' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pq_reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/o_score",
          "name": "default/o_score",
          "description": "Column 'o_score' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "o_score"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "OmniEdit-Filtered-1.2M",
  "description": "\n\t\n\t\t\n\t\tOmniEdit\n\t\n\nIn this paper, we present OMNI-EDIT, which is an omnipotent editor to handle seven different image editing tasks with any aspect ratio seamlessly. Our contribution is in four folds: (1) OMNI-EDIT is trained by utilizing the supervision\nfrom seven different specialist models to ensure task coverage. (2) we utilize importance sampling based on the scores provided by large multimodal models (like GPT-4o) instead of CLIP-score to improve the data quality. \n\ud83d\udcc3Paper | \ud83c\udf10Website |\u2026 See the full description on the dataset page: https://huggingface.co/datasets/TIGER-Lab/OmniEdit-Filtered-1.2M.",
  "alternateName": [
    "TIGER-Lab/OmniEdit-Filtered-1.2M",
    "OmniEdit"
  ],
  "creator": {
    "@type": "Organization",
    "name": "TIGER-Lab",
    "url": "https://huggingface.co/TIGER-Lab"
  },
