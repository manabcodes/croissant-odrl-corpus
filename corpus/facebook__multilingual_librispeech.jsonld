    {
      "@type": "cr:RecordSet",
      "@id": "dutch",
      "name": "dutch",
      "description": "facebook/multilingual_librispeech - 'dutch' subset\n\nAdditional information:\n- 5 splits: dev, test, train, 9_hours, 1_hours\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "dutch/split",
          "name": "dutch/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-dutch"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "dutch/(?:partial-)?(dev|test|train|9_hours|1_hours)/.+parquet$"
            }
          },
