        {
          "@type": "cr:Field",
          "@id": "default/F2F",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "F2F"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/test_command",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "test_command"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/task_category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "task_category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/is_no_nodes",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "is_no_nodes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/is_func_only",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "is_func_only"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/is_class_only",
          "dataType": "sc:Boolean",
