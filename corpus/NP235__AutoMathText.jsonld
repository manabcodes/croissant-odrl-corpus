{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/NP235/AutoMathText/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-web-full",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "web-full/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "web-full_splits/split_name"
      },
      "@id": "web-full_splits",
      "name": "web-full_splits",
      "description": "Splits for the web-full config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "web-full_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "web-full_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "web-full",
      "description": "NP235/AutoMathText - 'web-full' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "web-full/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-web-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "web\\-full/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "web-full_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "web-full/url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-web-full"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "web-full/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-web-full"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "web-full/date",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-web-full"
            },
            "extract": {
              "column": "date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "web-full/meta",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/domain",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "domain"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/url",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "url"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/openwebmath_score",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "openwebmath_score"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/openwebmath_perplexity",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "openwebmath_perplexity"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/lm_name",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "lm_name"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/lm_label",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "lm_label"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/lm_q1_score",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "lm_q1_score"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/lm_q2_score",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "lm_q2_score"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "web-full/meta/lm_q1q2_score",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-web-full"
                },
                "extract": {
                  "column": "meta"
                },
                "transform": {
                  "jsonPath": "lm_q1q2_score"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "AutoMathText",
  "description": "\ud83c\udf89 This work, introducing the AutoMathText dataset and the AutoDS method, has been accepted to The 63rd Annual Meeting of the Association for Computational Linguistics (ACL 2025 Findings)! \ud83c\udf89\n\n\t\n\t\t\n\t\n\t\n\t\tAutoMathText\n\t\n\nAutoMathText is an extensive and carefully curated dataset encompassing around 200 GB of mathematical texts. It's a compilation sourced from a diverse range of platforms including various websites, arXiv, and GitHub (OpenWebMath, RedPajama, Algebraic Stack). This rich\u2026 See the full description on the dataset page: https://huggingface.co/datasets/NP235/AutoMathText.",
  "alternateName": [
    "NP235/AutoMathText",
    "AutoMathText"
  ],
  "creator": {
    "@type": "Person",
    "name": "T T",
    "url": "https://huggingface.co/NP235"
  },
  "keywords": [
    "text-generation",
    "question-answering",
    "English",
    "cc-by-sa-4.0",
    "1M - 10M",
    "Text",
    "arxiv:2402.07625",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "mathematical-reasoning",
    "reasoning",
    "finetuning",
    "pretraining",
    "llm"
  ],
