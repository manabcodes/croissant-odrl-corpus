  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/linxy/USDT-M_Perpetual_Futures/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "linxy/USDT-M_Perpetual_Futures - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/open_time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "open_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/open",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "open"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/high",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "high"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/low",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "low"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/close",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "close"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/volume",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/close_time",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "close_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/quote_volume",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "quote_volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/count",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "count"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/taker_buy_volume",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "taker_buy_volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/taker_buy_quote_volume",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "taker_buy_quote_volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ignore",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ignore"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "USDT-M_Perpetual_Futures",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tUSDT-M Perpetual Futures (Binance)\n\t\n\nBinance USDT-margined perpetual futures historical data, including OHLCV klines,\nmark / index / premium-index prices, open-interest & long/short ratios, and funding rates.\nAuto-updated daily from the official Binance public data mirror.\n\u5e01\u5b89 U \u672c\u4f4d\u6c38\u7eed\u5408\u7ea6 \u5386\u53f2\u6570\u636e\u96c6\uff0c\u5305\u542b K \u7ebf\u3001\u6807\u8bb0\u4ef7\u683c\u3001\u6307\u6570\u4ef7\u683c\u3001\u6ea2\u4ef7\u6307\u6570\u3001\u6301\u4ed3\u91cf\u53ca\u591a\u7a7a\u6bd4\u3001\u8d44\u91d1\u8d39\u7387\uff0c\n\u6bcf\u65e5\u4ece Binance \u5b98\u65b9\u6570\u636e\u955c\u50cf\u81ea\u52a8\u66f4\u65b0\u3002\nLast updated on 2026-07-21 12:52:03 UTC\n\n\t\n\t\t\n\t\n\t\n\t\tUsage\n\t\n\nData is stored as Parquet in per-symbol subdirectories.\nimport pandas as\u2026 See the full description on the dataset page: https://huggingface.co/datasets/linxy/USDT-M_Perpetual_Futures.",
  "alternateName": [
    "linxy/USDT-M_Perpetual_Futures",
    "USDT-M Perpetual Futures"
  ],
