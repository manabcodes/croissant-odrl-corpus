{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/google/simpleqa-verified/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-simpleqa_verified",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "simpleqa_verified/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "simpleqa_verified_splits/split_name"
      },
      "@id": "simpleqa_verified_splits",
      "name": "simpleqa_verified_splits",
      "description": "Splits for the simpleqa_verified config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "simpleqa_verified_splits/split_name": "eval"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "simpleqa_verified",
      "description": "google/simpleqa-verified - 'simpleqa_verified' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "simpleqa_verified/(?:partial-)?(eval)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "simpleqa_verified_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/original_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "column": "original_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/problem",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "column": "problem"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/topic",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "column": "topic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/answer_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "column": "answer_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/multi_step",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "column": "multi_step"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/requires_reasoning",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "column": "requires_reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "simpleqa_verified/urls",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-simpleqa_verified"
            },
            "extract": {
              "column": "urls"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "simpleqa-verified",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tSimpleQA Verified\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tA 1,000-prompt factuality benchmark from Google DeepMind and Google Research, designed to reliably evaluate LLM parametric knowledge.\n\t\n\n\u25b6 SimpleQA Verified Leaderboard on Kaggle\u25b6 Technical Report\u25b6 Evaluation Starter Code\n\n\t\n\t\t\n\t\n\t\n\t\tBenchmark\n\t\n\nSimpleQA Verified is a 1,000-prompt benchmark for reliably evaluating Large Language Models (LLMs) on short-form factuality \nand parametric knowledge. The authors from Google DeepMind and Google Research\u2026 See the full description on the dataset page: https://huggingface.co/datasets/google/simpleqa-verified.",
  "alternateName": [
    "google/simpleqa-verified",
    "SimpleQA Verified"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Google",
    "url": "https://huggingface.co/google"
  },
  "keywords": [
    "question-answering",
    "English",
    "mit",
    "1K - 10K",
    "csv",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2509.07968",
    "arxiv:2411.04368",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "factuality",
    "parametric",
    "memory",
    "pretraining",
    "posttraining",
    "benchmark",
    "simpleqa",
    "OpenAI",
    "Google DeepMind",
    "Google Research"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/google/simpleqa-verified",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "MIT License",
