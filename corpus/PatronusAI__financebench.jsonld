{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/PatronusAI/financebench/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "name": "parquet-files-for-config-default",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "PatronusAI/financebench - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "name": "default/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/financebench_id",
          "name": "default/financebench_id",
          "description": "Column 'financebench_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "financebench_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/company",
          "name": "default/company",
          "description": "Column 'company' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "company"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/doc_name",
          "name": "default/doc_name",
          "description": "Column 'doc_name' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "doc_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/question_type",
          "name": "default/question_type",
          "description": "Column 'question_type' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "question_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/question_reasoning",
          "name": "default/question_reasoning",
          "description": "Column 'question_reasoning' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "question_reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/domain_question_num",
          "name": "default/domain_question_num",
          "description": "Column 'domain_question_num' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "domain_question_num"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/question",
          "name": "default/question",
          "description": "Column 'question' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/answer",
          "name": "default/answer",
          "description": "Column 'answer' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/justification",
          "name": "default/justification",
          "description": "Column 'justification' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "justification"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/dataset_subset_label",
          "name": "default/dataset_subset_label",
          "description": "Column 'dataset_subset_label' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "dataset_subset_label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/evidence",
          "name": "default/evidence",
          "description": "Column 'evidence' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/evidence/evidence_text",
              "name": "default/evidence/evidence_text",
              "description": "Column 'evidence' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "evidence"
                },
                "transform": {
                  "jsonPath": "evidence_text"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/evidence/doc_name",
              "name": "default/evidence/doc_name",
              "description": "Column 'evidence' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "evidence"
                },
                "transform": {
                  "jsonPath": "doc_name"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/evidence/evidence_page_num",
              "name": "default/evidence/evidence_page_num",
              "description": "Column 'evidence' from the Hugging Face parquet file.",
              "dataType": "sc:Integer",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "evidence"
                },
                "transform": {
                  "jsonPath": "evidence_page_num"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/evidence/evidence_text_full_page",
              "name": "default/evidence/evidence_text_full_page",
              "description": "Column 'evidence' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "evidence"
                },
                "transform": {
                  "jsonPath": "evidence_text_full_page"
                }
              }
            }
          ],
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "default/gics_sector",
          "name": "default/gics_sector",
          "description": "Column 'gics_sector' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gics_sector"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/doc_type",
          "name": "default/doc_type",
          "description": "Column 'doc_type' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "doc_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/doc_period",
          "name": "default/doc_period",
          "description": "Column 'doc_period' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "doc_period"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/doc_link",
          "name": "default/doc_link",
          "description": "Column 'doc_link' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "doc_link"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "financebench",
  "description": "FinanceBench is a first-of-its-kind test suite for evaluating the performance of LLMs on open book financial question answering (QA). This is an open source sample of 150 annotated examples used in the evaluation and analysis of models assessed in the FinanceBench paper.\nThe PDFs linked in the dataset can be found here as well: https://github.com/patronus-ai/financebench/tree/main/pdfs\nThe dataset comprises of questions about publicly traded companies, with corresponding answers and evidence\u2026 See the full description on the dataset page: https://huggingface.co/datasets/PatronusAI/financebench.",
  "alternateName": [
    "PatronusAI/financebench"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Patronus AI",
    "url": "https://huggingface.co/PatronusAI"
  },
  "keywords": [
    "cc-by-nc-4.0",
    "< 1K",
