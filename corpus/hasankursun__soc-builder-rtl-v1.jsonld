{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/hasankursun/soc-builder-rtl-v1/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-designs",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "designs/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "designs_splits/split_name"
      },
      "@id": "designs_splits",
      "name": "designs_splits",
      "description": "Splits for the designs config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "designs_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "designs_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "designs",
      "description": "hasankursun/soc-builder-rtl-v1 - 'designs' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "designs/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "designs/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "designs_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/seed",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "seed"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/fabric",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "fabric"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/topology",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "topology"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/num_masters",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "num_masters"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/num_slaves",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "num_slaves"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/num_bridges",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "num_bridges"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/categories",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "categories"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "designs/slaves",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "slaves"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "designs/num_source_files",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "num_source_files"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "designs/lint_ok",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-designs"
            },
            "extract": {
              "column": "lint_ok"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "soc-builder-rtl-v1",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tSoC Builder RTL Dataset \u2014 v1 (Experiment Release)\n\t\n\nA reproducible, machine-generated corpus of synthesizable System-on-Chip (SoC) RTL designs for machine learning on hardware: RTL representation learning today, and \u2014 as the corpus grows \u2014 netlist, timing, and placement prediction. Every design is a complete, hierarchical, lint-clean Verilog SoC assembled from real open-source IP \u2014 RISC-V CPU cores, network-on-chip (NoC) interconnects, accelerators, peripherals, memories and\u2026 See the full description on the dataset page: https://huggingface.co/datasets/hasankursun/soc-builder-rtl-v1.",
  "alternateName": [
    "hasankursun/soc-builder-rtl-v1",
    "SoC Builder RTL Dataset v1 (Experiment)"
  ],
  "creator": {
    "@type": "Person",
    "name": "Hasan Kur\u015fun",
    "url": "https://huggingface.co/hasankursun"
  },
  "keywords": [
    "text-generation",
    "graph-ml",
    "tabular-regression",
    "feature-extraction",
    "code",
    "apache-2.0",
    "1K - 10K",
    "json",
    "Tabular",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "verilog",
    "rtl",
    "hdl",
    "soc",
    "system-on-chip",
    "eda",
    "ml-for-eda",
    "chip-design",
    "netlist",
    "timing-prediction",
    "placement",
    "network-on-chip",
    "noc",
    "risc-v",
    "hardware"
  ],
