    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/neosapience/TA2.0_animation_dataset/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "neosapience/TA2.0_animation_dataset - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/video",
          "dataType": "sc:VideoObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "video"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/clip_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "clip_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ref_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ref_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/motion_mode",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "motion_mode"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/frame_num",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "frame_num"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/duration_sec",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "duration_sec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/vqa_score",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "vqa_score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/c50",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "c50"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/snr",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "snr"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pad_top",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pad_top"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pad_bottom",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pad_bottom"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pad_left",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pad_left"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pad_right",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pad_right"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "TA2.0_animation_dataset",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tTA2.0 Animation Dataset for Talking Avatars\n\t\n\n11,255 AI-generated anime-style talking avatar video clips (\u224830.3 hours) with per-clip quality metadata.\nEach clip shows a single animated character speaking, rendered at 1280\u00d71280 @ 25 fps (H.264 video + AAC audio, ~10 s per clip). Clips were generated with LongCat-Video-Avatar (Meituan LongCat Team), an audio-driven avatar video generation model, conditioned on reference character images and driven by speech audio in 9 languages \u2014\u2026 See the full description on the dataset page: https://huggingface.co/datasets/neosapience/TA2.0_animation_dataset.",
  "alternateName": [
    "neosapience/TA2.0_animation_dataset",
    "TA2.0 Animation Dataset"
  ],
  "creator": {
    "@type": "Organization",
    "name": "neosapience",
    "url": "https://huggingface.co/neosapience"
  },
  "keywords": [
    "English",
    "Korean",
    "German",
    "French",
    "Dutch",
    "Italian",
    "Spanish",
    "Portuguese",
    "Polish",
    "apache-2.0",
