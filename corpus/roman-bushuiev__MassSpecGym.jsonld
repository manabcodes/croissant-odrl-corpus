{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/roman-bushuiev/MassSpecGym/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-main",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "main/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "main_splits/split_name"
      },
      "@id": "main_splits",
      "name": "main_splits",
      "description": "Splits for the main config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "main_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "main_splits/split_name": "val"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "main",
      "description": "roman-bushuiev/MassSpecGym - 'main' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "main/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "main/(?:partial-)?(val)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "main_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/identifier",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "identifier"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/mzs",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "mzs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/intensities",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "intensities"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/smiles",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "smiles"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/inchikey",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "inchikey"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/formula",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "formula"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/precursor_formula",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "precursor_formula"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/parent_mass",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "parent_mass"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/precursor_mz",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "precursor_mz"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/adduct",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "adduct"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/instrument_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "instrument_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/collision_energy",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "collision_energy"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/fold",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "fold"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "main/simulation_challenge",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-main"
            },
            "extract": {
              "column": "simulation_challenge"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "MassSpecGym",
  "description": "\n  \n\n\nMassSpecGym provides a dataset and benchmark for the discovery and identification of new molecules from tandem mass spectrometry (MS/MS) spectra. The provided challenges abstract the process of scientific discovery of new molecules from biological and environmental samples into well-defined machine learning problems.\n\n\t\n\t\t\n\t\n\t\n\t\tPapers\n\t\n\n\nMassSpecGym in the Wild: Uncovering and Correcting Evaluation Pitfalls in AI-Driven Molecule Discovery (2025): Paper Link\nMassSpecGym: A benchmark for\u2026 See the full description on the dataset page: https://huggingface.co/datasets/roman-bushuiev/MassSpecGym.",
  "alternateName": [
    "roman-bushuiev/MassSpecGym",
    "MassSpecGym"
  ],
  "creator": {
    "@type": "Person",
    "name": "Roman Bushuiev",
    "url": "https://huggingface.co/roman-bushuiev"
  },
  "keywords": [
    "other",
    "mit",
    "100K - 1M",
    "csv",
    "Tabular",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2606.19624",
    "arxiv:2410.23326",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "chemistry",
    "mass-spectrometry",
    "molecule-discovery"
  ],
