  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "full_splits/split_name"
      },
      "@id": "full_splits",
      "name": "full_splits",
      "description": "Splits for the full config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "full_splits/split_name": "train"
        },
        {
          "full_splits/split_name": "validation"
        },
        {
          "full_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "full",
      "name": "full",
      "description": "c3po-ai/edgar-corpus - 'full' subset (first 5GB)\n\nAdditional information:\n- 3 splits: train, validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full/split",
          "name": "full/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "full/(?:partial-)?(train|validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "full_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "full/filename",
          "name": "full/filename",
          "description": "Column 'filename' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-full"
            },
            "extract": {
              "column": "filename"
            }
          }
        },
