          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "audio"
            },
            "sampling_rate": 48000
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sentence",
          "dataType": "sc:Text",
          "source": {
