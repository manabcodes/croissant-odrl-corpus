  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "cv_corpus_v22",
  "description": "\n\t\n\t\t\n\t\tDataset Card for Common Voice Corpus 22.0\n\t\n\n\n\nThis dataset is an unofficial version of the Mozilla Common Voice Corpus 22. It was downloaded and converted from the project's website https://commonvoice.mozilla.org/.\nNOTE: currently converting to parquet for convenience.. WIP \n\n\t\n\t\t\n\t\tLanguages\n\t\n\nAbkhaz, Albanian, Amharic, Arabic, Armenian, Assamese, Asturian, Azerbaijani, Basaa, Bashkir, Basque, Belarusian, Bengali, Breton, Bulgarian, Cantonese, Catalan, Central Kurdish, Chinese\u2026 See the full description on the dataset page: https://huggingface.co/datasets/mort666/cv_corpus_v22.",
  "alternateName": [
    "mort666/cv_corpus_v22",
    "Common Voice Corpus 22.0"
  ],
  "creator": {
    "@type": "Person",
    "name": "Stephen Kapp",
    "url": "https://huggingface.co/mort666"
  },
