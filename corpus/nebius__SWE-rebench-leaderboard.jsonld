      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "nebius/SWE-rebench-leaderboard - 'default' subset\n\nAdditional information:\n- 16 splits: test, 2025_01, 2025_02, 2025_03, 2025_04, 2025_05, 2025_06, 2025_07, 2025_08, 2025_09, 2025_10, 2025_11, 2025_12, 2026_01, 2026_02, 2026_03",
