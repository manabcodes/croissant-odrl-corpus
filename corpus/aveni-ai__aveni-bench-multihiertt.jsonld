{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/aveni-ai/aveni-bench-multihiertt/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-hard",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "hard/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-easy",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "easy/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "hard_splits/split_name"
      },
      "@id": "hard_splits",
      "name": "hard_splits",
      "description": "Splits for the hard config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "hard_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "hard_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "hard",
      "description": "aveni-ai/aveni-bench-multihiertt - 'hard' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "hard/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hard"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "hard/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "hard_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hard/answer",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hard"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hard/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hard"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hard/context",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hard"
            },
            "extract": {
              "column": "context"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "easy_splits/split_name"
      },
      "@id": "easy_splits",
      "name": "easy_splits",
      "description": "Splits for the easy config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "easy_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "easy_splits/split_name": "validation"
        },
        {
          "easy_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "easy",
      "description": "aveni-ai/aveni-bench-multihiertt - 'easy' subset\n\nAdditional information:\n- 2 splits: validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "easy/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-easy"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "easy/(?:partial-)?(validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "easy_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "easy/answer",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-easy"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "easy/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-easy"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "easy/context",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-easy"
            },
            "extract": {
              "column": "context"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "aveni-bench-multihiertt",
  "description": "\n\t\n\t\t\n\t\tAveniBench: MultiHiertt\n\t\n\nMultiHiertt split used in the AveniBench.\n\n\t\n\t\t\n\t\tLicense\n\t\n\nThis dataset is made available under the MIT license.\n\n\t\n\t\t\n\t\tCitation\n\t\n\nAveniBench\nTDB\n\nMultiHiertt\n@inproceedings{zhao-etal-2022-multihiertt,\n    title = \"{M}ulti{H}iertt: Numerical Reasoning over Multi Hierarchical Tabular and Textual Data\",\n    author = \"Zhao, Yilun  and\n      Li, Yunxiang  and\n      Li, Chenying  and\n      Zhang, Rui\",\n    booktitle = \"Proceedings of the 60th Annual Meeting of\u2026 See the full description on the dataset page: https://huggingface.co/datasets/aveni-ai/aveni-bench-multihiertt.",
  "alternateName": [
    "aveni-ai/aveni-bench-multihiertt"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Aveni",
    "url": "https://huggingface.co/aveni-ai"
  },
  "keywords": [
    "English",
    "mit",
    "1K - 10K",
    "json",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "aveni-bench",
    "long-context",
    "numerical-reasoning",
    "tabular-reasoning",
    "finnlp"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/aveni-ai/aveni-bench-multihiertt",
