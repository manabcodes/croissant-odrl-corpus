          "@id": "default/motion_score",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "motion_score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/motion_score_v2",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
