  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/HuggingFaceM4/FairFace/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-0.25",
      "name": "parquet-files-for-config-0.25",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "0.25/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-1.25",
      "name": "parquet-files-for-config-1.25",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "1.25/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "0.25_splits/split_name"
      },
      "@id": "0.25_splits",
      "name": "0.25_splits",
      "description": "Splits for the 0.25 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "0.25_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "0.25_splits/split_name": "train"
        },
        {
          "0.25_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "0.25",
      "name": "0.25",
      "description": "HuggingFaceM4/FairFace - '0.25' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "0.25/split",
          "name": "0.25/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-0.25"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "0\\.25/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "0.25_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "0.25/image",
          "name": "0.25/image",
          "description": "Image column 'image' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-0.25"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "0.25/age",
          "name": "0.25/age",
          "description": "ClassLabel column 'age' from the Hugging Face parquet file.\nLabels:\n0-2 (0), 3-9 (1), 10-19 (2), 20-29 (3), 30-39 (4), 40-49 (5), 50-59 (6), 60-69 (7), more than 70 (8)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-0.25"
            },
            "extract": {
              "column": "age"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "0.25/gender",
          "name": "0.25/gender",
          "description": "ClassLabel column 'gender' from the Hugging Face parquet file.\nLabels:\nMale (0), Female (1)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-0.25"
            },
            "extract": {
              "column": "gender"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "0.25/race",
          "name": "0.25/race",
          "description": "ClassLabel column 'race' from the Hugging Face parquet file.\nLabels:\nEast Asian (0), Indian (1), Black (2), White (3), Middle Eastern (4), Latino_Hispanic (5), Southeast Asian (6)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-0.25"
            },
            "extract": {
              "column": "race"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "0.25/service_test",
          "name": "0.25/service_test",
          "description": "Column 'service_test' from the Hugging Face parquet file.",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-0.25"
            },
            "extract": {
              "column": "service_test"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "1.25_splits/split_name"
      },
