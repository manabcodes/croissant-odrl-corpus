{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/SmartOR/FrontierOR/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-meta",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "meta/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "meta_splits/split_name"
      },
      "@id": "meta_splits",
      "name": "meta_splits",
      "description": "Splits for the meta config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "meta_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "meta_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "meta",
      "description": "SmartOR/FrontierOR - 'meta' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "meta/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "meta/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "meta_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/paper_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "paper_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/paper_title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "paper_title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/publication",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "publication"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/year",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "year"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/direction",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "direction"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/problem_class",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "problem_class"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/formulation_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "formulation_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/application_field",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "application_field"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/avg_num_var",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "avg_num_var"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/avg_num_int_var",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "avg_num_int_var"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/avg_num_constr",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "avg_num_constr"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "meta/source_link",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-meta"
            },
            "extract": {
              "column": "source_link"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "FrontierOR",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tFrontier-OR Benchmark\n\t\n\nA benchmark of 180 literature-grounded OR tasks, each packaged as a\nself-contained reproducible unit: natural-language problem description,\nmathematical formulation, reference Gurobi implementation, test instances,\nreference solutions, and an automated feasibility checker.\nDesigned for evaluating LLMs on the end-to-end task of turning a research\npaper's OR problem into runnable, verifiably-correct optimization code.\n\n\t\n\t\t\n\t\n\t\n\t\tWhat's in each paper folder\u2026 See the full description on the dataset page: https://huggingface.co/datasets/SmartOR/FrontierOR.",
  "alternateName": [
    "SmartOR/FrontierOR",
    "Frontier-OR Benchmark"
  ],
  "creator": {
    "@type": "Person",
    "name": "Minwei Kong",
    "url": "https://huggingface.co/SmartOR"
  },
  "keywords": [
    "other",
    "English",
    "cc-by-4.0",
    "< 1K",
    "json",
    "Tabular",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "operations-research",
    "optimization",
    "mixed-integer-programming",
    "gurobi",
    "benchmark",
    "llm-for-or"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/SmartOR/FrontierOR",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}