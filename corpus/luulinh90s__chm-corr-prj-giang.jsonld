          "name": "default/decision",
          "description": "Column 'decision' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "decision"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/self-reported-confidence",
          "name": "default/self-reported-confidence",
          "description": "Column 'self-reported-confidence' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
