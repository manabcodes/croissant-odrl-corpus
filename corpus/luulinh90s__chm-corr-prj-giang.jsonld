        },
        {
          "@type": "cr:Field",
          "@id": "default/ai-prediction",
          "name": "default/ai-prediction",
          "description": "Column 'ai-prediction' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/ai-prediction/label",
              "name": "default/ai-prediction/label",
              "description": "Column 'ai-prediction' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "ai-prediction"
                },
                "transform": {
                  "jsonPath": "label"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/ai-prediction/confidences",
              "name": "default/ai-prediction/confidences",
              "description": "Column 'ai-prediction' from the Hugging Face parquet file.",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/ai-prediction/confidences/label",
                  "name": "default/ai-prediction/confidences/label",
                  "description": "Column 'ai-prediction' from the Hugging Face parquet file.",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "ai-prediction"
                    },
                    "transform": {
                      "jsonPath": "label"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/ai-prediction/confidences/confidence",
                  "name": "default/ai-prediction/confidences/confidence",
                  "description": "Column 'ai-prediction' from the Hugging Face parquet file.",
                  "dataType": "sc:Float",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "ai-prediction"
                    },
                    "transform": {
                      "jsonPath": "confidence"
                    }
                  }
                }
              ],
              "repeated": true
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/image-index",
          "name": "default/image-index",
          "description": "Column 'image-index' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
