          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "lang"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/raw_index",
          "name": "default/raw_index",
          "description": "Column 'raw_index' from the Hugging Face parquet file.",
