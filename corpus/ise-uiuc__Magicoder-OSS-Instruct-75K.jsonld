            },
            "extract": {
              "column": "problem"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/solution",
          "name": "default/solution",
          "description": "Column 'solution' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
