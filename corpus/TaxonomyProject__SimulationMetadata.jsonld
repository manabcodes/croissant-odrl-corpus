  "recordSet": [],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "SimulationMetadata",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tPercepTax \u2014 Simulation Metadata\n\t\n\nSupporting metadata for the PercepTax benchmark.\n\n  \n  \n  \n  \n\n\nThis repository holds the object taxonomy, object lists / placement rules, and\nper-scene 3D annotations used to render and annotate the simulated split of PercepTax.\nIt is a collection of JSON/CSV/PNG files (not a load_dataset-style tabular dataset).\n\n\t\n\t\t\n\t\n\t\n\t\tContents\n\t\n\ntaxonomy/                     # the physical-property taxonomy\n\u251c\u2500\u2500 taxonomy.json             # full taxonomy\u2026 See the full description on the dataset page: https://huggingface.co/datasets/TaxonomyProject/SimulationMetadata.",
  "alternateName": [
    "TaxonomyProject/SimulationMetadata",
    "PercepTax Simulation Metadata"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Taxonomy Project",
    "url": "https://huggingface.co/TaxonomyProject"
  },
  "keywords": [
    "visual-question-answering",
    "image-classification",
    "cc-by-4.0",
    "Image",
    "3D",
    "arxiv:2511.19526",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "3d",
    "spatial-reasoning",
    "object-properties",
    "taxonomy",
    "simulation"
  ],
