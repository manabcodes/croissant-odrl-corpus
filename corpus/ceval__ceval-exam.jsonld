  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "accountant_splits/split_name"
      },
      "@id": "accountant_splits",
      "name": "accountant_splits",
      "description": "Splits for the accountant config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "accountant_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "accountant_splits/split_name": "test"
        },
        {
          "accountant_splits/split_name": "val"
        },
        {
          "accountant_splits/split_name": "dev"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "accountant",
      "description": "ceval/ceval-exam - 'accountant' subset\n\nAdditional information:\n- 3 splits: test, val, dev",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "accountant/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-accountant"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "accountant/(?:partial-)?(test|val|dev)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "accountant_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "accountant/id",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-accountant"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "accountant/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-accountant"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "accountant/A",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-accountant"
            },
            "extract": {
              "column": "A"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "accountant/B",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-accountant"
            },
            "extract": {
              "column": "B"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "accountant/C",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-accountant"
            },
            "extract": {
              "column": "C"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "accountant/D",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
