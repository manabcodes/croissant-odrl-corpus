  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "ANTLR_splits/split_name"
      },
      "@id": "ANTLR_splits",
      "name": "ANTLR_splits",
      "description": "Splits for the ANTLR config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ANTLR_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "ANTLR_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "ANTLR",
      "description": "AISE-TUDelft/the-heap - 'ANTLR' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ANTLR/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ANTLR"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "ANTLR/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "ANTLR_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ANTLR/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ANTLR"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ANTLR/file_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ANTLR"
            },
            "extract": {
              "column": "file_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ANTLR/file_path",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ANTLR"
            },
            "extract": {
              "column": "file_path"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ANTLR/content",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ANTLR"
            },
            "extract": {
              "column": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ANTLR/size",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-ANTLR"
            },
            "extract": {
              "column": "size"
            }
          }
        },
        {
          "@type": "cr:Field",
