    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Ehsanrs2/Forex_Factory_Calendar/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "Ehsanrs2/Forex_Factory_Calendar - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/DateTime",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "DateTime"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Currency",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Currency"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Impact",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Impact"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Event",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Event"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Actual",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Actual"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Forecast",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Forecast"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Previous",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Previous"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Detail",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Detail"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Forex_Factory_Calendar",
  "description": "\n\t\n\t\t\n\t\t\ud83d\udcc5 Forex Factory Economic Calendar Dataset (2007-01-01 to 2025-04-07)\n\t\n\nThis dataset contains a comprehensive archive of macroeconomic calendar events sourced from Forex Factory, spanning from January 1, 2007 to April 7, 2025.Each row captures a specific event with detailed metadata including currency, event type, market impact level, reported values, and descriptive context.\n\n\n\t\n\t\t\n\t\n\t\n\t\t\ud83d\udce6 Dataset Summary\n\t\n\n\nTotal timespan: 2007-01-01 \u2192 2025-04-07  \nFormat: CSV (UTF-8)  \nTimezone:\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Ehsanrs2/Forex_Factory_Calendar.",
  "alternateName": [
    "Ehsanrs2/Forex_Factory_Calendar",
    "Forex Factory Economic Calendar (2007\u20132025)"
  ],
  "creator": {
    "@type": "Person",
    "name": "Ehsan Rajabi safari",
    "url": "https://huggingface.co/Ehsanrs2"
  },
