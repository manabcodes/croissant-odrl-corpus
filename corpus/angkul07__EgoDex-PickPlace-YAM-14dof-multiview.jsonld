  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/angkul07/EgoDex-PickPlace-YAM-14dof-multiview/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "angkul07/EgoDex-PickPlace-YAM-14dof-multiview - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/observation.state",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "observation.state"
            }
          },
          "isArray": true,
          "arrayShape": "14"
        },
        {
          "@type": "cr:Field",
          "@id": "default/action",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "action"
            }
          },
          "isArray": true,
          "arrayShape": "14"
        },
        {
          "@type": "cr:Field",
          "@id": "default/timestamp",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "timestamp"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/frame_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "frame_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/episode_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "episode_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/task_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "task_index"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "EgoDex-PickPlace-YAM-14dof-multiview",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tEgoDex \u2192 YAM 14-DOF, Multiview (LeRobot v2.1)\n\t\n\nEgocentric human hand-manipulation demonstrations from EgoDex retargeted to a\nYAM bimanual robot (14-DOF), packaged as a LeRobot v2.1 dataset with three\nsynthesized camera views. The observation schema is drop-in compatible with\nangkul07/abc-teleop for\ncotraining (identical Hz, camera keys, and action convention).\n\n\t\n\t\t\n\t\n\t\n\t\tAt a glance\n\t\n\n\n\t\n\t\t\n\n\n\n\n\t\t\nEpisodes\n8,842\n\n\nFrames\n1,074,893\n\n\nControl rate\n30 Hz (30 fps video)\n\n\nRobot\nYAM\u2026 See the full description on the dataset page: https://huggingface.co/datasets/angkul07/EgoDex-PickPlace-YAM-14dof-multiview.",
  "alternateName": [
    "angkul07/EgoDex-PickPlace-YAM-14dof-multiview"
  ],
  "creator": {
    "@type": "Person",
    "name": "Angkul",
    "url": "https://huggingface.co/angkul07"
  },
