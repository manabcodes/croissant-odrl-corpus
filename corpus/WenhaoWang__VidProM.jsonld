{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/WenhaoWang/VidProM/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-VidProM_unique",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "VidProM_unique/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "VidProM_unique_splits/split_name"
      },
      "@id": "VidProM_unique_splits",
      "name": "VidProM_unique_splits",
      "description": "Splits for the VidProM_unique config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "VidProM_unique_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "VidProM_unique",
      "description": "WenhaoWang/VidProM - 'VidProM_unique' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "VidProM_unique/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "VidProM_unique_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/uuid",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "uuid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/time",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/toxicity",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "toxicity"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/obscene",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "obscene"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/identity_attack",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "identity_attack"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/insult",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "insult"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/threat",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "threat"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "VidProM_unique/sexual_explicit",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-VidProM_unique"
            },
            "extract": {
              "column": "sexual_explicit"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "VidProM",
  "description": "\n  \n\n\n\n\n\t\n\t\t\n\t\tSummary\n\t\n\nThis is the dataset proposed in our paper VidProM: A Million-scale Real Prompt-Gallery Dataset for Text-to-Video Diffusion Models (NeurIPS 2024).\nVidProM is the first dataset featuring 1.67 million unique text-to-video prompts and 6.69 million videos generated from 4 different state-of-the-art diffusion models.\nIt inspires many exciting new research areas, such as Text-to-Video Prompt Engineering, Efficient Video Generation, Fake Video Detection, and Video Copy\u2026 See the full description on the dataset page: https://huggingface.co/datasets/WenhaoWang/VidProM.",
  "alternateName": [
    "WenhaoWang/VidProM",
    "VidProM"
  ],
  "creator": {
    "@type": "Person",
    "name": "Wenhao Wang",
    "url": "https://huggingface.co/WenhaoWang"
  },
  "keywords": [
    "text-to-video",
    "text-to-image",
    "original",
    "English",
    "cc-by-nc-4.0",
    "1M - 10M",
    "csv",
    "Tabular",
    "Text",
    "Video",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "arxiv:2403.06098",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "prompts",
    "text-to-video",
    "text-to-image",
    "Pika",
    "VideoCraft2",
    "Text2Video-Zero",
    "ModelScope",
    "Video Generative Model Evaluation",
    "Text-to-Video Diffusion Model Development",
    "Text-to-Video Prompt Engineering",
    "Efficient Video Generation",
    "Fake Video Detection",
    "Video Copy Detection for Diffusion Models"
  ],
