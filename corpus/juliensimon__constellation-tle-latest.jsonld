    {
      "@type": "cr:RecordSet",
      "@id": "oneweb",
      "description": "juliensimon/constellation-tle-latest - 'oneweb' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "oneweb/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-oneweb"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "oneweb/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "oneweb_splits/split_name"
            }
          }
        },
        {
