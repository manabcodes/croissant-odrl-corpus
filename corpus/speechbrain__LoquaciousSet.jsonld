  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/speechbrain/LoquaciousSet/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-clean",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "clean/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-large",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "large/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-medium",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "medium/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-small",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "small/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "clean_splits/split_name"
      },
      "@id": "clean_splits",
      "name": "clean_splits",
      "description": "Splits for the clean config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "clean_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "clean_splits/split_name": "train"
        },
        {
          "clean_splits/split_name": "dev"
        },
        {
          "clean_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "clean",
      "description": "speechbrain/LoquaciousSet - 'clean' subset\n\nAdditional information:\n- 3 splits: train, dev, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "clean/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "clean/(?:partial-)?(train|dev|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "clean_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/ID",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "ID"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/duration",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/wav",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "wav"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/spk_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "spk_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/sex",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "sex"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "clean/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-clean"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
