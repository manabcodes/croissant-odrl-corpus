          "@id": "unfair_tos/labels",
          "name": "unfair_tos/labels",
          "description": "ClassLabel column 'labels' from the Hugging Face parquet file.\nLabels:\nLimitation of liability (0), Unilateral termination (1), Unilateral change (2), Content removal (3), Contract by using (4), Choice of law (5), Jurisdiction (6), Arbitration (7)",
          "dataType": "sc:Integer",
          "source": {
