      "name": "unfair_tos",
      "description": "coastalcph/lex_glue - 'unfair_tos' subset\n\nAdditional information:\n- 3 splits: train, test, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "unfair_tos/split",
          "name": "unfair_tos/split",
