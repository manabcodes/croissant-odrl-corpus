          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-case_hold"
            },
            "extract": {
              "column": "context"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "case_hold/endings",
          "name": "case_hold/endings",
          "description": "Column 'endings' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-case_hold"
            },
            "extract": {
              "column": "endings"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "case_hold/label",
          "name": "case_hold/label",
          "description": "ClassLabel column 'label' from the Hugging Face parquet file.\nLabels:\n0 (0), 1 (1), 2 (2), 3 (3), 4 (4)",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-case_hold"
            },
            "extract": {
              "column": "label"
            }
          }
        }
      ]
    },
