    {
      "@type": "cr:RecordSet",
      "@id": "case_hold",
      "name": "case_hold",
      "description": "coastalcph/lex_glue - 'case_hold' subset\n\nAdditional information:\n- 3 splits: train, test, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "case_hold/split",
          "name": "case_hold/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-case_hold"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "case_hold/(?:partial-)?(train|test|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "case_hold_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "case_hold/context",
