    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/TrevorJS/kalshi-trades/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "TrevorJS/kalshi-trades - 'default' subset\n\nAdditional information:\n- 3 skipped columns: created_time, open_time, close_time",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ticker",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ticker"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/event_ticker",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "event_ticker"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/market_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "market_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/yes_sub_title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "yes_sub_title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/no_sub_title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "no_sub_title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/status",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "status"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/yes_bid",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "yes_bid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/yes_ask",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "yes_ask"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/no_bid",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "no_bid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/no_ask",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "no_ask"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/last_price",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "last_price"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/volume",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "volume"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/volume_24h",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "volume_24h"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/open_interest",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "open_interest"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/result",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "result"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "kalshi-trades",
  "description": "\n\t\n\t\t\n\t\tKalshi Prediction Market Trades & Markets\n\t\n\nComplete public trade-level and market-level data from Kalshi, the first CFTC-regulated prediction market exchange in the United States.\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\n\n\t\n\t\t\n\nCount\nTimespan\n\n\n\t\t\nTrades\n154,505,005\nJune 2021 \u2013 January 2026\n\n\nMarkets\n17,464,713\nJune 2021 \u2013 January 2026\n\n\nEvents\n4,721,915\n\n\n\nTotal contracts traded\n34.6 billion\n\n\n\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tData Files\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\ttrades/\n\t\n\n16 parquet shards (~10M rows each), sorted by\u2026 See the full description on the dataset page: https://huggingface.co/datasets/TrevorJS/kalshi-trades.",
  "alternateName": [
    "TrevorJS/kalshi-trades"
  ],
  "creator": {
    "@type": "Person",
    "name": "trevor",
    "url": "https://huggingface.co/TrevorJS"
  },
  "keywords": [
    "tabular-classification",
    "time-series-forecasting",
    "cc-by-4.0",
    "100M - 1B",
    "Tabular",
    "Text",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "prediction-markets",
