    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "as_splits/split_name"
      },
      "@id": "as_splits",
      "name": "as_splits",
      "description": "Splits for the as config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "as_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "as_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "as",
      "description": "ai4bharat/samanantar - 'as' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "as/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-as"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "as/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "as_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "as/idx",
          "dataType": "sc:Integer",
