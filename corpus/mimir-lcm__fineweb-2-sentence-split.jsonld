        "@id": "arb_Arab_splits/split_name"
      },
      "@id": "arb_Arab_splits",
      "name": "arb_Arab_splits",
      "description": "Splits for the arb_Arab config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "arb_Arab_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "arb_Arab_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "arb_Arab",
      "description": "mimir-lcm/fineweb-2-sentence-split - 'arb_Arab' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "arb_Arab/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-arb_Arab"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "arb_Arab/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "arb_Arab_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "arb_Arab/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-arb_Arab"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "arb_Arab/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
