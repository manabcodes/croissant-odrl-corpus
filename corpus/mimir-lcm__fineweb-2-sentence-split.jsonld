  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "fineweb-2-sentence-split",
  "description": "Fineweb 2 split into sentences. Instances per languages were sampled by us to balance the data w.r.t. Fineweb-edu.\nTo split the text into sentences we used the sat3-l model from the wtpsplit library. \nWe fix a sentence threshold of 0.02 and a maximum sentence length of 256.\nIf you use this dataset, you should cite:\n@misc{penedo2025fineweb2pipelinescale,\n  title={FineWeb2: One Pipeline to Scale Them All -- Adapting Pre-Training Data Processing to Every Language}, \n  author={Guilherme Penedo and\u2026 See the full description on the dataset page: https://huggingface.co/datasets/mimir-lcm/fineweb-2-sentence-split.",
  "alternateName": [
    "mimir-lcm/fineweb-2-sentence-split"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Mimir",
    "url": "https://huggingface.co/mimir-lcm"
  },
  "keywords": [
    "Arabic",
    "Belarusian",
    "Bulgarian",
    "Bengali",
    "Bosnian",
    "Catalan",
    "Czech",
    "Welsh",
    "Danish",
    "German",
    "Spanish",
    "French",
    "Hebrew",
    "Hindi",
    "Croatian",
    "Indonesian",
    "Italian",
    "Japanese",
