            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "arb_Arab/text_sentences",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-arb_Arab"
            },
            "extract": {
              "column": "text_sentences"
            }
