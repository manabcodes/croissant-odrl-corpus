{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/JingkunAn/RefSpatial/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-SubsetVisualization",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "SubsetVisualization/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "SubsetVisualization_splits/split_name"
      },
      "@id": "SubsetVisualization_splits",
      "name": "SubsetVisualization_splits",
      "description": "Splits for the SubsetVisualization config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "SubsetVisualization_splits/split_name": "2D"
        },
        {
          "SubsetVisualization_splits/split_name": "3D"
        },
        {
          "SubsetVisualization_splits/split_name": "Simulator"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "SubsetVisualization",
      "description": "JingkunAn/RefSpatial - 'SubsetVisualization' subset\n\nAdditional information:\n- 3 splits: 2D, 3D, Simulator",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "SubsetVisualization/(?:partial-)?(2D|3D|Simulator)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "SubsetVisualization_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/json_file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "json_file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/image_0",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "image_0"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/image_1",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "image_1"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/depth_0",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "depth_0"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/depth_1",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "depth_1"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/conversations",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "SubsetVisualization/conversations/from",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-SubsetVisualization"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "from"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "SubsetVisualization/conversations/value",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-SubsetVisualization"
                },
                "extract": {
                  "column": "conversations"
                },
                "transform": {
                  "jsonPath": "value"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/thinking",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "SubsetVisualization/thinking/question_type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-SubsetVisualization"
                },
                "extract": {
                  "column": "thinking"
                },
                "transform": {
                  "jsonPath": "question_type"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "SubsetVisualization/thinking/thinking",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-SubsetVisualization"
                },
                "extract": {
                  "column": "thinking"
                },
                "transform": {
                  "jsonPath": "thinking"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/image_names",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "image_names"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/depth_names",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "depth_names"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/image_root",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "image_root"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "SubsetVisualization/depth_root",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-SubsetVisualization"
            },
            "extract": {
              "column": "depth_root"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "RefSpatial",
  "description": "\n  \u26a0\ufe0f Warning: The Dataset Viewer and Data Studio above are for display only. They show just 800 samples from the full RefSpatial dataset, taken from the \"SubsetVisualization\" folder in Hugging Face \".parquet\" format.\n\n\n\n\n  \u2139\ufe0f Info: The full raw dataset (~357GB) is available in non-HF formats (e.g., images, depth maps, JSON files).\n\n\n\n  \n  \n  \n  \n    RefSpatial: A Large-scale Dataset for teaching a general VLM to achieve spatial referring with reasoning\u2026 See the full description on the dataset page: https://huggingface.co/datasets/JingkunAn/RefSpatial.",
  "alternateName": [
    "JingkunAn/RefSpatial"
  ],
  "creator": {
    "@type": "Person",
    "name": "Jingkun",
    "url": "https://huggingface.co/JingkunAn"
  },
  "keywords": [
    "question-answering",
    "apache-2.0",
    "< 1K",
