{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/inesc-id/FalAR/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "dev"
        },
        {
          "default_splits/split_name": "test"
        },
        {
          "default_splits/split_name": "train_0"
        },
        {
          "default_splits/split_name": "train_1"
        },
        {
          "default_splits/split_name": "train_2"
        },
        {
          "default_splits/split_name": "train_3"
        },
        {
          "default_splits/split_name": "train_4"
        },
        {
          "default_splits/split_name": "train_5"
        },
        {
          "default_splits/split_name": "train_6"
        },
        {
          "default_splits/split_name": "train_7"
        },
        {
          "default_splits/split_name": "train_8"
        },
        {
          "default_splits/split_name": "train_9"
        },
        {
          "default_splits/split_name": "train_10"
        },
        {
          "default_splits/split_name": "train_11"
        },
        {
          "default_splits/split_name": "train_12"
        },
        {
          "default_splits/split_name": "train_13"
        },
        {
          "default_splits/split_name": "train_14"
        },
        {
          "default_splits/split_name": "train_15"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "inesc-id/FalAR - 'default' subset\n\nAdditional information:\n- 18 splits: dev, test, train_0, train_1, train_2, train_3, train_4, train_5, train_6, train_7, train_8, train_9, train_10, train_11, train_12, train_13, train_14, train_15",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(dev|test|train_0|train_1|train_2|train_3|train_4|train_5|train_6|train_7|train_8|train_9|train_10|train_11|train_12|train_13|train_14|train_15)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/ID",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ID"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/wav",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "wav"
            },
            "sampling_rate": 16000
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_id",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/duration",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/wrd",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "wrd"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/transcription",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "transcription"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id_lsmi",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id_lsmi"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/cer",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "cer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_affiliation",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_affiliation"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_role",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_role"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/action",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "action"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/gender",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gender"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/age",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "age"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "FalAR",
  "description": "\n\t\n\t\t\n\t\tFalAR\n\t\n\n\nFalAR is a large-scale, speaker-annotated European Portuguese speech corpus built from recordings of parliamentary sessions of the Portuguese Parliament. The dataset contains aligned speech segments, reference transcripts, automatic transcripts, and speaker metadata.\nThis release is intended to support research in automatic speech recognition (ASR), speaker-aware speech processing, and related studies on parliamentary speech in European Portuguese.\n\n\t\n\t\t\n\t\n\t\n\t\tHighlights\u2026 See the full description on the dataset page: https://huggingface.co/datasets/inesc-id/FalAR.",
  "alternateName": [
    "inesc-id/FalAR"
  ],
  "creator": {
    "@type": "Organization",
    "name": "INESC-ID Lisboa",
    "url": "https://huggingface.co/inesc-id"
  },
  "keywords": [
    "cc-by-4.0",
    "100K - 1M",
    "parquet",
    "optimized-parquet",
    "Audio",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/inesc-id/FalAR",
  "usageInfo": {
    "@type": [
