  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "RWKU",
  "identifier": "10.57967/hf/2448",
  "description": "\n\t\n\t\t\n\t\tDataset Card for Real-World Knowledge Unlearning Benchmark (RWKU)\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nRWKU is a real-world knowledge unlearning benchmark specifically designed for large language models (LLMs).\nThis benchmark contains 200 real-world unlearning targets and 13,131 multi-level forget probes, including 3,268 fill-in-the-blank probes, 2,879 question-answer probes, and 6,984 adversarial-attack probes.\nRWKU is designed based on the following three key factors: \n\nFor the task setting\u2026 See the full description on the dataset page: https://huggingface.co/datasets/jinzhuoran/RWKU.",
  "alternateName": [
    "jinzhuoran/RWKU",
    "RWKU"
  ],
  "creator": {
    "@type": "Person",
    "name": "Zhuoran Jin",
    "url": "https://huggingface.co/jinzhuoran"
  },
  "keywords": [
    "text-generation",
    "fill-mask",
    "question-answering",
    "English",
    "cc-by-4.0",
    "100K - 1M",
    "json",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
