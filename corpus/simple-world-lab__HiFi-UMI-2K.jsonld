    "lerobot",
    "arxiv:2607.25895",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "robotics",
    "robot-learning",
    "robot-manipulation",
    "imitation-learning",
    "vision-language-action",
    "world-action-model",
    "multimodal",
    "video",
    "lerobot",
    "umi",
    "arxiv:2607.25895"
  ],
