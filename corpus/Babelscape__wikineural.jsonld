{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Babelscape/wikineural/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "name": "parquet-files-for-config-default",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "test_de"
        },
        {
          "default_splits/split_name": "test_en"
        },
        {
          "default_splits/split_name": "test_es"
        },
        {
          "default_splits/split_name": "test_fr"
        },
        {
          "default_splits/split_name": "test_it"
        },
        {
          "default_splits/split_name": "test_nl"
        },
        {
          "default_splits/split_name": "test_pl"
        },
        {
          "default_splits/split_name": "test_pt"
        },
        {
          "default_splits/split_name": "test_ru"
        },
        {
          "default_splits/split_name": "train_de"
        },
        {
          "default_splits/split_name": "train_en"
        },
        {
          "default_splits/split_name": "train_es"
        },
        {
          "default_splits/split_name": "train_fr"
        },
        {
          "default_splits/split_name": "train_it"
        },
        {
          "default_splits/split_name": "train_nl"
        },
        {
          "default_splits/split_name": "train_pl"
        },
        {
          "default_splits/split_name": "train_pt"
        },
        {
          "default_splits/split_name": "train_ru"
        },
        {
          "default_splits/split_name": "val_de"
        },
        {
          "default_splits/split_name": "val_en"
        },
        {
          "default_splits/split_name": "val_es"
        },
        {
          "default_splits/split_name": "val_fr"
        },
        {
          "default_splits/split_name": "val_it"
        },
        {
          "default_splits/split_name": "val_nl"
        },
        {
          "default_splits/split_name": "val_pl"
        },
        {
          "default_splits/split_name": "val_pt"
        },
        {
          "default_splits/split_name": "val_ru"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "Babelscape/wikineural - 'default' subset\n\nAdditional information:\n- 27 splits: test_de, test_en, test_es, test_fr, test_it, test_nl, test_pl, test_pt, test_ru, train_de, train_en, train_es, train_fr, train_it, train_nl, train_pl, train_pt, train_ru, val_de, val_en, val_es, val_fr, val_it, val_nl, val_pl, val_pt, val_ru",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "name": "default/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(test_de|test_en|test_es|test_fr|test_it|test_nl|test_pl|test_pt|test_ru|train_de|train_en|train_es|train_fr|train_it|train_nl|train_pl|train_pt|train_ru|val_de|val_en|val_es|val_fr|val_it|val_nl|val_pl|val_pt|val_ru)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/tokens",
          "name": "default/tokens",
          "description": "Column 'tokens' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "tokens"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "default/ner_tags",
          "name": "default/ner_tags",
          "description": "Column 'ner_tags' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "ner_tags"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "default/lang",
          "name": "default/lang",
          "description": "Column 'lang' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "lang"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "wikineural",
  "description": "\n\t\n\t\t\n\t\tDataset Card for WikiNEuRal dataset\n\t\n\n\n\t\n\t\t\n\t\tDescription\n\t\n\n\nSummary: In a nutshell, WikiNEuRal consists in a novel technique which builds upon a multilingual lexical knowledge base (i.e., BabelNet) and transformer-based architectures (i.e., BERT) to produce high-quality annotations for multilingual NER. It shows consistent improvements of up to 6 span-based F1-score points against state-of-the-art alternative data production methods on common benchmarks for NER. We used this\u2026 See the full description on the dataset page: https://huggingface.co/datasets/Babelscape/wikineural.",
  "alternateName": [
    "Babelscape/wikineural",
    "wikineural-dataset"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Babelscape",
    "url": "https://huggingface.co/Babelscape"
  },
  "keywords": [
    "token-classification",
    "named-entity-recognition",
    "machine-generated",
    "machine-generated",
    "multilingual",
    "original",
    "German",
    "English",
    "Spanish",
    "French",
    "Italian",
    "Dutch",
    "Polish",
    "Portuguese",
    "Russian",
    "cc-by-nc-sa-4.0",
    "1M - 10M",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "arxiv:1810.04805",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "structure-prediction"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-nc-sa-4.0/",
  "url": "https://huggingface.co/datasets/Babelscape/wikineural",
