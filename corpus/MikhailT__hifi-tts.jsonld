  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/MikhailT/hifi-tts/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-all",
      "name": "parquet-files-for-config-all",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "all/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-clean",
      "name": "parquet-files-for-config-clean",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "clean/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-other",
      "name": "parquet-files-for-config-other",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "other/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "all_splits/split_name"
      },
      "@id": "all_splits",
      "name": "all_splits",
      "description": "Splits for the all config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_splits/split_name": "train.clean"
        },
        {
          "all_splits/split_name": "train.other"
        },
        {
          "all_splits/split_name": "dev.clean"
        },
        {
          "all_splits/split_name": "dev.other"
        },
        {
          "all_splits/split_name": "test.clean"
        },
        {
          "all_splits/split_name": "test.other"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all",
      "name": "all",
      "description": "MikhailT/hifi-tts - 'all' subset\n\nAdditional information:\n- 6 splits: train.clean, train.other, dev.clean, dev.other, test.clean, test.other\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all/split",
          "name": "all/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all/(?:partial-)?(train\\.clean|train\\.other|dev\\.clean|dev\\.other|test\\.clean|test\\.other)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/speaker",
          "name": "all/speaker",
          "description": "Column 'speaker' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "speaker"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/file",
          "name": "all/file",
          "description": "Column 'file' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/duration",
          "name": "all/duration",
          "description": "Column 'duration' from the Hugging Face parquet file.",
          "dataType": "sc:Float",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all/text",
          "name": "all/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
