      "@id": "seed_42_splits",
      "name": "seed_42_splits",
      "description": "Splits for the seed_42 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "seed_42_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "seed_42_splits/split_name": "train"
        }
      ]
