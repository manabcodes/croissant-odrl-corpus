    {
      "@type": "cr:RecordSet",
      "@id": "seed_42",
      "description": "OpenResearcher/OpenResearcher-Dataset - 'seed_42' subset\n\nAdditional information:\n- 1 skipped column: error",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "seed_42/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-seed_42"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "seed_42/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "seed_42_splits/split_name"
            }
          }
        },
        {
