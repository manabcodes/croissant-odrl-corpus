    {
      "@type": "cr:RecordSet",
      "@id": "all_languages",
      "name": "all_languages",
      "description": "nala-cub/americas_nli - 'all_languages' subset\n\nAdditional information:\n- 2 splits: validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_languages/split",
          "name": "all_languages/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_languages"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all_languages/(?:partial-)?(validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
