        {
          "@type": "cr:Field",
          "@id": "all_languages/premise",
          "name": "all_languages/premise",
          "description": "Column 'premise' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
