    "Bribri",
    "Ash\u00e1ninka",
    "Guaran\u00ed",
    "Huichol",
    "nah",
    "oto",
    "Quechua",
    "Shipibo-Conibo",
    "Central Tarahumara",
    "cc-by-sa-4.0",
    "10K - 100K",
