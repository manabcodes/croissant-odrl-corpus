            },
            "extract": {
              "column": "premise"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_languages/hypothesis",
          "name": "all_languages/hypothesis",
          "description": "Column 'hypothesis' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all_languages"
            },
            "extract": {
              "column": "hypothesis"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "all_languages/label",
          "name": "all_languages/label",
          "description": "ClassLabel column 'label' from the Hugging Face parquet file.\nLabels:\nentailment (0), neutral (1), contradiction (2)",
