  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/nayeon212/BLEnD/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-multiple-choice-questions",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "multiple-choice-questions/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-short-answer-questions",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "short-answer-questions/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "multiple-choice-questions_splits/split_name"
      },
      "@id": "multiple-choice-questions_splits",
      "name": "multiple-choice-questions_splits",
      "description": "Splits for the multiple-choice-questions config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "multiple-choice-questions_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "multiple-choice-questions",
      "description": "nayeon212/BLEnD - 'multiple-choice-questions' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-multiple-choice-questions"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "multiple\\-choice\\-questions/(?:partial-)?(test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "multiple-choice-questions_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions/MCQID",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-multiple-choice-questions"
            },
            "extract": {
              "column": "MCQID"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions/ID",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-multiple-choice-questions"
            },
            "extract": {
              "column": "ID"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions/country",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-multiple-choice-questions"
            },
            "extract": {
              "column": "country"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions/prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-multiple-choice-questions"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions/choices",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-multiple-choice-questions"
            },
            "extract": {
              "column": "choices"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions/choice_countries",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-multiple-choice-questions"
            },
            "extract": {
              "column": "choice_countries"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-questions/answer_idx",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-multiple-choice-questions"
            },
            "extract": {
              "column": "answer_idx"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "short-answer-questions_splits/split_name"
      },
      "@id": "short-answer-questions_splits",
      "name": "short-answer-questions_splits",
      "description": "Splits for the short-answer-questions config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "short-answer-questions_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "short-answer-questions_splits/split_name": "DZ"
        },
        {
          "short-answer-questions_splits/split_name": "AS"
        },
        {
          "short-answer-questions_splits/split_name": "AZ"
        },
        {
          "short-answer-questions_splits/split_name": "CN"
        },
        {
          "short-answer-questions_splits/split_name": "ET"
        },
        {
          "short-answer-questions_splits/split_name": "GR"
        },
        {
          "short-answer-questions_splits/split_name": "ID"
        },
        {
          "short-answer-questions_splits/split_name": "IR"
        },
        {
          "short-answer-questions_splits/split_name": "MX"
        },
        {
          "short-answer-questions_splits/split_name": "KP"
        },
        {
          "short-answer-questions_splits/split_name": "NG"
        },
        {
          "short-answer-questions_splits/split_name": "KR"
        },
        {
          "short-answer-questions_splits/split_name": "ES"
        },
        {
          "short-answer-questions_splits/split_name": "GB"
        },
        {
          "short-answer-questions_splits/split_name": "US"
        },
        {
          "short-answer-questions_splits/split_name": "JB"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "short-answer-questions",
      "description": "nayeon212/BLEnD - 'short-answer-questions' subset\n\nAdditional information:\n- 16 splits: DZ, AS, AZ, CN, ET, GR, ID, IR, MX, KP, NG, KR, ES, GB, US, JB",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "short-answer-questions/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-short-answer-questions"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "short\\-answer\\-questions/(?:partial-)?(DZ|AS|AZ|CN|ET|GR|ID|IR|MX|KP|NG|KR|ES|GB|US|JB)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "short-answer-questions_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "short-answer-questions/ID",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-short-answer-questions"
            },
            "extract": {
              "column": "ID"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "short-answer-questions/Topic",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-short-answer-questions"
            },
            "extract": {
              "column": "Topic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "short-answer-questions/Source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-short-answer-questions"
            },
            "extract": {
              "column": "Source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "short-answer-questions/Question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-short-answer-questions"
            },
            "extract": {
              "column": "Question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "short-answer-questions/Translation",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-short-answer-questions"
            },
            "extract": {
              "column": "Translation"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "BLEnD",
  "description": "\n\t\n\t\t\n\t\tBLEnD\n\t\n\nThis is the official repository of BLEnD: A Benchmark for LLMs on Everyday Knowledge in Diverse Cultures and Languages (Submitted to NeurIPS 2024 Datasets and Benchmarks Track).\n24/12/05: Updated translation errors25/05/02: Updated multiple choice questions file (v1.1)\n\n\t\n\t\t\n\t\tAbout\n\t\n\n\nLarge language models (LLMs) often lack culture-specific everyday knowledge, especially across diverse regions and non-English languages. Existing benchmarks for evaluating LLMs' cultural\u2026 See the full description on the dataset page: https://huggingface.co/datasets/nayeon212/BLEnD.",
  "alternateName": [
    "nayeon212/BLEnD"
  ],
  "creator": {
    "@type": "Person",
    "name": "Nayeon Lee",
    "url": "https://huggingface.co/nayeon212"
  },
