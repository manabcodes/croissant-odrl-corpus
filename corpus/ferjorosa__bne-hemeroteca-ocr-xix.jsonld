    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ferjorosa/bne-hemeroteca-ocr-xix/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "agricultura_y_ganaderia"
        },
        {
          "default_splits/split_name": "ciencias"
        },
        {
          "default_splits/split_name": "cultura"
        },
        {
          "default_splits/split_name": "deportes"
        },
        {
          "default_splits/split_name": "derecho"
        },
        {
          "default_splits/split_name": "economia"
        },
        {
          "default_splits/split_name": "educacion"
        },
        {
          "default_splits/split_name": "fuerzas_armadas"
        },
        {
          "default_splits/split_name": "historia"
        },
        {
          "default_splits/split_name": "industria"
        },
        {
          "default_splits/split_name": "literatura"
        },
        {
          "default_splits/split_name": "medicina"
        },
        {
          "default_splits/split_name": "mineria"
        },
        {
          "default_splits/split_name": "musica"
        },
        {
          "default_splits/split_name": "navegacion"
        },
        {
          "default_splits/split_name": "politica"
        },
        {
          "default_splits/split_name": "relaciones_internacionales"
        },
        {
          "default_splits/split_name": "religion"
        },
        {
          "default_splits/split_name": "revistas_femeninas"
        },
        {
          "default_splits/split_name": "teatro"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "ferjorosa/bne-hemeroteca-ocr-xix - 'default' subset\n\nAdditional information:\n- 20 splits: agricultura_y_ganaderia, ciencias, cultura, deportes, derecho, economia, educacion, fuerzas_armadas, historia, industria, literatura, medicina, mineria, musica, navegacion, politica, relaciones_internacionales, religion, revistas_femeninas, teatro",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(agricultura_y_ganaderia|ciencias|cultura|deportes|derecho|economia|educacion|fuerzas_armadas|historia|industria|literatura|medicina|mineria|musica|navegacion|politica|relaciones_internacionales|religion|revistas_femeninas|teatro)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/issue_uuid",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "issue_uuid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/issue_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "issue_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/page",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "page"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/publication_issn",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "publication_issn"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/date",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/issue_link",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "issue_link"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/model_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "model_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/total_input_tokens",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "total_input_tokens"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/total_output_tokens",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "total_output_tokens"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/total_fallback_pages",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "total_fallback_pages"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/primary_language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "primary_language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/is_rotation_valid",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "is_rotation_valid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/rotation_correction",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "rotation_correction"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/is_table",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "is_table"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/is_diagram",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "is_diagram"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "bne-hemeroteca-ocr-xix",
  "description": "\n\t\n\t\t\n\t\tBNE Hemeroteca OCR Dataset (19th Century)\n\t\n\nThis dataset provides full-text OCR and high-resolution page images for 19th-century Spanish publications sourced from the Biblioteca Nacional de Espa\u00f1a (BNE) - Hemeroteca Digital. It consists of over 830,000 pages from approximately 40,000 documents, totaling roughly 800 million text tokens.\nNote on Temporal Coverage: Although the selected publications originated in the 19th century, some long-running titles extend into the early 20th\u2026 See the full description on the dataset page: https://huggingface.co/datasets/ferjorosa/bne-hemeroteca-ocr-xix.",
  "alternateName": [
    "ferjorosa/bne-hemeroteca-ocr-xix"
  ],
  "creator": {
    "@type": "Person",
    "name": "Fernando Rodriguez",
    "url": "https://huggingface.co/ferjorosa"
  },
