              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/size/width",
              "name": "default/size/width",
              "description": "Column 'size' from the Hugging Face parquet file.",
              "dataType": "sc:Integer",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
