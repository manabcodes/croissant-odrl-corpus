  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "alignments_splits/split_name"
      },
      "@id": "alignments_splits",
      "name": "alignments_splits",
      "description": "Splits for the alignments config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "alignments_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "alignments_splits/split_name": "full"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "alignments",
      "name": "alignments",
      "description": "mhardalov/exams - 'alignments' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "alignments/split",
          "name": "alignments/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-alignments"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "alignments/(?:partial-)?(full)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "alignments_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "alignments/source_id",
          "name": "alignments/source_id",
          "description": "Column 'source_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-alignments"
            },
            "extract": {
              "column": "source_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "alignments/target_id_list",
          "name": "alignments/target_id_list",
          "description": "Column 'target_id_list' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-alignments"
            },
            "extract": {
              "column": "target_id_list"
            }
          },
          "repeated": true
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "crosslingual_bg_splits/split_name"
      },
      "@id": "crosslingual_bg_splits",
      "name": "crosslingual_bg_splits",
      "description": "Splits for the crosslingual_bg config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "crosslingual_bg_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "crosslingual_bg_splits/split_name": "train"
        },
        {
          "crosslingual_bg_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "crosslingual_bg",
      "name": "crosslingual_bg",
      "description": "mhardalov/exams - 'crosslingual_bg' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "crosslingual_bg/split",
          "name": "crosslingual_bg/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-crosslingual_bg"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "crosslingual_bg/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "crosslingual_bg_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
