    {
      "@type": "cr:RecordSet",
      "@id": "full_data",
      "name": "full_data",
      "description": "osunlp/AttributionBench - 'full_data' subset\n\nAdditional information:\n- 4 splits: train, dev, test, test_ood\n- 1 skipped column: webpage_references",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "full_data/split",
          "name": "full_data/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
