    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "benchmark_complex_splits/split_name"
      },
      "@id": "benchmark_complex_splits",
      "name": "benchmark_complex_splits",
      "description": "Splits for the benchmark_complex config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark_complex_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "benchmark_complex_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "benchmark_complex",
      "description": "OleehyO/latex-formulas-80M - 'benchmark_complex' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark_complex/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark_complex"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "benchmark_complex/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "benchmark_complex_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark_complex/image",
