            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark_complex/latex_formula",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark_complex"
            },
            "extract": {
              "column": "latex_formula"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark_complex/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-benchmark_complex"
            },
            "extract": {
              "column": "category"
            }
          }
        }
      ]
