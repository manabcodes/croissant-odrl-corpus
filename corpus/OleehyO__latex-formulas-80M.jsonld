      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/OleehyO/latex-formulas-80M/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-benchmark_complex",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "benchmark_complex/*/*.parquet"
    },
