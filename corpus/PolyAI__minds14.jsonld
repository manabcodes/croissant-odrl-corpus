      "description": "Splits for the all config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "all_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all",
      "description": "PolyAI/minds14 - 'all' subset\n\nAdditional information:\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
