        },
        {
          "@type": "cr:Field",
          "@id": "default/airframe_combustor_angle_deg",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "airframe_combustor_angle_deg"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/airframe_length_frac_intake",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "airframe_length_frac_intake"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/airframe_length_frac_isolator",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "airframe_length_frac_isolator"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/airframe_length_frac_combustor",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "airframe_length_frac_combustor"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/airframe_length_frac_nozzle",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "airframe_length_frac_nozzle"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/intake_ramp_1_angle_deg",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "intake_ramp_1_angle_deg"
            }
