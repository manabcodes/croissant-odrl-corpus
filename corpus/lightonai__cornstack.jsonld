      "@id": "go_splits",
      "name": "go_splits",
      "description": "Splits for the go config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "go_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "go_splits/split_name": "train"
        }
      ]
    },
    {
