        }
      ],
      "data": [
        {
          "all_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "all",
      "name": "all",
      "description": "Hello-SimpleAI/HC3-Chinese - 'all' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "all/split",
          "name": "all/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-all"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "all/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "all_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
