    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-plates",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "plates/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-siglip2_embeddings",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "siglip2_embeddings/*/*.parquet"
