      "includes": "pseudobulk_differential_expression/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-sample_metadata",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "sample_metadata/*/*.parquet"
    }
