{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/SimpleStories/SimpleStories/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "SimpleStories/SimpleStories - 'default' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/story",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "story"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/topic",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "topic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/theme",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "theme"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/style",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "style"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/feature",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "feature"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/grammar",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "grammar"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/persona",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "persona"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/initial_word_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "initial_word_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/initial_letter",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "initial_letter"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/word_count",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "word_count"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/character_count",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "character_count"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_paragraphs",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_paragraphs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/avg_word_length",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "avg_word_length"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/avg_sentence_length",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "avg_sentence_length"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/flesch_reading_ease",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "flesch_reading_ease"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/flesch_kincaid_grade",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "flesch_kincaid_grade"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/dale_chall_readability_score",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "dale_chall_readability_score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_stories_in_completion",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_stories_in_completion"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/expected_num_stories_in_completion",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "expected_num_stories_in_completion"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/generation_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "generation_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/model",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "model"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "SimpleStories",
  "description": "\n\t\n\t\t\n\t\t\ud83d\udcd8\ud83d\udcd5 SimpleStories \ud83d\udcd9\ud83d\udcd7\n\t\n\nSimpleStories is a dataset of >2 million model-generated short stories. It was made to train small, interpretable language models on it. The generation process is open-source: To see how the dataset was generated, or to generate some stories yourself, head over to this repository.\nIf you'd like to commission other languages or story formats, feel free to send mail.\nWhen using SimpleStories in your work, please cite the SimpleStories paper:\u2026 See the full description on the dataset page: https://huggingface.co/datasets/SimpleStories/SimpleStories.",
  "alternateName": [
    "SimpleStories/SimpleStories",
    "SimpleStories"
  ],
  "creator": {
    "@type": "Organization",
    "name": "The SimpleStories Project",
    "url": "https://huggingface.co/SimpleStories"
  },
  "keywords": [
    "text-generation",
    "English",
    "mit",
    "1M - 10M",
    "parquet",
    "Tabular",
    "Text",
    "Datasets",
    "Dask",
    "Croissant",
    "Polars",
    "arxiv:2504.09184",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "NLP",
    "Distillation"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/SimpleStories/SimpleStories",
