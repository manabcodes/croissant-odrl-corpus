{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/mesolitica/Malaysian-Emilia-annotated/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "malaysian_emilia_podcast"
        },
        {
          "default_splits/split_name": "malaysian_emilia_youtube"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "mesolitica/Malaysian-Emilia-annotated - 'default' subset\n\nAdditional information:\n- 2 splits: malaysian_emilia_podcast, malaysian_emilia_youtube",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(malaysian_emilia_podcast|malaysian_emilia_youtube)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/transcription",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "transcription"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/gender",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gender"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/country",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "country"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/utterance_pitch_mean",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "utterance_pitch_mean"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/utterance_pitch_std",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "utterance_pitch_std"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/snr",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "snr"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/c50",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "c50"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speech_duration",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speech_duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/stoi",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "stoi"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/si-sdr",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "si-sdr"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pesq",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pesq"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/pitch",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "pitch"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaking_rate",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaking_rate"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/noise",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "noise"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/reverberation",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "reverberation"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speech_monotony",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speech_monotony"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sdr_noise",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sdr_noise"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/audio_filename",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "audio_filename"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/prompt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "prompt"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Malaysian-Emilia-annotated",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tMalaysian Emilia Annotated\n\t\n\nAnnotate Malaysian-Emilia using Data-Speech pipeline.\n\n\t\n\t\t\n\t\n\t\n\t\tMalaysian Youtube\n\t\n\n\nOriginally from malaysia-ai/crawl-youtube\nTotal 3168.8 hours.\nGender prediction, filtered-24k_processed_24k_gender.zip\nLanguage prediction, filtered-24k_processed_language.zip\n\nForce alignment.\n\n\nPost cleaned to 24k and 44k sampling rates,\n\n\n24k, filtered-24k_processed_24k.zip\n44k, filtered-24k_processed_44k.zip\n\n\nSynthetic description\u2026 See the full description on the dataset page: https://huggingface.co/datasets/mesolitica/Malaysian-Emilia-annotated.",
  "alternateName": [
    "mesolitica/Malaysian-Emilia-annotated",
    "malaysian-emilia-annotated"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Mesolitica",
    "url": "https://huggingface.co/mesolitica"
  },
  "keywords": [
    "text-to-speech",
    "Malay",
    "English",
    "cc-by-nc-4.0",
