{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/gtfintechlab/ipo-text/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "gtfintechlab/ipo-text - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/company",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "company"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/company_tickers",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "company_tickers"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/cik",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "cik"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sic",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sic"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/office",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "office"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/industry",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "industry"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/exchanges",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "exchanges"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/filing_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "filing_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/filing_date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "filing_date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/filing_accession_number",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "filing_accession_number"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/filing_processed",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "filing_processed"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_toc_keys",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_toc_keys"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_prospectus_summary_valid",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_prospectus_summary_valid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_prospectus_summary",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_prospectus_summary"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_prospectus_summary_word_count",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_prospectus_summary_word_count"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_risk_factors_valid",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_risk_factors_valid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_risk_factors",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_risk_factors"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_risk_factors_word_count",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_risk_factors_word_count"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_legal_matters_valid",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_legal_matters_valid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_legal_matters",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_legal_matters"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_legal_matters_word_count",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_legal_matters_word_count"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/filing_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "filing_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/filing_images",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "filing_images"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "ipo-text",
  "description": "\n\t\n\t\t\n\t\tSEC IPO Filings Dataset\n\t\n\nA large-scale, comprehensive dataset of 100,000+ filings (S-1 and F-1 filings) filed with the SEC EDGAR system, spanning 1994\u20132026 and over 20,000 unique registrants.\nEvery filing has been downloaded and then parsed using the IPO-Mine Python Package. We have extracted three common sections found in these documents (Prospectus Summary, Risk Factors, Legal Matters), and then used an LLM classifier to group them into three categories. For this dataset, we have\u2026 See the full description on the dataset page: https://huggingface.co/datasets/gtfintechlab/ipo-text.",
  "alternateName": [
    "gtfintechlab/ipo-text",
    "SEC IPO Filings Datase"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Financial Services Innovation Lab, Georgia Tech",
    "url": "https://huggingface.co/gtfintechlab"
  },
  "keywords": [
    "text-classification",
    "sentence-similarity",
    "document-question-answering",
    "English",
    "cc-by-4.0",
    "100K - 1M",
    "json",
    "Tabular",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
