        "@id": "flux2_splits/split_name"
      },
      "@id": "flux2_splits",
      "name": "flux2_splits",
      "description": "Splits for the flux2 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "flux2_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "flux2_splits/split_name": "scigen"
        },
        {
          "flux2_splits/split_name": "seephys"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "flux2",
      "description": "J017athan/SciGenBench - 'flux2' subset\n\nAdditional information:\n- 2 splits: scigen, seephys",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "flux2/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flux2"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "flux2/(?:partial-)?(scigen|seephys)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "flux2_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flux2/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flux2"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flux2/original_question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flux2"
            },
            "extract": {
              "column": "original_question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flux2/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flux2"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flux2/image_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flux2"
            },
            "extract": {
              "column": "image_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "flux2/multimodal_question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-flux2"
            },
            "extract": {
              "column": "multimodal_question"
            }
          }
        }
      ]
    },
