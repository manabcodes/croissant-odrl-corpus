{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/Columbia-NLP/PUPA/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-pupa_new",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "pupa_new/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-pupa_tnb",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "pupa_tnb/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "pupa_new_splits/split_name"
      },
      "@id": "pupa_new_splits",
      "name": "pupa_new_splits",
      "description": "Splits for the pupa_new config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pupa_new_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "pupa_new_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "pupa_new",
      "description": "Columbia-NLP/PUPA - 'pupa_new' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pupa_new/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_new"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "pupa_new/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "pupa_new_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_new/conversation_hash",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_new"
            },
            "extract": {
              "column": "conversation_hash"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_new/predicted_category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_new"
            },
            "extract": {
              "column": "predicted_category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_new/user_query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_new"
            },
            "extract": {
              "column": "user_query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_new/target_response",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_new"
            },
            "extract": {
              "column": "target_response"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_new/pii_units",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_new"
            },
            "extract": {
              "column": "pii_units"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_new/redacted_query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_new"
            },
            "extract": {
              "column": "redacted_query"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "pupa_tnb_splits/split_name"
      },
      "@id": "pupa_tnb_splits",
      "name": "pupa_tnb_splits",
      "description": "Splits for the pupa_tnb config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pupa_tnb_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "pupa_tnb_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "pupa_tnb",
      "description": "Columbia-NLP/PUPA - 'pupa_tnb' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pupa_tnb/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_tnb"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "pupa_tnb/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "pupa_tnb_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_tnb/conversation_hash",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_tnb"
            },
            "extract": {
              "column": "conversation_hash"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_tnb/predicted_category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_tnb"
            },
            "extract": {
              "column": "predicted_category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_tnb/user_query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_tnb"
            },
            "extract": {
              "column": "user_query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_tnb/target_response",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_tnb"
            },
            "extract": {
              "column": "target_response"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_tnb/pii_units",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_tnb"
            },
            "extract": {
              "column": "pii_units"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pupa_tnb/redacted_query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pupa_tnb"
            },
            "extract": {
              "column": "redacted_query"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "PUPA",
  "description": "This dataset contains the data presented in the paper PAPILLON: Privacy Preservation from Internet-based and Local Language Model Ensembles.\nCode: https://github.com/siyan-sylvia-li/PAPILLON\n",
  "alternateName": [
    "Columbia-NLP/PUPA"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Columbia NLP",
    "url": "https://huggingface.co/Columbia-NLP"
  },
  "keywords": [
    "text-generation",
