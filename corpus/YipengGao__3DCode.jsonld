{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/YipengGao/3DCode/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-3DCodeData",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "3DCodeData/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "3DCodeData_splits/split_name"
      },
      "@id": "3DCodeData_splits",
      "name": "3DCodeData_splits",
      "description": "Splits for the 3DCodeData config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "3DCodeData_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "3DCodeData_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "3DCodeData",
      "description": "YipengGao/3DCode - '3DCodeData' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "3DCodeData/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-3DCodeData"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "3DCodeData/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "3DCodeData_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "3DCodeData/factory",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-3DCodeData"
            },
            "extract": {
              "column": "factory"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "3DCodeData/preview",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-3DCodeData"
            },
            "extract": {
              "column": "preview"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "3DCodeData/caption_object",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-3DCodeData"
            },
            "extract": {
              "column": "caption_object"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "3DCodeData/caption_create_3D_object",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-3DCodeData"
            },
            "extract": {
              "column": "caption_create_3D_object"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "3DCodeData/code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-3DCodeData"
            },
            "extract": {
              "column": "code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "3DCodeData/code_geo",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-3DCodeData"
            },
            "extract": {
              "column": "code_geo"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "3DCode",
  "description": "\n  \n\n\n\n\t\n\t\t\nProject page\nPaper\nCode\n\n\n\t\t\n3dcodebench.com\narXiv:2606.01057\ngaoypeng/3dcodebench\n\n\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tNews\n\t\n\n\n[06/01/2026] Paper released on arXiv: 3DCodeBench: Benchmarking Agentic Procedural 3D Modeling Via Code.\n\n\nNote. This is an open-source reproduction of 3DCodeBench.\n\n\n\u26a0\ufe0f Under final check. The 3DCodeData/ code is still undergoing final\nquality review and may contain occasional issues (non-executable scripts, mismatched\ncaptions/renders, or imperfect geometry). If you run\u2026 See the full description on the dataset page: https://huggingface.co/datasets/YipengGao/3DCode.",
  "alternateName": [
    "YipengGao/3DCode"
  ],
  "creator": {
    "@type": "Person",
    "name": "Yipeng Gao",
    "url": "https://huggingface.co/YipengGao"
  },
  "keywords": [
    "text-to-3d",
    "image-to-3d",
    "English",
    "mit",
    "10K - 100K",
    "parquet",
    "3D",
    "Image",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2606.01057",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "procedural-3d",
    "blender",
    "code-generation",
    "benchmark"
  ],
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/YipengGao/3DCode",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "MIT License",
