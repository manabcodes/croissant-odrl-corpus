            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
              "column": "doctrine"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/decl",
          "dataType": "cr:Int64",
