            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/predicted_hash",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
              "column": "predicted_hash"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/actual_hash",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
