  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/SZLHOLDINGS/szl-lake/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-receipts",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "receipts/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "receipts_splits/split_name"
      },
      "@id": "receipts_splits",
      "name": "receipts_splits",
      "description": "Splits for the receipts config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "receipts_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "receipts_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "receipts",
      "description": "SZLHOLDINGS/szl-lake - 'receipts' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "receipts/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "receipts/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "receipts_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/receipt_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
              "column": "receipt_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/timestamp",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
              "column": "timestamp"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/organ",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
              "column": "organ"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/kind",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
              "column": "kind"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
              "column": "index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "receipts/lambda",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-receipts"
            },
            "extract": {
