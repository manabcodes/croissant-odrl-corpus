{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/facebook/show3d-dataset/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "facebook/show3d-dataset - 'default' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/scene_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "scene_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/subject_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "subject_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/activity",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "activity"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_frames",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_frames"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/fps",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "fps"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/blur_applied",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "blur_applied"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_headset0",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_headset0"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_headset1",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_headset1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/headset0_resolution",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "headset0_resolution"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/headset1_resolution",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "headset1_resolution"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_rig0",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_rig0"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_rig1",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_rig1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_rig2",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_rig2"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_rig3",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_rig3"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_rig4",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_rig4"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_rig5",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_rig5"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_rig6",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_rig6"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_rig7",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_rig7"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_hand_pose",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_hand_pose"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_object_pose",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_object_pose"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/has_caption",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "has_caption"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "show3d-dataset",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tSHOW3D: Capturing Scenes of 3D Hands and Objects in the Wild\n\t\n\nPatrick Rim, Kevin Harris, Braden Copple, Shangchen Han, Xu Xie, Ivan Shugurov, Sizhe An, He Wen,\nAlex Wong, Tomas Hodan, and Kun He\nCVPR 2026; https://arxiv.org/abs/2603.28760\n\nSHOW3D is a large-scale multi-view dataset of hand\u2013object interactions captured in the wild.\nIt is intended to advance research on egocentric 3D hand\u2013object interaction understanding,\nand generalization of perception models to real-world\u2026 See the full description on the dataset page: https://huggingface.co/datasets/facebook/show3d-dataset.",
  "alternateName": [
    "facebook/show3d-dataset",
    "SHOW3D"
  ],
  "creator": {
    "@type": "Organization",
    "name": "AI at Meta",
    "url": "https://huggingface.co/facebook"
  },
