  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "l10_splits/split_name"
      },
      "@id": "l10_splits",
      "name": "l10_splits",
      "description": "Splits for the l10 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "l10_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "l10_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "l10",
      "name": "l10",
      "description": "kisate-team/gemma-2b-suite-explanations - 'l10' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "l10/split",
          "name": "l10/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-l10"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "l10/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "l10_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "l10/feature",
          "name": "l10/feature",
          "description": "Column 'feature' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-l10"
            },
            "extract": {
              "column": "feature"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "l10/explanation",
          "name": "l10/explanation",
          "description": "Column 'explanation' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-l10"
            },
            "extract": {
              "column": "explanation"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "l10/settings",
          "name": "l10/settings",
          "description": "Column 'settings' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "l10/settings/min_scale",
              "name": "l10/settings/min_scale",
              "description": "Column 'settings' from the Hugging Face parquet file.",
              "dataType": "sc:Integer",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-l10"
                },
                "extract": {
                  "column": "settings"
                },
                "transform": {
                  "jsonPath": "min_scale"
                }
              }
            },
            {
              "@type": "cr:Field",
