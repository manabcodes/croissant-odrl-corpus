                {
                  "@type": "cr:Field",
                  "@id": "default/json/qwen_source_meta/source_json_rel",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "qwen_source_meta"
                      },
                      {
                        "jsonPath": "source_json_rel"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/json/qwen_source_meta/source_tar",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
