  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/laion/captioned-ai-music-snippets/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "laion/captioned-ai-music-snippets - 'default' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/mp3",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "mp3"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/json",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/json/Flash_2.0_Annotation",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/json/Flash_2.0_Annotation/caption",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "['Flash 2.0 Annotation']"
                      },
                      {
                        "jsonPath": "caption"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/json/Flash_2.0_Annotation/interpretation",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "['Flash 2.0 Annotation']"
                      },
                      {
                        "jsonPath": "interpretation"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/comprehensive_caption",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "comprehensive_caption"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/duration_ms",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "duration_ms"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/meta",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "meta"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/path",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "path"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/qwen_chat",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/json/qwen_chat/messages",
                  "subField": [
                    {
                      "@type": "cr:Field",
                      "@id": "default/json/qwen_chat/messages/content",
                      "subField": [
                        {
                          "@type": "cr:Field",
                          "@id": "default/json/qwen_chat/messages/content/text",
                          "dataType": "sc:Text",
                          "source": {
                            "fileSet": {
                              "@id": "parquet-files-for-config-default"
                            },
                            "extract": {
                              "column": "json"
                            },
                            "transform": [
                              {
                                "jsonPath": "qwen_chat"
                              },
                              {
                                "jsonPath": "messages"
                              },
                              {
                                "jsonPath": "content"
                              },
                              {
                                "jsonPath": "text"
                              }
                            ]
                          }
                        },
                        {
                          "@type": "cr:Field",
                          "@id": "default/json/qwen_chat/messages/content/type",
                          "dataType": "sc:Text",
                          "source": {
                            "fileSet": {
                              "@id": "parquet-files-for-config-default"
                            },
                            "extract": {
                              "column": "json"
                            },
                            "transform": [
                              {
                                "jsonPath": "qwen_chat"
                              },
                              {
                                "jsonPath": "messages"
                              },
                              {
                                "jsonPath": "content"
                              },
                              {
                                "jsonPath": "type"
                              }
                            ]
                          }
                        }
                      ],
                      "isArray": true,
                      "arrayShape": "-1"
                    },
                    {
                      "@type": "cr:Field",
                      "@id": "default/json/qwen_chat/messages/role",
                      "dataType": "sc:Text",
                      "source": {
                        "fileSet": {
                          "@id": "parquet-files-for-config-default"
                        },
                        "extract": {
                          "column": "json"
                        },
                        "transform": [
                          {
                            "jsonPath": "qwen_chat"
                          },
                          {
                            "jsonPath": "messages"
                          },
                          {
                            "jsonPath": "role"
                          }
                        ]
                      }
                    }
                  ],
                  "isArray": true,
                  "arrayShape": "-1"
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/qwen_selected_caption_key_path",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "qwen_selected_caption_key_path"
                }
              }
            },
            {
              "@type": "cr:Field",
