{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/DeepStudentLlama/AoPS-Instruct/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-2024_not_decontaminated",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "2024_not_decontaminated/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "DeepStudentLlama/AoPS-Instruct - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/messages",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/messages/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/messages/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            }
          ],
          "repeated": true
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "2024_not_decontaminated_splits/split_name"
      },
      "@id": "2024_not_decontaminated_splits",
      "name": "2024_not_decontaminated_splits",
      "description": "Splits for the 2024_not_decontaminated config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "2024_not_decontaminated_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "2024_not_decontaminated_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "2024_not_decontaminated",
      "description": "DeepStudentLlama/AoPS-Instruct - '2024_not_decontaminated' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "2024_not_decontaminated/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-2024_not_decontaminated"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "2024_not_decontaminated/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "2024_not_decontaminated_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "2024_not_decontaminated/original_question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-2024_not_decontaminated"
            },
            "extract": {
              "column": "original_question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "2024_not_decontaminated/rewritten_question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-2024_not_decontaminated"
            },
            "extract": {
              "column": "rewritten_question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "2024_not_decontaminated/original_answers",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-2024_not_decontaminated"
            },
            "extract": {
              "column": "original_answers"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "2024_not_decontaminated/rewritten_answers",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-2024_not_decontaminated"
            },
            "extract": {
              "column": "rewritten_answers"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "2024_not_decontaminated/metadata",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "2024_not_decontaminated/metadata/question_metadata",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "2024_not_decontaminated/metadata/question_metadata/post_date",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-2024_not_decontaminated"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": {
                      "jsonPath": "post_date"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "2024_not_decontaminated/metadata/question_metadata/question_username_hash",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-2024_not_decontaminated"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": {
                      "jsonPath": "question_username_hash"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "2024_not_decontaminated/metadata/question_metadata/question_user_num_posts",
                  "dataType": "sc:Integer",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-2024_not_decontaminated"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": {
                      "jsonPath": "question_user_num_posts"
                    }
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "2024_not_decontaminated/metadata/answers_metadata",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "2024_not_decontaminated/metadata/answers_metadata/answer_username_hash",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-2024_not_decontaminated"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": {
                      "jsonPath": "answer_username_hash"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "2024_not_decontaminated/metadata/answers_metadata/answer_user_num_posts",
                  "dataType": "sc:Integer",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-2024_not_decontaminated"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": {
                      "jsonPath": "answer_user_num_posts"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "2024_not_decontaminated/metadata/answers_metadata/thanks_received",
                  "dataType": "sc:Integer",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-2024_not_decontaminated"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": {
                      "jsonPath": "thanks_received"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "2024_not_decontaminated/metadata/answers_metadata/answer_date",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-2024_not_decontaminated"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": {
                      "jsonPath": "answer_date"
                    }
                  }
                }
              ],
              "repeated": true
            }
          ]
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "AoPS-Instruct",
  "description": "Reproduction of AoPS-Instruct training set using code here: https://github.com/DSL-Lab/aops\n",
