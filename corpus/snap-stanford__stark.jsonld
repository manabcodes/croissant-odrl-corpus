    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-STaRK-Amazon",
      "name": "parquet-files-for-config-STaRK-Amazon",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "STaRK-Amazon/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-STaRK-MAG",
