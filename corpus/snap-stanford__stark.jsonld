            },
            "extract": {
              "column": "query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "STaRK-Amazon/answer_ids",
          "name": "STaRK-Amazon/answer_ids",
          "description": "Column 'answer_ids' from the Hugging Face parquet file.",
