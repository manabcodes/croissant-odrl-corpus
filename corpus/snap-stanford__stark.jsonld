          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-STaRK-Amazon"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "STaRK-Amazon/query",
