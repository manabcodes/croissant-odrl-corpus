  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "STaRK-Amazon_splits/split_name"
      },
      "@id": "STaRK-Amazon_splits",
      "name": "STaRK-Amazon_splits",
      "description": "Splits for the STaRK-Amazon config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "STaRK-Amazon_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "STaRK-Amazon_splits/split_name": "synthesized_all_split"
        },
        {
          "STaRK-Amazon_splits/split_name": "humen_generated_eval"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "STaRK-Amazon",
      "name": "STaRK-Amazon",
      "description": "snap-stanford/stark - 'STaRK-Amazon' subset\n\nAdditional information:\n- 2 splits: synthesized_all_split, humen_generated_eval",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "STaRK-Amazon/split",
          "name": "STaRK-Amazon/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-STaRK-Amazon"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "STaRK\\-Amazon/(?:partial-)?(synthesized_all_split|humen_generated_eval)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "STaRK-Amazon_splits/split_name"
            }
          }
        },
        {
