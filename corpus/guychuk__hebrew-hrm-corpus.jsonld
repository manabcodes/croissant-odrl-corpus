    "apache-2.0",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "hrm",
    "hierarchical-reasoning-model",
    "hebrew",
    "instruction-tuning",
    "prefix-lm",
    "ml-intern"
  ],
