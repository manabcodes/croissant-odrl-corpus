  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/HuggingFaceM4/Docmatix/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-images",
      "name": "parquet-files-for-config-images",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "images/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-pdf",
      "name": "parquet-files-for-config-pdf",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "pdf/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-zero-shot-exp",
      "name": "parquet-files-for-config-zero-shot-exp",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "zero-shot-exp/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "images_splits/split_name"
      },
      "@id": "images_splits",
      "name": "images_splits",
      "description": "Splits for the images config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "images_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "images_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "images",
      "name": "images",
      "description": "HuggingFaceM4/Docmatix - 'images' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "images/split",
          "name": "images/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-images"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "images/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "images_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "images/images",
          "name": "images/images",
          "description": "Image column 'images' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-images"
            },
            "extract": {
              "column": "images"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "images/texts",
          "name": "images/texts",
          "description": "Column 'texts' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "images/texts/user",
              "name": "images/texts/user",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-images"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "user"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "images/texts/assistant",
              "name": "images/texts/assistant",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-images"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "assistant"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "images/texts/source",
              "name": "images/texts/source",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-images"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "source"
                }
              }
            }
          ],
          "repeated": true
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "pdf_splits/split_name"
      },
      "@id": "pdf_splits",
      "name": "pdf_splits",
      "description": "Splits for the pdf config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pdf_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "pdf_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "pdf",
      "name": "pdf",
      "description": "HuggingFaceM4/Docmatix - 'pdf' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "pdf/split",
          "name": "pdf/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pdf"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
