            }
          },
          "references": {
            "field": {
              "@id": "pdf_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pdf/pdf",
          "name": "pdf/pdf",
          "description": "Column 'pdf' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-pdf"
            },
            "extract": {
              "column": "pdf"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "pdf/texts",
          "name": "pdf/texts",
          "description": "Column 'texts' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "pdf/texts/user",
              "name": "pdf/texts/user",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-pdf"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "user"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "pdf/texts/assistant",
              "name": "pdf/texts/assistant",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-pdf"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "assistant"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "pdf/texts/source",
              "name": "pdf/texts/source",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-pdf"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "source"
                }
              }
            }
          ],
          "repeated": true
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "zero-shot-exp_splits/split_name"
      },
      "@id": "zero-shot-exp_splits",
      "name": "zero-shot-exp_splits",
      "description": "Splits for the zero-shot-exp config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "zero-shot-exp_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "zero-shot-exp_splits/split_name": "train"
        },
        {
          "zero-shot-exp_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "zero-shot-exp",
      "name": "zero-shot-exp",
      "description": "HuggingFaceM4/Docmatix - 'zero-shot-exp' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "zero-shot-exp/split",
          "name": "zero-shot-exp/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zero-shot-exp"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "zero\\-shot\\-exp/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "zero-shot-exp_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "zero-shot-exp/images",
          "name": "zero-shot-exp/images",
          "description": "Image column 'images' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-zero-shot-exp"
            },
            "extract": {
              "column": "images"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          },
          "repeated": true
        },
        {
          "@type": "cr:Field",
          "@id": "zero-shot-exp/texts",
          "name": "zero-shot-exp/texts",
          "description": "Column 'texts' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "zero-shot-exp/texts/user",
              "name": "zero-shot-exp/texts/user",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-zero-shot-exp"
                },
                "extract": {
                  "column": "texts"
                },
                "transform": {
                  "jsonPath": "user"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "zero-shot-exp/texts/assistant",
              "name": "zero-shot-exp/texts/assistant",
              "description": "Column 'texts' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-zero-shot-exp"
                },
                "extract": {
                  "column": "texts"
