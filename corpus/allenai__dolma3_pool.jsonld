{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/allenai/dolma3_pool/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "allenai/dolma3_pool - 'default' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/metadata",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/metadata/cc_dump",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "cc_dump"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/dolma2_qc",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/dolma2_qc/0",
                  "dataType": "cr:Float64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "dolma2_qc"
                      },
                      {
                        "jsonPath": "0"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/dolma2_qc/1",
                  "dataType": "cr:Float64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "dolma2_qc"
                      },
                      {
                        "jsonPath": "1"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/exact_duplicates",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "exact_duplicates"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/lang",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/lang/en",
                  "dataType": "cr:Float64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "lang"
                      },
                      {
                        "jsonPath": "en"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/madlad",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/madlad/num_sentences",
                  "dataType": "cr:Int64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "madlad"
                      },
                      {
                        "jsonPath": "num_sentences"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/madlad/rule.2",
                  "dataType": "cr:Int64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "madlad"
                      },
                      {
                        "jsonPath": "['rule.2']"
                      }
                    ]
                  },
                  "isArray": true,
                  "arrayShape": "-1"
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/madlad/rule.5",
                  "dataType": "cr:Int64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "madlad"
                      },
                      {
                        "jsonPath": "['rule.5']"
                      }
                    ]
                  },
                  "isArray": true,
                  "arrayShape": "-1"
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/madlad/status",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "madlad"
                      },
                      {
                        "jsonPath": "status"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/minhash",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/minhash/cc_id",
                  "dataType": "cr:Int64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "minhash"
                      },
                      {
                        "jsonPath": "cc_id"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/minhash/cc_idx",
                  "dataType": "cr:Int64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "minhash"
                      },
                      {
                        "jsonPath": "cc_idx"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/metadata/minhash/cc_size",
                  "dataType": "cr:Int64",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "metadata"
                    },
                    "transform": [
                      {
                        "jsonPath": "minhash"
                      },
                      {
                        "jsonPath": "cc_size"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/original_word_count",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "original_word_count"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/sa_remove_ranges",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "sa_remove_ranges"
                }
              },
              "isArray": true,
              "arrayShape": "-1,-1"
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/text_hash",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "text_hash"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/warc_content_type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "warc_content_type"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/warc_date",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "warc_date"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/metadata/warc_url",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "warc_url"
                }
              }
            },
            null,
            {
              "@type": "cr:Field",
              "@id": "default/metadata/weborganizer_max",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "metadata"
                },
                "transform": {
                  "jsonPath": "weborganizer_max"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
