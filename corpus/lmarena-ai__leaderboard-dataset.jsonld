      "@id": "agent_splits",
      "name": "agent_splits",
      "description": "Splits for the agent config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "agent_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "agent_splits/split_name": "latest"
        },
        {
          "agent_splits/split_name": "full"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "agent",
      "description": "lmarena-ai/leaderboard-dataset - 'agent' subset\n\nAdditional information:\n- 2 splits: latest, full",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "agent/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-agent"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "agent/(?:partial-)?(latest|full)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "agent_splits/split_name"
            }
          }
        },
        {
