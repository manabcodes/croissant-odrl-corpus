        },
        {
          "@type": "cr:Field",
          "@id": "agent/score",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-agent"
            },
            "extract": {
              "column": "score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "agent/score_ci_lower",
