  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/cy0307/awesome-egocentric-atlas/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-catalog",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "catalog/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "catalog_splits/split_name"
      },
      "@id": "catalog_splits",
      "name": "catalog_splits",
      "description": "Splits for the catalog config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "catalog_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "catalog_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "catalog",
      "description": "cy0307/awesome-egocentric-atlas - 'catalog' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "catalog/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "catalog/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "catalog_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/kind",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "kind"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/released",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "released"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/venue",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "venue"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/status",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "status"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/scope",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "scope"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/year",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "year"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/paper",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "paper"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/license",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-catalog"
            },
            "extract": {
              "column": "license"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "catalog/scale",
