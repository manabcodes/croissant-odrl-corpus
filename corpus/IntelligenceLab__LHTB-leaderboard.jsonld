          "@id": "leaderboard/model",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-leaderboard"
            },
            "extract": {
              "column": "model"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "leaderboard/agent",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
