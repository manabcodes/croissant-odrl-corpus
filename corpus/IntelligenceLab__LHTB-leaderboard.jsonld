        },
        {
          "@type": "cr:Field",
          "@id": "leaderboard/strict_pass_at_10",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-leaderboard"
            },
            "extract": {
              "column": "strict_pass_at_10"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "leaderboard/n_tasks",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-leaderboard"
            },
            "extract": {
              "column": "n_tasks"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "leaderboard/agent_budget_sec",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-leaderboard"
            },
