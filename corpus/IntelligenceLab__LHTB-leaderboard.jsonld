            "fileSet": {
              "@id": "parquet-files-for-config-leaderboard"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "leaderboard/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "leaderboard_splits/split_name"
            }
          }
        },
