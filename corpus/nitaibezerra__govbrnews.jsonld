    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/nitaibezerra/govbrnews/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "nitaibezerra/govbrnews - 'default' subset\n\nAdditional information:\n- 2 skipped columns: published_at, updated_datetime",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/unique_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "unique_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/agency",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "agency"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/extracted_at",
          "dataType": "sc:DateTime",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "extracted_at"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/subtitle",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "subtitle"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/editorial_lead",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "editorial_lead"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/content",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "content"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/video_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "video_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/tags",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/theme_1_level_1",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "theme_1_level_1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/theme_1_level_1_code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "theme_1_level_1_code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/theme_1_level_1_label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "theme_1_level_1_label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/theme_1_level_2_code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "theme_1_level_2_code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/theme_1_level_2_label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "theme_1_level_2_label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/theme_1_level_3_code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "theme_1_level_3_code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/theme_1_level_3_label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "theme_1_level_3_label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/most_specific_theme_code",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "most_specific_theme_code"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/most_specific_theme_label",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "most_specific_theme_label"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/summary",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "summary"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "govbrnews",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tGovBR News Dataset\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tIntrodu\u00e7\u00e3o\n\t\n\nO GovBR News Dataset \u00e9 um conjunto de dados resultante da raspagem automatizada de not\u00edcias publicadas por ag\u00eancias governamentais no dom\u00ednio gov.br. Este dataset \u00e9 atualizado regularmente para incluir as not\u00edcias mais recentes, facilitando o monitoramento, an\u00e1lise e pesquisa de informa\u00e7\u00f5es governamentais.\nOs dados incluem not\u00edcias com seus metadados, como t\u00edtulo, data de publica\u00e7\u00e3o, categoria, tags, URL original e conte\u00fado. Este\u2026 See the full description on the dataset page: https://huggingface.co/datasets/nitaibezerra/govbrnews.",
  "alternateName": [
    "nitaibezerra/govbrnews"
  ],
  "creator": {
    "@type": "Person",
    "name": "Nitai Bezerra da Silva ",
    "url": "https://huggingface.co/nitaibezerra"
  },
