  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "HAE_RAE_BENCH_1.1",
  "description": "The HAE_RAE_BENCH 1.1 is an ongoing project to develop a suite of evaluation tasks designed to test the \nunderstanding of models regarding Korean cultural and contextual nuances. \nCurrently, it comprises 13 distinct tasks, with a total of 4900 instances. \nPlease note that although this repository contains datasets from the original HAE-RAE BENCH paper, \nthe contents are not completely identical. Specifically, the reading comprehension subset from the original version has been removed due to\u2026 See the full description on the dataset page: https://huggingface.co/datasets/HAERAE-HUB/HAE_RAE_BENCH_1.1.",
  "alternateName": [
    "HAERAE-HUB/HAE_RAE_BENCH_1.1"
  ],
  "creator": {
    "@type": "Organization",
    "name": "HAE-RAE",
    "url": "https://huggingface.co/HAERAE-HUB"
  },
