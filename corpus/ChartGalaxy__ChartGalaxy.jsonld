    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ChartGalaxy/ChartGalaxy/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "preview"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "ChartGalaxy/ChartGalaxy - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(preview)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/chart_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "chart_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/chart_variation",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "chart_variation"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/chart_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "chart_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/data_source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "data_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/data",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "data"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "ChartGalaxy",
  "identifier": "10.57967/hf/5638",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tChartGalaxy: A Dataset for Infographic Chart Understanding and Generation\n\t\n\n\ud83e\udd17 Dataset | \ud83d\udda5\ufe0f Code | \ud83d\udcc4 Paper | \ud83d\udcc4 Arxiv \n\n\t\n\t\t\n\t\n\t\n\t\t\ud83d\udd25 News\n\t\n\n[2026.02] \ud83c\udf89\ud83c\udf89 A new batch of data has been added, comprising 108,208 infographic charts.\nThis update features broader diversity in title designs and more polished layouts, improving overall readability.\n[2025.12]  \ud83c\udf89\ud83c\udf89 A new batch of data has been added, comprising 19,458 infographic charts.\nThis update includes more diverse title designs\u2026 See the full description on the dataset page: https://huggingface.co/datasets/ChartGalaxy/ChartGalaxy.",
  "alternateName": [
    "ChartGalaxy/ChartGalaxy"
  ],
  "creator": {
    "@type": "Person",
    "name": "Chart Galaxy",
    "url": "https://huggingface.co/ChartGalaxy"
  },
  "keywords": [
