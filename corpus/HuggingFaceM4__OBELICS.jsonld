          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "opt_out_docs_removed_2023_07_12_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "opt_out_docs_removed_2023_07_12",
      "name": "opt_out_docs_removed_2023_07_12",
      "description": "HuggingFaceM4/OBELICS - 'opt_out_docs_removed_2023_07_12' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "opt_out_docs_removed_2023_07_12/split",
          "name": "opt_out_docs_removed_2023_07_12/split",
