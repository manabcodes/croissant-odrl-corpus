          "@id": "default/general_metadata",
          "name": "default/general_metadata",
          "description": "Column 'general_metadata' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "general_metadata"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/texts",
          "name": "default/texts",
          "description": "Column 'texts' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "texts"
            }
          },
          "repeated": true
        }
      ]
    },
