    {
      "@type": "cr:RecordSet",
      "@id": "abs",
      "description": "dazhiyang/bsrn-crs - 'abs' subset\n\nAdditional information:\n- 1 skipped column: __index_level_0__",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "abs/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-abs"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "abs/(?:partial-)?(abs)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "abs_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "abs/ghi_crs",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-abs"
            },
            "extract": {
              "column": "ghi_crs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "abs/bni_crs",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-abs"
            },
            "extract": {
              "column": "bni_crs"
            }
          }
