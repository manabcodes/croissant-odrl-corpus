      "name": "condition_splits",
      "description": "Splits for the condition config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "condition_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "condition_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "condition",
      "description": "moose-code/polymarket-onchain-v1 - 'condition' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "condition/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-condition"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "condition/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "condition_splits/split_name"
            }
          }
        },
        {
