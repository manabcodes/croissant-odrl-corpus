{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/open-index/open-markdown/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-CC-MAIN-2026-21",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "CC-MAIN-2026-21/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "CC-MAIN-2026-21_splits/split_name"
      },
      "@id": "CC-MAIN-2026-21_splits",
      "name": "CC-MAIN-2026-21_splits",
      "description": "Splits for the CC-MAIN-2026-21 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "CC-MAIN-2026-21_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "CC-MAIN-2026-21",
      "description": "open-index/open-markdown - 'CC-MAIN-2026-21' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "CC\\-MAIN\\-2026\\-21/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "CC-MAIN-2026-21_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/doc_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "doc_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/host",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "host"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/crawl_date",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "crawl_date"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/warc_record_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "warc_record_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/warc_refers_to",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "warc_refers_to"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/html_length",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "html_length"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/markdown_length",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "markdown_length"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "CC-MAIN-2026-21/markdown",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-CC-MAIN-2026-21"
            },
            "extract": {
              "column": "markdown"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "open-markdown",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tOpen Markdown\n\t\n\n\nClean markdown from the web, ready for training and retrieval\n\n\n\t\n\t\t\n\t\n\t\n\t\tWhat is it?\n\t\n\nOpen Markdown is a large-scale web text dataset built from Common Crawl. Common Crawl is a non-profit that crawls the web and freely provides its archives and datasets to the public \u2014 see their latest crawl announcement for details on the source data. Every page goes through a pipeline that extracts the main content from raw HTML, converts it to clean Markdown, and packages\u2026 See the full description on the dataset page: https://huggingface.co/datasets/open-index/open-markdown.",
  "alternateName": [
    "open-index/open-markdown",
    "Open Markdown"
  ],
  "creator": {
    "@type": "Organization",
    "name": "OpenIndex",
    "url": "https://huggingface.co/open-index"
  },
  "keywords": [
    "text-generation",
    "feature-extraction",
    "English",
    "odc-by",
    "10M - 100M",
    "Tabular",
    "Text",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "common-crawl",
    "web-crawl",
    "markdown",
    "text"
  ],
  "license": "https://choosealicense.com/licenses/odc-by/",
  "sameAs": "https://huggingface.co/datasets/open-index/open-markdown",
  "url": "https://huggingface.co/datasets/open-index/open-markdown",
