{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/nvidia/OpenCodeReasoning-2/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-train",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "train/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "train_splits/split_name"
      },
      "@id": "train_splits",
      "name": "train_splits",
      "description": "Splits for the train config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "train_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "train_splits/split_name": "python"
        },
        {
          "train_splits/split_name": "cpp"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "train",
      "description": "nvidia/OpenCodeReasoning-2 - 'train' subset (first 5GB)\n\nAdditional information:\n- 2 splits: python, cpp",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "train/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "train/(?:partial-)?(python|cpp)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "train_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/r1_generation",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "r1_generation"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/qwq_critique",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "qwq_critique"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/solution",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "solution"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/judgement",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "judgement"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/pass_rate",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "pass_rate"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/license",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "license"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "dataset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "split"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/difficulty",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "difficulty"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/index",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "train/question_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-train"
            },
            "extract": {
              "column": "question_id"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "OpenCodeReasoning-2",
  "description": "\n\t\n\t\t\n\t\tOpenCodeReasoning-2: A Large-scale Dataset for Reasoning in Code Generation and Critique\n\t\n\n\n\t\n\t\t\n\t\tDataset Description\n\t\n\nOpenCodeReasoning-2 is the largest reasoning-based synthetic dataset to date for coding, comprising 1.4M samples in Python and 1.1M samples in C++ across 34,799 unique competitive programming questions. \nOpenCodeReasoning-2 is designed for supervised fine-tuning (SFT) tasks of code completion and code critique.\n\nGithub Repo - Access the complete pipeline used to\u2026 See the full description on the dataset page: https://huggingface.co/datasets/nvidia/OpenCodeReasoning-2.",
  "alternateName": [
    "nvidia/OpenCodeReasoning-2",
    "OpenCodeReasoning-2"
  ],
  "creator": {
    "@type": "Organization",
    "name": "NVIDIA",
    "url": "https://huggingface.co/nvidia"
  },
  "keywords": [
    "text-generation",
    "cc-by-4.0",
    "1M - 10M",
    "parquet",
    "Text",
    "Datasets",
    "Dask",
    "Croissant",
    "Polars",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "Synthetic"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/nvidia/OpenCodeReasoning-2",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}