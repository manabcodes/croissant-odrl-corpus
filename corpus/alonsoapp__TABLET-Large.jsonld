{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/alonsoapp/TABLET-Large/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "wikibio_train"
        },
        {
          "default_splits/split_name": "rel_extraction_train"
        },
        {
          "default_splits/split_name": "col_type_train"
        },
        {
          "default_splits/split_name": "tatqa_train"
        },
        {
          "default_splits/split_name": "hybridqa_train"
        },
        {
          "default_splits/split_name": "table_instruction_train"
        },
        {
          "default_splits/split_name": "tabmwp_train"
        },
        {
          "default_splits/split_name": "hitab_train"
        },
        {
          "default_splits/split_name": "fetaqa_train"
        },
        {
          "default_splits/split_name": "table_recognition_train"
        },
        {
          "default_splits/split_name": "table_cell_extraction_train"
        },
        {
          "default_splits/split_name": "table_size_detection_train"
        },
        {
          "default_splits/split_name": "merged_cell_detection_train"
        },
        {
          "default_splits/split_name": "table_cell_location_train"
        },
        {
          "default_splits/split_name": "tabfact_train"
        },
        {
          "default_splits/split_name": "totto_train"
        },
        {
          "default_splits/split_name": "ent_link_train"
        },
        {
          "default_splits/split_name": "row_column_extraction_train"
        },
        {
          "default_splits/split_name": "infotabs_train"
        },
        {
          "default_splits/split_name": "wikitq_train"
        },
        {
          "default_splits/split_name": "struct_aware_parse_train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "alonsoapp/TABLET-Large - 'default' subset\n\nAdditional information:\n- 21 splits: wikibio_train, rel_extraction_train, col_type_train, tatqa_train, hybridqa_train, table_instruction_train, tabmwp_train, hitab_train, fetaqa_train, table_recognition_train, table_cell_extraction_train, table_size_detection_train, merged_cell_detection_train, table_cell_location_train, tabfact_train, totto_train, ent_link_train, row_column_extraction_train, infotabs_train, wikitq_train, struct_aware_parse_train",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(wikibio_train|rel_extraction_train|col_type_train|tatqa_train|hybridqa_train|table_instruction_train|tabmwp_train|hitab_train|fetaqa_train|table_recognition_train|table_cell_extraction_train|table_size_detection_train|merged_cell_detection_train|table_cell_location_train|tabfact_train|totto_train|ent_link_train|row_column_extraction_train|infotabs_train|wikitq_train|struct_aware_parse_train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/example_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "example_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/img_source",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "img_source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/input",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "input"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/metadata",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "metadata"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/output",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "output"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "split"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/src_example_ids",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "src_example_ids"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_html",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_html"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_img",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_img"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_page_title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_page_title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_section_title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_section_title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_seed_dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_seed_dataset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_seed_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_seed_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_variant",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_variant"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_wiki_old_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_wiki_old_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/table_wiki_page_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "table_wiki_page_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/task",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "task"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "TABLET-Large",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tTABLET-Large\n\t\n\nThis is the Large sized train set of the TABLET dataset. It contains all train examples for all TABLET tasks, resulting in a total of 3,505,311 training examples across 17 tasks.This dataset is self-contained, each example includes a table image, its HTML representation, and the associated task data.However, if you're interested in downloading just the TABLET tables, check out TABLET-tables.  \nAll TABLET Subsets:\n\n(train) TABLET-Small: The smallest TABLET subset\u2026 See the full description on the dataset page: https://huggingface.co/datasets/alonsoapp/TABLET-Large.",
  "alternateName": [
    "alonsoapp/TABLET-Large"
  ],
  "creator": {
    "@type": "Person",
    "name": "I\u00f1igo",
    "url": "https://huggingface.co/alonsoapp"
  },
  "keywords": [
    "cc-by-4.0",
    "1M - 10M",
    "parquet",
    "optimized-parquet",
    "Image",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "arxiv:2509.21205",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/alonsoapp/TABLET-Large",
