        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "small_tokens/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-small_tokens_cleaned",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "small_tokens_cleaned/*/*.parquet"
    }
  ],
