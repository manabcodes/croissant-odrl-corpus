      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "Ciroc0/dmi-aarhus-weather-data - 'default' subset\n\nAdditional information:\n- 3 skipped columns: target_timestamp, reference_time, observation_context_timestamp",
