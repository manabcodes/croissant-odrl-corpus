    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/brian-learns/cdx-cc-news/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "year_2016"
        },
        {
          "default_splits/split_name": "year_2017"
        },
        {
          "default_splits/split_name": "year_2018"
        },
        {
          "default_splits/split_name": "year_2019"
        },
        {
          "default_splits/split_name": "year_2020"
        },
        {
          "default_splits/split_name": "year_2021"
        },
        {
          "default_splits/split_name": "year_2022"
        },
        {
          "default_splits/split_name": "year_2023"
        },
        {
          "default_splits/split_name": "year_2024"
        },
        {
          "default_splits/split_name": "year_2025"
        },
        {
          "default_splits/split_name": "year_2026"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "brian-learns/cdx-cc-news - 'default' subset\n\nAdditional information:\n- 11 splits: year_2016, year_2017, year_2018, year_2019, year_2020, year_2021, year_2022, year_2023, year_2024, year_2025, year_2026",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(year_2016|year_2017|year_2018|year_2019|year_2020|year_2021|year_2022|year_2023|year_2024|year_2025|year_2026)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/Surt",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "Surt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/capture_time",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "capture_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/mime",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "mime"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/status",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "status"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/digest",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "digest"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/length",
          "dataType": "cr:UInt64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "length"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/offset",
          "dataType": "cr:UInt64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "offset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/filename",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "filename"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "cdx-cc-news",
  "identifier": "10.57967/hf/9637",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tcdx-cc-news\n\t\n\nCDXj indexes for Common Crawl News Dataset.\nSee also News Dataset Announcement\nI could not find indexes to Common Crawl News, so I decided to create some.\nThen I created a RocksDB Index and a lookup API.\nDirect url to API:\nhttps://brian-learns-cc-news-cdx-server.hf.space/lookup\n\nCLI for querying this index and retrieving archived web pages from CC-NEWS Common Crawl WARC files https://github.com/brian-learns/ccnget\n\n\t\n\t\t\n\t\n\t\n\t\tDirectory Layout\n\t\n\n\u251c\u2500\u2500\u2026 See the full description on the dataset page: https://huggingface.co/datasets/brian-learns/cdx-cc-news.",
  "alternateName": [
    "brian-learns/cdx-cc-news"
  ],
  "creator": {
    "@type": "Person",
    "name": "Brian",
    "url": "https://huggingface.co/brian-learns"
  },
