        },
        {
          "@type": "cr:Field",
          "@id": "Gemini-1.0_reason/gold_ids",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Gemini-1.0_reason"
            },
            "extract": {
              "column": "gold_ids"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "Gemini-1.0_reason/gold_answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Gemini-1.0_reason"
