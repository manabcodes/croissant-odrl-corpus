    {
      "@type": "cr:RecordSet",
      "@id": "Gemini-1.0_reason",
      "description": "mteb/BRIGHT - 'Gemini-1.0_reason' subset\n\nAdditional information:\n- 12 splits: biology, earth_science, economics, psychology, robotics, stackoverflow, sustainable_living, leetcode, pony, aops, theoremqa_questions, theoremqa_theorems",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Gemini-1.0_reason/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Gemini-1.0_reason"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Gemini\\-1\\.0_reason/(?:partial-)?(biology|earth_science|economics|psychology|robotics|stackoverflow|sustainable_living|leetcode|pony|aops|theoremqa_questions|theoremqa_theorems)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Gemini-1.0_reason_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Gemini-1.0_reason/query",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Gemini-1.0_reason"
            },
            "extract": {
              "column": "query"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Gemini-1.0_reason/reasoning",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Gemini-1.0_reason"
            },
            "extract": {
              "column": "reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Gemini-1.0_reason/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Gemini-1.0_reason"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "Gemini-1.0_reason/excluded_ids",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Gemini-1.0_reason"
            },
            "extract": {
              "column": "excluded_ids"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "Gemini-1.0_reason/gold_ids_long",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Gemini-1.0_reason"
            },
            "extract": {
