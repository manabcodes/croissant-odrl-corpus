{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/nyuuzyou/pxhere/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "all"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "nyuuzyou/pxhere - 'default' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(all)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/jpg",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "jpg"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/json",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/json/download_url",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "download_url"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/exif_info",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "default/json/exif_info/aperture",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "exif_info"
                      },
                      {
                        "jsonPath": "aperture"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/json/exif_info/camera_model",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "exif_info"
                      },
                      {
                        "jsonPath": "camera_model"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/json/exif_info/focal_length",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "exif_info"
                      },
                      {
                        "jsonPath": "focal_length"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/json/exif_info/iso",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "exif_info"
                      },
                      {
                        "jsonPath": "iso"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/json/exif_info/lens_details_raw",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "exif_info"
                      },
                      {
                        "jsonPath": "lens_details_raw"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/json/exif_info/resolution",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "exif_info"
                      },
                      {
                        "jsonPath": "resolution"
                      }
                    ]
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "default/json/exif_info/shutter_speed",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-default"
                    },
                    "extract": {
                      "column": "json"
                    },
                    "transform": [
                      {
                        "jsonPath": "exif_info"
                      },
                      {
                        "jsonPath": "shutter_speed"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/image_id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "image_id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/tags",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                }
              },
              "isArray": true,
              "arrayShape": "-1"
            },
            {
              "@type": "cr:Field",
              "@id": "default/json/uploaded",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "json"
                },
                "transform": {
                  "jsonPath": "uploaded"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/__key__",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "__key__"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/__url__",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "__url__"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "pxhere",
  "description": "\n\t\n\t\t\n\t\tDataset Card for pxhere Images\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nThis dataset contains a large collection of high-quality photographs sourced from pxhere.com, a free stock photo website. The dataset includes approximately 1,100,000 images in full resolution covering a wide range of subjects including nature, people, urban environments, objects, animals, and landscapes. All images are provided under the Creative Commons Zero (CC0) license, making them freely available for personal and\u2026 See the full description on the dataset page: https://huggingface.co/datasets/nyuuzyou/pxhere.",
  "alternateName": [
    "nyuuzyou/pxhere",
    "PxHere Images"
  ],
  "creator": {
    "@type": "Person",
    "name": "nyuuzyou",
    "url": "https://huggingface.co/nyuuzyou"
  },
  "keywords": [
    "image-classification",
    "image-to-text",
    "text-to-image",
    "image-to-image",
    "found",
    "monolingual",
    "original",
    "English",
    "cc0-1.0",
    "1M - 10M",
    "webdataset",
    "Image",
    "Text",
    "Datasets",
    "WebDataset",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "image"
  ],
  "license": "https://choosealicense.com/licenses/cc0-1.0/",
  "url": "https://huggingface.co/datasets/nyuuzyou/pxhere",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC0 1.0 Universal \u2014 public domain dedication",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ]
  }
}