      "name": "3D_splits",
      "description": "Splits for the 3D config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "3D_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "3D_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
