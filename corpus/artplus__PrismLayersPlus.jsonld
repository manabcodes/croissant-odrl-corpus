            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "3D/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "3D_splits/split_name"
            }
          }
        },
