      "description": "Splits for the toy config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "toy_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "toy_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "toy",
      "description": "artplus/PrismLayersPlus - 'toy' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "toy/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-toy"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "toy/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "toy_splits/split_name"
            }
          }
        },
        {
