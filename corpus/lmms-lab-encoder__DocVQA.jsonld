    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/lmms-lab-encoder/DocVQA/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-DocVQA",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "DocVQA/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-InfographicVQA",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "InfographicVQA/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "DocVQA_splits/split_name"
      },
      "@id": "DocVQA_splits",
      "name": "DocVQA_splits",
      "description": "Splits for the DocVQA config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "DocVQA_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "DocVQA_splits/split_name": "validation"
        },
        {
          "DocVQA_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "DocVQA",
      "description": "lmms-lab-encoder/DocVQA - 'DocVQA' subset\n\nAdditional information:\n- 2 splits: validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "DocVQA/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "DocVQA/(?:partial-)?(validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "DocVQA_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/questionId",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "questionId"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/question_types",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "question_types"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/docId",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "docId"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/ucsf_document_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "ucsf_document_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/ucsf_document_page_no",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "ucsf_document_page_no"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/answers",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "answers"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "DocVQA/data_split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-DocVQA"
            },
            "extract": {
              "column": "data_split"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "InfographicVQA_splits/split_name"
      },
      "@id": "InfographicVQA_splits",
      "name": "InfographicVQA_splits",
      "description": "Splits for the InfographicVQA config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "InfographicVQA_splits/split_name": "validation"
        },
        {
          "InfographicVQA_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "InfographicVQA",
      "description": "lmms-lab-encoder/DocVQA - 'InfographicVQA' subset\n\nAdditional information:\n- 2 splits: validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "InfographicVQA/(?:partial-)?(validation|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "InfographicVQA_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/questionId",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "questionId"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/answers",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "answers"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/answer_type",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "answer_type"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/image_url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "image_url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/operation_reasoning",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "operation/reasoning"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/ocr",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "ocr"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "InfographicVQA/data_split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-InfographicVQA"
            },
            "extract": {
              "column": "data_split"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "DocVQA",
  "description": "\n\n\n\n\n\t\n\t\t\n\t\n\t\n\t\tLarge-scale Multi-modality Models Evaluation Suite\n\t\n\n\nAccelerating the development of large-scale multi-modality models (LMMs) with lmms-eval\n\n\ud83c\udfe0 Homepage | \ud83d\udcda Documentation | \ud83e\udd17 Huggingface Datasets\n\n\t\n\t\t\n\t\n\t\n\t\tThis Dataset\n\t\n\nThis is a formatted version of DocVQA. It is used in our lmms-eval pipeline to allow for one-click evaluations of large multi-modality models.\n@article{mathew2020docvqa,\n  title={DocVQA: A Dataset for VQA on Document Images. CoRR abs/2007.00398 (2020)}\u2026 See the full description on the dataset page: https://huggingface.co/datasets/lmms-lab-encoder/DocVQA.",
  "alternateName": [
    "lmms-lab-encoder/DocVQA"
  ],
  "creator": {
    "@type": "Organization",
    "name": "LMMs-Lab-Encoder",
    "url": "https://huggingface.co/lmms-lab-encoder"
  },
