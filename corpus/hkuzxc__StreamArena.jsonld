    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/hkuzxc/StreamArena/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-questions",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "questions/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-video_meta",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "video_meta/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "questions_splits/split_name"
      },
      "@id": "questions_splits",
      "name": "questions_splits",
      "description": "Splits for the questions config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "questions_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "questions_splits/split_name": "zh"
        },
        {
          "questions_splits/split_name": "en"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "questions",
      "description": "hkuzxc/StreamArena - 'questions' subset\n\nAdditional information:\n- 2 splits: zh, en\n- 2 skipped columns: answer, qdesc",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "questions/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "questions/(?:partial-)?(zh|en)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "questions_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/video_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "video_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/qid",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "qid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/qtype",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "qtype"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/ask_time",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "ask_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/ask_sec",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "ask_sec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/ref_time",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "ref_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/ref_sec",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "ref_sec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/horizon_layer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "horizon_layer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/horizon_sec",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "horizon_sec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/evidence_ts_sec",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "evidence_ts_sec"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "questions/evidence_hint",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-questions"
            },
            "extract": {
              "column": "evidence_hint"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "video_meta_splits/split_name"
      },
      "@id": "video_meta_splits",
      "name": "video_meta_splits",
      "description": "Splits for the video_meta config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "video_meta_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "video_meta_splits/split_name": "zh"
        },
        {
          "video_meta_splits/split_name": "en"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "video_meta",
      "description": "hkuzxc/StreamArena - 'video_meta' subset\n\nAdditional information:\n- 2 splits: zh, en",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "video_meta/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "video_meta/(?:partial-)?(zh|en)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "video_meta_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/video_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "video_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/duration_sec",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "duration_sec"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/n_questions",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "n_questions"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/url",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "url"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/channel",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "channel"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/youtube_category",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "youtube_category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/L1",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "L1"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/L2",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "L2"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/L3_tags",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "L3_tags"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "video_meta/was_live",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-video_meta"
            },
            "extract": {
              "column": "was_live"
            }
          }
        }
      ]
