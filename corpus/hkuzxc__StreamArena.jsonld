  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "StreamArena",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tStreamArena\n\t\n\n\n\n\nA benchmark for always-on, streaming video QA agents.\nThe user watches a long video (52\u2013134 min) with an AI assistant.\nThe assistant must answer questions in real time, sometimes based on the current frame,\nsometimes by recalling earlier content, sometimes by calling external tools,\nand sometimes by proactively waiting for a future moment to speak up.\n\nOverview of StreamArena. Top row: (a) source domains, (b) task types, (c) video durations, (d) temporal gaps\u2026 See the full description on the dataset page: https://huggingface.co/datasets/hkuzxc/StreamArena.",
  "alternateName": [
    "hkuzxc/StreamArena",
    "StreamArena"
  ],
  "creator": {
    "@type": "Person",
    "name": "Xichen Zhang",
    "url": "https://huggingface.co/hkuzxc"
  },
  "keywords": [
    "visual-question-answering",
    "video-classification",
    "Chinese",
    "English",
    "cc-by-nc-4.0",
