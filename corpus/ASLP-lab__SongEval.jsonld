{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "containedIn": "cr:containedIn",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cc": "http://creativecommons.org/ns#"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/ASLP-lab/SongEval/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "ASLP-lab/SongEval - 'default' subset (first 5GB)\n\nAdditional information:\n- 1 skipped column: audio",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/gender",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gender"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/annotation",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/annotation/annotator",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "annotation"
                },
                "transform": {
                  "jsonPath": "annotator"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/annotation/Coherence",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "annotation"
                },
                "transform": {
                  "jsonPath": "Coherence"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/annotation/Musicality",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "annotation"
                },
                "transform": {
                  "jsonPath": "Musicality"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/annotation/Memorability",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "annotation"
                },
                "transform": {
                  "jsonPath": "Memorability"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/annotation/Clarity",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "annotation"
                },
                "transform": {
                  "jsonPath": "Clarity"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/annotation/Naturalness",
              "dataType": "cr:Float64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "annotation"
                },
                "transform": {
                  "jsonPath": "Naturalness"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "SongEval",
  "description": "\n\t\n\t\t\n\t\tSongEval \ud83c\udfb5\n\t\n\nA Large-Scale Benchmark Dataset for Aesthetic Evaluation of Complete Songs\n\n\n\n  \n\n\n\t\n\t\t\n\t\n\t\n\t\t\ud83d\udcd6 Overview\n\t\n\nSongEval is the first open-source, large-scale benchmark dataset designed for aesthetic evaluation of complete songs. It provides over 2,399 songs (~140 hours) annotated by 16 expert raters across five perceptual dimensions. The dataset enables research in evaluating and improving music generation systems from a human aesthetic perspective.  \n\n\n\n\t\n\t\t\n\t\t\ud83c\udf1f Features\u2026 See the full description on the dataset page: https://huggingface.co/datasets/ASLP-lab/SongEval.",
  "alternateName": [
    "ASLP-lab/SongEval"
  ],
  "creator": {
    "@type": "Person",
    "name": "ASLP-lab",
    "url": "https://huggingface.co/ASLP-lab"
  },
  "keywords": [
    "cc-by-nc-sa-4.0",
    "1K - 10K",
    "soundfolder",
    "Audio",
    "Text",
    "Datasets",
    "Croissant",
    "arxiv:2505.10793",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-nc-sa-4.0/",
  "url": "https://huggingface.co/datasets/ASLP-lab/SongEval",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY-NC-SA 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:prohibition": {
      "@type": "odrl:Prohibition",
      "odrl:action": {
        "@id": "odrl:commercialize"
      }
    },
    "odrl:duty": [
      {
        "@type": "odrl:Duty",
        "odrl:action": {
          "@id": "odrl:attribution"
        }
      },
      {
        "@type": "odrl:Duty",
        "odrl:action": {
          "@id": "cc:ShareAlike"
        }
      }
    ]
  }
}