  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "de"
        },
        {
          "default_splits/split_name": "en"
        },
        {
          "default_splits/split_name": "es"
        },
        {
          "default_splits/split_name": "id"
        },
        {
          "default_splits/split_name": "ja"
        },
        {
          "default_splits/split_name": "ru"
        },
        {
          "default_splits/split_name": "tr"
        },
        {
          "default_splits/split_name": "zh"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "mteb/xflickrco - 'default' subset\n\nAdditional information:\n- 8 splits: de, en, es, id, ja, ru, tr, zh",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(de|en|es|id|ja|ru|tr|zh)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sentences",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sentences"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/image/bytes",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "image"
                },
                "transform": {
                  "jsonPath": "bytes"
                }
              }
            },
            null
          ]
        }
      ]
    },
