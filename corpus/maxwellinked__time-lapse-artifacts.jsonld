              "column": "dimensions"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/duration_seconds",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "duration_seconds"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/width_px",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
