    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/zeta-alpha-ai/NanoNQ/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-corpus",
      "name": "parquet-files-for-config-corpus",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "corpus/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-qrels",
      "name": "parquet-files-for-config-qrels",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "qrels/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-queries",
      "name": "parquet-files-for-config-queries",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "queries/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "corpus_splits/split_name"
      },
      "@id": "corpus_splits",
      "name": "corpus_splits",
      "description": "Splits for the corpus config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "corpus_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "corpus",
      "name": "corpus",
      "description": "zeta-alpha-ai/NanoNQ - 'corpus' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corpus/split",
          "name": "corpus/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "corpus/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "corpus_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/_id",
          "name": "corpus/_id",
          "description": "Column '_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corpus/text",
          "name": "corpus/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-corpus"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "qrels_splits/split_name"
      },
      "@id": "qrels_splits",
      "name": "qrels_splits",
      "description": "Splits for the qrels config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qrels_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "qrels_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "qrels",
      "name": "qrels",
      "description": "zeta-alpha-ai/NanoNQ - 'qrels' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "qrels/split",
          "name": "qrels/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "qrels/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "qrels_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qrels/query-id",
          "name": "qrels/query-id",
          "description": "Column 'query-id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "column": "query-id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "qrels/corpus-id",
          "name": "qrels/corpus-id",
          "description": "Column 'corpus-id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-qrels"
            },
            "extract": {
              "column": "corpus-id"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "queries_splits/split_name"
      },
      "@id": "queries_splits",
      "name": "queries_splits",
      "description": "Splits for the queries config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "queries_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "queries",
      "name": "queries",
      "description": "zeta-alpha-ai/NanoNQ - 'queries' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "queries/split",
          "name": "queries/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "queries/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "queries_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/_id",
          "name": "queries/_id",
          "description": "Column '_id' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "queries/text",
          "name": "queries/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-queries"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
