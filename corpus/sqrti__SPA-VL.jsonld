          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "test_splits/split_name": "harm"
        },
        {
          "test_splits/split_name": "help"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "test",
      "name": "test",
      "description": "sqrti/SPA-VL - 'test' subset\n\nAdditional information:\n- 2 splits: harm, help",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "test/split",
          "name": "test/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
