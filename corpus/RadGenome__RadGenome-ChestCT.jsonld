{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/RadGenome/RadGenome-ChestCT/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-grounded_reports",
      "name": "parquet-files-for-config-grounded_reports",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "grounded reports/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "grounded_reports_splits/split_name"
      },
      "@id": "grounded_reports_splits",
      "name": "grounded_reports_splits",
      "description": "Splits for the grounded_reports config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "grounded_reports_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "grounded_reports_splits/split_name": "train"
        },
        {
          "grounded_reports_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "grounded_reports",
      "name": "grounded_reports",
      "description": "RadGenome/RadGenome-ChestCT - 'grounded reports' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "grounded_reports/split",
          "name": "grounded_reports/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-grounded_reports"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "grounded\\ reports/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "grounded_reports_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "grounded_reports/Volumename",
          "name": "grounded_reports/Volumename",
          "description": "Column 'Volumename' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-grounded_reports"
            },
            "extract": {
              "column": "Volumename"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "grounded_reports/Anatomy",
          "name": "grounded_reports/Anatomy",
          "description": "Column 'Anatomy' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-grounded_reports"
            },
            "extract": {
              "column": "Anatomy"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "grounded_reports/Sentence",
          "name": "grounded_reports/Sentence",
          "description": "Column 'Sentence' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-grounded_reports"
            },
            "extract": {
              "column": "Sentence"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "RadGenome-ChestCT",
  "identifier": "10.57967/hf/5331",
  "description": "\n\t\n\t\t\n\t\tRadGenome Chest CT: A Grounded Vision-Language Dataset for Chest CT Analysis\n\t\n\nDeveloping generalist foundation model has recently attracted tremendous attention among researchers in the field of AI for Medicine (AI4Medicine). A pivotal insight in developing these models is their reliance on dataset scaling, which emphasizes the requirements on developing open-source medical image datasets that incorporate diverse supervision signals across various imaging modalities.\nWe introduce\u2026 See the full description on the dataset page: https://huggingface.co/datasets/RadGenome/RadGenome-ChestCT.",
  "alternateName": [
    "RadGenome/RadGenome-ChestCT"
  ],
  "creator": {
    "@type": "Organization",
    "name": "RadGenome",
    "url": "https://huggingface.co/RadGenome"
  },
  "keywords": [
    "cc-by-4.0",
    "100K - 1M",
    "Text",
    "arxiv:2404.16754",
    "arxiv:2403.17834",
    "doi:10.57967/hf/5331",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/RadGenome/RadGenome-ChestCT",
