  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "af_splits/split_name"
      },
      "@id": "af_splits",
      "name": "af_splits",
      "description": "Splits for the af config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "af_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "af_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "af",
      "description": "Viet-Mistral/CulturaY - 'af' subset (first 5GB)",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "af/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-af"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "af/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "af_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "af/id",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-af"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "af/document_lang",
          "dataType": "sc:Text",
