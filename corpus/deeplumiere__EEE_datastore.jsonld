  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "EEE_datastore",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tEvery Eval Ever Datastore\n\t\n\nThis is the datastore for the Every Eval Ever project. The readme from the project GitHub is below. It describes how to submit new benchmarks and evals to this dataset.\n\nEvalEval Coalition \u2014 \"We are a researcher community developing scientifically grounded research outputs and robust deployment infrastructure for broader impact evaluations.\"\n\nEvery Eval Ever is a shared schema and crowdsourced eval database. It defines a standardized metadata format for\u2026 See the full description on the dataset page: https://huggingface.co/datasets/deeplumiere/EEE_datastore.",
  "alternateName": [
    "deeplumiere/EEE_datastore"
  ],
  "creator": {
    "@type": "Person",
    "name": "Deep Joshi",
    "url": "https://huggingface.co/deeplumiere"
  },
  "keywords": [
