      "description": "allenai/omega-explorative - 'algebra_func_area' subset\n\nAdditional information:\n- 3 splits: train, test_in, test_out",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "algebra_func_area/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
