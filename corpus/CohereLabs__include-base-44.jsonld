  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "Albanian_splits/split_name"
      },
      "@id": "Albanian_splits",
      "name": "Albanian_splits",
      "description": "Splits for the Albanian config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Albanian_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "Albanian_splits/split_name": "test"
        },
        {
          "Albanian_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "Albanian",
      "description": "CohereLabs/include-base-44 - 'Albanian' subset\n\nAdditional information:\n- 2 splits: test, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "Albanian/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-Albanian"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "Albanian/(?:partial-)?(test|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "Albanian_splits/split_name"
            }
          }
        },
        {
