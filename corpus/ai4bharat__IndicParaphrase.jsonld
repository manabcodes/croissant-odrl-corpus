    {
      "@type": "cr:RecordSet",
      "@id": "as",
      "name": "as",
      "description": "ai4bharat/IndicParaphrase - 'as' subset\n\nAdditional information:\n- 2 splits: test, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "as/split",
          "name": "as/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-as"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "as/(?:partial-)?(test|validation)/.+parquet$"
            }
          },
          "references": {
