      "description": "Splits for the en config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "en_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "en_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "en",
