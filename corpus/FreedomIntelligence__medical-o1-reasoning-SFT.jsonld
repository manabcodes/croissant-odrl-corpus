      "field": [
        {
          "@type": "cr:Field",
          "@id": "en/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-en"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "en/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "en_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "en/Question",
