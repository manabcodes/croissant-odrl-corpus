    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/gretelai/synthetic_text_to_sql/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "name": "parquet-files-for-config-default",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "name": "default",
      "description": "gretelai/synthetic_text_to_sql - 'default' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "name": "default/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/id",
          "name": "default/id",
          "description": "Column 'id' from the Hugging Face parquet file.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/domain",
          "name": "default/domain",
          "description": "Column 'domain' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "domain"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/domain_description",
          "name": "default/domain_description",
          "description": "Column 'domain_description' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "domain_description"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sql_complexity",
          "name": "default/sql_complexity",
          "description": "Column 'sql_complexity' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sql_complexity"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sql_complexity_description",
          "name": "default/sql_complexity_description",
          "description": "Column 'sql_complexity_description' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sql_complexity_description"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sql_task_type",
          "name": "default/sql_task_type",
          "description": "Column 'sql_task_type' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sql_task_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sql_task_type_description",
          "name": "default/sql_task_type_description",
          "description": "Column 'sql_task_type_description' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sql_task_type_description"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sql_prompt",
          "name": "default/sql_prompt",
          "description": "Column 'sql_prompt' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sql_prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sql_context",
          "name": "default/sql_context",
          "description": "Column 'sql_context' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sql_context"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sql",
          "name": "default/sql",
          "description": "Column 'sql' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sql"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/sql_explanation",
          "name": "default/sql_explanation",
          "description": "Column 'sql_explanation' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "sql_explanation"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "synthetic_text_to_sql",
  "description": "\n  \n  Image generated by DALL-E. See prompt for more details\n\n\n\n\t\n\t\t\n\t\n\t\n\t\tsynthetic_text_to_sql\n\t\n\n\ngretelai/synthetic_text_to_sql is a rich dataset of high quality synthetic Text-to-SQL samples, \ndesigned and generated using Gretel Navigator, and released under Apache 2.0.\nPlease see our release blogpost for more details.\nThe dataset includes:\n\n  105,851 records partitioned into 100,000 train and 5,851 test records\n  ~23M total tokens, including ~12M SQL tokens\n  Coverage across 100 distinct\u2026 See the full description on the dataset page: https://huggingface.co/datasets/gretelai/synthetic_text_to_sql.",
  "alternateName": [
    "gretelai/synthetic_text_to_sql"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Gretel.ai",
    "url": "https://huggingface.co/gretelai"
  },
