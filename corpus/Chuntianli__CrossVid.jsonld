    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "BU_splits/split_name"
      },
      "@id": "BU_splits",
      "name": "BU_splits",
      "description": "Splits for the BU config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "BU_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "BU_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "BU",
      "description": "Chuntianli/CrossVid - 'BU' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "BU/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-BU"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "BU/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "BU_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "BU/id",
