      "@id": "advanced_math_splits",
      "name": "advanced_math_splits",
      "description": "Splits for the advanced_math config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "advanced_math_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "advanced_math_splits/split_name": "train"
        },
        {
          "advanced_math_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "advanced_math",
      "description": "camel-ai/loong - 'advanced_math' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "advanced_math/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-advanced_math"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "advanced_math/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "advanced_math_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "advanced_math/question",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-advanced_math"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "advanced_math/rationale",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-advanced_math"
            },
            "extract": {
              "column": "rationale"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "advanced_math/final_answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-advanced_math"
            },
            "extract": {
              "column": "final_answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "advanced_math/metadata",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-advanced_math"
            },
            "extract": {
              "column": "metadata"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "advanced_math/domain",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-advanced_math"
            },
            "extract": {
              "column": "domain"
            }
          }
        }
      ]
