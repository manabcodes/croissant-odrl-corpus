    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/DannHiroaki/China-Building-Footprints-CMAB-Mirror/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-metadata",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "metadata/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "metadata_splits/split_name"
      },
      "@id": "metadata_splits",
      "name": "metadata_splits",
      "description": "Splits for the metadata config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "metadata_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "metadata_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "metadata",
      "description": "DannHiroaki/China-Building-Footprints-CMAB-Mirror - 'metadata' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "metadata/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-metadata"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "metadata/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "metadata_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "metadata/Name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-metadata"
            },
            "extract": {
              "column": "Name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "metadata/Description",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-metadata"
            },
            "extract": {
              "column": "Description"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "metadata/Value_meaning",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-metadata"
            },
            "extract": {
              "column": "Value meaning"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "China-Building-Footprints-CMAB-Mirror",
  "description": "\n\t\n\t\t\n\t\tOrigin Data\n\t\n\n@misc{Zhang2025CMAB,\n  author       = {Zhang, Yecheng and Zhao, Huimin and Long, Ying},\n  title        = {{CMAB-The World's First National-Scale Multi-Attribute Building Dataset}},\n  year         = {2025},\n  month        = apr,\n  publisher    = {figshare},\n  doi          = {10.6084/m9.figshare.27992417},\n  url          = {https://doi.org/10.6084/m9.figshare.27992417},\n  howpublished = {dataset}\n}\n\n\n\t\n\t\t\n\t\tPaper\n\t\n\n@article{Zhang2025SciData,\n  author  = {Zhang, Y. and\u2026 See the full description on the dataset page: https://huggingface.co/datasets/DannHiroaki/China-Building-Footprints-CMAB-Mirror.",
  "alternateName": [
    "DannHiroaki/China-Building-Footprints-CMAB-Mirror",
    "China Building Footprints (CMAB) - Mirror"
  ],
  "creator": {
    "@type": "Person",
