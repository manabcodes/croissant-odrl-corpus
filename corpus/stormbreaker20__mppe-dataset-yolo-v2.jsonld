    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/stormbreaker20/mppe-dataset-yolo-v2/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "validation"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "stormbreaker20/mppe-dataset-yolo-v2 - 'default' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|validation)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/file_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "file_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/yolo_annotations",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "yolo_annotations"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/classes",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "classes"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/class_names",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "class_names"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/num_objects",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "num_objects"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/class_counts",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Coverall",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Coverall"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Face_Shield",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Face_Shield"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Goggles",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Goggles"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/No_Facial_Gear",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "No_Facial_Gear"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/No_Medical_Attire",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "No_Medical_Attire"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/No_Surgical_Cap",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "No_Surgical_Cap"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/No_Surgical_Gloves",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "No_Surgical_Gloves"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Person",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Person"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Shoe_Covers",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Shoe_Covers"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Surgical_Cap",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Surgical_Cap"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Surgical_Gloves",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Surgical_Gloves"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Surgical_Gown",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Surgical_Gown"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Surgical_Mask",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Surgical_Mask"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/class_counts/Surgical_Scrubs",
              "dataType": "cr:Int64",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "class_counts"
                },
                "transform": {
                  "jsonPath": "Surgical_Scrubs"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_width",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "image_width"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/image_height",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
