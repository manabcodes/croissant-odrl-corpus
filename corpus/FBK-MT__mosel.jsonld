  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/FBK-MT/mosel/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-hr",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "hr/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-mt",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "mt/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "hr_splits/split_name"
      },
      "@id": "hr_splits",
      "name": "hr_splits",
      "description": "Splits for the hr config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "hr_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "hr_splits/split_name": "train_voxpopuli"
        },
        {
          "hr_splits/split_name": "train_youtubecommons"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "hr",
      "description": "FBK-MT/mosel - 'hr' subset\n\nAdditional information:\n- 2 splits: train_voxpopuli, train_youtubecommons",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "hr/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "hr/(?:partial-)?(train_voxpopuli|train_youtubecommons)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "hr_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/lid",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "lid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/hall_repeated_ngrams",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "hall_repeated_ngrams"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/hall_long_word",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "hall_long_word"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/hall_frequent_single_word",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "hall_frequent_single_word"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/source",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "source"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/offset",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "offset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/duration",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/translation_en",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "translation_en"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hr/text_version_changed",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-hr"
            },
            "extract": {
              "column": "text_version_changed"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "mt_splits/split_name"
      },
      "@id": "mt_splits",
      "name": "mt_splits",
      "description": "Splits for the mt config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "mt_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "mt_splits/split_name": "train_voxpopuli"
        },
        {
          "mt_splits/split_name": "train_youtubecommons"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "mt",
      "description": "FBK-MT/mosel - 'mt' subset\n\nAdditional information:\n- 2 splits: train_voxpopuli, train_youtubecommons",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "mt/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "mt/(?:partial-)?(train_voxpopuli|train_youtubecommons)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "mt_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "mt/id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "mt/language",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
              "column": "language"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "mt/text",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "mt/lid",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
              "column": "lid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "mt/hall_repeated_ngrams",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
              "column": "hall_repeated_ngrams"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "mt/hall_long_word",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
              "column": "hall_long_word"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "mt/hall_frequent_single_word",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
