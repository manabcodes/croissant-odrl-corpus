        },
        {
          "@type": "cr:Field",
          "@id": "mt/translation_en",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-mt"
            },
            "extract": {
              "column": "translation_en"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "mt/text_version_changed",
          "dataType": "cr:Int64",
          "source": {
