    {
      "@type": "cr:RecordSet",
      "@id": "et",
      "name": "et",
      "description": "cambridgeltl/xcopa - 'et' subset\n\nAdditional information:\n- 2 splits: validation, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "et/split",
          "name": "et/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-et"
            },
            "extract": {
              "fileProperty": "fullpath"
