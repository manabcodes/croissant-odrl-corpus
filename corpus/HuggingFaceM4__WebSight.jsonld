    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/HuggingFaceM4/WebSight/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-v0.2",
      "name": "parquet-files-for-config-v0.2",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "v0.2/*/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-v0.1",
      "name": "parquet-files-for-config-v0.1",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "v0.1/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "v0.2_splits/split_name"
      },
      "@id": "v0.2_splits",
      "name": "v0.2_splits",
      "description": "Splits for the v0.2 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "v0.2_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "v0.2_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "v0.2",
      "name": "v0.2",
      "description": "HuggingFaceM4/WebSight - 'v0.2' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "v0.2/split",
          "name": "v0.2/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-v0.2"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "v0\\.2/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "v0.2_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "v0.2/image",
          "name": "v0.2/image",
          "description": "Image column 'image' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-v0.2"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "v0.2/text",
          "name": "v0.2/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-v0.2"
            },
            "extract": {
              "column": "text"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "v0.2/llm_generated_idea",
          "name": "v0.2/llm_generated_idea",
          "description": "Column 'llm_generated_idea' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-v0.2"
            },
            "extract": {
              "column": "llm_generated_idea"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "v0.1_splits/split_name"
      },
      "@id": "v0.1_splits",
      "name": "v0.1_splits",
      "description": "Splits for the v0.1 config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "v0.1_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "v0.1_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "v0.1",
      "name": "v0.1",
      "description": "HuggingFaceM4/WebSight - 'v0.1' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "v0.1/split",
          "name": "v0.1/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-v0.1"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "v0\\.1/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "v0.1_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "v0.1/image",
          "name": "v0.1/image",
          "description": "Image column 'image' from the Hugging Face parquet file.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-v0.1"
            },
            "extract": {
              "column": "image"
            },
            "transform": {
              "jsonPath": "bytes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "v0.1/text",
          "name": "v0.1/text",
          "description": "Column 'text' from the Hugging Face parquet file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-v0.1"
            },
            "extract": {
              "column": "text"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "WebSight",
  "description": "\n\t\n\t\t\n\t\tDataset Card for WebSight\n\t\n\n\n\t\n\t\t\n\t\tDataset Description\n\t\n\nWebSight is a large synthetic dataset containing HTML/CSS codes representing synthetically generated English websites, each accompanied by a corresponding screenshot.\nThis dataset serves as a valuable resource for tasks such as generating UI codes from a screenshot.\nIt comes in two versions:\n\nv0.1: Websites are coded with HTML + CSS. They do not include real images.\nv0.2: Websites are coded with HTML + Tailwind CSS. They do\u2026 See the full description on the dataset page: https://huggingface.co/datasets/HuggingFaceM4/WebSight.",
  "alternateName": [
    "HuggingFaceM4/WebSight",
    "WebSight"
  ],
  "creator": {
    "@type": "Organization",
    "name": "HuggingFaceM4",
    "url": "https://huggingface.co/HuggingFaceM4"
  },
  "keywords": [
    "English",
    "cc-by-4.0",
    "1M - 10M",
