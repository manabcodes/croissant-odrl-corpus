{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/dual-sim/data/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-eval",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "eval/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "eval_splits/split_name"
      },
      "@id": "eval_splits",
      "name": "eval_splits",
      "description": "Splits for the eval config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "eval_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "eval_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "eval",
      "description": "dual-sim/data - 'eval' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "eval/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eval"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "eval/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "eval_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "eval/action",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eval"
            },
            "extract": {
              "column": "action"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "eval/observation.state",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eval"
            },
            "extract": {
              "column": "observation.state"
            }
          },
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "eval/episode_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eval"
            },
            "extract": {
              "column": "episode_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "eval/frame_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eval"
            },
            "extract": {
              "column": "frame_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "eval/index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eval"
            },
            "extract": {
              "column": "index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "eval/task_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eval"
            },
            "extract": {
              "column": "task_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "eval/timestamp",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-eval"
            },
            "extract": {
              "column": "timestamp"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "data",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tDualSim\n\t\n\nData package for the AgiBotWorld Challenge 2026 dual-arm simulation track.\n\n\t\n\t\t\n\t\n\t\n\t\tLayout\n\t\n\ndualsim/\n\u251c\u2500\u2500 eval/                       # dualsim-specific evaluation set (~321 MB)\n\u2502   \u2514\u2500\u2500 AgiBotWorldChallenge-2026-eval-dualsim/\n\u2502       \u251c\u2500\u2500 _lerobot/           # LeRobot v2.1 dataset (meta / data / videos / sim)\n\u2502       \u251c\u2500\u2500 info_dataset/       # per-episode inputs (frame.png, proprio_stats.h5, camera params, sim/)\n\u2502       \u251c\u2500\u2500 gt_dataset/         # per-episode ground\u2026 See the full description on the dataset page: https://huggingface.co/datasets/dual-sim/data.",
  "alternateName": [
    "dual-sim/data",
    "DualSim (AgiBotWorld Challenge 2026)"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Dual-Sim",
    "url": "https://huggingface.co/dual-sim"
  },
  "keywords": [
    "robotics",
    "cc-by-nc-4.0",
    "< 1K",
    "parquet",
    "Image",
    "Tabular",
    "Time-series",
    "Video",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "lerobot",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "robotics",
    "manipulation",
    "lerobot",
    "agibot-world",
    "dual-arm",
    "simulation",
    "world-model"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-nc-4.0/",
  "url": "https://huggingface.co/datasets/dual-sim/data",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY-NC 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:prohibition": {
      "@type": "odrl:Prohibition",
      "odrl:action": {
        "@id": "odrl:commercialize"
      }
    },
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}