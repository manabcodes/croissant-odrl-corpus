{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/phamquiluan/RCAEval/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-cases",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "cases/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "cases_splits/split_name"
      },
      "@id": "cases_splits",
      "name": "cases_splits",
      "description": "Splits for the cases config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "cases_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "cases_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "cases",
      "description": "phamquiluan/RCAEval - 'cases' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "cases/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "cases/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "cases_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/case",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "case"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/dataset",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "dataset"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/suite",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "suite"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/system",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "system"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/system_name",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "system_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/root_cause_service",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "root_cause_service"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/fault",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "fault"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/fault_description",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "fault_description"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/repetition",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "repetition"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/inject_time",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "inject_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/n_metrics",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "n_metrics"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/n_timesteps",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "n_timesteps"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/time_start",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "time_start"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/time_end",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "time_end"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/duration_minutes",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "duration_minutes"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/normal_timesteps",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "normal_timesteps"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/faulty_timesteps",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "faulty_timesteps"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/has_logs",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "has_logs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/n_logs",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "n_logs"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/has_traces",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "has_traces"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/n_traces",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "n_traces"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cases/has_root_cause_file",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-cases"
            },
            "extract": {
              "column": "has_root_cause_file"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "RCAEval",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tRCAEval: A Benchmark for Root Cause Analysis of Microservice Systems\n\t\n\nThis repository hosts the datasets of RCAEval, an open-source benchmark for root\ncause analysis (RCA) in microservice systems. It contains 735 failure cases\ncollected from three microservice systems, organized into three benchmark suites.\n\n\ud83d\udcc4 Paper: RCAEval: A Benchmark for Root Cause Analysis of Microservice Systems with Telemetry Data (WWW 2025)\n\ud83d\udcbb Code: https://github.com/phamquiluan/RCAEval\n\ud83d\udce6 PyPI:\u2026 See the full description on the dataset page: https://huggingface.co/datasets/phamquiluan/RCAEval.",
  "alternateName": [
    "phamquiluan/RCAEval"
  ],
  "creator": {
    "@type": "Person",
    "name": "Luan Pham",
    "url": "https://huggingface.co/phamquiluan"
  },
  "keywords": [
    "English",
    "mit",
    "< 1K",
    "parquet",
    "Tabular",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "arxiv:2412.17015",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "arxiv:2412.17015",
    "root-cause-analysis",
    "microservices",
    "observability",
    "aiops",
    "telemetry",
    "anomaly-detection"
  ],
