      "@id": "metadata_splits",
      "name": "metadata_splits",
      "description": "Splits for the metadata config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "metadata_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "metadata_splits/split_name": "train"
        }
      ]
