              "@id": "other/questions/question",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-other"
                },
                "extract": {
                  "column": "questions"
                },
                "transform": {
                  "jsonPath": "question"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "other/questions/answer",
              "dataType": "sc:Text",
              "source": {
