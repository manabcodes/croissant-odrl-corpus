              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-diagrams"
                },
                "extract": {
                  "column": "questions"
                },
                "transform": {
                  "jsonPath": "answer"
                }
              }
            }
          ],
          "repeated": true
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "other_splits/split_name"
      },
      "@id": "other_splits",
      "name": "other_splits",
      "description": "Splits for the other config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "other_splits/split_name",
