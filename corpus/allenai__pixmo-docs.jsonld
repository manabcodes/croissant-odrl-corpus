      "description": "allenai/pixmo-docs - 'diagrams' subset\n\nAdditional information:\n- 2 splits: train, validation",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "diagrams/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-diagrams"
            },
            "extract": {
              "fileProperty": "fullpath"
