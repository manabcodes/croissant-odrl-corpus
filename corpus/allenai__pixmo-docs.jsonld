  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "pixmo-docs",
  "description": "\n\t\n\t\t\n\t\tPixMo-Docs\n\t\n\nWe now recommend using CoSyn-400k and CoSyn-point over these\ndatasets. They are improved versions with more images categories and an improved generation pipeline.\nPixMo-Docs is a collection of synthetic question-answer pairs about various kinds of computer-generated images, including charts, tables, diagrams, and documents. \nThe data was created by using the Claude large language model to generate code that can be executed to render an image, \nand using GPT-4o mini to\u2026 See the full description on the dataset page: https://huggingface.co/datasets/allenai/pixmo-docs.",
  "alternateName": [
    "allenai/pixmo-docs"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Ai2",
    "url": "https://huggingface.co/allenai"
  },
