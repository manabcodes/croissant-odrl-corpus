{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/openbank-uz/youtube_transcriptions/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "openbank-uz/youtube_transcriptions - 'default' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/file",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/gender",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "gender"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/transcription",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "transcription"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/prompt_tokens_used",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "prompt_tokens_used"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/total_tokens_used",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "total_tokens_used"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/audio",
          "dataType": "sc:AudioObject",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "audio"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/parsed_time",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "parsed_time"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/video_title",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "video_title"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/youtube_video_duration",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "youtube_video_duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/audio_format",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "audio_format"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_id_in_video",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_id_in_video"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_audio_index",
          "dataType": "cr:Int64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_audio_index"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/speaker_embedding",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "speaker_embedding"
            }
          },
          "isArray": true,
          "arrayShape": "-1,-1,-1"
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "youtube_transcriptions",
  "description": "\n\t\n\t\t\n\t\tDataset Description\n\t\n\nA speech dataset of Uzbek language audio clips sourced from YouTube videos. Audio segments were extracted, separated by speaker using vocal isolation, and transcribed using Google's Gemini 2.0 Flash model. Speaker identities were clustered using ECAPA-TDNN embeddings.\n\n\t\n\t\t\n\t\tUse Cases\n\t\n\n\nAutomatic Speech Recognition (ASR) for Uzbek\nText-to-Speech (TTS) synthesis for Uzbek\nFine-tuning speech models on Uzbek language data (e.g., Qwen3-TTS)\nSpeaker-conditioned TTS\u2026 See the full description on the dataset page: https://huggingface.co/datasets/openbank-uz/youtube_transcriptions.",
  "alternateName": [
    "openbank-uz/youtube_transcriptions",
    "Uzbek YouTube Speech Dataset"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Open Bank",
    "url": "https://huggingface.co/openbank-uz"
  },
  "keywords": [
    "automatic-speech-recognition",
    "text-to-speech",
    "Uzbek",
    "cc-by-nc-4.0",
    "100K - 1M",
    "parquet",
    "Audio",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "uzbek",
    "speech",
    "audio",
    "tts",
    "asr",
    "youtube",
    "gemini",
    "speaker-clustering"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-nc-4.0/",
  "url": "https://huggingface.co/datasets/openbank-uz/youtube_transcriptions",
  "usageInfo": {
    "@type": [
      "CreativeWork",
