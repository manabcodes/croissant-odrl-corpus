{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/FrontisAI/NatureBench-traces/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-index",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "index/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "index_splits/split_name"
      },
      "@id": "index_splits",
      "name": "index_splits",
      "description": "Splits for the index config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "index_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "index_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "index",
      "description": "FrontisAI/NatureBench-traces - 'index' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "index/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "index/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "index_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/harness",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "harness"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/model",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "model"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/case_id",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "case_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/compute",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "compute"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/best_aggregate_improvement",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "best_aggregate_improvement"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/effective_improvement",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "effective_improvement"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/judge_valid",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "judge_valid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/has_submissions",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "has_submissions"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/has_judge",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "has_judge"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/has_result",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "has_result"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "index/has_transcript",
          "dataType": "sc:Boolean",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-index"
            },
            "extract": {
              "column": "has_transcript"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "NatureBench-traces",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tNatureBench-traces\n\t\n\nNatureBench-traces contains the full solving process \nof coding agents on the 90 tasks of NatureBench.\n\nThe task packages themselves (task brief, data, evaluator, SOTA\nscores) live in the sibling repository FrontisAI/NatureBench.\nThis repository releases only the process traces: the complete conversation\nhistory of an agent reading the task, exploring the data, writing and debugging\ncode, and submitting for scoring, together with the per-attempt score records\u2026 See the full description on the dataset page: https://huggingface.co/datasets/FrontisAI/NatureBench-traces.",
  "alternateName": [
    "FrontisAI/NatureBench-traces",
    "NatureBench-traces"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Frontis AI",
    "url": "https://huggingface.co/FrontisAI"
  },
  "keywords": [
    "cc-by-4.0",
    "1K - 10K",
    "parquet",
    "Tabular",
    "Text",
    "Datasets",
    "pandas",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "agent",
    "coding-agent",
    "llm-agent",
    "agent-trajectories",
    "agent-traces"
  ],
  "license": "https://choosealicense.com/licenses/cc-by-4.0/",
  "url": "https://huggingface.co/datasets/FrontisAI/NatureBench-traces",
  "usageInfo": {
    "@type": [
      "CreativeWork",
      "odrl:Offer"
    ],
    "name": "CC BY 4.0",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:use"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:distribute"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:commercialize"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:derive"
        }
      },
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "odrl:reproduce"
        }
      }
    ],
    "odrl:duty": {
      "@type": "odrl:Duty",
      "odrl:action": {
        "@id": "odrl:attribution"
      }
    }
  }
}