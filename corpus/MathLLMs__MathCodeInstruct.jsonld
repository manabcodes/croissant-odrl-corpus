{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/MathLLMs/MathCodeInstruct/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-MathCodeInstruct",
      "name": "parquet-files-for-config-MathCodeInstruct",
      "description": "The underlying Parquet files as converted by Hugging Face (see: https://huggingface.co/docs/dataset-viewer/parquet).",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "MathCodeInstruct/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "MathCodeInstruct_splits/split_name"
      },
      "@id": "MathCodeInstruct_splits",
      "name": "MathCodeInstruct_splits",
      "description": "Splits for the MathCodeInstruct config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "MathCodeInstruct_splits/split_name",
          "name": "split_name",
          "description": "The name of the split.",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "MathCodeInstruct_splits/split_name": "train"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "MathCodeInstruct",
      "name": "MathCodeInstruct",
      "description": "MathLLMs/MathCodeInstruct - 'MathCodeInstruct' subset",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "MathCodeInstruct/split",
          "name": "MathCodeInstruct/split",
          "description": "Split to which the example belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-MathCodeInstruct"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "MathCodeInstruct/(?:partial-)?(train)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "MathCodeInstruct_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "MathCodeInstruct/messages",
          "name": "MathCodeInstruct/messages",
          "description": "Column 'messages' from the Hugging Face parquet file.",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "MathCodeInstruct/messages/role",
              "name": "MathCodeInstruct/messages/role",
              "description": "Column 'messages' from the Hugging Face parquet file.",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-MathCodeInstruct"
                },
                "extract": {
                  "column": "messages"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "MathCodeInstruct/messages/content",
              "name": "MathCodeInstruct/messages/content",
              "description": "Column 'messages' from the Hugging Face parquet file.",
              "subField": [
                {
                  "@type": "cr:Field",
                  "@id": "MathCodeInstruct/messages/content/type",
                  "name": "MathCodeInstruct/messages/content/type",
                  "description": "Column 'messages' from the Hugging Face parquet file.",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-MathCodeInstruct"
                    },
                    "extract": {
                      "column": "messages"
                    },
                    "transform": {
                      "jsonPath": "type"
                    }
                  }
                },
                {
                  "@type": "cr:Field",
                  "@id": "MathCodeInstruct/messages/content/content",
                  "name": "MathCodeInstruct/messages/content/content",
                  "description": "Column 'messages' from the Hugging Face parquet file.",
                  "dataType": "sc:Text",
                  "source": {
                    "fileSet": {
                      "@id": "parquet-files-for-config-MathCodeInstruct"
                    },
                    "extract": {
                      "column": "messages"
                    },
                    "transform": {
                      "jsonPath": "content"
                    }
                  }
                }
              ],
              "repeated": true
            }
          ],
          "repeated": true
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "MathCodeInstruct",
  "description": "\n\t\n\t\t\n\t\tMathCoder: Seamless Code Integration in LLMs for Enhanced Mathematical Reasoning\n\t\n\nPaper: https://arxiv.org/pdf/2310.03731.pdf\nRepo: https://github.com/mathllm/MathCoder\n\n\t\n\t\t\n\t\tIntroduction\n\t\n\nWe introduce MathCoder, a series of open-source large language models (LLMs) specifically tailored for general math problem-solving.\n\n\t\n\t\t\nBase Model: Llama-2\nBase Model: Code Llama\n\n\n\t\t\nMathCoder-L-7B\nMathCoder-CL-7B\n\n\nMathCoder-L-13B\nMathCoder-CL-34B\n\n\n\t\n\n\n\t\n\t\n\t\n\t\tTraining Data\n\t\n\nThe models\u2026 See the full description on the dataset page: https://huggingface.co/datasets/MathLLMs/MathCodeInstruct.",
  "alternateName": [
    "MathLLMs/MathCodeInstruct"
  ],
  "creator": {
    "@type": "Organization",
    "name": "LLMs for Reasoning",
    "url": "https://huggingface.co/MathLLMs"
  },
  "keywords": [
    "question-answering",
    "text-generation",
    "English",
    "apache-2.0",
    "10K - 100K",
    "json",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "arxiv:2310.03731",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "math",
    "code",
    "reasoning",
    "problem solving"
  ],
