  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "gaia2",
  "description": "\n\t\n\t\t\n\t\tGaia2\n\t\n\nPaper | Code | Project Page\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nGaia2 is a benchmark dataset for evaluating AI agent capabilities in simulated environments. The dataset contains 800 scenarios that test agent performance in environments where time flows continuously and events occur dynamically.\nThe dataset evaluates seven core capabilities: Execution (multi-step planning and state changes), Search (information gathering and synthesis), Adaptability (dynamic response to environmental\u2026 See the full description on the dataset page: https://huggingface.co/datasets/meta-agents-research-environments/gaia2.",
  "alternateName": [
    "meta-agents-research-environments/gaia2",
    "Gaia2: General AI Agent Benchmark"
  ],
  "creator": {
    "@type": "Organization",
    "name": "Meta Agents Research Environments",
    "url": "https://huggingface.co/meta-agents-research-environments"
  },
  "keywords": [
    "reinforcement-learning",
    "task-planning",
    "dialogue-modeling",
    "dialogue-generation",
    "conversational",
    "expert-generated",
    "expert-generated",
    "original",
    "English",
    "cc-by-4.0",
    "< 1K",
    "parquet",
    "Text",
    "Datasets",
    "pandas",
    "Croissant",
    "Polars",
    "arxiv:2509.17158",
    "\ud83c\uddfa\ud83c\uddf8 Region: US",
    "agent-evaluation",
    "multi-agent",
    "benchmark",
    "simulated-environment",
